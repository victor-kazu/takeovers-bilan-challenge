], "score": 0.9996001124382019, "text": "FORME"}, {"orientation_angle": 0, "polygon": [[293.0, 1732.0], [2279.0, 1741.0], [2278.0, 1792.0], [293.0, 1784.0]], "score": 0.9964666366577148, "text": "La société a été initialement constituée sous forme de société anonyme, par acte sous-seing privés"}, {"orientation_angle": 0, "polygon": [[295.0, 1790.0], [2279.0, 1794.0], [2278.0, 1847.0], [294.0, 1844.0]], "score": 0.9813904762268066, "text": "en date à Lyon du 30 juin 1983, enregistré à Lyon 6ème, le 19/07/1983, bord. 530 n° 6, puis elle a été"}, {"orientation_angle": 0, "polygon": [[291.0, 1849.0], [2279.0, 1856.0], [2278.0, 1909.0], [291.0, 1902.0]], "score": 0.9870491623878479, "text": "transformée en société par actions simplifiée régie par les lois et règlements en vigueur et par les"}, {"orientation_angle": 0, "polygon": [[294.0, 1909.0], [2029.0, 1909.0], [2029.0, 1960.0], [294.0, 1960.0]], "score": 0.9859253168106079, "text": "présents statuts, au terme de l'assemblée générale mixte en date du 17 novembre 2020."}, {"orientation_angle": 0, "polygon": [[293.0, 2020.0], [1951.0, 2025.0], [1951.0, 2078.0], [293.0, 2073.0]], "score": 0.9971766471862793, "text": "Elle fonctionne indifféremment sous la même forme avec un ou plusieurs associés."}, {"orientation_angle": 0, "polygon": [[294.0, 2138.0], [1347.0, 2138.0], [1347.0, 2190.0], [294.0, 2190.0]], "score": 0.99686199426651, "text": "Tout appel public à l'épargne est interdit à la société."}, {"orientation_angle": 0, "polygon": [[291.0, 2293.0], [525.0, 2293.0], [525.0, 2346.0], [291.0, 2346.0]], "score": 0.992438793182373, "text": "Article 2 "}, {"orientation_angle": 0, "polygon": [[580.0, 2291.0], [758.0, 2291.0], [758.0, 2346.0], [580.0, 2346.0]], "score": 0.9950156211853027, "text": "OBJET"}, {"orientation_angle": 0, "polygon": [[290.0, 2407.0], [777.0, 2411.0], [776.0, 2466.0], [289.0, 2462.0]], "score": 0.9944603443145752, "text": "La société a pour objet :"}, {"orientation_angle": 0, "polygon": [[362.0, 2520.0], [2277.0, 2529.0], [2277.0, 2580.0], [362.0, 2572.0]], "score": 0.9953744411468506, "text": "La création, l'acquisition et l'exploitation directement ou en location-gérance, de tout fonds de"}, {"orientation_angle": 1, "polygon": [[298.0, 2548.0], [307.0, 2548.0], [307.0, 2556.0], [298.0, 2556.0]], "score": 0.8694778084754944, "text": "="}, {"orientation_angle": 0, "polygon": [[363.0, 2577.0], [1779.0, 2580.0], [1779.0, 2632.0], [363.0, 2628.0]], "score": 0.9827307462692261, "text": "commerce de pâtisserie, confiserie et fabrication et vente de chocolats."}, {"orientation_angle": 0, "polygon": [[362.0, 2683.0], [2277.0, 2694.0], [2277.0, 2747.0], [362.0, 2736.0]], "score": 0.9949766993522644, "text": "Et généralement toutes opérations immobilières, mobilières et financières pouvant se rapporter"}, {"orientation_angle": 0, "polygon": [[360.0, 2734.0], [2279.0, 2743.0], [2278.0, 2801.0], [360.0, 2793.0]], "score": 0.9853643178939819, "text": "directement ou indirectement aux activités ci-dessus ou susceptibles d'en faciliter"}, {"orientation_angle": 0, "polygon": [[360.0, 2791.0], [749.0, 2795.0], [749.0, 2850.0], [360.0, 2846.0]], "score": 0.9999568462371826, "text": "l'accomplissement."}, {"orientation_angle": 0, "polygon": [[362.0, 2896.0], [2275.0, 2904.0], [2275.0, 2957.0], [362.0, 2949.0]], "score": 0.9939584136009216, "text": "La participation de la société à toutes entreprises, groupements d'intérêt économique ou sociétés"}, {"orientation_angle": 0, "polygon": [[362.0, 2950.0], [2277.0, 2957.0], [2277.0, 3009.0], [362.0, 3002.0]], "score": 0.9914250373840332, "text": "françaises ou étrangères, créées ou à créer, pouvant se rattacher directement ou indirectement à"}, {"orientation_angle": 0, "polygon": [[362.0, 3003.0], [2275.0, 3016.0], [2275.0, 3067.0], [362.0, 3055.0]], "score": 0.9955964684486389, "text": "l'objet social ou à tous objets similaires ou connexes, notamment aux entreprises, groupements"}, {"orientation_angle": 0, "polygon": [[360.0, 3057.