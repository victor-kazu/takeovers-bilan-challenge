, 2159.0], [823.0, 2145.0]], "score": 0.9926249384880066, "text": "ARTICLE 28 - Actes souscrits au nom de la Société en formation"}, {"orientation_angle": 0, "polygon": [[814.0, 2149.0], [6075.0, 2189.0], [6074.0, 2333.0], [813.0, 2294.0]], "score": 0.9925141334533691, "text": "Monsieur MARTORANA Francesco associé unique, a établi un état des actes accomplis à ce jour pour"}, {"orientation_angle": 0, "polygon": [[814.0, 2304.0], [6066.0, 2338.0], [6065.0, 2478.0], [813.0, 2443.0]], "score": 0.9827549457550049, "text": "le compte de la Société en formation avec l'indication pour chacun d'eux, des engagements qui en"}, {"orientation_angle": 0, "polygon": [[823.0, 2463.0], [4243.0, 2482.0], [4242.0, 2613.0], [822.0, 2593.0]], "score": 0.9952038526535034, "text": "résulteront pour la Société. Cet état est annexé aux présents statuts."}, {"orientation_angle": 0, "polygon": [[818.0, 2607.0], [6061.0, 2637.0], [6060.0, 2772.0], [818.0, 2742.0]], "score": 0.9931750893592834, "text": "L'immatriculation de la Société au Registre du Commerce et des Sociétés entraînera de plein droit"}, {"orientation_angle": 0, "polygon": [[814.0, 2762.0], [3425.0, 2772.0], [3425.0, 2916.0], [813.0, 2906.0]], "score": 0.9952481389045715, "text": "reprise par la Société desdits actes et engagements."}, {"orientation_angle": 0, "polygon": [[814.0, 2906.0], [6070.0, 2931.0], [6070.0, 3075.0], [813.0, 3051.0]], "score": 0.9892420768737793, "text": "En outre, Monsieur MARTORANA Francesco, associé unique et seul Gérant agira au nom et pour le"}, {"orientation_angle": 0, "polygon": [[809.0, 3060.0], [6065.0, 3080.0], [6065.0, 3225.0], [808.0, 3205.0]], "score": 0.9906005263328552, "text": "compte de la Société en formation, jusqu'à son immatriculation au Registre du Commerce et des"}, {"orientation_angle": 0, "polygon": [[804.0, 3200.0], [5209.0, 3220.0], [5209.0, 3379.0], [803.0, 3359.0]], "score": 0.9909540414810181, "text": "Sociétés. il passera les actes et prendra les engagements pour le compte d