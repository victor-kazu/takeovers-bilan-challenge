500.0, 2256.0], [2304.0, 2256.0], [2304.0, 2297.0], [500.0, 2297.0]], "score": 0.9784983396530151, "text": "fraude est plus élevé que celui d'une anomalie significative résultant d’une erreur, car la fraude"}, {"orientation_angle": 0, "polygon": [[498.0, 2318.0], [2307.0, 2314.0], [2307.0, 2360.0], [498.0, 2364.0]], "score": 0.997577428817749, "text": "peut impliquer la collusion, la falsification, les omissions volontaires, les fausses déclarations ou le"}, {"orientation_angle": 0, "polygon": [[501.0, 2381.0], [1199.0, 2381.0], [1199.0, 2422.0], [501.0, 2422.0]], "score": 0.9990875124931335, "text": "contournement du contrôle interne ;"}, {"orientation_angle": 0, "polygon": [[441.0, 2501.0], [467.0, 2501.0], [467.0, 2544.0], [441.0, 2544.0]], "score": 0.49355605244636536, "text": "A"}, {"orientation_angle": 0, "polygon": [[500.0, 2506.0], [2305.0, 2506.0], [2305.0, 2547.0], [500.0, 2547.0]], "score": 0.9846808910369873, "text": "Il prend connaissance du contrôle interne pertinent pour l’audit afin de définir des procédures"}, {"orientation_angle": 0, "polygon": [[500.0, 2566.0], [2305.0, 2566.0], [2305.0, 2612.0], [500.0, 2612.0]], "score": 0.9820572733879089, "text": "d’audit appropriées en la circonstance, et non dans le but d’exprimer une opinion sur l’efficacité"}, {"orientation_angle": 0, "polygon": [[496.0, 2626.0], [887.0, 2629.0], [887.0, 2676.0], [496.0, 2672.0]], "score": 0.9969583749771118, "text": "du contrôle interne;"}, {"orientation_angle": 0, "polygon": [[441.0, 2751.0], [467.0, 2751.0], [467.0, 2794.0], [441.0, 2794.0]], "score": 0.49355605244636536, "text": "A"}, {"orientation_angle": 0, "polygon": [[500.0, 2756.0], [2302.0, 2756.0], [2302.0, 2797.0], [500.0, 2797.0]], "score": 0.9939910769462585, "text": "Il apprécie le caractère approprié des méthodes comptables retenues et le caractère raisonnable"}, {"orientation_angle": 0, "polygon": [[500.0, 2819.0], [2307.0, 2819.0], [2307.0, 2861.0], [500.0, 2861.0]], "score": 0.9915301203727722, "text": "des estimations comptables faites par la direction, ainsi que les informations les concernant"}, {"orientation_angle": 0, "polygon": [[501.0, 2881.0], [1156.0, 2881.0], [1156.0, 2922.0], [501.0, 2922.0]], "score": 0.9859973192214966, "text": "fournies dans les comptes annuels ;"}, {"orientation_angle": 0, "polygon": [[441.0, 3001.0], [469.0, 3001.0], [469.0, 3042.0], [441.0, 3042.0]], "score": 0.4471397399902344, "text": ">"}, {"orientation_angle": 0, "polygon": [[500.0, 3006.0], [2302.0, 3006.0], [2302.0, 3047.0], [500.0, 3047.0]], "score": 0.9970524311065674, "text": "Il apprécie le caractère approprié de l’application par la direction de la convention comptable de"}, {"orientation_angle": 0, "polygon": [[501.0, 3070.0], [2304.0, 3070.0], [2304.0, 3109.0], [501.0, 3109.0]], "score": 0.983532726764679, "text": "continuité d’exploitation et, selon les éléments collectés, l’existence ou non d’une incertitude"}, {"orientation_angle": 1, "polygon": [[124.0, 3172.0], [327.0, 3172.0], [327.0, 3366.0], [124.0, 3366.0]], "score": 0.7990504503250122, "text": "V"}, {"orientation_angle": 1, "polygon": [[298.0, 3210.0], [748.0, 3210.0], [748.0, 3332.0], [298.0, 3332.0]], "score": 0.31202682852745056, "text": "AAAAS"}, {"orientation_angle": 1, "polygon": [[2085.0, 3237.0], [2359.0, 3237.0], [2359.0, 3344.0], [2085.0, 3344.0]], "score": 0.5095502734184265, "text": "<s2/s"}], "page": 22, "pdf": "CA_328024377_6901_1983B01173_2022_B2022057483__63e8ebbb54febda17c19ee7e.pdf", "skew_angle": 0.0}