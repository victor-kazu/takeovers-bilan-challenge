9468727112, "text": "l'exercice clos par le crédit d'un compte de transfert de charges à caractère financier. Ele l'a crédité"}, {"orientation_angle": 0, "polygon": [[414.0, 1354.0], [2155.0, 1356.0], [2154.0, 1407.0], [414.0, 1405.0]], "score": 0.9911156296730042, "text": "d'un montant de 16.578 €uros par le débit du compte 6868 « Dotation aux amortissements des"}, {"orientation_angle": 0, "polygon": [[416.0, 1411.0], [2154.0, 1411.0], [2154.0, 1462.0], [416.0, 1462.0]], "score": 0.9811054468154907, "text": "intérêts compensateurs à répartir » pour la fraction des intérêts compensateurs incluse dans"}, {"orientation_angle": 0, "polygon": [[414.0, 1462.0], [575.0, 1462.0], [575.0, 1512.0], [414.0, 1512.0]], "score": 0.9911409616470337, "text": "l'annuité."}]}, {"bbox": [404.66705322265625, 2573.64208984375, 2034.076904296875, 2846.0654296875], "label": "text", "score": 0.9823044538497925, "texts": [{"orientation_angle": 0, "polygon": [[410.0, 2579.0], [2040.0, 2579.0], [2040.0, 2631.0], [410.0, 2631.0]], "score": 0.9930046796798706, "text": "La Provision pour Gros Entretien est constatée à compter de l'exercice au titre duquel les"}, {"orientation_angle": 0, "polygon": [[412.0, 2633.0], [2040.0, 2631.0], [2040.0, 2682.0], [412.0, 2684.0]], "score": 0.9805132746696472, "text": "dépenses sont programmées et inscrites dans le programme pluriannuel. Une quote-part de la"}, {"orientation_angle": 0, "polygon": [[410.0, 2687.0], [2038.0, 2684.0], [2038.0, 2735.0], [410.0, 2739.0]], "score": 0.9945241808891296, "text": "provision correspondant à l'usage passé du bien sur sa durée d'usage total entre deux périodes"}, {"orientation_angle": 0, "polygon": [[414.0, 2740.0], [2035.0, 2740.0], [2035.0, 2787.0], [414.0, 2787.0]], "score": 0.9921287894248962, "text": "d'entretien est immédiatement constatée pour la période des 3 premières années dès lors que"}, {"orientation_angle": 0, "polygon": [[412.0, 2792.0], [1523.0, 2788.0], [1524.0, 2840.0], [412.0, 2843.0]], "score": 0.990197479724884, "text": "son inscription dans le Plan Stratégique du Patrimoine est validée."}]}, {"bbox": [405.81475830078125, 1725.8466796875, 2146.167724609375, 1887.7314453125], "label": "text", "score": 0.9740728139877319, "texts": [{"orientation_angle": 0, "polygon": [[414.0, 1728.0], [2154.0, 1728.0], [2154.0, 1779.0], [414.0, 1779.0]], "score": 0.9969656467437744, "text": "Par dérogation aux principes comptables de droit commun, les quotes-parts de subventions"}, {"orientation_angle": 0, "polygon": [[412.0, 1779.0], [2153.0, 1781.0], [2153.0, 1832.0], [412.0, 1830.0]], "score": 0.9934248328208923, "text": "d'investissement reprises au résultat de lexercice sont comptabilisées en produits d'exploitation sous la"}, {"orientation_angle": 0, "polygon": [[414.0, 1836.0], [1691.0, 1836.0], [1691.0, 1887.0], [414.0, 1887.0]], "score": 0.987823486328125, "text": "rubrique des \"Autres produits\" et non pas en « Produits exceptionnels »."}]}, {"bbox": [416.813720703125, 502.1111755371094, 2153.262451171875, 606.3875732421875], "label": "text", "score": 0.963801383972168, "texts": [{"orientation_angle": 0, "polygon": [[426.0, 504.0], [2158.0, 504.0], [2158.0, 555.0], [426.0, 555.0]], "score": 0.9912766218185425, "text": "Lorsque les titres font l'objet d'une cotation régulière, leur valeur d'inventaire est calculée sur la base du"}, {"orientation_angle": 0, "polygon": [[424.0, 559.0], [1099.0, 557.0], [1100.0, 608.0], [424.0, 610.0]], "score": 0.9909926056861877, "text": "cours moyen du dernier mois de clôture."}]}, {"bbox": [417.22216796875, 359.805419921875, 2154.165283203125, 465.5394287109375], "label": "text", "score": 0.9607046842575073, "texts": [{"orientation_angle": 0, "polygon": [[427.0, 365.0], [2158.0, 365.0], [2158.0, 411.0], [427.0, 411.0]], "score": 0.9890558123588562, "text": "Une provision pour dépréciation est comptabilisée lorsque leur valeur probable de négociation est"}, {"orientation_angle": 0, "polygon": [[426.0, 416.0], [1366.0, 420.0], [1366.0, 4