5142212, "text": "30/11/17"}, {"orientation_angle": 0, "polygon": [[1612.0, 253.0], [1912.0, 256.0], [1912.0, 299.0], [1612.0, 295.0]], "score": 0.9995672106742859, "text": "Tenue de compte"}, {"orientation_angle": 0, "polygon": [[225.0, 388.0], [1890.0, 388.0], [1890.0, 429.0], [225.0, 429.0]], "score": 0.9932093620300293, "text": "Les conventions générales comptables ont été appliquées, dans le respect du principe de prudence,"}, {"orientation_angle": 0, "polygon": [[224.0, 429.0], [903.0, 429.0], [903.0, 470.0], [224.0, 470.0]], "score": 0.9945886731147766, "text": "conformément aux hypothèses de base :"}, {"orientation_angle": 0, "polygon": [[225.0, 489.0], [680.0, 489.0], [680.0, 528.0], [225.0, 528.0]], "score": 0.9984274506568909, "text": "- continuité de l'exploitation"}, {"orientation_angle": 0, "polygon": [[224.0, 540.0], [1280.0, 536.0], [1280.0, 577.0], [224.0, 581.0]], "score": 0.9823916554450989, "text": "- permanence des méthodes comptables d'un exercice à l'autre"}, {"orientation_angle": 0, "polygon": [[225.0, 588.0], [729.0, 588.0], [729.0, 629.0], [225.0, 629.0]], "score": 0.9769960641860962, "text": "- Indépendance des exercices"}, {"orientation_angle": 0, "polygon": [[225.0, 654.0], [1820.0, 654.0], [1820.0, 695.0], [225.0, 695.0]], "score": 0.9921891689300537, "text": "et conformément aux règles générales d'établissement et de présentation des comptes annuels."}, {"orientation_angle": 0, "polygon": [[225.0, 731.0], [2231.0, 731.0], [2231.0, 772.0], [225.0, 772.0]], "score": 0.9834766983985901, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques"}, {"orientation_angle": 0, "polygon": [[220.0, 825.0], [1934.0, 823.0], [1934.0, 864.0], [220.0, 866.0]], "score": 0.9922419786453247, "text": "Les comptes annuels cet exercice ont été établis conformément au règlement de l'Autorité des Normes"}, {"orientation_angle": 0, "polygon": [[219.0, 873.0], [2008.0, 870.0], [2009.0, 916.0], [219.0, 919.0]], "score": 0.9923340082168579, "text": "Comptables n°2014-03 du 5 juin 2014, modifié par les règlements ANC n°2015-06 du 23 novembre 2015 et"}, {"orientation_angle": 0, "polygon": [[220.0, 923.0], [814.0, 923.0], [814.0, 962.0], [220.0, 962.0]], "score": 0.9992634654045105, "text": "ANC 2016-07 du 4 Novembre 2016"}, {"orientation_angle": 0, "polygon": [[225.0, 981.0], [1127.0, 981.0], [1127.0, 1022.0], [225.0, 1022.0]], "score": 0.9996945261955261, "text": "Les principales méthodes utilisées sont les suivantes :"}, {"orientation_angle": 0, "polygon": [[164.0, 1071.0], [205.0, 1071.0], [205.0, 1111.0], [164.0, 1111.0]], "score": 0.9941051006317139, "text": "a)"}, {"orientation_angle": 0, "polygon": [[212.0, 1070.0], [720.0, 1070.0], [720.0, 1111.0], [212.0, 1111.0]], "score": 0.9981221556663513, "text": "Immobilisations corporelles"}, {"orientation_angle": 0, "polygon": [[224.0, 1140.0], [2327.0, 1140.0], [2327.0, 1179.0], [224.0, 1179.0]], "score": 0.9847756624221802, "text": "Les immobilisations corporelles sont évaluées à leur coût d'acquisition (prix d'achat et frais accessoires, hors frais d'acquisition"}, {"orientation_angle": 0, "polygon": [[222.0, 1179.0], [1031.0, 1181.0], [1030.0, 1222.0], [222.0, 1220.0]], "score": 0.9993603825569153, "text": "des immobilisation) ou à leur coût de production."}, {"orientation_angle": 0, "polygon": [[227.0, 1247.0], [2312.0, 1247.0], [2312.0, 1288.0], [227.0, 1288.0]], "score": 0.9965575337409973, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire/dégressif en fonction de la durée de vie prévue :"}, {"orientation_angle": 0, "polygon": [[221.0, 1298.0], [482.0, 1302.0], [481.0, 1345.0], [220.0, 1341.0]], "score": 0.9997161030769348, "text": "- Constructions"}, {"orientation_angle": 0, "polygon": [[1818.0, 1296.0], [1995.0, 1300.0], [1994.0, 1343.0], [1817.0, 1339.0]], "score": 0.9533084630966187, "text": "30 .....ans"}, {"orientation_angle": 0, "polygon": [[224.0, 1358.0], [1092.0, 1358.0], [1092.0, 1399.0], [224.0, 1399.0]], "score": 0.9929324388504028, "text": "- Agencements et aménagements des constructions"}, {"orientation_angle": 0, "polygon": [[1820.0, 1353.0], [1995.0, 1359.0], [1994.0, 1401.0], [1818.0, 1395.0]], "score": 0.9184543490409851, "text": "15 ....ans"}, {"orientation_angle": 0, "polygon": [[222.0, 1415.0], [641.0, 1415.0], [641.0, 1456.0], [222.0, 1456.0]], "score": 0.9996963739395142, "text": "- Installations techniques"}, {"orientation_angle": 0, "polygon": [[1836.0, 1411.0], [1997.0, 1415.0], [1996.0, 1458.0], [1835.0, 1454.0]], "score": 0.7949842214584351, "text": "5 ...ans"}, {"orientation_angle": 0, "polygon": [[224.0, 1471.0], [763.0, 1471.0], [763.0, 1512.0], [224.0, 1512.0]], "score": 0.9810488820075989, "text": "- Matériel et Outillage industriels"}, {"orientation_angle": 0, "polygon": [[1835.0, 1465.0], [1995.0, 1471.0], [1994.0, 1514.0], [1833.0, 1508.0]], "score": 0.8647496700286865, "text": "3 ....ans"}, {"orientation_angle": 0, "polygon": [[159.0, 1550.0], [214.0, 1550.0], [214.0, 1594.0], [159.0, 1594.0]], "score": 0.9243504405021667, "text": "b)"}, {"orientation_angle": 0, "polygon": [[207.0, 1548.0], [351.0, 1548.0], [351.0, 1596.0], [207.0, 1596.0]], "score": 0.9998940825462341, "text": "Stocks"}, {"orientation_angle": 0, "polygon": [[219.0, 1623.0], [1429.0, 1621.0], [1429.0, 1662.0], [219.0, 1664.0]], "score": 0.9994451999664307, "text": "Les stocks sont évalués suivant la méthode premier entré, premier sorti."}, {"orientation_angle": 0, "polygon": [[219.0, 1674.0], [1992.0, 1674.0], [1992.0, 1715.0], [219.0, 1715.0]], "score": 0.9844062924385071, "text": "La valeur brute des marchandises et approvisionnements comprend le prix d'achat et les frais accessoires."}, {"orientation_angle": 0, "polygon": [[220.0, 1746.0], [2175.0, 1746.0], [2175.0, 1787.0], [220.0, 1787.0]], "score": 0.9901438355445862, "text": "Les produits fabriqués sont valorisés au coût de production comprenant les consommations et les charges directes et"}, {"orientation_angle": 0, "polygon": [[219.0, 1785.0], [2295.0, 1787.0], [2295.0, 1828.0], [219.0, 1826.0]], "score": 0.9920225739479065, "text": "indirectes de production, les amortissements des biens concourant à la production. Le coût de la sous-activité est exclu de la"}, {"orientation_angle": 0, "polygon": [[220.0, 1830.0], [522.0, 1830.0], [522.0, 1866.0], [220.0, 1866.0]], "score": 0.9999123811721802, "text": "valeur des stocks."}, {"orientation_angle": 0, "polygon": [[222.0, 1871.0], [1249.0, 1871.0], [1249.0, 1912.0], [222.0, 1912.0]], "score": 0.9994313716888428, "text": "Les intérêts sont toujours exclus de la valorisation des stocks."}, {"orientation_angle": 0, "polygon": [[220.0, 1944.0], [2188.0, 1943.0], [2188.0, 1984.0], [220.0, 1985.0]], "score": 0.9933455586433411, "text": "Une provision pour dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités"}, {"orientation_angle": 0, "polygon": [[220.0, 1987.0], [2180.0, 1987.0], [2180.0, 2026.0], [220.0, 2026.0]], "score": 0.9938675165176392, "text": "indiquées ci-dessus et le cours du jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est"}, {"orientation_angle": 0, "polygon": [[222.0, 2028.0], [1451.0, 2028.0], [1451.0, 2069.0], [222.0, 2069.0]], "score": 0.9929733276367188, "text": "effectuée lorsque cette valeur brute est supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[159.0, 2110.0], [392.0, 2110.0], [392.0, 2158.0], [159.0, 2158.0]], "score": 0.994066059589386, "text": "c) Créances"}, {"orientation_angle": 0, "polygon": [[215.0, 2178.0], [2146.0, 2180.0], [2146.0, 2221.0], [215.0, 2219.0]], "score": 0.9922795295715332, "text": "Les créances sont valorisées à leur valeur nominale. Une provision pour dépréciation est pratiquée lorsque la valeur"}, {"orientation_angle": 0, "polygon": [[219.0, 2223.0], [1012.0, 2223.0], [1012.0, 2264.0], [219.0, 2264.0]], "score": 0.9986602663993835, "text": "d'inventaire est inférieure à la valeur comptable."}, {"orientation_angle": 0, "polygon": [[161.0, 2298.0], [719.0, 2298.0], [719.0, 2344.0], [161.0, 2344.0]], "score": 0.9970551133155823, "text": "d) Crédit d'impôt compétitivité"}, {"orientation_angle": 0, "polygon": [[219.0, 2375.0], [2080.0, 2375.0], [2080.0, 2414.0], [219.0, 2414.0]], "score": 0.9920779466629028, "text": "Le crédit d'impôt compétitivité a été comptabilisé au crédit des charges de personnel à hauteur de 31 733 euros."}, {"orientation_angle": 0, "polygon": [[169.0, 2457.0], [393.0, 2457.0], [393.0, 2505.0], [169.0, 2505.0]], "score": 0.9648749232292175, "text": "e) Provision"}, {"orientation_angle": 0, "polygon": [[205.0, 2556.0], [2317.0, 2556.0], [2317.0, 2595.0], [205.0, 2595.0]], "score": 0.9909378886222839, "text": "Les provisions sont comptabilisées lorsque, à la clôture de l'exercice, l'entreprise a une obligation à l'égard d'un tiers qui résulte"}, {"orientation_angle": 0, "polygon": [[205.0, 2599.0], [2320.0, 2599.0], [2320.0, 2638.0], [205.0, 2638.0]], "score": 0.9895655512809753, "text": "d'un fait générateur passé et dont il est probable ou certain qu'elle provoquera une sortie de ressources au bénéfice de ce tiers,"}, {"orientation_angle": 0, "polygon": [[203.0, 2640.0], [2326.0, 2640.0], [2326.0, 2679.0], [203.0, 2679.0]], "score": 0.9955624938011169, "text": "sans contrepartie au moins équivalente attendue de celui-ci. Cette obligation peut être d'ordre légale, réglementaire ou implicite."}, {"orientation_angle": 0, "polygon": [[205.0, 2682.0], [1876.0, 2682.0], [1876.0, 2722.0], [205.0, 2722.0]], "score": 0.9905884265899658, "text": "Ces provisions sont estimées selon leur nature en tenant compte des hypothèses les plus probables."}, {"orientation_angle": 0, "polygon": [[156.0, 2802.0], [856.0, 2802.0], [856.0, 2855.0], [156.0, 2855.0]], "score": 0.9841116666793823, "text": "f) Engagements de départ à la retraite"}, {"orientation_angle": 0, "polygon": [[217.0, 2874.0], [2231.0, 2872.0], [2231.0, 2913.0], [217.0, 2915.0]], "score": 0.9841678738594055, "text": "Les engagements de départs à la retraite ne font ni l'objet d'une provision comptable ni d'une assurance. Compte tenu de"}, {"orientation_angle": 0, "polygon": [[217.0, 2916.0], [1758.0, 2916.0], [1758.0, 2956.0], [217.0, 2956.0]], "score": 0.9952722787857056, "text": "l'âge des salariés et de leur ancienneté, l'IFC n'a pas était calculée mais est non significative."}, {"orientation_angle": 0, "polygon": [[159.0, 3005.0], [336.0, 3005.0], [336.0, 3055.0], [159.0, 3055.0]], "score": 0.9218763709068298, "text": "g) Divers"}, {"orientation_angle": 0, "polygon": [[219.0, 3072.0], [329.0, 3072.0], [329.0, 3116.0], [219.0, 3116.0]], "score": 0.999367892742157, "text": "Néant"}, {"orientation_angle": 0, "polygon": [[2137.0, 3196.0], [2257.0, 3124.0], [2287.0, 3173.0], [2167.0, 3246.0]], "score": 0.905500054359436, "text": "Philippe"}, {"orientation_angle": 0, "polygon": [[2223.0, 3232.0], [2351.0, 3236.0], [2350.0, 3267.0], [2222.0, 3263.0]], "score": 0.9305538535118103, "text": "Memubre de la"}, {"orientation_angle": 1, "polygon": [[89.0, 3254.0], [138.0, 3256.0], [131.0, 3384.0], [82.0, 3381.0]], "score": 0.9622110724449158, "text": "© Sage"}, {"orientation_angle": 0, "polygon": [[2144.0, 3246.0], [2168.0, 3246.0], [2168.0, 3270.0], [2144.0, 3270.0]], "score": 0.9568643569946289, "text": "*"}, {"orientation_angle": 0, "polygon": [[2184.0, 3266.0], [2389.0, 3272.0], [2388.0, 3308.0], [2183.0, 3302.0]], "score": 0.9538915753364563, "text": "Compagnie Régionale"}, {"orientation_angle": 0, "polygon": [[2159.0, 3294.0], [2301.0, 3411.0], [2256.0, 3466.0], [2115.0, 3349.0]], "score": 0.9769989848136902, "text": "MMISSAIRE"}, {"orientation_angle": 0, "polygon": [[2234.0, 3298.0], [2338.0, 3305.0], [2336.0, 3342.0], [2232.0, 3336.0]], "score": 0.870931088924408, "text": "de Colmar"}, {"orientation_angle": 0, "polygon": [[258.0, 3371.0], [746.0, 3371.0], [746.0, 3405.0], [258.0, 