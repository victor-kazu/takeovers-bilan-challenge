{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[307.0, 257.0], [2208.0, 266.0], [2208.0, 317.0], [306.0, 308.0]], "score": 0.9899435043334961, "text": "Aux termes de l'assemblée générale extraordinaire du 27/06/2008, le capital social a été"}, {"orientation_angle": 0, "polygon": [[308.0, 313.0], [1550.0, 317.0], [1550.0, 368.0], [308.0, 365.0]], "score": 0.9891335964202881, "text": "augmenté de 17.241 euros afin d’être porté à 217.241 euros."}, {"orientation_angle": 0, "polygon": [[305.0, 418.0], [2208.0, 427.0], [2208.0, 478.0], [305.0, 469.0]], "score": 0.9837083220481873, "text": "Aux termes de l’assemblée générale extraordinaire du 27/06/2008, le capital social a été"}, {"orientation_angle": 0, "polygon": [[305.0, 473.0], [1578.0, 478.0], [1577.0, 530.0], [305.0, 524.0]], "score": 0.9870366454124451, "text": "augmenté de 150.861 euros afin d'être porté à 368.102 euros."}, {"orientation_angle": 0, "polygon": [[305.0, 579.0], [2208.0, 589.0], [2208.0, 636.0], [305.0, 625.0]], "score": 0.9878806471824646, "text": "Aux termes des délibérations de l'Assemblée Générale Extraordinaire en date du 19 janvier"}, {"orientation_angle": 0, "polygon": [[305.0, 630.0], [2205.0, 643.0], [2204.0, 689.0], [305.0, 677.0]], "score": 0.9935927391052246, "text": "2017 et de décisions du Président en date du 21 février 2017, le capital social a été réduit de"}, {"orientation_angle": 0, "polygon": [[307.0, 682.0], [1901.0, 691.0], [1901.0, 742.0], [306.0, 733.0]], "score": 0.9986087679862976, "text": "150 861 euros pour être ramené à 217 241 euros par voie de rachat d'actions."}, {"orientation_angle": 0, "polygon": [[305.0, 841.0], [983.0, 845.0], [983.0, 893.0], [305.0, 889.0]], "score": 0.9858255386352539, "text": "ARTICLE 7 - CAPITAL SOCIAL"}, {"orientation_angle": 0, "polygon": [[303.0, 946.0], [1428.0, 951.0], [1428.0, 1002.0], [303.0, 997.0]], "score": 0.9976291060447693, "text": "Le capital social est fixé à la somme de 217 241 euros."}, {"