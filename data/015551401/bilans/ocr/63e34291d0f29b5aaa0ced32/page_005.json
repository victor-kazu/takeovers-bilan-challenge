olygon": [[293.0, 1442.0], [1458.0, 1442.0], [1458.0, 1489.0], [293.0, 1489.0]], "score": 0.9932088851928711, "text": "ou leurs enfants mineurs non émancipés, sont assujettis :"}, {"orientation_angle": 0, "polygon": [[291.0, 1546.0], [2185.0, 1546.0], [2185.0, 1598.0], [291.0, 1598.0]], "score": 0.9888697266578674, "text": "- à prélèvements sociaux pour la fraction des dividendes qui n'excède pas une somme égale"}, {"orientation_angle": 0, "polygon": [[286.0, 1600.0], [2183.0, 1598.0], [2183.0, 1650.0], [286.0, 1652.0]], "score": 0.9954517483711243, "text": "à 10 % du montant du capital social majoré des primes d'émission et du solde moyen annuel"}, {"orientation_angle": 0, "polygon": [[291.0, 1659.0], [775.0, 1659.0], [775.0, 1705.0], [291.0, 1705.0]], "score": 0.9995555877685547, "text": "de leur compte courant,"}, {"orientation_angle": 0, "polygon": [[289.0, 1709.0], [2181.0, 1705.0], [2181.0, 1752.0], [289.0, 1755.0]], "score": 0.9941684007644653, "text": "- à cotisations et contributions sociales TNS sur la fraction des dividendes qui excède une"}, {"orientation_angle": 0, "polygon": [[289.0, 1762.0], [2183.0, 1755.0], [2183.0, 1809.0], [289.0, 1816.0]], "score": 0.998331606388092, "text": "somme égale à 10 % du montant du capital social majoré des primes d'émission et du solde"}, {"orientation_angle": 0, "polygon": [[289.0, 1818.0], [1074.0, 1812.0], [1074.0, 1864.0], [289.0, 1870.0]], "score": 0.9860873818397522, "text": "moyen annuel de leur compte courant."}, {"orientation_angle": 0, "polygon": [[289.0, 1972.0], [2185.0, 1970.0], [2185.0, 2022.0], [289.0, 2024.0]], "score": 0.9972192049026489, "text": "Conformément à la loi, l'Assemblée Générale prend acte que les dividendes distribués au titre"}, {"orientation_angle": 0, "polygon": [[291.0, 2029.0], [1341.0, 2027.0], [1341.0, 2075.0], [291.0, 2077.0]], "score": 0.9997550249099731, "text": "des trois exercices précédents ont été les suivants :"}, {"orientation_angle": 0, "polygon": [[408.0, 2134.0], [592.0,