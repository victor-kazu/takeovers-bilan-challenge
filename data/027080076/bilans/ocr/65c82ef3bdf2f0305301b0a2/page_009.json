.0, 1521.0], [2136.0, 1572.0], [251.0, 1579.0]], "score": 0.9930633306503296, "text": "passé du bien sur sa durée d'usage total entre deux périodes d'entretien est immédiatement constatée pour la"}, {"orientation_angle": 0, "polygon": [[252.0, 1577.0], [2117.0, 1572.0], [2117.0, 1625.0], [252.0, 1631.0]], "score": 0.9868204593658447, "text": "période des 3 premières années dès lors que son inscription dans le Plan Stratégique du Patrimoine est validée."}]}, {"bbox": [247.70556640625, 563.4739379882812, 2242.469970703125, 724.7217407226562], "label": "text", "score": 0.9774707555770874, "texts": [{"orientation_angle": 0, "polygon": [[254.0, 567.0], [2250.0, 565.0], [2250.0, 619.0], [254.0, 620.0]], "score": 0.9964803457260132, "text": "Conformément aux principes comptables de droit commun, les quotes-parts de subventions d'investissement reprises au"}, {"orientation_angle": 0, "polygon": [[254.0, 620.0], [2249.0, 619.0], [2249.0, 672.0], [254.0, 674.0]], "score": 0.9844334125518799, "text": "résultat de l'exercice sont comptabilisées « Produits exceptionnels » au même rythme que l'amortissement technique"}, {"orientation_angle": 0, "polygon": [[252.0, 675.0], [638.0, 675.0], [638.0, 727.0], [252.0, 727.0]], "score": 0.9962838292121887, "text": "sur les immobilisations"}]}, {"bbox": [243.12298583984375, 2628.064697265625, 2240.68115234375, 2792.213134765625], "label": "text", "score": 0.9741044044494629, "texts": [{"orientation_angle": 0, "polygon": [[250.0, 2632.0], [2244.0, 2631.0], [2244.0, 2684.0], [250.0, 2686.0]], "score": 0.9849801659584045, "text": "En application du Règlement de l'Autorité des Normes Comptables (ANC) n°2015-04 du 04 juin 2015, la SEMIE, en"}, {"orientation_angle": 0, "polygon": [[250.0, 2689.0], [2245.0, 2686.0], [2245.0, 2737.0], [250.0, 2741.0]], "score": 0.9832255244255066, "text": "qualité de Bailleur social, a l'obligation de présenter un bilan et un compte de résultat laissant apparaître la"}, {"orientation_angle": 0, "polygon": [[252.0, 2744.0], [1045.0, 2744.0], [1045.0, 2790.0], [252.0, 2790.0]], "score": 0.9993699789047241, "text": "comptabilisation distincte des activités agréées."}]}, {"bbox": [242.98846435546875, 2311.6357421875, 2239.247314453125, 2417.431640625], "label": "text", "score": 0.9643123149871826, "texts": [{"orientation_angle": 0, "polygon": [[249.0, 2313.0], [2244.0, 2311.0], [2244.0, 2364.0], [249.0, 2366.0]], "score": 0.9830682873725891, "text": "Cette disposition implique la répartition des charges mixtes entre les différents secteurs. Pour ce faire la SEMlE a calé"}, {"orientation_angle": 0, "polygon": [[247.0, 2368.0], [1545.0, 2370.0], [1545.0, 2421.0], [247.0, 2419.0]], "score": 0.9922184944152832, "text": "l'affectation de ces charges au prorata du chiffre d'affaires de chaque secteur."}]}, {"bbox": [243.306640625, 1834.9488525390625, 2239.417236328125, 1992.5965576171875], "label": "text", "score": 0.9613303542137146, "texts": [{"orientation_angle": 0, "polygon": [[250.0, 1839.0], [2244.0, 1837.0], [2244.0, 1888.0], [250.0, 1890.0]], "score": 0.9888701438903809, "text": "Conformément à l'article 96 de la loi de finance 2004, la SEMlE peut désormais bénéficier du même régime fiscal que les"}, {"orientation_angle": 0, "polygon": [[250.0, 1894.0], [1955.0, 1890.0], [1955.0, 1942.0], [250.0, 1945.0]], "score": 0.9917411208152771, "text": "organismes d'HLM à savoir : l'exonération de l'impôt sur les sociétés pour l'activité de logement sociat."}, {"orientation_angle": 0, "polygon": [[250.0, 1945.0], [1621.0, 1945.0], [1621.0, 1997.0], [250.0, 1997.0]], "score": 0.9891690015792847, "text": "Pour la SEMiE, restent soumises à l'impôt sur les sociétés les activités suivantes :"}, {"orientation_angle": 0, "polygon": [[453.0, 1995.0], [2247.0, 1990.0], [2247.0, 2048.0], [453.0, 2053.0]], "score": 0.9882655739784241, "text": "Gestion des logements des secteurs intermédiaires ou libres : Boule d'Or 24 logements, le Forum 3"}]}, {"bbox": [248.7373046875, 244.166015625, 2246.773925