 6126.0], [6180.0, 6116.0], [6180.0, 6266.0], [1192.0, 6276.0]], "score": 0.9955227375030518, "text": "dépréciation des stocks et des en-cours égale à la différence entre la valeur brute"}, {"orientation_angle": 0, "polygon": [[1206.0, 6290.0], [6171.0, 6290.0], [6171.0, 6406.0], [1206.0, 6406.0]], "score": 0.997154951095581, "text": "déterminée suivant les modalités indiquées ci-dessus et le cours du jour ou la valeur de"}, {"orientation_angle": 0, "polygon": [[1202.0, 6434.0], [6032.0, 6434.0], [6032.0, 6565.0], [1202.0, 6565.0]], "score": 0.9917848110198975, "text": "réalisation, est effectuée lorsque cette valeur brute est supérieure à l'autre terme enoncé."}, {"orientation_angle": 0, "polygon": [[809.0, 6661.0], [2992.0, 6656.0], [2992.0, 6786.0], [809.0, 6791.0]], "score": 0.9982531666755676, "text": "Evaluation des créances et des dettes"}, {"orientation_angle": 0, "polygon": [[833.0, 6825.0], [2566.0, 6820.0], [2566.0, 6936.0], [833.0, 6941.0]], "score": 0.9790439009666443, "text": "(Déeret n°83-1020 du 29/11/83 artiele 24 - 5°)"}, {"orientation_angle": 0, "polygon": [[1197.0, 7046.0], [6176.0, 7056.0], [6175.0, 7201.0], [1197.0, 7191.0]], "score": 0.986203670501709, "text": "Les créances et dettes ont été évaluées pour leur valeur nominale.Une provision pour"}, {"orientation_angle": 0, "polygon": [[1197.0, 7201.0], [6176.0, 7201.0], [6176.0, 7345.0], [1197.0, 7345.0]], "score": 0.9900338053703308, "text": "dépréciation est pratiquée lorsque la valeur d'inventaire est inférieure à la valeur"}, {"orientation_angle": 0, "polygon": [[1191.0, 7366.0], [1836.0, 7349.0], [1839.0, 7489.0], [1194.0, 7506.0]], "score": 0.9998229742050171, "text": "comptable."}, {"orientation_angle": 0, "polygon": [[4730.0, 9466.0], [6157.0, 9476.0], [6156.0, 9572.0], [4730.0, 9562.0]], "score": 0.9887124300003052, "text": "S.A REVISION & FINANCE-COGEFOR"}, {"orientation_angle": 0, "polygon": [[383.0, 9495.0], [1235.0, 9490.0], [1235.0, 9558.0], [383.0, 9563.0]], "score": 0.8821604251