.0], [4936.0, 2739.0]], "score": 0.2883616089820862, "text": "*"}, {"orientation_angle": 0, "polygon": [[1735.0, 2947.0], [6466.0, 2904.0], [6467.0, 3045.0], [1737.0, 3089.0]], "score": 0.9698161482810974, "text": "S'il ne reste plus qu'un seul ou que deux administrateurs en"}, {"orientation_angle": 0, "polygon": [[1406.0, 3103.0], [6461.0, 3041.0], [6462.0, 3182.0], [1408.0, 3245.0]], "score": 0.9856033325195312, "text": "fonction, celui-ci ou ceux-ci ou à défaut le ou les commissaires aux"}, {"orientation_angle": 0, "polygon": [[1406.0, 3249.0], [6451.0, 3182.0], [6453.0, 3324.0], [1408.0, 3391.0]], "score": 0.9895443916320801, "text": "comptes, doivent convoquer immédiatement l'assemblée générale ordinaire"}, {"orientation_angle": 0, "polygon": [[1406.0, 3401.0], [5020.0, 3347.0], [5022.0, 3475.0], [1408.0, 3528.0]], "score": 0.9983235001564026, "text": "des actionnaires à l'effet de compléter le conseil."}, {"orientation_angle": 0, "polygon": [[1754.0, 3670.0], [6465.0, 3617.0], [6467.0, 3749.0], [1756.0, 3802.0]], "score": 0.9788665771484375, "text": "L'administrateur nommé en remplacement d'un autre ne demeure en"}, {"orientation_angle": 0, "polygon": [[1411.0, 3821.0], [6470.0, 3758.0], [6472.0, 3900.0], [1413.0, 3962.0]], "score": 0.9656388163566589, "text": "fonction que pendant le temps restant à courir du mandat de son"}, {"orientation_angle": 0, "polygon": [[1415.0, 3977.0], [2334.0, 3956.0], [2338.0, 4103.0], [1419.0, 4123.0]], "score": 0.9931883215904236, "text": "prédécesseur."}, {"orientation_angle": 0, "polygon": [[1754.0, 4241.0], [6461.0, 4198.0], [6462.0, 4339.0], [1756.0, 4383.0]], "score": 0.99101722240448, "text": "V. - Les administrateurs personnes physiques ne peuvent appartenir"}, {"orientation_angle": 0, "polygon": [[1396.0, 4392.0], [6470.0, 4315.0], [6472.0, 4476.0], [1399.0, 4553.0]], "score": 0.9820193648338318, "text": "au total à plus de huit conseils d'administration ou conseils de"}, {"orientation_angle": 0, "polygon": [[1416.0, 45