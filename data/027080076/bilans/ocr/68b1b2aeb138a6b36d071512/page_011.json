18.0], [1610.0, 2671.0], [177.0, 2680.0]], "score": 0.9879190921783447, "text": "Intérêts courus, lors de leur entrée dans le patrimoine de la société."}, {"orientation_angle": 0, "polygon": [[177.0, 2718.0], [2275.0, 2706.0], [2275.0, 2759.0], [177.0, 2771.0]], "score": 0.9865028858184814, "text": "Lors de leur sortie, le résultat de cession est calculé selon la méthode de premier entré, premier sorti."}, {"orientation_angle": 0, "polygon": [[177.0, 2809.0], [2282.0, 2797.0], [2282.0, 2850.0], [177.0, 2863.0]], "score": 0.9901103973388672, "text": "Une provision pour dépréciation est comptabilisée lorsque leur valeur probable de négociation est"}, {"orientation_angle": 0, "polygon": [[178.0, 2864.0], [1405.0, 2859.0], [1405.0, 2911.0], [179.0, 2916.0]], "score": 0.9942290782928467, "text": "inférieure à leur coût historique à la clôture de l'exercice."}, {"orientation_angle": 0, "polygon": [[178.0, 2955.0], [2280.0, 2943.0], [2281.0, 2997.0], [179.0, 3009.0]], "score": 0.9859741926193237, "text": "Lorsque les titres font l'objet d'une cotation régulière, leur valeur d'inventaire est calculée sur la"}, {"orientation_angle": 0, "polygon": [[180.0, 3010.0], [1234.0, 3005.0], [1234.0, 3057.0], [180.0, 3062.0]], "score": 0.9781956672668457, "text": "base du cours moyen du dernier mois de clôture."}, {"orientation_angle": 0, "polygon": [[1208.0, 3258.0], [1260.0, 3258.0], [1260.0, 3306.0], [1208.0, 3306.0]], "score": 0.9998818039894104, "text": "15"}, {"orientation_angle": 1, "polygon": [[2348.0, 3387.0], [2414.0, 3410.0], [2387.0, 3491.0], [2320.0, 3468.0]], "score": 0.0, "text": ""}], "page": 11, "pdf": "CA_027080076_7901_1970B00007_2024_C__68b1b2aeb138a6b36d071512.pdf", "skew_angle": 0.0}