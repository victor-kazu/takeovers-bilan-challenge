235.0, 1486.0], [189.0, 1482.0]], "score": 0.9917006492614746, "text": "Elle a été transformée en Société par actions simplifiée suivant décisions de l’Assemblée Générale"}, {"orientation_angle": 0, "polygon": [[193.0, 1496.0], [901.0, 1496.0], [901.0, 1537.0], [193.0, 1537.0]], "score": 0.9732429385185242, "text": "Extraordinaire du 31 décembre 2014."}, {"orientation_angle": 0, "polygon": [[189.0, 1657.0], [2235.0, 1660.0], [2235.0, 1705.0], [189.0, 1701.0]], "score": 0.9857906699180603, "text": "Elle se poursuit et continue d’exister entre les associés sous la forme d’une Société par Actions Simplifiée"}, {"orientation_angle": 0, "polygon": [[191.0, 1715.0], [2237.0, 1715.0], [2237.0, 1761.0], [191.0, 1761.0]], "score": 0.9909451603889465, "text": "régie notamment par le chapitre VIl du Titre 2 du Livre deuxième du Code de Commerce et les règlements"}, {"orientation_angle": 0, "polygon": [[193.0, 1773.0], [1047.0, 1773.0], [1047.0, 1814.0], [193.0, 1814.0]], "score": 0.9941067099571228, "text": "en vigueur, ainsi que par les présents statuts."}, {"orientation_angle": 0, "polygon": [[188.0, 1878.0], [527.0, 1881.0], [527.0, 1929.0], [188.0, 1926.0]], "score": 0.9985029101371765, "text": "Article 2 - Objet :"}, {"orientation_angle": 0, "polygon": [[190.0, 1991.0], [1133.0, 1993.0], [1133.0, 2041.0], [189.0, 2039.0]], "score": 0.9854865670204163, "text": "La société a pour objet, en France et à l’étranger :"}, {"orientation_angle": 0, "polygon": [[189.0, 2104.0], [2235.0, 2107.0], [2235.0, 2154.0], [189.0, 2150.0]], "score": 0.9924454092979431, "text": "La création et l’exploitation d’un fonds d’industrie et de fabrication de produits de confiserie et plus"}, {"orientation_angle": 0, "polygon": [[191.0, 2162.0], [2235.0, 2162.0], [2235.0, 2209.0], [191.0, 2209.0]], "score": 0.9922340512275696, "text": "particulièrement de nougats, ainsi qu’accessoirement de viennoiserie, de chocolaterie et d’une manière"}, {"orientation_angle": 0, "polygon": [[188.0, 2215.0], [2235.0, 2219.0], [2235.0, 2265.0], [188.0, 2262.0]], "score": 0.9871612787246704, "text": "générale de toute activité de transformation et de négoce ayant trait à l’agroalimentaire, aux activités de"}, {"orientation_angle": 0, "polygon": [[190.0, 2270.0], [2235.0, 2274.0], [2235.0, 2323.0], [189.0, 2320.0]], "score": 0.9845833778381348, "text": "pâtisserie, d’organisation d’évènements touristiques et de gestion de sociétés ayant pour objet la"}, {"orientation_angle": 0, "polygon": [[191.0, 2328.0], [1249.0, 2328.0], [1249.0, 2375.0], [191.0, 2375.0]], "score": 0.9943509101867676, "text": "promotion des marques et savoir-faire de CREAMANDE."}, {"orientation_angle": 0, "polygon": [[186.0, 2440.0], [1428.0, 2442.0], [1428.0, 2488.0], [186.0, 2486.0]], "score": 0.9906305074691772, "text": "Toutes opérations industrielles et commerciales se rapportant à :"}, {"orientation_angle": 0, "polygon": [[188.0, 2495.0], [2239.0, 2498.0], [2239.0, 2544.0], [188.0, 2541.0]], "score": 0.9949105381965637, "text": "- la création, l’acquisition, la location, la prise en location-gérance de tous fonds de commerce, la prise à"}, {"orientation_angle": 0, "polygon": [[188.0, 2549.0], [2237.0, 2556.0], [2237.0, 2603.0], [188.0, 2596.0]], "score": 0.9832389950752258, "text": "bail, l'’installation, l’exploitation de tous établissements, fonds de commerce, usines, ateliers, se rapportant"}, {"orientation_angle": 0, "polygon": [[186.0, 2604.0], [1163.0, 2610.0], [1162.0, 2656.0], [186.0, 2651.0]], "score": 0.980932891368866, "text": "à l’une ou l’autre des activités spécifiées ci-dessus ;"}, {"orientation_angle": 0, "polygon": [[188.0, 2663.0], [2237.0, 2668.0], [2237.0, 2714.0], [188.0, 2709.0]], "score": 0.991083562374115, "text": "- la prise, l’acquisition, l’exploitation ou la cession de tous procédés, brevets et droits de propriété"}, {"orientation_angle": 0, "polygon": [[188.0, 2717.0], [930.0, 2719.0], [930.0, 2765.0], [188.0, 2764.0]], "score": 0.9981558322906494, "text": "intellectuelle concernant ces activités ;"}, {"orientation_angle": 0, "polygon": [[188.0, 2770.0], [2241.0, 2776.0], [2241.0, 2827.0], [188.0, 2822.0]], "score": 0.9906443357467651, "text": "- la participation, directe ou indirecte, de la Société dans toutes opérations financières, mobilières ou"}, {"orientation_angle": 0, "polygon": [[188.0, 2829.0], [2239.0, 2834.0], [2239.0, 2880.0], [188.0, 2875.0]], "score": 0.9908700585365295, "text": "immobilières ou entreprises commerciales ou industrielles pouvant se rattacher à l’objet social ou à tout"}, {"orientation_angle": 0, "polygon": [[190.0, 2885.0], [720.0, 2889.0], [720.0, 2937.0], [189.0, 2933.0]], "score": 0.993620753288269, "text": "objet similaire ou connexe ;"}, {"orientation_angle": 0, "polygon": [[193.0, 2947.0], [1572.0, 2947.0], [1572.0, 2988.0], [193.0, 2988.0]], "score": 0.9918416142463684, "text": "- toutes opérations quelconques contribuant à la réalisation de cet objet."}, {"orientation_angle": 0, "polygon": [[190.0, 3050.0], [837.0, 3053.0], [837.0, 3101.0], [189.0, 3098.0]], "score": 0.9986700415611267, "text": "Article 3 - Dénomination sociale :"}, {"orientation_angle": 0, "polygon": [[189.0, 3165.0], [1292.0, 3166.0], [1292.0, 3213.0], [189.0, 3211.0]], "score": 0.9807360768318176, "text": "La dénomination sociale est la suivante : « CREAMANDE »"}, {"orientation_angle": 0, "polygon": [[250.0, 3301.0], [450.0, 3315.0], [440.0, 3457.0], [240.0, 3443.0]], "score": 0.787968635559082, "text": "th"}, {"orientation_angle": 0, "polygon": [[2206.0, 3319.0], [2242.0, 3319.0], [2242.0, 3360.0], [2206.0, 3360.0]], "score": 0.9999160766601562, "text": "2"}], "page": 15, "pdf": "63e881148be6eb9f9d1ff966__63e881148be6eb9f9d1ff966.pdf", "skew_angle": 0.0}