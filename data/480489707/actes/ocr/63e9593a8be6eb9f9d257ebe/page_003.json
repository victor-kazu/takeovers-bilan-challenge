7.0], [930.0, 1059.0], [458.0, 1059.0]], "score": 0.9989210367202759, "text": "- à FIP GALIA PME 4"}, {"orientation_angle": 0, "polygon": [[1614.0, 1002.0], [1912.0, 1002.0], [1912.0, 1050.0], [1614.0, 1050.0]], "score": 0.9785192608833313, "text": "12 931 actions"}, {"orientation_angle": 0, "polygon": [[1609.0, 1055.0], [1914.0, 1059.0], [1913.0, 1112.0], [1608.0, 1108.0]], "score": 0.9645605087280273, "text": "30 172 actions"}, {"orientation_angle": 0, "polygon": [[460.0, 1069.0], [931.0, 1064.0], [932.0, 1112.0], [460.0, 1117.0]], "score": 0.991720974445343, "text": "- à GALIA VENTURE"}, {"orientation_angle": 0, "polygon": [[463.0, 1126.0], [1252.0, 1120.0], [1252.0, 1168.0], [464.0, 1174.0]], "score": 0.9872312545776367, "text": "- à FPCI FINANCIERE DE BRIENNE"}, {"orientation_angle": 0, "polygon": [[1609.0, 1119.0], [1908.0, 1119.0], [1908.0, 1167.0], [1609.0, 1167.0]], "score": 0.9998778104782104, "text": "43 103 actions"}, {"orientation_angle": 0, "polygon": [[279.0, 1239.0], [1429.0, 1234.0], [1430.0, 1287.0], [279.0, 1292.0]], "score": 0.9954807162284851, "text": "Les actions rachetées sont annulées à compter de ce jour."}, {"orientation_angle": 0, "polygon": [[281.0, 1355.0], [2182.0, 1345.0], [2182.0, 1398.0], [281.0, 1408.0]], "score": 0.9983528256416321, "text": "En conséquence, le Président constate que le capital social est réduit de 150 861 euros pour"}, {"orientation_angle": 0, "polygon": [[282.0, 1414.0], [2182.0, 1401.0], [2182.0, 1453.0], [283.0, 1465.0]], "score": 0.9864097237586975, "text": "être ramené de 368 102 euros à 217 241 euros et divisé en 217 241 actions de 1 euro de valeur"}, {"orientation_angle": 0, "polygon": [[284.0, 1474.0], [664.0, 1470.0], [665.0, 1521.0], [285.0, 1525.0]], "score": 0.9998985528945923, "text": "nominale chacune."}, {"orientation_angle": 0, "polygon": [[282.0, 1588.0], [2182.0, 1576.0], [2182.0, 1629.0], [283.0, 1642.0]], "score": 0.9805708527565002, "text": "L’excédent du prix global de rachat sur la valeur nominale des actions rachetées, soit la"}, {"orientation_angle": 0, "polygon": [[286.0, 1648.0], [1775.0, 1638.0], [1776.0, 1691.0], [286.0, 1702.0]], "score": 0.9868695139884949, "text": "somme de 259 480,92 euros, sera imputé sur le poste « Autres Réserves »."}, {"orientation_angle": 0, "polygon": [[286.0, 1821.0], [1036.0, 1814.0], [1037.0, 1867.0], [286.0, 1875.0]], "score": 0.9997467398643494, "text": "MODIFICATION DES STATUTS"}, {"orientation_angle": 0, "polygon": [[284.0, 1935.0], [2103.0, 1921.0], [2103.0, 1977.0], [284.0, 1991.0]], "score": 0.9856835007667542, "text": "En conséquence, le Président décide de modifier comme suit les articles 6 et 7 des statuts :"}, {"orientation_angle": 0, "polygon": [[284.0, 2111.0], [1662.0, 2100.0], [1662.0, 2154.0], [284.0, 2164.0]], "score": 0.9824429154396057, "text": "Il est ajouté in fine la clause suivante à l' « ARTICLE 6 - APPORTS"}, {"orientation_angle": 0, "polygon": [[282.0, 2222.0], [405.0, 2222.0], [405.0, 2286.0], [282.0, 2286.0]], "score": 0.8750530481338501, "text": "\"[..]"}, {"orientation_angle": 0, "polygon": [[289.0, 2339.0], [2185.0, 2327.0], [2186.0, 2378.0], [290.0, 2390.0]], "score": 0.9876348972320557, "text": "Aux termes des délibérations de l'Assemblée Générale Extraordinaire en date du 19 janvier"}, {"orientation_angle": 0, "polygon": [[289.0, 2394.0], [2184.0, 2381.0], [2184.0, 2429.0], [290.0, 2442.0]], "score": 0.9944213628768921, "text": "2017 et de décisions du Président en date du 21 février 2017, le capital social a été réduit de"}, {"orientation_angle": 0, "polygon": [[291.0, 2447.0], [1901.0, 2436.0], [1901.0, 2489.0], [291.0, 2500.0]], "score": 0.9873007535934448, "text": "150 861 euros pour être ramené à 217 241 euros par voie de rachat d'actions.\""}, {"orientation_angle": 0, "polygon": [[288.0, 2622.0], [1054.0, 2618.0], [1054.0, 2669.0], [288.0, 2673.0]], "score": 0.9887849688529968, "text": "Et l'article 7 est modifié comme suit :"}, {"orientation_angle": 0, "polygon": [[287.0, 2740.0], [1007.0, 2731.0], [1008.0, 2782.0], [288.0, 2791.0]], "score": 0.9613677263259888, "text": "« ARTICLE 7 - CAPITAL SOCIAL"}, {"orientation_angle": 0, "polygon": [[289.0, 2851.0], [1412.0, 2841.0], [1412.0, 2894.0], [290.0, 2904.0]], "score": 0.9876454472541809, "text": "Le capital social est fixé à la somme de 217 241 euros."}, {"orientation_angle": 0, "polygon": [[291.0, 2957.0], [2190.0, 2942.0], [2191.0, 2995.0], [291.0, 3011.0]], "score": 0.9843177795410156, "text": "Il est divisé en 217 241 actions de 1 euro chacune entièrement libérées, intégralerent"}, {"orientation_angle": 0, "polygon": [[291.0, 3012.0], [1956.0, 2998.0], [1957.0, 3050.0], [291.0, 3064.0]], "score": 0.986398458480835, "text": "détenues par la société HADEAN, titulaire d'actions de préférence de catégorie A."}], "page": 3, "pdf": "63e9593a8be6eb9f9d257ebe__63e9593a8be6eb9f9d257ebe.pdf", "skew_angle": 0.0}