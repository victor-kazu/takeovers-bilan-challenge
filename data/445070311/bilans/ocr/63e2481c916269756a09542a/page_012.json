1.0], [1793.0, 404.0], [1793.0, 446.0], [219.0, 442.0]], "score": 0.9881224632263184, "text": "Les conventions générales comptables ont été appliquées, dans le respect du principe de prudence,"}, {"orientation_angle": 0, "polygon": [[219.0, 440.0], [865.0, 442.0], [864.0, 483.0], [219.0, 481.0]], "score": 0.9911900162696838, "text": "conformément aux hypothèses de base :"}, {"orientation_angle": 0, "polygon": [[219.0, 495.0], [653.0, 497.0], [653.0, 538.0], [219.0, 536.0]], "score": 0.9987741708755493, "text": "- continuité de l'exploitation"}, {"orientation_angle": 0, "polygon": [[219.0, 547.0], [1218.0, 547.0], [1218.0, 588.0], [219.0, 588.0]], "score": 0.980277955532074, "text": "- permanence des méthodes comptables d'un exercice à l'autre"}, {"orientation_angle": 0, "polygon": [[219.0, 589.0], [698.0, 591.0], [697.0, 632.0], [219.0, 630.0]], "score": 0.9998741149902344, "text": "- Indépendance des exercices"}, {"orientation_angle": 0, "polygon": [[217.0, 653.0], [1726.0, 658.0], [1726.0, 699.0], [217.0, 694.0]], "score": 0.9996777176856995, "text": "et conformément aux règles générales d'établissement et de présentation des comptes annuels."}, {"orientation_angle": 0, "polygon": [[219.0, 726.0], [2115.0, 730.0], [2115.0, 771.0], [219.0, 768.0]], "score": 0.9914243221282959, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques"}, {"orientation_angle": 0, "polygon": [[214.0, 816.0], [1834.0, 819.0], [1834.0, 858.0], [214.0, 855.0]], "score": 0.9937654137611389, "text": "Les comptes annuels cet exercice ont été établis conformément au règlement de l’Autorité des Normes"}, {"orientation_angle": 0, "polygon": [[215.0, 862.0], [1903.0, 865.0], [1903.0, 906.0], [215.0, 903.0]], "score": 0.9914243221282959, "text": "Comptables n°2014-03 du 5 juin 2014, modifié par les règlements ANC n°2015-06 du 23 novembre 2015 et"}, {"orientation_angle": 0, "polygon": [[214.0, 908.0], [778.0, 910.0], [778.0, 951.0], [214.0, 949.0]], "score": 0.9976212978363037, "text": "ANC 2016-07 du 4 Novembre 2016"}, {"orientation_angle": 0, "polygon": [[217.0, 963.0], [1075.0, 965.0], [1075.0, 1006.0], [217.0, 1004.0]], "score": 0.9843322038650513, "text": "Les principales méthodes utilisées sont les suivantes :"}, {"orientation_angle": 0, "polygon": [[158.0, 1052.0], [195.0, 1052.0], [195.0, 1088.0], [158.0, 1088.0]], "score": 0.985954225063324, "text": "a)"}, {"orientation_angle": 0, "polygon": [[205.0, 1043.0], [692.0, 1045.0], [692.0, 1091.0], [205.0, 1090.0]], "score": 0.9999186396598816, "text": "Immobilisations corporelles"}, {"orientation_angle": 0, "polygon": [[215.0, 1114.0], [2203.0, 1117.0], [2203.0, 1158.0], [215.0, 1155.0]], "score": 0.9912157654762268, "text": "Les immobilisations corporelles sont évaluées à leur coût d'acquisition (prix d'achat et frais accessoires, hors frais d'acquisition"}, {"orientation_angle": 0, "polygon": [[217.0, 1155.0], [983.0, 1155.0], [983.0, 1194.0], [217.0, 1194.0]], "score": 0.997859537601471, "text": "des immobilisation) ou à leur coût de production."}, {"orientation_angle": 0, "polygon": [[219.0, 1216.0], [2186.0, 1220.0], [2185.0, 1261.0], [219.0, 1258.0]], "score": 0.9941796064376831, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire/dégressif en fonction de la durée de vie prévue :"}, {"orientation_angle": 0, "polygon": [[212.0, 1264.0], [464.0, 1270.0], [463.0, 1311.0], [212.0, 1305.0]], "score": 0.979089081287384, "text": "- Constructions"}, {"orientation_angle": 0, "polygon": [[1870.0, 1277.0], [1985.0, 1273.0], [1986.0, 1310.0], [1871.0, 1315.0]], "score": 0.8479507565498352, "text": "....ans"}, {"orientation_angle": 0, "polygon": [[214.0, 1319.0], [1039.0, 1323.0], [1038.0, 1366.0], [213.0, 1362.0]], "score": 0.991710364818573, "text": "- Agencements et aménagements des constructions"}, {"orientation_angle": 0, "polygon": [[1816.0, 1322.0], [1986.0, 1328.0], [1985.0, 1369.0], [1815.0, 1363.0]], "score": 0.857666552066803, "text": "15 ...ans"}, {"orientation_angle": 0, "polygon": [[212.0, 1372.0], [612.0, 1378.0], [611.0, 1419.0], [212.0, 1413.0]], "score": 0.9956392049789429, "text": "- Installations techniques"}, {"orientation_angle": 0, "polygon": [[1816.0, 1375.0], [1984.0, 1381.0], [1983.0, 1423.0], [1815.0, 1417.0]], "score": 0.8934122323989868, "text": "10 ....ans"}, {"orientation_angle": 0, "polygon": [[212.0, 1425.0], [727.0, 1429.0], [727.0, 1472.0], [212.0, 1468.0]], "score": 0.9994599223136902, "text": "- Matériel et Outillage industriels"}, {"orientation_angle": 0, "polygon": [[1830.0, 1428.0], [1986.0, 1435.0], [1985.0, 1477.0], [1828.0, 1471.0]], "score": 0.826734721660614, "text": "5 ....ans"}, {"orientation_angle": 0, "polygon": [[148.0, 1504.0], [198.0, 1504.0], [198.0, 1551.0], [148.0, 1551.0]], "score": 0.9943287968635559, "text": "b)"}, {"orientation_angle": 0, "polygon": [[208.0, 1504.0], [339.0, 1504.0], [339.0, 1547.0], [208.0, 1547.0]], "score": 0.9999046325683594, "text": "Stocks"}, {"orientation_angle": 0, "polygon": [[210.0, 1575.0], [1354.0, 1578.0], [1354.0, 1617.0], [210.0, 1614.0]], "score": 0.999273955821991, "text": "Les stocks sont évalués suivant la méthode premier entré, premier sorti.."}, {"orientation_angle": 0, "polygon": [[208.0, 1621.0], [1888.0, 1626.0], [1887.0, 1667.0], [208.0, 1662.0]], "score": 0.9915628433227539, "text": "La valeur brute des marchandises et approvisionnements comprend le prix d'achat et les frais accessoires."}, {"orientation_angle": 0, "polygon": [[210.0, 1689.0], [2056.0, 1695.0], [2056.0, 1736.0], [210.0, 1730.0]], "score": 0.9979682564735413, "text": "Les produits fabriqués sont valorisés au coût de production comprenant les consommations et les charges directes et"}, {"orientation_angle": 0, "polygon": [[210.0, 1729.0], [2172.0, 1734.0], [2172.0, 1775.0], [210.0, 1770.0]], "score": 0.9930605292320251, "text": "indirectes de production, les amortissements des biens concourant à la production. Le coût de la sous-activité est exclu de la"}, {"orientation_angle": 0, "polygon": [[212.0, 1772.0], [501.0, 1772.0], [501.0, 1808.0], [212.0, 1808.0]], "score": 0.987661600112915, "text": "valeur des stocks."}, {"orientation_angle": 0, "polygon": [[210.0, 1808.0], [1185.0, 1811.0], [1185.0, 1852.0], [210.0, 1849.0]], "score": 0.9976186752319336, "text": "Les intérêts sont toujours exclus de la valorisation des stocks."}, {"orientation_angle": 0, "polygon": [[210.0, 1880.0], [2070.0, 1883.0], [2070.0, 1924.0], [210.0, 1921.0]], "score": 0.9947232604026794, "text": "Une provision pour dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités"}, {"orientation_angle": 0, "polygon": [[210.0, 1919.0], [2063.0, 1926.0], [2063.0, 1967.0], [210.0, 1960.0]], "score": 0.9960688948631287, "text": "indiquées ci-dessus et le cours du jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est"}, {"orientation_angle": 0, "polygon": [[210.0, 1958.0], [1374.0, 1962.0], [1374.0, 2003.0], [210.0, 1999.0]], "score": 0.9957465529441833, "text": "effectuée lorsque cette valeur brute est supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[148.0, 2037.0], [377.0, 2037.0], [377.0, 2085.0], [148.0, 2085.0]], "score": 0.9905927181243896, "text": "c) Créances"}, {"orientation_angle": 0, "polygon": [[205.0, 2102.0], [2029.0, 2111.0], [2029.0, 2152.0], [205.0, 2143.0]], "score": 0.9969037771224976, "text": "Les créances sont valorisées à leur valeur nominale. Une provision pour dépréciation est pratiquée lorsque la valeur"}, {"orientation_angle": 0, "polygon": [[205.0, 2142.0], [961.0, 2147.0], [961.0, 2188.0], [205.0, 2183.0]], "score": 0.9931743144989014, "text": "d'inventaire est inférieure à la valeur comptable."}, {"orientation_angle": 0, "polygon": [[148.0, 2214.0], [682.0, 2215.0], [682.0, 2262.0], [148.0, 2260.0]], "score": 0.9817916750907898, "text": "d)Crédit d'impôt compétitivité"}, {"orientation_angle": 0, "polygon": [[203.0, 2284.0], [1967.0, 2291.0], [1967.0, 2337.0], [203.0, 2330.0]], "score": 0.9832216501235962, "text": "Le crédit d'impôt compétitivité a été comptabilisé au crédit des charges de personnel à hauteur de 49 322 euros."}, {"orientation_angle": 0, "polygon": [[158.0, 2364.0], [377.0, 2364.0], [377.0, 2411.0], [158.0, 2411.0]], "score": 0.9640660285949707, "text": "e) Provision"}, {"orientation_angle": 0, "polygon": [[191.0, 2457.0], [2187.0, 2467.0], [2187.0, 2508.0], [191.0, 2498.0]], "score": 0.9921703934669495, "text": "Les provisions sont comptabilisées lorsque, à la clôture de l'exercice, l'entreprise a une obligation à l'égard d'un tiers qui résulte"}, {"orientation_angle": 0, "polygon": [[191.0, 2498.0], [2189.0, 2508.0], [2189.0, 2550.0], [191.0, 2539.0]], "score": 0.9924952387809753, "text": "d'un fait générateur passé et dont il est probable ou certain qu'elle provoquera une sortie de ressources au bénéfice de ce tiers,"}, {"orientation_angle": 0, "polygon": [[190.0, 2537.0], [2196.0, 2548.0], [2196.0, 2589.0], [189.0, 2579.0]], "score": 0.9935728907585144, "text": "sans contrepartie au moins équivalente attendue de celui-ci. Cette obligation peut être d'ordre légale, réglementaire ou implicite."}, {"orientation_angle": 0, "polygon": [[191.0, 2577.0], [1774.0, 2586.0], [1774.0, 2627.0], [191.0, 2618.0]], "score": 0.9888886213302612, "text": "Ces provisions sont estimées selon leur nature en tenant compte des hypothèses les plus probables."}, {"orientation_angle": 0, "polygon": [[141.0, 2693.0], [811.0, 2699.0], [811.0, 2747.0], [141.0, 2741.0]], "score": 0.9901869893074036, "text": "f) Engagements de départ à la retraite"}, {"orientation_angle": 0, "polygon": [[202.0, 2758.0], [2106.0, 2771.0], [2106.0, 2812.0], [201.0, 2800.0]], "score": 0.984350323677063, "text": "Les engagements de départs à la retraite ne font ni l'objet d'une provision comptable ni d'une assurance. Compte tenu de"}, {"orientation_angle": 0, "polygon": [[202.0, 2800.0], [1662.0, 2808.0], [1662.0, 2849.0], [201.0, 2841.0]], "score": 0.991308867931366, "text": "l'âge des salariés et de leur ancienneté, l'IFC n'a pas était caiculée mais est non significative."}, {"orientation_angle": 0, "polygon": [[142.0, 2882.0], [321.0, 2886.0], [320.0, 2934.0], [141.0, 2930.0]], "score": 0.958032488822937, "text": "g) Divers"}, {"orientation_angle": 0, "polygon": [[203.0, 2949.0], [312.0, 2949.0], [312.0, 2992.0], [203.0, 2992.0]], "score": 0.9996727108955383, "text": "Néant"}, {"orientation_angle": 0, "polygon": [[2171.0, 3048.0], [2335.0, 3144.0], [2299.0, 3206.0], [2134.0, 3110.0]], "score": 0.8668743371963501, "text": "Hlufschmitt"}, {"orientation_angle": 1, "polygon": [[75.0, 3121.0], [118.0, 3125.0], [107.0, 3243.0], [64.0, 3239.0]], "score": 0.9265055060386658, "text": "© Sage"}, {"orientation_angle": 0, "polygon": [[2024.0, 3148.0], [2144.0, 3072.0], [2171.0, 3116.0], [2052.0, 3192.0]], "score": 0.9671934843063354, "text": "Philippe"}, {"orientation_angle": 0, "polygon": [[2109.0, 3181.0], [2245.0, 3187.0], [2243.0, 3223.0], [2107.0, 3217.0]], "score": 0.9892181754112244, "text": "Membre de la"}, {"orientation_angle": 0, "polygon": [[2031.0, 3194.0], [2053.0, 3194.0], [2053.0, 3218.0], [2031.0, 3218.0]], "score": 0.9783813953399658, "text": "*"}, {"orientation_angle": 0, "polygon": [[2068.0, 3214.0], [2283.0, 3227.0], [2280.0, 3268.0], [2066.0, 3255.0]], "score": 0.9641352295875549, "text": "Compagnie Région"}, {"orientation_angle": 0, "polygon": [[238.0, 3228.0], [705.0, 3233.0], [704.0, 3273.0], [238.0, 3267.0]], "score": 0.9991391897201538, "text": "MBS CONSULTANTS SARL"}, {"orientation_angle": 0, "polygon": [[2337.0, 3243.0], [2384.0, 3243.0], [2384.0, 3279.0], [2337.0, 3279.0]], "score": 0.999265193939209, "text": "16"}, {"orientation_angle": 0, "polygon": [[2123.0, 3257.0], [2226.0, 3263.0], [2224.0, 3295.0], [2121.0, 3289.0]], "score": 0.9921841025352478, "text": "de Colmar"}, {"orientation_angle": 0, "polygon": [[2055.0, 3294.0], [2185.0, 3368.0], [2160.0, 3411.0], [2030.0, 3338.0]], "score": 0.8580601215362549, "text": "MISSAIRL"}, {"orientation_angle": 0, "polygon": [[2179.0, 3365.0], [2208.0, 3365.0], [2208.0, 3389.0], [2179.0, 3389.0]], "score": 0.9430389404296875, "text": "Al"}], "page": 12, "pdf": "CA_445070311_6751_2003B00059_2019_1083__63e2481c916269756a09542a.pdf", "skew_angle": 0.0}