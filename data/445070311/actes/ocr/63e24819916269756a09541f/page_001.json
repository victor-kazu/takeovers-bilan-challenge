187.0, 2286.0], [176.0, 2298.0]], "score": 0.9970752596855164, "text": "de Commissaire à la transformation de la Société, lequel a établi un rapport sur la situation de la Société"}, {"orientation_angle": 0, "polygon": [[176.0, 2296.0], [2189.0, 2286.0], [2189.0, 2334.0], [176.0, 2344.0]], "score": 0.9967111945152283, "text": "conformément aux dispositions de l'article L 223-43 du Code de commerce et un rapport portant sur la"}, {"orientation_angle": 0, "polygon": [[176.0, 2346.0], [2187.0, 2334.0], [2187.0, 2382.0], [176.0, 2394.0]], "score": 0.9924293160438538, "text": "valeur des biens composant l'actif social et les avantages particuliers pouvant exister au profit d'associés ou"}, {"orientation_angle": 0, "polygon": [[178.0, 2394.0], [1712.0, 2387.0], [1713.0, 2433.0], [178.0, 2440.0]], "score": 0.9815011024475098, "text": "de tiers conformément aux dispositions de l'article L 224-3 du Code de commerce ."}, {"orientation_angle": 0, "polygon": [[176.0, 2488.0], [2191.0, 2476.0], [2191.0, 2527.0], [176.0, 2539.0]], "score": 0.9908043742179871, "text": "Ce rapport fait apparaitre que rien s'oppose à la transformation de la Société en société par actions"}, {"orientation_angle": 0, "polygon": [[178.0, 2536.0], [375.0, 2536.0], [375.0, 2584.0], [178.0, 2584.0]], "score": 0.9983566403388977, "text": "simplifiée."}, {"orientation_angle": 0, "polygon": [[174.0, 2582.0], [2192.0, 2570.0], [2193.0, 2621.0], [175.0, 2634.0]], "score": 0.9960977435112, "text": "Cette transformation prendrait effet à compter de ce jour et l'ensemble des dispositions légales et statutaires"}, {"orientation_angle": 0, "polygon": [[176.0, 2630.0], [2194.0, 2618.0], [2194.0, 2669.0], [176.0, 2682.0]], "score": 0.9914593696594238, "text": "régissant la Société sous sa nouvelle forme seraient applicables à l'établissement, au contrôle, et à"}, {"orientation_angle": 0, "polygon": [[176.0, 2682.0], [1251.0, 2674.0], [1252.0, 2721.0], [176.0, 2728.0]], "score": 0.990515947341919, "text": "l'approbation des comptes annuels de l'exercice en cours."}, {"orientation_angle": 0, "polygon": [[176.0, 2728.0], [2192.0, 2717.0], [2193.0, 2764.0], [176.0, 2774.0]], "score": 0.9888678193092346, "text": "Ladite transformation s'effectuerait sans création d'une personne morale nouvelle et entraînera en ce qui"}, {"orientation_angle": 0, "polygon": [[178.0, 2777.0], [2191.0, 2765.0], [2191.0, 2812.0], [178.0, 2824.0]], "score": 0.9981025457382202, "text": "concerne le capital social, un simple échange de parts représentant ledit capital contre des actions, à raison"}, {"orientation_angle": 0, "polygon": [[183.0, 2827.0], [680.0, 2827.0], [680.0, 2868.0], [183.0, 2868.0]], "score": 0.9720996022224426, "text": "d'une part pour une action."}, {"orientation_angle": 0, "polygon": [[179.0, 2873.0], [2192.0, 2860.0], [2193.0, 2906.0], [180.0, 2920.0]], "score": 0.9939365386962891, "text": "Si vous approuvez cette transformation, vous aurez à adopter les nouveaux statuts de la Société et vous"}, {"orientation_angle": 0, "polygon": [[179.0, 2921.0], [2192.0, 2907.0], [2193.0, 2954.0], [180.0, 2968.0]], "score": 0.9882179498672485, "text": "aurez à vous prononcer sur la désignation d'un Président en remplacement de la gérance dont les fonctions"}, {"orientation_angle": 0, "polygon": [[183.0, 2973.0], [758.0, 2967.0], [758.0, 3009.0], [183.0, 3014.0]], "score": 0.9950479865074158, "text": "prendraient fin immédiatement."}, {"orientation_angle": 0, "polygon": [[1117.0, 3307.0], [1259.0, 3303.0], [1261.0, 3346.0], [1118.0, 3350.0]], "score": 0.991321861743927, "text": "Page 1/2"}], "page": 1, "pdf": "63e24819916269756a09541f__63e24819916269756a09541f.pdf", "skew_angle": 0.0}