99.0, 1163.0], [2199.0, 1204.0], [294.0, 1204.0]], "score": 0.9882895350456238, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts"}, {"orientation_angle": 0, "polygon": [[293.0, 1202.0], [486.0, 1206.0], [485.0, 1249.0], [292.0, 1245.0]], "score": 0.9998693466186523, "text": "historiques."}, {"orientation_angle": 0, "polygon": [[294.0, 1285.0], [1978.0, 1287.0], [1978.0, 1328.0], [294.0, 1326.0]], "score": 0.9981052279472351, "text": "Seules sont exprimées les informations significatives. Sauf mention, les montants sont exprimés en euros."}, {"orientation_angle": 0, "polygon": [[294.0, 1371.0], [1228.0, 1371.0], [1228.0, 1422.0], [294.0, 1422.0]], "score": 0.9913143515586853, "text": "Immobilisations corporelles et incorporelles"}, {"orientation_angle": 0, "polygon": [[294.0, 1479.0], [2199.0, 1479.0], [2199.0, 1519.0], [294.0, 1519.0]], "score": 0.9926983118057251, "text": "Les immobilisations corporelles et incorporelles sont évaluées à leur coût d'acquisition pour les actifs acquis à titre"}, {"orientation_angle": 0, "polygon": [[292.0, 1518.0], [2199.0, 1520.0], [2199.0, 1561.0], [292.0, 1560.0]], "score": 0.9842287302017212, "text": "onéreux, à leur coût de production pour les actifs produits par l'entreprise, à leur valeur vénale pour les actifs acquis"}, {"orientation_angle": 0, "polygon": [[292.0, 1560.0], [878.0, 1561.0], [878.0, 1603.0], [292.0, 1601.0]], "score": 0.9765620231628418, "text": "à titre gratuit et par voie d'échange."}, {"orientation_angle": 0, "polygon": [[292.0, 1640.0], [2201.0, 1642.0], [2201.0, 1683.0], [292.0, 1682.0]], "score": 0.9890375137329102, "text": "Le coût d'une immobilisation est constitué de son prix d'achat, y compris les droits de douane et taxes non"}, {"orientation_angle": 0, "polygon": [[294.0, 1682.0], [2199.0, 1683.0], [2199.0, 1725.0], [294.0, 1723.0]], "score": 0.9925855398178101, "text": "récupérables, après déduction des remises, rabais commerciaux et escomptes de règlement de tous les coûts"}, {"orientation_angle": 0, "polygon": [[292.0, 1723.0], [2201.0, 1725.0], [2201.0, 1766.0], [292.0, 1764.0]], "score": 0.9946110844612122, "text": "directement attribuables engagés pour mettre l'actif en place et en état de fonctionner selon l'utilisation prévue. Les"}, {"orientation_angle": 0, "polygon": [[292.0, 1764.0], [2201.0, 1766.0], [2201.0, 1807.0], [292.0, 1805.0]], "score": 0.9909220933914185, "text": "droits de mutation, honoraires ou commissions et frais d'actes liés à l'acquisition, sont rattachés à ce coût"}, {"orientation_angle": 0, "polygon": [[292.0, 1807.0], [2199.0, 1805.0], [2199.0, 1847.0], [292.0, 1848.0]], "score": 0.9959003925323486, "text": "d'acquisition. Tous les coûts qui ne font pas partie du prix d'acquisition de l'immobilisation et qui ne peuvent pas être"}, {"orientation_angle": 0, "polygon": [[294.0, 1850.0], [2201.0, 1850.0], [2201.0, 1890.0], [294.0, 1890.0]], "score": 0.9890875816345215, "text": "rattachés directement aux coûts rendus nécessaires pour mettre l'actif en place et en état de fonctionner"}, {"orientation_angle": 0, "polygon": [[292.0, 1888.0], [1374.0, 1893.0], [1373.0, 1933.0], [292.0, 1927.0]], "score": 0.9915003776550293, "text": "conformément à l'utilisation prévue, sont comptabilisés en charges."}, {"orientation_angle": 0, "polygon": [[294.0, 1979.0], [636.0, 1979.0], [636.0, 2025.0], [294.0, 2025.0]], "score": 0.9999683499336243, "text": "Amortissements"}, {"orientation_angle": 0, "polygon": [[292.0, 2066.0], [2134.0, 2066.0], [2134.0, 2106.0], [292.0, 2106.0]], "score": 0.9887170195579529, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire en fonction de la durée de vie prévue."}, {"orientation_angle": 0, "polygon": [[291.0, 2185.0], [643.0, 2189.0], [642.0, 2230.0], [290.0, 2226.0]], "score": 0.9827781319618225, "text": "* Site internet : 3 ans"}, {"orientation_angle": 0, "polygon": [[287.0, 2224.0], [1512.0, 2228.0], [1512.0, 2274.0], [287.0, 2271.0]], "score": 0.9926225543022156, "text": "* Installations générales, agencements et aménagements divers : 5 & 10 ans"}, {"orientation_angle": 0, "polygon": [[290.0, 2267.0], [793.0, 2271.0], [793.0, 2312.0], [290.0, 2309.0]], "score": 0.979444146156311, "text": "* Matériel de transports : 5 ans"}, {"orientation_angle": 0, "polygon": [[289.0, 2309.0], [741.0, 2312.0], [741.0, 2353.0], [288.0, 2350.0]], "score": 0.9926647543907166, "text": "* Matériel de bureau : 5 ans"}, {"orientation_angle": 0, "polygon": [[291.0, 2350.0], [786.0, 2355.0], [786.0, 2396.0], [290.0, 2391.0]], "score": 0.9785526394844055, "text": "* Matériel informatique : 3 ans"}, {"orientation_angle": 0, "polygon": [[289.0, 2391.0], [634.0, 2396.0], [634.0, 2438.0], [288.0, 2432.0]], "score": 0.9857256412506104, "text": "* Mobilier : 4 & 6 ans"}, {"orientation_angle": 0, "polygon": [[292.0, 2475.0], [2184.0, 2477.0], [2184.0, 2518.0], [292.0, 2517.0]], "score": 0.9903472065925598, "text": "La durée d'amortissement retenue par simplification est la durée d'usage pour les biens non décomposables à l'origine."}, {"orientation_angle": 0, "polygon": [[292.0, 2520.0], [2194.0, 2520.0], [2194.0, 2559.0], [292.0, 2559.0]], "score": 0.989320695400238, "text": "L'entreprise a apprécié à la date de clôture, en considérant les informations internes et externes à sa disposition,"}, {"orientation_angle": 0, "polygon": [[290.0, 2558.0], [1647.0, 2559.0], [1647.0, 2599.0], [290.0, 2597.0]], "score": 0.9978982210159302, "text": "l'existence d'indices montrant que les actifs ont pu perdre notablement de la valeur."}, {"orientation_angle": 0, "polygon": [[2190.0, 3252.0], [2322.0, 3260.0], [2316.0, 3360.0], [2184.0, 3352.0]], "score": 0.6719475388526917, "text": "77"}, {"orientation_angle": 0, "polygon": [[221.0, 3267.0], [486.0, 3267.0], [486.0, 3358.0], [221.0, 3358.0]], "score": 0.7934292554855347, "text": "ACCI"}, {"orientation_angle": 0, "polygon": [[821.0, 3265.0], [1085.0, 3265.0], [1085.0, 3300.0], [821.0, 3300.0]], "score": 0.9797314405441284, "text": "39 Rue Denis Papin"}, {"orientation_angle": 0, "polygon": [[1151.0, 3265.0], [1671.0, 3265.0], [1671.0, 3300.0], [1151.0, 3300.0]], "score": 0.9755233526229858, "text": "BP 81830 85180 Les Sables d'Olonne"}, {"orientation_angle": 0, "polygon": [[655.0, 3319.0], [1830.0, 3322.0], [1830.0, 3358.0], [655.0, 3355.0]], "score": 0.9851645231246948, "text": "Mission de présentation des comptes annuels / Voir attestation de l'expert comptable"}, {"orientation_angle": 0, "polygon": [[240.0, 3343.0], [297.0, 3343.0], [297.0, 3355.0], [240.0, 3355.0]], "score": 0.5103111863136292, "text": "m O"}, {"orientation_angle": 0, "polygon": [[314.0, 3343.0], [411.0, 3343.0], [411.0, 3355.0], [314.0, 3355.0]], "score": 0.5529312491416931, "text": "• - COm"}], "page": 9, "pdf": "CA_412000887_8501_1997B00311_2023_C__65cc22ee1ff6221e070c2104.pdf", "skew_angle": 0.0}