{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[857.0, 940.0], [1920.0, 940.0], [1920.0, 1056.0], [857.0, 1056.0]], "score": 0.9997670650482178, "text": "LES SOUSSIGNES :"}, {"orientation_angle": 0, "polygon": [[852.0, 1200.0], [2518.0, 1200.0], [2518.0, 1330.0], [852.0, 1330.0]], "score": 0.9972209334373474, "text": "Monsieur Jean-Baptiste ORTELLI,"}, {"orientation_angle": 0, "polygon": [[852.0, 1335.0], [3255.0, 1330.0], [3255.0, 1460.0], [852.0, 1465.0]], "score": 0.9869883060455322, "text": "Demeurant 10, rue des Vignes -- 39100 BREVANS"}, {"orientation_angle": 0, "polygon": [[852.0, 1605.0], [2111.0, 1605.0], [2111.0, 1721.0], [852.0, 1721.0]], "score": 0.9986763000488281, "text": "Madame Sylvie ORTELLI"}, {"orientation_angle": 0, "polygon": [[857.0, 1735.0], [3255.0, 1735.0], [3255.0, 1865.0], [857.0, 1865.0]], "score": 0.9774594902992249, "text": "Demeurant 10, rue des Vignes - 39100 BREVANS"}, {"orientation_angle": 0, "polygon": [[852.0, 2000.0], [2250.0, 2005.0], [2250.0, 2135.0], [852.0, 2130.0]], "score": 0.9991075396537781, "text": "Monsieur Georges ORTELLI"}, {"orientation_angle": 0, "polygon": [[852.0, 2140.0], [3207.0, 2130.0], [3208.0, 2260.0], [852.0, 2270.0]], "score": 0.9988012909889221, "text": "Demeurant 10, rue des Vignes -39100 BREVANS"}, {"orientation_angle": 0, "polygon": [[852.0, 2530.0], [5979.0, 2545.0], [5979.0, 2690.0], [852.0, 2675.0]], "score": 0.9885416626930237, "text": "Ont adopté à l'Assemblée Générale Extraordinaire du 19 décembre 2002 les statuts d'une société par"}, {"orientation_angle": 0, "polygon": [[866.0, 2694.0], [2963.0, 2694.0], [2963.0, 2810.0], [866.0, 2810.0]], "score": 0.9960092306137085, "text": "actions simplifiée (S.A.S.) ainsi qu'il suit :"}, {"orientation_angle": 0, "polygon": [[3021.0, 3114.0], [3806.0, 3114.0], [3806.0, 3229.0], [3021.0, 3229.0]], "score": 0.9998154640197754, "text": "STATUTS"}, {"orientation_angle": 0, "polygon": [[3157.0, 3691.0], [3668.0, 3702.0], [3665.0, 3823.0], [3154.0, 3812.0]], "score": 0.9992666244506836, "text": "TITRE 1"}, {"orientation_angle": 0, "polygon": [[1479.0, 3986.0], [5333.0, 3996.0], [5333.0, 4111.0], [1479.0, 4102.0]], "score": 0.9760028123855591, "text": "FORME - OBJET - DENOMINATION SOCIALE -SIEGE - DUREE"}, {"orientation_angle": 0, "polygon": [[857.0, 4420.0], [2135.0, 4425.0], [2135.0, 4540.0], [857.0, 4535.0]], "score": 0.9714200496673584, "text": "ARTICLE 1 - FORME"}, {"orientation_angle": 0, "polygon": [[1011.0, 4699.0], [5975.0, 4724.0], [5974.0, 4849.0], [1010.0, 4824.0]], "score": 0.9845687747001648, "text": "La société a été constituée sous forme de société à responsabilité limitée suivant acte reçu par Maître"}, {"orientation_angle": 0, "polygon": [[1024.0, 4849.0], [3270.0, 4849.0], [3270.0, 4964.0], [1024.0, 4964.0]], "score": 0.9906255602836609, "text": "LAB, Notaire à Dole, en date du 26 juillet 1948."}, {"orientation_angle": 0, "polygon": [[1010.0, 5118.0], [5979.0, 5138.0], [5979.0, 5268.0], [1010.0, 5249.0]], "score": 0.9928056597709656, "text": "Elle a été transformée par les associés en société anonyme, suivant acte sous seings privés, en date à"}, {"orientation_angle": 0, "polygon": [[1015.0, 5253.0], [5965.0, 5268.0], [5965.0, 5398.0], [1015.0, 5384.0]], "score": 0.9927482008934021, "text": "Brévans du 13 octobre 1955, déposé au rang des Minutes de Maître LAB, Notaire à Dole."}, {"orientation_angle": 0, "polygon": [[1020.0, 5543.0], [5965.0, 5562.0], [5965.0, 5678.0], [1020.0, 5658.0]], "score": 0.9974674582481384, "text": "Elle a été transformée en société par actions simplifiée, suivant décision de l'Assemblée Générale"}, {"orientation_angle": 1, "polygon": [[881.0, 5596.0], [910.0, 5596.0], [910.0, 5620.0], [881.0, 5620.0]], "score": 0.39290252327919006, "text": "."}, {"orientation_angle": 0, "polygon": [[1020.0, 5678.0], [4175.0, 5683.0], [4174.0, 5798.0], [1020.0, 5793.0]], "score": 0.9808194637298584, "text": "Extraordinaire, en date du 19 décembre 2002, statuant à l'unanimité."}, {"orientation_angle": 0, "polygon": [[848.0, 5943.0], [5970.0, 5967.0], [5969.0, 6097.0], [847.0, 6073.0]], "score": 0.9934255480766296, "text": "La société continue d'exister entre les propriétaires des actions existantes et de celles qui seraient créées"}, {"orientation_angle": 0, "polygon": [[854.0, 6082.0], [1581.0, 6098.0], [1578.0, 6214.0], [851.0, 6198.0]], "score": 0.9997751712799072, "text": "ultérieurement."}, {"orientation_angle": 0, "polygon": [[852.0, 6343.0], [5965.0, 6362.0], [5965.0, 6492.0], [852.0, 6473.0]], "score": 0.9969980120658875, "text": "Elle est régie par les dispositions légales applicables et par les présents statuts. Elle ne peut faire appel public"}, {"orientation_angle": 0, "polygon": [[847.0, 6478.0], [3954.0, 6483.0], [3954.0, 6613.0], [847.0, 6608.0]], "score": 0.9987689852714539, "text": "à l'épargne sous sa forme actuelle de société par actions simplifiée."}, {"orientation_angle": 0, "polygon": [[848.0, 6738.0], [3940.0, 6748.0], [3940.0, 6878.0], [847.0, 6868.0]], "score": 0.9937322735786438, "text": "Elle fonctionne sous la même forme avec un ou plusieurs associés."}, {"orientation_angle": 0, "polygon": [[857.0, 7157.0], [1977.0, 7162.0], [1977.0, 7278.0], [857.0, 7273.0]], "score": 0.9884340763092041, "text": "ARTICLE 2 - OBJET"}, {"orientation_angle": 0, "polygon": [[857.0, 7427.0], [4620.0, 7427.0], [4620.0, 7543.0], [857.0, 7543.0]], "score": 0.9971415400505066, "text": "La présente société par actions simplifiée continue d'avoir pour objet, en France :"}, {"orientation_angle": 0, "polygon": [[857.0, 7683.0], [5970.0, 7697.0], [5969.0, 7813.0], [857.0, 7798.0]], "score": 0.9973251819610596, "text": "l'exploitation de tous établissements concernant l'entreprise de travaux publics, et notamment l'exploitation"}, {"orientation_angle": 0, "polygon": [[857.0, 7808.0], [5386.0, 7818.0], [5385.0, 7948.0], [857.0, 7938.0]], "score": 0.993283212184906, "text": "de l'entreprise de travaux publics, ci-après apportée à la société par Monsieur Baptiste ORTELLI."}, {"orientation_angle": 0, "polygon": [[857.0, 8073.0], [5970.0, 8088.0], [5969.0, 8218.0], [857.0, 8203.0]], "score": 0.982033908367157, "text": "Et plus généralement toutes opérations de quelque nature qu'elles soient, économiques ou juridiques,"}, {"orientation_angle": 0, "polygon": [[857.0, 8198.0], [5975.0, 8218.0], [5974.0, 8348.0], [857.0, 8329.0]], "score": 0.991100549697876, "text": "financières, civiles ou commerciales, pouvant se rattacher, directement ou indirectement, à cet objet ou à tous"}, {"orientation_angle": 0, "polygon": [[862.0, 8333.0], [3117.0, 8343.0], [3116.0, 8473.0], [862.0, 8463.0]], "score": 0.999778151512146, "text": "objets similaires, connexes ou complémentaires."}, {"orientation_angle": 0, "polygon": [[862.0, 8594.0], [5975.0, 8608.0], [5974.0, 8738.0], [862.0, 8724.0]], "score": 0.992401123046875, "text": "La participation, directe ou indirecte, de la société à toutes activités ou opérations industrielles, commerciales"}, {"orientation_angle": 0, "polygon": [[867.0, 8733.0], [5970.0, 8748.0], [5969.0, 8864.0], [866.0, 8849.0]], "score": 0.9921915531158447, "text": "ou financières, mobilières ou immobilières, en France ou à l'étranger, sous quelque forme que ce soit, dès lors"}, {"orientation_angle": 0, "polygon": [[862.0, 8864.0], [5979.0, 8869.0], [5979.0, 8999.0], [862.0, 8994.0]], "score": 0.9892722368240356, "text": "que ces activités ou opérations peuvent se rattacher, directement ou indirectement, à l'objet social ou à tous"}, {"orientation_angle": 0, "polygon": [[876.0, 8999.0], [3107.0, 8999.0], [3107.0, 9114.0], [876.0, 9114.0]], "score": 0.9998965263366699, "text": "objets similaires, connexes ou complémentaires."}, {"orientation_angle": 0, "polygon": [[5453.0, 9147.0], [5760.0, 9128.0], [5778.0, 9407.0], [5471.0, 9427.0]], "score": 0.4661296308040619, "text": "\\C0"}, {"orientation_angle": 0, "polygon": [[5855.0, 9206.0], [6022.0, 9206.0], [6022.0, 9365.0], [5855.0, 9365.0]], "score": 0.46465638279914856, "text": "C"}, {"orientation_angle": 1, "polygon": [[6003.0, 9206.0], [6137.0, 9206.0], [6137.0, 9331.0], [6003.0, 9331.0]], "score": 0.8243935108184814, "text": "O"}, {"orientation_angle": 0, "polygon": [[5977.0, 9367.0], [6252.0, 9323.0], [6284.0, 9527.0], [6009.0, 9571.0]], "score": 0.6567531824111938, "text": "S0"}], "page": 27, "pdf": "63ebd08aede2a73e4f0a814b__63ebd08aede2a73e4f0a814b.pdf", "skew_angle": 0.0}