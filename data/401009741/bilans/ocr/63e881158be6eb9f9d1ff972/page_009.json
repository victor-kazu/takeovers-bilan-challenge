0, 865.0], [212.0, 862.0]], "score": 0.990533173084259, "text": "récupérables par l'entité auprès des administrations fiscales, ainsi que les frais de transport, de manutention et autres coûts directement"}, {"orientation_angle": 0, "polygon": [[212.0, 876.0], [2241.0, 879.0], [2241.0, 915.0], [212.0, 912.0]], "score": 0.9891602993011475, "text": "attribuables au coút de revient des matières premières, des marchandises, des encours de production et des produits finis. Les rabais"}, {"orientation_angle": 0, "polygon": [[210.0, 925.0], [2127.0, 927.0], [2127.0, 966.0], [210.0, 965.0]], "score": 0.9949501752853394, "text": "commerciaux, remises, escomptes de règlement et autres éléments similaires sont déduits pour déterminer les coûts d'acquisition."}, {"orientation_angle": 0, "polygon": [[212.0, 1025.0], [2237.0, 1026.0], [2237.0, 1066.0], [212.0, 1064.0]], "score": 0.9883014559745789, "text": "Les produits fabriqués sont valorisés au coût de production comprenant les consommations, les charges directes et indirectes de"}, {"orientation_angle": 0, "polygon": [[212.0, 1076.0], [2241.0, 1078.0], [2241.0, 1114.0], [212.0, 1112.0]], "score": 0.9936650991439819, "text": "production, les amortissements des biens concourant à la production. Le coût de la sous activité est exclu de la valeur des stocks. Les"}, {"orientation_angle": 0, "polygon": [[214.0, 1127.0], [956.0, 1127.0], [956.0, 1162.0], [214.0, 1162.0]], "score": 0.9945261478424072, "text": "intérêts sont exclus pour la valorisation des stocks."}, {"orientation_angle": 0, "polygon": [[212.0, 1225.0], [2242.0, 1229.0], [2242.0, 1264.0], [212.0, 1261.0]], "score": 0.9975054860115051, "text": "Les stocks sont évalués suivant la méthode du premier entré, premier sorti. Pour des raisons pratiques et sauf écart significatif, le dernier"}, {"orientation_angle": 0, "polygon": [[214.0, 1276.0], [677.0, 1276.0], [677.0, 1311.0], [214.0, 1311.0]], "score": 0.983137309551239, "text": "prix d'achat connu a été retenu."}, {"orientation_angle": 0, "polygon": [[210.0, 1374.0], [2241.0, 1378.0], [2241.0, 1414.0], [210.0, 1410.0]], "score": 0.9887786507606506, "text": "Une dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités indiquées ci-dessus et le cours du"}, {"orientation_angle": 0, "polygon": [[207.0, 1422.0], [2241.0, 1426.0], [2241.0, 1465.0], [207.0, 1461.0]], "score": 0.9956220984458923, "text": "jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est prise en compte lorsque cette valeur brute est"}, {"orientation_angle": 0, "polygon": [[212.0, 1474.0], [718.0, 1474.0], [718.0, 1513.0], [212.0, 1513.0]], "score": 0.9972373843193054, "text": "supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[210.0, 1585.0], [443.0, 1585.0], [443.0, 1638.0], [210.0, 1638.0]], "score": 0.9998071193695068, "text": "Créances"}, {"orientation_angle": 0, "polygon": [[208.0, 1695.0], [2242.0, 1698.0], [2242.0, 1739.0], [208.0, 1736.0]], "score": 0.996021568775177, "text": "Les créances sont valorisées à leur valeur nominale. Une dépréciation est pratiquée lorsque la valeur d'inventaire est inférieure à la valeur"}, {"orientation_angle": 0, "polygon": [[208.0, 1746.0], [382.0, 1746.0], [382.0, 1789.0], [208.0, 1789.0]], "score": 0.9999438524246216, "text": "comptable."}, {"orientation_angle": 0, "polygon": [[210.0, 1857.0], [942.0, 1859.0], [942.0, 1912.0], [210.0, 1910.0]], "score": 0.9902458190917969, "text": "Frais d'émission des emprunts"}, {"orientation_angle": 0, "polygon": [[208.0, 1965.0], [1710.0, 1969.0], [1710.0, 2015.0], [208.0, 2011.0]], "score": 0.9954258799552917, "text": "Les frais d'émission des emprunts sont pris en compte immédiatement dans les charges de l'exercice."}, {"orientation_angle": 0, "polygon": [[212.0, 2080.0], [1025.0, 2082.0], [1025.0, 2135.0], [212.0, 2133.0]], "score": 0.995427668094635, "text": "Produits et charges exceptionnels"}, {"orientation_angle": 0, "polygon": [[210.0, 2191.0], [2020.0, 2197.0], [2020.0, 2238.0], [210.0, 2232.0]], "score": 0.9861018657684326, "text": "Les produits et charges exceptionnels tiennent compte des éléments qui ne sont pas liés à l'activité normale de l'entreprise."}, {"orientation_angle": 0, "polygon": [[212.0, 2304.0], [1104.0, 2308.0], [1104.0, 2361.0], [212.0, 2358.0]], "score": 0.9826174378395081, "text": "Crédit d'impôt compétitivité et emploi"}, {"orientation_angle": 0, "polygon": [[210.0, 2416.0], [2235.0, 2421.0], [2235.0, 2460.0], [210.0, 2455.0]], "score": 0.9909960031509399, "text": "Conformément à la recommandation de l'Autorité des normes comptables, le produit du crédit d'impôt compétitivité emploi (CiCE)"}, {"orientation_angle": 0, "polygon": [[210.0, 2467.0], [2103.0, 2469.0], [2103.0, 2510.0], [210.0, 2508.0]], "score": 0.9891469478607178, "text": "correspondant à l'exercice pour un montant de 16 331 euros a été porté au crédit du compte 649 - Charges de personnel - CICE."}, {"orientation_angle": 0, "polygon": [[212.0, 2568.0], [1660.0, 2570.0], [1660.0, 2606.0], [212.0, 2604.0]], "score": 0.995492160320282, "text": "Ce produit du CiCE comptabilisé à la date de clôture vient en diminution des charges d'exploitation"}, {"orientation_angle": 0, "polygon": [[212.0, 2668.0], [2239.0, 2671.0], [2239.0, 2707.0], [212.0, 2704.0]], "score": 0.9899278879165649, "text": "Le montant de la créance du CiCE définitif au titre de l'année civile 2018 est imputé sur l'impôt sur les sociétés dù au titre de cet exercice"}, {"orientation_angle": 0, "polygon": [[212.0, 2717.0], [1938.0, 2721.0], [1937.0, 2757.0], [212.0, 2753.0]], "score": 0.9863377809524536, "text": "alors que le CiCE théorique couru à la date de clôture sera imputable sur l'impôt sur les sociétés de l'exercice suivant."}, {"orientation_angle": 0, "polygon": [[1994.0, 3311.0], [2143.0, 3316.0], [2141.0, 3378.0], [1992.0, 3373.0]], "score": 0.987126886844635, "text": "Page"}, {"orientation_angle": 1, "polygon": [[2137.0, 3315.0], [2149.0, 3315.0], [2149.0, 3327.0], [2137.0, 3327.0]], "score": 0.7611770629882812, "text": ".", "text_original": "5"}, {"orientation_angle": 0, "polygon": [[2173.0, 3313.0], [2210.0, 3316.0], [2206.0, 3368.0], [2168.0, 3364.0]], "score": 0.9990744590759277, "text": "7"}, {"orientation_angle": 0, "polygon": [[482.0, 3336.0], [899.0, 3336.0], [899.0, 3360.0], [482.0, 3360.0]], "score": 0.9606048464775085, "text": "CERFRANCE MIDI MEDITERRANEE"}, {"orientation_angle": 0, "polygon": [[992.0, 3336.0], [1671.0, 3336.0], [1671.0, 3360.0], [992.0, 3360.0]], "score": 0.8378556966781616, "text": "638 Avenue DE la liBeration 13160 Chateaurenard"}, {"orientation_angle": 0, "polygon": [[1739.0, 3334.0], [1956.0, 3334.0], [1956.0, 3363.0], [1739.0, 3363.0]], "score": 0.9881055951118469, "text": "Tél. 04 90 26 30 23"}, {"orientation_angle": 0, "polygon": [[160.0, 3389.0], [361.0, 3384.0], [362.0, 3420.0], [161.0, 3425.0]], "score": 0.9998171329498291, "text": "CERFRANCE"}], "page": 9, "pdf": "CA_401009741_8401_1995B40188_2019_14556__63e881158be6eb9f9d1ff972.pdf", "skew_angle": 0.0}