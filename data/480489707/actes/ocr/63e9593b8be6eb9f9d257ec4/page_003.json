{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[325.0, 116.0], [392.0, 116.0], [392.0, 188.0], [325.0, 188.0]], "score": 0.12255796045064926, "text": "-"}, {"orientation_angle": 0, "polygon": [[808.0, 1074.0], [2601.0, 1059.0], [2603.0, 1208.0], [809.0, 1223.0]], "score": 0.9996074438095093, "text": "TROISIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[799.0, 1396.0], [6117.0, 1367.0], [6118.0, 1526.0], [799.0, 1555.0]], "score": 0.9930728077888489, "text": "L'assemblée générale, prenant acte de la démission de Monsieur Xavier AUMONT de son"}, {"orientation_angle": 0, "polygon": [[813.0, 1565.0], [6113.0, 1540.0], [6113.0, 1690.0], [814.0, 1714.0]], "score": 0.9902550578117371, "text": "mandat de président à compter de ce jour, nomme en qualité de nouveau président, pour une"}, {"orientation_angle": 0, "polygon": [[808.0, 1724.0], [2061.0, 1713.0], [2062.0, 1877.0], [809.0, 1888.0]], "score": 0.9992731809616089, "text": "période indéterminée"}, {"orientation_angle": 0, "polygon": [[813.0, 2041.0], [3774.0, 2036.0], [3774.0, 2185.0], [813.0, 2190.0]], "score": 0.993894636631012, "text": "Monsieur Malik GUELLATI, Directeur commercial,"}, {"orientation_angle": 0, "polygon": [[813.0, 2210.0], [4587.0, 2200.0], [4587.0, 2349.0], [813.0, 2359.0]], "score": 0.9878504872322083, "text": "Né à VERDUN ( MEUSE ) le 13/09/1965, de nationalité française,"}, {"orientation_angle": 0, "polygon": [[813.0, 2374.0], [4018.0, 2359.0], [4018.0, 2517.0], [814.0, 2532.0]], "score": 0.9849357604980469, "text": "Demeurant 15 rue de la République , 31330 GRENADE,"}, {"orientation_angle": 0, "polygon": [[818.0, 2696.0], [3199.0, 2681.0], [3200.0, 2840.0], [819.0, 2855.0]], "score": 0.9803957343101501, "text": "Cette résolution est adoptée à l’unanimité."}, {"orientation_angle": 0, "polygon": [[827.0, 3033.0], [2678.0, 3023.0], [2679.0, 3172.0], [828.0, 3182.0]], "score": 0.998790442943573, "text": "QUATRIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[823.0, 3346.0], [6122.0, 3331.0], [6123.0, 3495.0], [823.0, 3510.0]], "score": 0.9961320757865906, "text": "Suivant la proposition de son président, l'Assemblée Générale nomme en qualité de Directeur"}, {"orientation_angle": 0, "polygon": [[822.0, 3515.0], [3142.0, 3499.0], [3143.0, 3663.0], [823.0, 3678.0]], "score": 0.9807578921318054, "text": "Général, pour une période indéterminée :"}, {"orientation_angle": 0, "polygon": [[828.0, 3837.0], [3654.0, 3837.0], [3654.0, 3996.0], [828.0, 3996.0]], "score": 0.9979001879692078, "text": "Monsieur Xavier AUMONT, Directeur technique,"}, {"orientation_angle": 0, "polygon": [[827.0, 4005.0], [4716.0, 3995.0], [4716.0, 4140.0], [828.0, 4150.0]], "score": 0.9863297343254089, "text": "Né à CAEN ( CALVADOS ) le 07/02/1966, de nationalité française,"}, {"orientation_angle": 0, "polygon": [[827.0, 4169.0], [4419.0, 4154.0], [4420.0, 4304.0], [828.0, 4318.0]], "score": 0.9897940158843994, "text": "Demeurant à 721 avenue de Beausoleil, 82000 MONTAUBAN,"}, {"orientation_angle": 0, "polygon": [[827.0, 4482.0], [6132.0, 4467.0], [6132.0, 4631.0], [828.0, 4646.0]], "score": 0.9867032766342163, "text": "Conformément aux dispositions des statuts, le directeur général disposera des mêmes"}, {"orientation_angle": 0, "polygon": [[832.0, 4646.0], [2994.0, 4641.0], [2994.0, 4804.0], [833.0, 4809.0]], "score": 0.9997079968452454, "text": "pouvoirs de direction que le président"}, {"orientation_angle": 0, "polygon": [[827.0, 4968.0], [4917.0, 4958.0], [4917.0, 5117.0], [828.0, 5127.0]], "score": 0.9900750517845154, "text": "En aucun cas il n'aura le droit de représenter la société à l'égard des tiers."}, {"orientation_angle": 0, "polygon": [[842.0, 5296.0], [3209.0, 5286.0], [3210.0, 5435.0], [842.0, 5445.0]], "score": 0.9660036563873291, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[842.0, 5782.0], [2664.0, 5772.0], [2665.0, 5931.0], [842.0, 5941.0]], "score": 0.9995586276054382, "text": "CINQUIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[832.0, 6099.0], [6137.0, 6090.0], [6137.0, 6253.0], [832.0, 6263.0]], "score": 0.9842827320098877, "text": "L'assemblée générale donne tous pouvoirs au porteur de copies ou d'extraits du présent"}, {"orientation_angle": 0, "polygon": [[837.0, 6273.0], [3816.0, 6253.0], [3817.0, 6412.0], [838.0, 6432.0]], "score": 0.9980236291885376, "text": "procès-verbal pour remplir toutes formalités de droit"}, {"orientation_angle": 0, "polygon": [[842.0, 6595.0], [3214.0, 6585.0], [3215.0, 6730.0], [842.0, 6740.0]], "score": 0.9797735810279846, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[832.0, 7072.0], [6137.0, 7057.0], [6137.0, 7221.0], [833.0, 7236.0]], "score": 0.9896695613861084, "text": "L'ordre du jour étant épuisé et personne ne demandant plus la parole, le président déclare la"}, {"orientation_angle": 0, "polygon": [[841.0, 7241.0], [1596.0, 7230.0], [1598.0, 7379.0], [843.0, 7390.0]], "score": 0.999043881893158, "text": "séance levée."}, {"orientation_angle": 0, "polygon": [[847.0, 7563.0], [6142.0, 7553.0], [6142.0, 7702.0], [847.0, 7712.0]], "score": 0.9882829189300537, "text": "De tout ce que dessus, il a été dressé le présent procès-verbal qui, après lecture, a été signé par"}, {"orientation_angle": 0, "polygon": [[847.0, 7721.0], [2182.0, 7732.0], [2181.0, 7866.0], [846.0, 7856.0]], "score": 0.9997302889823914, "text": "les membres du bureau."}, {"orientation_angle": 0, "polygon": [[3128.0, 8367.0], [3854.0, 8356.0], [3856.0, 8525.0], [3130.0, 8536.0]], "score": 0.9993183016777039, "text": "Le président"}, {"orientation_angle": 0, "polygon": [[5333.0, 8362.0], [6080.0, 8362.0], [6080.0, 8511.0], [5333.0, 8511.0]], "score": 0.9983705282211304, "text": "Le secrétaire"}, {"orientation_angle": 0, "polygon": [[847.0, 8381.0], [1712.0, 8381.0], [1712.0, 8516.0], [847.0, 8516.0]], "score": 0.9999111890792847, "text": "Les scrutateurs"}, {"orientation_angl