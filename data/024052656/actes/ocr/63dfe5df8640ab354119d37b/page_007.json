, 798.0]], "score": 0.9986761808395386, "text": "50 parts"}, {"orientation_angle": 0, "polygon": [[285.0, 842.0], [1032.0, 842.0], [1032.0, 881.0], [285.0, 881.0]], "score": 0.9992660880088806, "text": "Madame Akila Katoune MAHAMODRAZA,"}, {"orientation_angle": 0, "polygon": [[285.0, 886.0], [1015.0, 886.0], [1015.0, 927.0], [285.0, 927.0]], "score": 0.9851826429367065, "text": "A concurrence de cinquante parts sociales,"}, {"orientation_angle": 0, "polygon": [[287.0, 929.0], [721.0, 929.0], [721.0, 970.0], [287.0, 970.0]], "score": 0.9973966479301453, "text": "Numérotées de 51 à 100,"}, {"orientation_angle": 0, "polygon": [[283.0, 970.0], [336.0, 970.0], [336.0, 1013.0], [283.0, 1013.0]], "score": 0.9989147186279297, "text": "Ci"}, {"orientation_angle": 0, "polygon": [[1918.0, 966.0], [2083.0, 970.0], [2081.0, 1018.0], [1917.0, 1014.0]], "score": 0.9973630905151367, "text": "50 parts"}, {"orientation_angle": 0, "polygon": [[287.0, 1059.0], [1624.0, 1059.0], [1624.0, 1100.0], [287.0, 1100.0]], "score": 0.9874139428138733, "text": "Total égal au nombre de parts composant le capital social : 100 parts sociales"}, {"orientation_angle": 0, "polygon": [[288.0, 1187.0], [1188.0, 1187.0], [1188.0, 1228.0], [288.0, 1228.0]], "score": 0.9959085583686829, "text": "ARTICLE 8 : MODIFICATION PU CAPITAL SOCIAL"}, {"orientation_angle": 0, "polygon": [[287.0, 1272.0], [808.0, 1272.0], [808.0, 1319.0], [287.0, 1319.0]], "score": 0.999869167804718, "text": "8.1. Augmentation de capital"}, {"orientation_angle": 0, "polygon": [[288.0, 1361.0], [2196.0, 1361.0], [2196.0, 1402.0], [288.0, 1402.0]], "score": 0.9901139140129089, "text": "Les associés réunis extraordinairement peuvent décider d'augmenter le capital par quelque procédé que ce soit,"}, {"orientation_angle": 0, "polygon": [[290.0, 1406.0], [1271.0, 1406.0], [1271.0, 1447.0], [290.0, 1447.0]], "score": 0.999305784702301, "text": "sous réserve du respect des lois et règlements en vigueur."}, {"orientation_angle": 0, "polygon": [