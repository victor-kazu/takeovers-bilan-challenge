0], [1182.0, 1569.0], [220.0, 1569.0]], "score": 0.987041711807251, "text": "- permanence des méthodes comptables d'un exercice à l'autre,"}, {"orientation_angle": 0, "polygon": [[222.0, 1581.0], [688.0, 1581.0], [688.0, 1616.0], [222.0, 1616.0]], "score": 0.9846732020378113, "text": "- indépendance des exercices."}, {"orientation_angle": 0, "polygon": [[203.0, 1679.0], [1626.0, 1679.0], [1626.0, 1718.0], [203.0, 1718.0]], "score": 0.9852161407470703, "text": "et conformément aux règles générales d'établissement et de présentation des comptes annuels."}, {"orientation_angle": 0, "polygon": [[204.0, 1776.0], [2001.0, 1778.0], [2001.0, 1819.0], [203.0, 1818.0]], "score": 0.9931992888450623, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques."}, {"orientation_angle": 0, "polygon": [[204.0, 1877.0], [1777.0, 1879.0], [1777.0, 1920.0], [203.0, 1918.0]], "score": 0.9975075125694275, "text": "Seules sont exprimées les informations significatives. Sauf mention, les montants sont exprimés en euros."}, {"orientation_angle": 0, "polygon": [[207.0, 1994.0], [1260.0, 1994.0], [1260.0, 2045.0], [207.0, 2045.0]], "score": 0.9979420304298401, "text": "Immobilisations corporelles et incorporelles"}, {"orientation_angle": 0, "polygon": [[205.0, 2105.0], [2254.0, 2105.0], [2254.0, 2144.0], [205.0, 2144.0]], "score": 0.987859845161438, "text": "Les immobilisations corporelles et incorporelles sont évaluées à leur coût d'acquisition pour les actifs acquis à titre onéreux, à leur coût de"}, {"orientation_angle": 0, "polygon": [[205.0, 2156.0], [2099.0, 2156.0], [2099.0, 2196.0], [205.0, 2196.0]], "score": 0.992962121963501, "text": "production pour les actifs produits par l'entreprise, à leur valeur vénale pour les actifs acquis à titre gratuit et par voie d'échange."}, {"orientation_angle": 0, "polygon": [[205.0, 2256.0], [2255.0, 2256.0], [2255.0, 2295.0], [205.0, 2295.0]], "score": 0.9847880005836487, "text": "Le coût d'une immobilisation est constitué de son prix d'achat, y compris les droits de douane et taxes non récupérables, après déduction"}, {"orientation_angle": 0, "polygon": [[205.0, 2307.0], [2254.0, 2307.0], [2254.0, 2346.0], [205.0, 2346.0]], "score": 0.9819387197494507, "text": "des remises, rabais commerciaux et escomptes de règlement de tous les coûts directement attribuables engagés pour mettre l'actif en"}, {"orientation_angle": 0, "polygon": [[205.0, 2357.0], [2253.0, 2355.0], [2254.0, 2396.0], [205.0, 2398.0]], "score": 0.9916354417800903, "text": "place et en état de fonctionner selon l'utilisation prévue. Les droits de mutation, honoraires ou commissions et frais d'actes liés à"}, {"orientation_angle": 0, "polygon": [[205.0, 2408.0], [2255.0, 2408.0], [2255.0, 2447.0], [205.0, 2447.0]], "score": 0.9888903498649597, "text": "l'acquisition, sont rattachés à ce coût d'acquisition. Tous les coûts qui ne font pas partie du prix d'acquisition de l'immobilisation et qui ne"}, {"orientation_angle": 0, "polygon": [[203.0, 2459.0], [2257.0, 2456.0], [2257.0, 2495.0], [204.0, 2499.0]], "score": 0.9969133138656616, "text": "peuvent pas être rattachés directement aux coûts rendus nécessaires pour mettre l'actif en place et en état de fonctionner conformément"}, {"orientation_angle": 0, "polygon": [[205.0, 2506.0], [978.0, 2506.0], [978.0, 2545.0], [205.0, 2545.0]], "score": 0.9799378514289856, "text": "à l'utilisation prévue, sont comptabilisés en charges."}, {"orientation_angle": 0, "polygon": [[207.0, 2661.0], [482.0, 2661.0], [482.0, 2697.0], [207.0, 2697.0]], "score": 0.9999744296073914, "text": "Amortissements"}, {"orientation_angle": 0, "polygon": [[209.0, 2714.0], [1906.0, 2714.0], [1906.0, 2749.0], [209.0, 2749.0]], "score": 0.992112934589386, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire en fonction de la durée de vie prévue."}, {"orientation_angle": 0, "polygon": [[205.0, 2812.0], [850.0, 2812.0], [850.0, 2851.0], [205.0, 2851.0]], "score": 0.998070478439331, "text": "* Concessions, logiciels et brevets : 10 ans"}, {"orientation_angle": 0, "polygon": [[207.0, 2867.0], [907.0, 2867.0], [907.0, 2901.0], [207.0, 2901.0]], "score": 0.9955914616584778, "text": "* Agencements des constructions : 10 à 20 ans"}, {"orientation_angle": 0, "polygon": [[205.0, 2913.0], [766.0, 2915.0], [766.0, 2951.0], [205.0, 2949.0]], "score": 0.9737277030944824, "text": "* Installations techniques : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[205.0, 2962.0], [868.0, 2964.0], [868.0, 3000.0], [205.0, 2998.0]], "score": 0.9912192821502686, "text": "* Matériel et outillage industriels : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[204.0, 3010.0], [1290.0, 3014.0], [1290.0, 3055.0], [203.0, 3051.0]], "score": 0.9967748522758484, "text": "* Installations générales, agencements et aménagements divers : 10 ans"}, {"orientation_angle": 0, "polygon": [[205.0, 3060.0], [709.0, 3064.0], [709.0, 3105.0], [205.0, 3101.0]], "score": 0.9926201105117798, "text": "* Matériel de transport : 4 à 5 ans"}, {"orientation_angle": 0, "polygon": [[207.0, 3113.0], [699.0, 3115.0], [699.0, 3151.0], [207.0, 3149.0]], "score": 0.995110034942627, "text": "* Matériel de bureau : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[207.0, 3161.0], [658.0, 3166.0], [658.0, 3206.0], [207.0, 3200.0]], "score": 0.9784643054008484, "text": "* Matériel informatique : 3 ans"}, {"orientation_angle": 0, "polygon": [[204.0, 3210.0], [485.0, 3216.0], [484.0, 3257.0], [203.0, 3251.0]], "score": 0.9737114310264587, "text": "* Mobilier : 10 ans"}, {"orientation_angle": 0, "polygon": [[2028.0, 3324.0], [2162.0, 3335.0], [2157.0, 3399.0], [2023.0, 3387.0]], "score": 0.9996815919876099, "text": "Page"}, {"orientation_angle": 0, "polygon": [[2186.0, 3324.0], [2264.0, 3324.0], [2264.0, 3390.0], [2186.0, 3390.0]], "score": 0.9991386532783508, "text": "10"}, {"orientation_angle": 0, "polygon": [[995.0, 3351.0], [1684.0, 3349.0], [1684.0,