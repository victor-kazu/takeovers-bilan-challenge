{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[1867.0, 1383.0], [6518.0, 1440.0], [6516.0, 1581.0], [1865.0, 1524.0]], "score": 0.9709528088569641, "text": "Les fonctions de scrutateurs sont remplies par les deux"}, {"orientation_angle": 0, "polygon": [[1540.0, 1533.0], [6499.0, 1590.0], [6497.0, 1717.0], [1539.0, 1660.0]], "score": 0.9967178106307983, "text": "actionnaires, présents et acceptants, disposant tant par eux-mêmes que"}, {"orientation_angle": 0, "polygon": [[1545.0, 1674.0], [4894.0, 1698.0], [4893.0, 1839.0], [1544.0, 1815.0]], "score": 0.9991806149482727, "text": "comme mandataires, du plus grand nombre de voix."}, {"orientation_angle": 0, "polygon": [[1872.0, 1946.0], [6508.0, 2008.0], [6507.0, 2149.0], [1870.0, 2086.0]], "score": 0.9788385033607483, "text": "Le bureau ainsi conposé désigne un secrétaire qui peut ne pas être"}, {"orientation_angle": 0, "polygon": [[1545.0, 2091.0], [2380.0, 2102.0], [2378.0, 2233.0], [1544.0, 2223.0]], "score": 0.9991024136543274, "text": "actionnaire."}, {"orientation_angle": 0, "polygon": [[1872.0, 2368.0], [6508.0, 2411.0], [6507.0, 2552.0], [1870.0, 2509.0]], "score": 0.9915547966957092, "text": "Les membres du bureau ont pour mission de vérifier, certifier et"}, {"orientation_angle": 0, "polygon": [[1545.0, 2504.0], [6490.0, 2552.0], [6488.0, 2692.0], [1544.0, 2645.0]], "score": 0.989199697971344, "text": "signer la feuille de présence, de veiller à la bonne tenue des débats,"}, {"orientation_angle": 0, "polygon": [[1540.0, 2649.0], [6513.0, 2688.0], [6512.0, 2833.0], [1539.0, 2795.0]], "score": 0.9834819436073303, "text": "de régler les incidents de séance, de concrôler les votes émis et d'en"}, {"orientation_angle": 0, "polygon": [[1535.0, 2790.0], [6513.0, 2824.0], [6512.0, 2969.0], [1534.0, 2936.0]], "score": 0.9792188405990601, "text": "assurer la régularité, et de veiller à l'établissement du"}, {"orientation_angle": 0, "polygon": [[1553.0, 2946.0], [2522.0, 2931.0],