{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[1105.0, 375.0], [1312.0, 371.0], [1313.0, 419.0], [1106.0, 423.0]], "score": 0.998961329460144, "text": "BENEFICES"}, {"orientation_angle": 0, "polygon": [[339.0, 534.0], [494.0, 534.0], [494.0, 584.0], [339.0, 584.0]], "score": 0.9918607473373413, "text": "Article 40"}, {"orientation_angle": 0, "polygon": [[339.0, 635.0], [2071.0, 614.0], [2072.0, 666.0], [340.0, 686.0]], "score": 0.990705668926239, "text": "Après dotation à la réserve légale suivant les dispositions de l'article L 232-10 du Code de Commerce, il peut en"}, {"orientation_angle": 0, "polygon": [[339.0, 685.0], [2070.0, 666.0], [2070.0, 717.0], [340.0, 736.0]], "score": 0.9872756004333496, "text": "outre être prélevé sur les bénéfices par décision de l'Assemblée Générale la somme nécessaire pour servir un"}, {"orientation_angle": 0, "polygon": [[341.0, 736.0], [2070.0, 719.0], [2070.0, 765.0], [341.0, 782.0]], "score": 0.9898408055305481, "text": "intérêt net à titre de dividende statutaire sur le mantant libéré et non amorti des actions, les sommes non payées"}, {"orientation_angle": 0, "polygon": [[339.0, 787.0], [2071.0, 768.0], [2072.0, 816.0], [340.0, 835.0]], "score": 0.987381637096405, "text": "à ce titre au cours d’un exercice en l'absence de bénéfice étant reportées sur l'exercice ou les exercices"}, {"orientation_angle": 0, "polygon": [[339.0, 837.0], [489.0, 837.0], [489.0, 885.0], [339.0, 885.0]], "score": 0.9539843797683716, "text": "suivants."}, {"orientation_angle": 0, "polygon": [[341.0, 936.0], [2073.0, 915.0], [2074.0, 967.0], [341.0, 988.0]], "score": 0.9817585945129395, "text": "Il ne peut y avoir aucune distribution de bénéfice si celle-ci a pour effet de porter l'actif net de la Société à un"}, {"orientation_angle": 0, "polygon": [[341.0, 986.0], [2075.0, 967.0], [2075.0, 1018.0], [341.0, 1037.0]], "score": 0.9942428469657898, "text": "montant inférieur au capital social augmenté des réserves légales et des réserves qui ne peuvent statutairement"}, {"orientation_angle": 0, "polygon": [[342.0, 1039.0], [601.0, 1035.0], [601.0, 1083.0], [343.0, 1087.0]], "score": 0.9886263608932495, "text": "être distribuées."}, {"orientation_angle": 0, "polygon": [[344.0, 1138.0], [2073.0, 1117.0], [2074.0, 1165.0], [345.0, 1186.0]], "score": 0.994056224822998, "text": "L'excédent sera affecté, suivant les décisions de l'Assemblée Générale, à la constitution de réserves destinées"}, {"orientation_angle": 0, "polygon": [[346.0, 1188.0], [1966.0, 1170.0], [1967.0, 1218.0], [347.0, 1236.0]], "score": 0.9901596307754517, "text": "notamment à permettre le financement d'opération d'intérêt général entrant dans le cadre de l'objet social."}, {"orientation_angle": 0, "polygon": [[1112.0, 1376.0], [1315.0, 1372.0], [1316.0, 1427.0], [1113.0, 1431.0]], "score": 0.9984716773033142, "text": "TITRE VII"}, {"orientation_angle": 0, "polygon": [[968.0, 1546.0], [1464.0, 1540.0], [1464.0, 1586.0], [968.0, 1592.0]], "score": 0.9956907629966736, "text": "DISSOLUTION - LIQUIDATION"}, {"orientation_angle": 0, "polygon": [[1097.0, 1693.0], [1338.0, 1689.0], [1338.0, 1737.0], [1098.0, 1741.0]], "score": 0.9995277523994446, "text": "DISSOLUTION"}, {"orientation_angle": 0, "polygon": [[351.0, 1850.0], [766.0, 1845.0], [767.0, 1891.0], [352.0, 1896.0]], "score": 0.9883809685707092, "text": "Article 41 : DISSOLUTION"}, {"orientation_angle": 0, "polygon": [[351.0, 1955.0], [2080.0, 1932.0], [2081.0, 1983.0], [352.0, 2006.0]], "score": 0.9932029843330383, "text": "Après dissolution de la Société, il ne peut être apposé de scellés ni exigé d'autres Inventaires que ceux faits en"}, {"orientation_angle": 0, "polygon": [[351.0, 2006.0], [707.0, 2000.0], [708.0, 2047.0], [352.0, 2052.0]], "score": 0.9985349178314209, "text": "conformité des statuts."}, {"orientation_angle": 0, "polygon": [[1105.0, 2098.0], [1334.0, 2095.0], [1335.0, 2142.0], [1106.0, 2146.0]], "score": 0.9993419647216797, "text": "LIQUIDATION"}, {"orientation_angle": 0, "polygon": [[352.0, 2256.0], [510.0, 2250.0], [512.0, 2305.0], [355.0, 2311.0]], "score": 0.990660548210144, "text": "Article 42"}, {"orientation_angle": 0, "polygon": [[356.0, 2357.0], [2084.0, 2338.0], [2084.0, 2386.0], [357.0, 2405.0]], "score": 0.9908018708229065, "text": "A l'expiration de la société, ou en cas de dissolution anticipée, l'Assemblée Générale règle, sur proposition du"}, {"orientation_angle": 0, "polygon": [[356.0, 2406.0], [2082.0, 2389.0], [2082.0, 2435.0], [357.0, 2453.0]], "score": 0.9885334968566895, "text": "Directeur Général et du Conseil d’Administration le mode de liquidation et nomme un ou plusieurs liquidateurs"}, {"orientation_angle": 0, "polygon": [[356.0, 2458.0], [862.0, 2452.0], [863.0, 2499.0], [357.0, 2504.0]], "score": 0.9857272505760193, "text": "dont elle détermine les pouvoirs."}, {"orientation_angle": 0, "polygon": [[360.0, 2557.0], [1755.0, 2541.0], [1755.0, 2588.0], [360.0, 2603.0]], "score": 0.9907460808753967, "text": "La nomination d'un liquidateur met fin aux fonctions des membres de la Direction Générale."}, {"orientation_angle": 0, "polygon": [[1197.0, 3147.0], [1261.0, 3147.0], [1261.0, 3200.0], [1197.0, 3200.0]], "score": 0.9999434351921082, "text": "22"}], "page": 29, "pdf": "66739509ea3633ddee02c192__66739509ea3633ddee02c192.pdf", "skew_angle": 0.9658533197587135}