 1475.0], [215.0, 1475.0]], "score": 0.9874312877655029, "text": "-continuité de l'exploitation,"}, {"orientation_angle": 0, "polygon": [[215.0, 1488.0], [1174.0, 1482.0], [1174.0, 1524.0], [215.0, 1529.0]], "score": 0.9976991415023804, "text": "- permanence des méthodes comptables d'un exercice à l'autre,"}, {"orientation_angle": 0, "polygon": [[216.0, 1536.0], [687.0, 1534.0], [687.0, 1575.0], [216.0, 1577.0]], "score": 0.9811691045761108, "text": "- indépendance des exercices."}, {"orientation_angle": 0, "polygon": [[199.0, 1638.0], [1619.0, 1632.0], [1619.0, 1674.0], [199.0, 1679.0]], "score": 0.9991267919540405, "text": "et conformément aux règles générales d'établissement et de présentation des comptes annuels."}, {"orientation_angle": 0, "polygon": [[199.0, 1736.0], [1990.0, 1732.0], [1990.0, 1774.0], [199.0, 1777.0]], "score": 0.9886437654495239, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques."}, {"orientation_angle": 0, "polygon": [[199.0, 1836.0], [1766.0, 1833.0], [1766.0, 1874.0], [199.0, 1877.0]], "score": 0.9957335591316223, "text": "Seules sont exprimées les informations significatives. Sauf mention, les montants sont exprimés en euros."}, {"orientation_angle": 0, "polygon": [[199.0, 1950.0], [1255.0, 1946.0], [1255.0, 2003.0], [199.0, 2007.0]], "score": 0.9976658225059509, "text": "Immobilisations corporelles et incorporelles"}, {"orientation_angle": 0, "polygon": [[199.0, 2062.0], [2242.0, 2057.0], [2242.0, 2097.0], [199.0, 2102.0]], "score": 0.9931083917617798, "text": "Les immobilisations corporelles et incorporelles sont évaluées à leur coût d'acquisition pour les actifs acquis à titre onéreux, à leur coût de"}, {"orientation_angle": 0, "polygon": [[199.0, 2110.0], [2087.0, 2105.0], [2088.0, 2152.0], [199.0, 2157.0]], "score": 0.997170627117157, "text": "production pour les actifs produits par l'entreprise, à leur valeur vénale pour les actifs acquis à titre gratuit et par voie d'échange."}, {"orientation_angle": 0, "polygon": [[199.0, 2212.0], [2242.0, 2207.0], [2242.0, 2248.0], [199.0, 2254.0]], "score": 0.9923603534698486, "text": "Le coût d'une immobilisation est constitué de son prix d'achat, y compris les droits de douane et taxes non récupérables, après déduction"}, {"orientation_angle": 0, "polygon": [[199.0, 2264.0], [2240.0, 2257.0], [2240.0, 2298.0], [199.0, 2305.0]], "score": 0.9903389811515808, "text": "des remises, rabais commerciaux et escomptes de règlement de tous les coûts directement attribuables engagés pour mettre l'actif en"}, {"orientation_angle": 0, "polygon": [[201.0, 2314.0], [2240.0, 2307.0], [2240.0, 2347.0], [201.0, 2354.0]], "score": 0.9875364303588867, "text": "place et en état de fonctionner selon l'utilisation prévue. Les droits de mutation, honoraires ou commissions et frais d'actes liés à"}, {"orientation_angle": 0, "polygon": [[199.0, 2362.0], [2242.0, 2357.0], [2242.0, 2397.0], [199.0, 2402.0]], "score": 0.9879989624023438, "text": "l'acquisition, sont rattachés à ce coût d'acquisition. Tous les coûts qui ne font pas partie du prix d'acquisition de l'immobilisation et qui ne"}, {"orientation_angle": 0, "polygon": [[199.0, 2414.0], [2244.0, 2405.0], [2244.0, 2447.0], [199.0, 2456.0]], "score": 0.9955342411994934, "text": "peuvent pas être rattachés directement aux coûts rendus nécessaires pour mettre l'actif en place et en état de fonctionner conformément"}, {"orientation_angle": 0, "polygon": [[203.0, 2468.0], [970.0, 2468.0], [970.0, 2502.0], [203.0, 2502.0]], "score": 0.9966313242912292, "text": "à l'utilisation prévue, sont comptabilisés en charges."}, {"orientation_angle": 0, "polygon": [[199.0, 2614.0], [1893.0, 2609.0], [1894.0, 2649.0], [199.0, 2654.0]], "score": 0.9939655065536499, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire en fonction de la durée de vie prévue."}, {"orientation_angle": 0, "polygon": [[199.0, 2716.0], [903.0, 2714.0], [903.0, 2756.0], [199.0, 2758.0]], "score": 0.9800992608070374, "text": "* Agencements des constructions : 10 à 20 ans"}, {"orientation_angle": 0, "polygon": [[199.0, 2764.0], [761.0, 2766.0], [760.0, 2806.0], [199.0, 2804.0]], "score": 0.9845658540725708, "text": "* Installations techniques : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[199.0, 2818.0], [862.0, 2818.0], [862.0, 2858.0], [199.0, 2858.0]], "score": 0.9781119227409363, "text": "* Matériel et outillage industriels : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[199.0, 2866.0], [1279.0, 2863.0], [1279.0, 2906.0], [199.0, 2909.0]], "score": 0.9958071112632751, "text": "* Installations générales, agencements et aménagements divers : 10 ans"}, {"orientation_angle": 0, "polygon": [[199.0, 2916.0], [700.0, 2918.0], [700.0, 2954.0], [199.0, 2952.0]], "score": 0.9961567521095276, "text": "* Matériel de transport : 4 à 5 ans"}, {"orientation_angle": 0, "polygon": [[201.0, 2968.0], [692.0, 2968.0], [692.0, 3003.0], [201.0, 3003.0]], "score": 0.9932048916816711, "text": "* Matériel de bureau : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[199.0, 3014.0], [652.0, 3018.0], [652.0, 3060.0], [199.0, 3056.0]], "score": 0.9921959638595581, "text": "* Matériel informatique : 3 ans"}, {"orientation_angle": 0, "polygon": [[199.0, 3066.0], [476.0, 3070.0], [475.0, 3106.0], [199.0, 3102.0]], "score": 0.9931372404098511, "text": "* Mobilier : 10 ans"}, {"orientation_angle": 0, "polygon": [[201.0, 3170.0], [1959.0, 3165.0], [1959.0, 3204.0], [201.0, 3210.0]], "score": 0.9946785569190979, "text": "La durée d'amortissement retenue par simplification est la durée d'usage pour les biens non décomposables à l'origine."}, {"orientation_angle": 0, "polygon": [[201.0, 3220.0], [2240.0, 3213.0], [2240.0, 3253.0], [201.0, 3260.0]], "score": 0.9930973052978516, "text": "L'entreprise a apprécié à la date de clôture, en considérant les informations internes et externes à sa disposition, l'existence d'indices"}, {"orientation_angle": 0, "polygon": [[1919.0, 3256.0], [2041.0, 3256.0], [2041.0, 3348.0], [1919.0, 3348.0]], "score": 0.6534568667411804, "text": "sfC"}, {"orientation_angle": 0, "polygon": [[927.0, 3346.0], [1175.0, 3342.0], [1176.0, 3392.0], [928.0, 3396.0]], "score": 0.9676563739776611, "text": "Page 52 /67"}, {"orientation_angle": 0, "polygon": [[1006.0, 3420.0], [1483.0, 3420.0], [1483.0, 3455.0], [1006.0, 3455.0]], "score": 0.9824889898300171, "text": "Voir rapport de l'expert comptable"}], "page": 6, "pdf": "CA_328024377_6901_1983B01173_2021_B2021051128__63e8ebbb54febda17c19ee7d.pdf", "skew_angle": 0.0}