23.0, 4613.0], [772.0, 4603.0]], "score": 0.9978869557380676, "text": "Marié sous le régime de la séparation de biens à Muriel JOUSSAUME DE LA BRETESCHE de nationalité"}, {"orientation_angle": 0, "polygon": [[769.0, 4602.0], [1320.0, 4614.0], [1317.0, 4764.0], [766.0, 4752.0]], "score": 0.9976417422294617, "text": "Française,"}, {"orientation_angle": 0, "polygon": [[767.0, 4884.0], [5706.0, 4894.0], [5706.0, 5039.0], [767.0, 5029.0]], "score": 0.9876826405525208, "text": "ont établi, ainsi qu'il suit, les statuts de la société anonyme simplifiée qu’il ont décidé d'instituer."}, {"orientation_angle": 0, "polygon": [[777.0, 5320.0], [1899.0, 5320.0], [1899.0, 5450.0], [777.0, 5450.0]], "score": 0.97007155418396, "text": "ARTICLE 1 - FORME"}, {"orientation_angle": 0, "polygon": [[768.0, 5595.0], [5328.0, 5610.0], [5327.0, 5750.0], [767.0, 5736.0]], "score": 0.9951191544532776, "text": "Il est formé par les associés sus-dénommés une société par actions simplifiée régie par :"}, {"orientation_angle": 0, "polygon": [[768.0, 5876.0], [5706.0, 5896.0], [5706.0, 6041.0], [767.0, 6021.0]], "score": 0.985454261302948, "text": "- les dispositions des articles L. 227-1 à L. 227-20 et L. 244-1 à L. 244-4 du Code de commerce;"}, {"orientation_angle": 0, "polygon": [[772.0, 6166.0], [5965.0, 6186.0], [5965.0, 6317.0], [772.0, 6297.0]], "score": 0.9930447936058044, "text": "- dans la mesure où elles sont compatibles avec les dispositions particulières aux sociétés par actions"}, {"orientation_angle": 0, "polygon": [[767.0, 6307.0], [5913.0, 6317.0], [5912.0, 6462.0], [767.0, 6452.0]], "score": 0.9889552593231201, "text": "simplifiées, les dispositions relatives aux sociétés anonymes, à l'exception des articles L. 225-17 à L."}, {"orientation_angle": 0, "polygon": [[767.0, 6447.0], [6023.0, 6462.0], [6022.0, 6607.0], [767.0, 6592.0]], "score": 0.9863699674606323, "text": "225-126 du Code de commerce et les dispositions générales relatives à toute société des articles 1832"}, {"orientation_angle": 0, "polygon": [[768.0, 6587.0], [2029.0, 6603.0], [2027.0, 6738.0], [767.0, 6723.0]], "score": 0.9906482696533203, "text": "à 1844-17 du Code civil;"}, {"orientation_angle": 0, "polygon": [[777.0, 6888.0], [2733.0, 6888.0], [2733.0, 7018.0], [777.0, 7018.0]], "score": 0.9941437840461731, "text": "- les dispositions des présents statuts."}, {"orientation_angle": 0, "polygon": [[772.0, 7159.0], [4196.0, 7164.0], [4196.0, 7309.0], [772.0, 7304.0]], "score": 0.9859631061553955, "text": "Elle fonctionne sous la même forme avec un ou plusieurs associés."}, {"orientation_angle": 0, "polygon": [[777.0, 7599.0], [1846.0, 7599.0], [1846.0, 7715.0], [777.0, 7715.0]], "score": 0.9956586360931396, "text": "ARTICLE 2 - OBJET"}, {"orientation_angle": 0, "polygon": [[768.0, 7865.0], [4968.0, 7880.0], [4967.0, 8025.0], [767.0, 8011.0]], "score": 0.9916274547576904, "text": "La présente société par actions simplifiée a pour objet, en France et à l'étranger :"}, {"orientation_angle": 0, "polygon": [[1185.0, 8015.0], [5697.0, 8030.0], [5696.0, 8166.0], [1184.0, 8151.0]], "score": 0.9936694502830505, "text": "l’ingénierie, la conception, la fabrication et la maintenance de systèmes de sonorisation,"}, {"orientation_angle": 0, "polygon": [[1180.0, 8156.0], [5980.0, 8171.0], [5979.0, 8306.0], [1179.0, 8291.0]], "score": 0.9817267060279846, "text": "d’interphonie, de vidéo, de contrôle d‘accès, de Gestion Technique Centralisée, et de logiciels"}, {"orientation_angle": 0, "polygon": [[1189.0, 8301.0], [2369.0, 8301.0], [2369.0, 8432.0], [1189.0, 8432.0]], "score": 0.978249192237854, "text": "dédiés à ces fonctions."}, {"orientation_angle": 0, "polygon": [[1180.0, 8432.0], [5922.0, 8447.0], [5922.0, 8597.0], [1179.0, 8582.0]], "score": 0.99455726146698, "text": "le négoce de matériels composants électriques, électroniques, et appareillages industriels et"}, {"orientation_angle": 0, "polygon": [[1180.0, 8577.0], [1803.0, 8577.0], [1803.0, 8727.0], [1180.0, 8727.0]], "score": 0.9788979291915894, "text": "de logiciels."}, {"orientation_angle": 0, "polygon": [[1175.0, 8717.0], [5893.0, 8732.0], [5893.0, 8877.0], [1175.0, 8863.0]], "score": 0.9893494248390198, "text": "La distribution de produits, marchandises et procédés dans les domaines de la sonorisation,"}, {"orientation_angle": 0, "polygon": [[1185.0, 8867.0], [5188.0, 8872.0], [5188.0, 9003.0], [1184.0, 8998.0]], "score": 0.9836563467979431, "text": "l‘interphonie, la vidéo, le contrôle d’accès et la Gestion Technique Centralisée."}, {"orientation_angle": 0, "polygon": [[232.0, 9178.0], [611.0, 9145.0], [656.0, 9670.0], [276.0, 9703.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[777.0, 9352.0], [1913.0, 9352.0], [1913.0, 9453.0], [777.0, 9453.0]], "score": 0.98686683177948, "text": "Statuts de la SAS ARCHEAN"}, {"orientation_angle": 0, "polygon": [[5845.0, 9361.0], [6056.0, 9361.0], [6056.0, 9468.0], [5845.0, 9468.0]], "score": 0.8888084292411804, "text": "- 1 -"}, {"orientation_angle": 1, "polygon": [[17.0, 9737.0], [74.0, 9751.0], [64.0, 9789.0], [8.0, 9775.0]], "score": 0.0, "text": ""}], "page": 8, "pdf": "63e9593b8be6eb9f9d257ec7__63e9593b8be6eb9f9d257ec7.pdf", "skew_angle": 0.0}