494.0], [210.0, 1505.0]], "score": 0.9823890328407288, "text": "Elle a été transformée en Société par actions simplifiée suivant décisions de l'Assemblée Générale"}, {"orientation_angle": 0, "polygon": [[212.0, 1513.0], [909.0, 1510.0], [909.0, 1553.0], [212.0, 1556.0]], "score": 0.993863582611084, "text": "Extraordinaire du 31 décembre 2014."}, {"orientation_angle": 0, "polygon": [[212.0, 1676.0], [2208.0, 1666.0], [2208.0, 1712.0], [212.0, 1722.0]], "score": 0.9741160869598389, "text": "Elle se poursuit et continue d'exister entre les associés sous la forme d'une Société par Actions Simplifiée"}, {"orientation_angle": 0, "polygon": [[212.0, 1734.0], [2209.0, 1722.0], [2210.0, 1768.0], [212.0, 1780.0]], "score": 0.9763702750205994, "text": "régie notamment par le chapitre VIl du Titre 2 du Livre deuxième du Code de Commerce et les règlements"}, {"orientation_angle": 0, "polygon": [[210.0, 1789.0], [1056.0, 1785.0], [1056.0, 1832.0], [210.0, 1835.0]], "score": 0.9969065189361572, "text": "en vigueur, ainsi que par les présents statuts."}, {"orientation_angle": 0, "polygon": [[212.0, 1899.0], [542.0, 1899.0], [542.0, 1945.0], [212.0, 1945.0]], "score": 0.9588210582733154, "text": "Article 2 - Objet :"}, {"orientation_angle": 0, "polygon": [[210.0, 2012.0], [1140.0, 2006.0], [1140.0, 2054.0], [210.0, 2060.0]], "score": 0.9829296469688416, "text": "La société a pour objet, en France et à l'étranger :"}, {"orientation_angle": 0, "polygon": [[210.0, 2125.0], [2211.0, 2114.0], [2211.0, 2159.0], [210.0, 2169.0]], "score": 0.9860131144523621, "text": "La création et l’exploitation d'un fonds d'industrie et de fabrication de produits de confiserie et plus"}, {"orientation_angle": 0, "polygon": [[212.0, 2181.0], [2209.0, 2169.0], [2210.0, 2215.0], [212.0, 2227.0]], "score": 0.9879781603813171, "text": "particulièrement de nougats, ainsi qu'accessoirement de viennoiserie, de chocolaterie et d'une manière"}, {"orientation_angle": 0, "polygon": [[210.0, 2236.0], [2209.0, 2224.0], [2210.0, 2270.0], [210.0, 2282.0]], "score": 0.9920082688331604, "text": "générale de toute activité de transformation et de négoce ayant trait à l'agroalimentaire, aux activités de"}, {"orientation_angle": 0, "polygon": [[212.0, 2292.0], [2209.0, 2280.0], [2210.0, 2326.0], [212.0, 2339.0]], "score": 0.9865737557411194, "text": "pâtisserie, d'organisation d'évènements touristiques et de gestion de sociétés ayant pour objet la"}, {"orientation_angle": 0, "polygon": [[212.0, 2351.0], [1257.0, 2340.0], [1257.0, 2386.0], [212.0, 2397.0]], "score": 0.9910055994987488, "text": "promotion des marques et savoir-faire de CREAMANDE."}, {"orientation_angle": 0, "polygon": [[210.0, 2462.0], [1545.0, 2451.0], [1545.0, 2498.0], [210.0, 2508.0]], "score": 0.9984573721885681, "text": "Les prestations de services, travaux et conseil dans le domaine agricole."}, {"orientation_angle": 0, "polygon": [[208.0, 2515.0], [1428.0, 2508.0], [1428.0, 2556.0], [209.0, 2563.0]], "score": 0.9920182228088379, "text": "Toutes opérations industrielles et commerciales se rapportant à :"}, {"orientation_angle": 0, "polygon": [[210.0, 2571.0], [2211.0, 2561.0], [2211.0, 2607.0], [210.0, 2618.0]], "score": 0.9879357814788818, "text": "- la création, l'acquisition, la location, la prise en location-gérance de tous fonds de commerce, la prise à"}, {"orientation_angle": 0, "polygon": [[210.0, 2628.0], [2209.0, 2619.0], [2210.0, 2665.0], [210.0, 2674.0]], "score": 0.9914699196815491, "text": "bail, l'installation, l’exploitation de tous établissements, fonds de commerce, usines, ateliers, se rapportant"}, {"orientation_angle": 0, "polygon": [[208.0, 2683.0], [1169.0, 2679.0], [1169.0, 2725.0], [209.0, 2729.0]], "score": 0.9783582091331482, "text": "à l’une ou l'autre des activités spécifiées ci-dessus ;"}, {"orientation_angle": 0, "polygon": [[210.0, 2739.0], [2209.0, 2729.0], [2210.0, 2775.0], [210.0, 2785.0]], "score": 0.9882057905197144, "text": "- la prise, l'acquisition, l'exploitation ou la cession