{"layout": [{"bbox": [285.33740234375, 926.587158203125, 2179.02392578125, 1102.670654296875], "label": "text", "score": 0.9787711501121521, "texts": [{"orientation_angle": 0, "polygon": [[292.0, 932.0], [2184.0, 927.0], [2184.0, 972.0], [293.0, 977.0]], "score": 0.9930851459503174, "text": "Monsieur Mo KALFANE et Monsieur Al KALFANE, gérants non associés de la société CONSEIL ET AUDIT"}, {"orientation_angle": 0, "polygon": [[296.0, 973.0], [2180.0, 973.0], [2180.0, 1015.0], [296.0, 1015.0]], "score": 0.992455780506134, "text": "MAYOTTE OCEAN INDIEN, ont, en vue de l'approbation des comptes de l'exercice clos le 31 décembre 2017,"}, {"orientation_angle": 0, "polygon": [[292.0, 1020.0], [2184.0, 1016.0], [2184.0, 1057.0], [293.0, 1061.0]], "score": 0.9884677529335022, "text": "par la société S.K2.R., établi le présent rapport de gestion sur la situation et l'activité de la Société durant"}, {"orientation_angle": 0, "polygon": [[291.0, 1061.0], [590.0, 1064.0], [590.0, 1106.0], [291.0, 1102.0]], "score": 0.9923698902130127, "text": "l'exercice écoulé."}]}, {"bbox": [285.753662109375, 2869.76904296875, 2180.492919921875, 2955.10400390625], "label": "text", "score": 0.9721368551254272, "texts": [{"orientation_angle": 0, "polygon": [[289.0, 2871.0], [2187.0, 2869.0], [2187.0, 2915.0], [289.0, 2917.0]], "score": 0.995157778263092, "text": "Il convient de souligner qu'aucun événement important n'est survenu entre la date de la clôture de l'exercice et la"}, {"orientation_angle": 0, "polygon": [[294.0, 2915.0], [882.0, 2914.0], [883.0, 2960.0], [294.0, 2962.0]], "score": 0.9991088509559631, "text": "date à laquelle le rapport est établi."}]}, {"bbox": [284.8076171875, 3135.97509765625, 2181.66015625, 3222.28076171875], "label": "text", "score": 0.9687879681587219, "texts": [{"orientation_angle": 0, "polygon": [[291.0, 3138.0], [2187.0, 3136.0], [2187.0, 3183.0], [291.0, 3184.0]], "score": 0.9879991412162781, "text": "Les objectifs pour l'exercice ouvert au 1er janvier 2018 