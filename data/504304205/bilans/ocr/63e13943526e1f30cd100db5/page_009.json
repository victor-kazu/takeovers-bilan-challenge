.0, 1919.0], [2070.0, 1953.0], [168.0, 1950.0]], "score": 0.9889108538627625, "text": "Cette colonne ne concerne que les immobilisations réévaluées, cédées au cours de l'’exercice. Il convient d'y reporter, l'année de la cession de l'élément, le solde non"}, {"orientation_angle": 0, "polygon": [[169.0, 1953.0], [770.0, 1953.0], [770.0, 1988.0], [169.0, 1988.0]], "score": 0.9909799695014954, "text": "utilisé de la marge supplémentaire d'amortissement."}, {"orientation_angle": 0, "polygon": [[93.0, 2030.0], [144.0, 2030.0], [144.0, 2075.0], [93.0, 2075.0]], "score": 0.9695107340812683, "text": "(4)"}, {"orientation_angle": 0, "polygon": [[168.0, 2035.0], [449.0, 2035.0], [449.0, 2070.0], [168.0, 2070.0]], "score": 0.9979081153869629, "text": "Ce montant comprend :"}, {"orientation_angle": 0, "polygon": [[171.0, 2076.0], [872.0, 2076.0], [872.0, 2105.0], [171.0, 2105.0]], "score": 0.9868262410163879, "text": "a) le montant total des sommes portées aux colonnes 3 et 4 ;"}, {"orientation_angle": 0, "polygon": [[168.0, 2109.0], [2070.0, 2112.0], [2070.0, 2148.0], [168.0, 2145.0]], "score": 0.9876828193664551, "text": "b) le montant cumulé à la fin de l'exercice précédent, dans la mesure où ce montant correspond à des éléments figurant à l'actif de l'entreprise au début de l'exercice."}, {"orientation_angle": 0, "polygon": [[91.0, 2165.0], [144.0, 2165.0], [144.0, 2210.0], [91.0, 2210.0]], "score": 0.9893178939819336, "text": "(5)"}, {"orientation_angle": 0, "polygon": [[166.0, 2169.0], [1849.0, 2172.0], [1849.0, 2206.0], [166.0, 2203.0]], "score": 0.9891577959060669, "text": "Le montant total de la provision spéciale en fin d'exercice est à reporter au passif du bilan (tableau n°2051) à la ligne «Provisions réglementées»."}, {"orientation_angle": 0, "polygon": [[96.0, 2302.0], [256.0, 2302.0], [256.0, 2338.0], [96.0, 2338.0]], "score": 0.9963088631629944, "text": "CADRE B"}, {"orientation_angle": 1, "polygon": [[95.0, 2346.0], [2008.0, 2352.0], [2008.0, 2396.0], [95.0, 2391.0]], "score": 0.28578025102615356, "text": "T TE T RC TI CR SIERR L RTE RTRS"}, {"orientation_angle": 1, "polygon": [[97.0, 2432.0], [1390.0, 2434.0], [1390.0, 2475.0], [96.0, 2473.0]], "score": 0.24519793689250946, "text": "IATE TT GRSS IGN"}, {"orientation_angle": 0, "polygon": [[98.0, 2509.0], [1006.0, 2509.0], [1006.0, 2548.0], [98.0, 2548.0]], "score": 0.9990398287773132, "text": "2 - FRACTION RATTACHÉE AU RÉSULTAT DE L'EXERCICE"}, {"orientation_angle": 1, "polygon": [[97.0, 2582.0], [1278.0, 2584.0], [1278.0, 2625.0], [96.0, 2623.0]], "score": 0.23022890090942383, "text": "TDGNGN ITIGE SI GAE"}, {"orientation_angle": 0, "polygon": [[2055.0, 2593.0], [2074.0, 2593.0], [2074.0, 2606.0], [2055.0, 2606.0]], "score": 0.9580236077308655, "text": "="}, {"orientation_angle": 0, "polygon": [[171.0, 2769.0], [1793.0, 2772.0], [1793.0, 2806.0], [171.0, 2803.0]], "score": 0.9930915832519531, "text": "Le cadre B est servi par les seules entreprises qui ont imputé leurs déficits fiscalement reportables au 31 décembre sur la provision spéciale."}, {"orientation_angle": 0, "polygon": [[169.0, 2844.0], [2186.0, 2847.0], [2186.0, 2881.0], [169.0, 2878.0]], "score": 0.9912002682685852, "text": "Il est rappelé que cette imputation est purement fiscale et ne modifie pas les montants de la provision spéciale figurant au bilan : de même, les entreprises en cause continuent"}, {"orientation_angle": 0, "polygon": [[171.0, 2881.0], [1497.0, 2883.0], [1497.0, 2917.0], [171.0, 2916.0]], "score": 0.9863932132720947, "text": "à réintégrer chaque année dans leur résultat comptable le supplément d'amortissement consécutif à la réévaluation."}, {"orientation_angle": 0, "polygon": [[171.0, 2957.0], [2214.0, 2960.0], [2214.0, 2994.0], [171.0, 2991.0]], "score": 0.9908443689346313, "text": "Ligne 2, inscrire la partie de ce déficit incluse chaque année dans les montants portés aux colonnes 3 et 4 du cadre A. Cette partie est obtenue en multipliant les montants portés"}, {"orientation_angle": 0, "polygon": [[171.0, 2992.0], [2270.0, 2998.0], [2270.0, 3032.0], [171.0, 3027.0]], "score": 0.9912165999412537, "text": "aux colonnes 3 et 4 par une fraction dont les éléments sont fixés au moment de l'imputation, le numérateur étant le montant du déficit imputé et le dénominateur celui de la provision."}, {"orientation_angle": 0, "polygon": [[119.0, 3052.0], [1068.0, 3054.0], [1068.0, 3088.0], [118.0, 3086.0]], "score": 0.9923402070999146, "text": "* Des explications concernant cette rubrique sont données dans la notice n° 2032."}, {"orientation_angle": 1, "polygon": [[59.0, 3122.0], [83.0, 3122.0], [83.0, 3368.0], [59.0, 3368.0]], "score": 0.982693076133728, "text": "QUADRATUS Informatique"}, {"orientation_angle": 0, "polygon": [[102.0, 3425.0], [408.0, 3427.0], [408.0, 3456.0], [102.0, 3454.0]], "score": 0.9876575469970703, "text": "Dossier N° SOMEP en Euros."}, {"orientation_angle": 0, "polygon": [[1673.0, 3426.0], [2028.0, 3428.0], [2028.0, 3457.0], [1673.0, 3456.0]], "score": 0.9932041764259338, "text": "CABINET BARD CONSULTING"}], "page": 9, "pdf": "CA_504304205_1303_2008B02193_2016_5621__63e13943526e1f30cd100db5.pdf", "skew_angle": 0.0}