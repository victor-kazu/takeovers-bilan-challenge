{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[298.0, 353.0], [890.0, 353.0], [890.0, 394.0], [298.0, 394.0]], "score": 0.9997223019599915, "text": "HUITIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[291.0, 511.0], [2144.0, 517.0], [2144.0, 569.0], [291.0, 562.0]], "score": 0.9874778389930725, "text": "L'Assemblée Générale décide que la durée de l'exercice en cours qui sera clos le 31 mars, n'a"}, {"orientation_angle": 0, "polygon": [[291.0, 569.0], [2125.0, 571.0], [2125.0, 624.0], [291.0, 622.0]], "score": 0.993782103061676, "text": "pas à être modifiée du fait de la transformation de la Société en société par actions simplifiée."}, {"orientation_angle": 0, "polygon": [[291.0, 678.0], [2144.0, 680.0], [2144.0, 732.0], [291.0, 730.0]], "score": 0.9899457693099976, "text": "Les comptes de cet exercice seront établis, présentés et contrôlés dans les conditions fixées"}, {"orientation_angle": 0, "polygon": [[289.0, 735.0], [2146.0, 737.0], [2146.0, 790.0], [289.0, 788.0]], "score": 0.9909564852714539, "text": "par les nouveaux statuts et les dispositions du Code de commerce relatives aux sociétés par"}, {"orientation_angle": 0, "polygon": [[293.0, 790.0], [675.0, 790.0], [675.0, 843.0], [293.0, 843.0]], "score": 0.9909572601318359, "text": "actions simplifiées."}, {"orientation_angle": 0, "polygon": [[288.0, 898.0], [2142.0, 901.0], [2142.0, 953.0], [288.0, 949.0]], "score": 0.9934756755828857, "text": "La gérance de la Société sous sa forme à responsabilité limitée présentera à l'Assemblée"}, {"orientation_angle": 0, "polygon": [[289.0, 953.0], [2142.0, 958.0], [2142.0, 1011.0], [289.0, 1006.0]], "score": 0.995189905166626, "text": "Générale des associés qui statuera sur ces comptes, un rapport rendant compte de sa gestion"}, {"orientation_angle": 0, "polygon": [[289.0, 1011.0], [2117.0, 1011.0], [2117.0, 1062.0], [289.0, 1062.0]], "score": 0.9945130944252014, "text": "pendant la période comprise entre le premier jour dudit exercice et celui de la transformation."}, {"orientation_angle": 0, "polygon": [[289.0, 1119.0], [2141.0, 1124.0], [2141.0, 1175.0], [289.0, 1170.0]], "score": 0.9924882054328918, "text": "Ce rapport sera communiqué aux associés dans les conditions fixées par le Code de commerce"}, {"orientation_angle": 0, "polygon": [[290.0, 1175.0], [748.0, 1179.0], [747.0, 1225.0], [289.0, 1222.0]], "score": 0.9971516728401184, "text": "et les nouveaux statuts."}, {"orientation_angle": 0, "polygon": [[284.0, 1283.0], [2139.0, 1289.0], [2139.0, 1340.0], [284.0, 1335.0]], "score": 0.9987220168113708, "text": "L'Assemblée Générale des associés statuera sur ces comptes conformément aux règles fixées"}, {"orientation_angle": 0, "polygon": [[286.0, 1340.0], [2142.0, 1342.0], [2142.0, 1395.0], [286.0, 1393.0]], "score": 0.9968268275260925, "text": "par les nouveaux statuts et les dispositions du Code de commerce relatives aux sociétés par"}, {"orientation_angle": 0, "polygon": [[288.0, 1395.0], [2139.0, 1398.0], [2139.0, 1450.0], [288.0, 1446.0]], "score": 0.9958975911140442, "text": "actions simplifiées. Elle statuera également sur le quitus à accorder à la gérance de la Société"}, {"orientation_angle": 0, "polygon": [[289.0, 1456.0], [782.0, 1456.0], [782.0, 1497.0], [289.0, 1497.0]], "score": 0.983855664730072, "text": "sous son ancienne forme."}, {"orientation_angle": 0, "polygon": [[284.0, 1557.0], [2136.0, 1564.0], [2135.0, 1616.0], [284.0, 1609.0]], "score": 0.9880275726318359, "text": "Les bénéfices de l'exercice en cours seront affectés et répartis entre les associés suivant les"}, {"orientation_angle": 0, "polygon": [[288.0, 1617.0], [1924.0, 1621.0], [1924.0, 1667.0], [288.0, 1664.0]], "score": 0.9907029867172241, "text": "dispositions statutaires de la Société sous sa forme de société par actions simplifiée."}, {"orientation_angle": 0, "polygon": [[283.0, 1724.0], [2137.0, 1731.0], [2137.0, 1782.0], [282.0, 1775.0]], "score": 0.9932489991188049, "text": "Les fonctions de la gérance prennent fin à compter de ce jour, sous réserve de la nécessité"}, {"orientation_angle": 0, "polygon": [[286.0, 1784.0], [1199.0, 1784.0], [1199.0, 1835.0], [286.0, 1835.0]], "score": 0.9997773170471191, "text": "pour la gérance d'établir un rapport de gestion."}, {"orientation_angle": 0, "polygon": [[284.0, 1890.0], [1104.0, 1890.0], [1104.0, 1941.0], [284.0, 1941.0]], "score": 0.9951275587081909, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[286.0, 2058.0], [894.0, 2058.0], [894.0, 2104.0], [286.0, 2104.0]], "score": 0.9833261370658875, "text": "NEUVIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[283.0, 2164.0], [2134.0, 2171.0], [2134.0, 2222.0], [282.0, 2215.0]], "score": 0.9833446741104126, "text": "L'Assemblée Générale, comme conséquence de l'adoption des résolutions qui précèdent,"}, {"orientation_angle": 0, "polygon": [[283.0, 2220.0], [2137.0, 2226.0], [2137.0, 2277.0], [282.0, 2272.0]], "score": 0.9934163689613342, "text": "constate que la transformation de la Société en société par actions simplifiée est"}, {"orientation_angle": 0, "polygon": [[284.0, 2275.0], [744.0, 2279.0], [744.0, 2325.0], [284.0, 2322.0]], "score": 0.9969497323036194, "text": "définitivement réalisée."}, {"orientation_angle": 0, "polygon": [[286.0, 2390.0], [1102.0, 2390.0], [1102.0, 2436.0], [286.0, 2436.0]], "score": 0.9763352274894714, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[283.0, 2553.0], [846.0, 2555.0], [846.0, 2603.0], [282.0, 2601.0]], "score": 0.9834649562835693, "text": "DIXIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[281.0, 2661.0], [2136.0, 2668.0], [2135.0, 2719.0], [281.0, 2712.0]], "score": 0.9940893650054932, "text": "L'Assemblée Générale donne tous pouvoirs au porteur de copies ou d'extraits du présent"}, {"orientation_angle": 0, "polygon": [[283.0, 2717.0], [1323.0, 2719.0], [1323.0, 2771.0], [282.0, 2769.0]], "score": 0.9947495460510254, "text": "procès-verbal pour remplir toutes formalités de droit."}, {"orientation_angle": 0, "polygon": [[284.0, 2827.0], [1099.0, 2829.0], [1099.0, 2877.0], [284.0, 2875.0]], "score": 0.978856086730957, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 1, "polygon": [[251.0, 2995.0], [516.0, 3005.0], [510.0, 3166.0], [245.0, 3156.0]], "score": 0.7014893889427185, "text": "Syd"}, {"orientation_angle": 0, "polygon": [[746.0, 3044.0], [1069.0, 3051.0], [1066.0, 3189.0], [743.0, 3183.0]], "score": 0.9259452819824219, "text": "C.S"}, {"orientation_angle": 0, "polygon": [[1299.0, 3055.0], [1819.0, 3106.0], [1804.0, 3254.0], [1285.0, 3203.0]], "score": 0.9184072613716125, "text": "P.S RS"}, {"orientation_angle": 0, "polygon": [[2055.0, 3115.0], [2149.0, 3115.0], [2149.0, 3197.0], [2055.0, 3197.0]], "score": 0.9760779142379761, "text": "6/"}], "page": 7, "pdf": "63e881148be6eb9f9d1ff967__63e881148be6eb9f9d1ff967.pdf", "skew_angle": 0.0}