38.0, 2104.0], [2191.0, 2107.0], [2191.0, 2161.0], [338.0, 2157.0]], "score": 0.9949630498886108, "text": "falsification, les omissions volontaires, les fausses déclarations ou le contournement du"}, {"orientation_angle": 0, "polygon": [[338.0, 2164.0], [691.0, 2168.0], [690.0, 2219.0], [337.0, 2215.0]], "score": 0.9994202852249146, "text": "contrôle interne ;"}, {"orientation_angle": 0, "polygon": [[282.0, 2281.0], [2191.0, 2281.0], [2191.0, 2332.0], [282.0, 2332.0]], "score": 0.9923559427261353, "text": "> il prend connaissance du contrôle interne pertinent pour l’audit afin de définir des"}, {"orientation_angle": 0, "polygon": [[338.0, 2339.0], [2191.0, 2340.0], [2191.0, 2394.0], [338.0, 2392.0]], "score": 0.9884501695632935, "text": "procédures d’audit appropriées en la circonstance, et non dans le but d’exprimer une"}, {"orientation_angle": 0, "polygon": [[343.0, 2397.0], [1226.0, 2397.0], [1226.0, 2452.0], [343.0, 2452.0]], "score": 0.9915606379508972, "text": "opinion sur l’efficacité du contrôle interne ;"}, {"orientation_angle": 0, "polygon": [[284.0, 2505.0], [2187.0, 2505.0], [2187.0, 2551.0], [284.0, 2551.0]], "score": 0.9804838299751282, "text": "> il apprécie le caractère approprié des méthodes comptables retenues et le caractère"}, {"orientation_angle": 0, "polygon": [[336.0, 2558.0], [2191.0, 2560.0], [2191.0, 2611.0], [336.0, 2609.0]], "score": 0.9997202754020691, "text": "raisonnable des estimations comptables faites par la direction, ainsi que les informations"}, {"orientation_angle": 0, "polygon": [[338.0, 2618.0], [1357.0, 2618.0], [1357.0, 2669.0], [338.0, 2669.0]], "score": 0.9998904466629028, "text": "les concernant fournies dans les comptes annuels ;"}, {"orientation_angle": 0, "polygon": [[282.0, 2723.0], [2189.0, 2723.0], [2189.0, 2774.0], [282.0, 2774.0]], "score": 0.9759134650230408, "text": "> il apprécie le caractère approprié de l'application par la direction de la convention"}, {"orientation_angle": 0, "polygon": [[341.0, 2781.0], [2191.0, 2781.0], [2191.0, 2832.0], [341.0, 2832.0]], "score": 0.976495623588562, "text": "comptable de continuité d’exploitation et, selon les éléments collectés, l’existence ou non"}, {"orientation_angle": 0, "polygon": [[341.0, 2837.0], [2189.0, 2837.0], [2189.0, 2889.0], [341.0, 2889.0]], "score": 0.9931778907775879, "text": "d’une incertitude significative liée à des événements ou à des circonstances susceptibles de"}, {"orientation_angle": 0, "polygon": [[338.0, 2897.0], [2189.0, 2894.0], [2189.0, 2945.0], [338.0, 2949.0]], "score": 0.9994209408760071, "text": "mettre en cause la capacité de la société à poursuivre son exploitation. Cette appréciation"}, {"orientation_angle": 0, "polygon": [[338.0, 2952.0], [2191.0, 2949.0], [2191.0, 3005.0], [338.0, 3009.0]], "score": 0.9898829460144043, "text": "s'appuie sur les éléments collectés jusqu'à la date de son rapport, étant toutefois rappelé"}, {"orientation_angle": 0, "polygon": [[339.0, 3012.0], [2191.0, 3007.0], [2191.0, 3060.0], [339.0, 3065.0]], "score": 0.9984936714172363, "text": "que des circonstances ou événements ultérieurs pourraient mettre en cause la continuité"}, {"orientation_angle": 0, "polygon": [[339.0, 3069.0], [2191.0, 3065.0], [2191.0, 3117.0], [339.0, 3120.0]], "score": 0.9817876219749451, "text": "d’exploitation. S’il conclut à l’existence d’une incertitude significative, il attire l’attention"}, {"orientation_angle": 0, "polygon": [[300.0, 3088.0], [2232.0, 3088.0], [2232.0, 3274.0], [300.0, 3274.0]], "score": 0.4152449667453766, "text": "des letuutu "}, {"orientation_angle": 0, "polygon": [[2185.0, 3123.0], [2329.0, 3178.0], [2309.0, 3228.0], [2166.0, 3173.0]], "score": 0.8903630971908569, "text": "Hufschni"}, {"orientation_angle": 0, "polygon": [[341.0, 3243.0], [1645.0, 3243.0], [1645.0, 3290.0], [341.0, 3290.0]], "score": 0.9991549253463745, "text": "il formule une certification avec réserve ou un refus de certifier ;"}, {"orientation_angle": 0, "polygon": [[2139.0, 3249.0], [2270.0, 3249.0], [2270.0, 3278.0], [2139.0, 3278.0]], "score": 0.9868994355201721, "text": "Membre de la"}, {"orientation_angle": 0, "polygon": [[2053.0, 3261.0], [2077.0, 3261.0], [2077.0, 3283.0], [2053.0, 3283.0]], "score": 0.5348408222198486, "text": "×"}, {"orientation_angle": 0, "polygon": [[2098.0, 3285.0], [2310.0, 3285.0], [2310.0, 3319.0], [2098.0, 3319.0]], "score": 0.9555483460426331, "text": "Compagnie Régionale"}, {"orientation_angle": 0, "polygon": [[2151.0, 3319.0], [2258.0, 3319.0], [2258.0, 3355.0], [2151.0, 3355.0]], "score": 0.9666199088096619, "text": "de Colmar"}, {"orientation_angle": 0, "polygon": [[2084.0, 3356.0], [2219.0, 3425.0], [2192.0, 3477.0], [2057.0, 3407.0]], "score": 0.9859228730201721, "text": "MISSAIRE"}, {"orientation_angle": 0, "polygon": [[2199.0, 3423.0], [2253.0, 3413.0], [2259.0, 3446.0], [2206.0, 3456.0]], "score": 0.9792313575744629, "text": "AU"}], "page": 11, "pdf": "CA_445070311_6751_2003B00059_2020_603__63e2481c916269756a09542b.pdf", "skew_angle": 0.0}