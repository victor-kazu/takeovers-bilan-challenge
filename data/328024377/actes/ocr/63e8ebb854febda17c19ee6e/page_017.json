0], [6367.0, 4878.0], [1732.0, 4902.0]], "score": 0.9975041151046753, "text": "En cas de vote par correspondance, il n'est tenu compte pour le"}, {"orientation_angle": 0, "polygon": [[1402.0, 4921.0], [6370.0, 4887.0], [6371.0, 5015.0], [1403.0, 5048.0]], "score": 0.978757917881012, "text": "calcul du quorum que des formulaires reçus par la société avant la"}, {"orientation_angle": 0, "polygon": [[1402.0, 5058.0], [6347.0, 5038.0], [6347.0, 5166.0], [1402.0, 5185.0]], "score": 0.9987108707427979, "text": "réunion de l'assemblée, dans les conditions et délais fixés par décret."}, {"orientation_angle": 0, "polygon": [[1745.0, 5322.0], [6375.0, 5303.0], [6376.0, 5444.0], [1746.0, 5464.0]], "score": 0.9847574830055237, "text": "II. - Le droit de vote attaché aux actions est proportionnel au"}, {"orientation_angle": 0, "polygon": [[1411.0, 5473.0], [6385.0, 5449.0], [6386.0, 5596.0], [1412.0, 5620.0]], "score": 0.9847924709320068, "text": "capital qu'elles représentent. A égalité de valeur nominale, chaque"}, {"orientation_angle": 0, "polygon": [[1411.0, 5624.0], [5450.0, 5600.0], [5451.0, 5728.0], [1412.0, 5752.0]], "score": 0.988857626914978, "text": "action de capital ou de jouissance donne droit à une voix."}, {"orientation_angle": 0, "polygon": [[1755.0, 5889.0], [6385.0, 5865.0], [6386.0, 6006.0], [1755.0, 6030.0]], "score": 0.9926927089691162, "text": "III. - Au cas où des actions sont remises en gage, le droit de"}, {"orientation_angle": 0, "polygon": [[1407.0, 6045.0], [6390.0, 6016.0], [6390.0, 6143.0], [1407.0, 6172.0]], "score": 0.9891184568405151, "text": "vote est exercé par le propriétaire des titres. A cet effet, le"}, {"orientation_angle": 0, "polygon": [[1416.0, 6182.0], [6380.0, 6153.0], [6381.0, 6280.0], [1417.0, 6309.0]], "score": 0.9888308048248291, "text": "créancier gagiste dépose, à la demande de son débiteur, les actions"}, {"orientation_angle": 0, "polygon": [[1416.0, 6314.0], [6385.0, 6280.0], [6386.0, 6422.0], [1417.0, 6456.0]], "score": 0.9828543663024902, "text": "qu'ils détient en gage, sous la forme et dans le délai indiqués dans"}, {"orientation_angle": 0, "polygon": [[1426.0, 6460.0], [2465.0, 6460.0], [2465.0, 6573.0], [1426.0, 6573.0]], "score": 0.9965382814407349, "text": "la convocation."}, {"orientation_angle": 0, "polygon": [[1759.0, 6739.0], [6385.0, 6710.0], [6386.0, 6837.0], [1760.0, 6866.0]], "score": 0.9933587312698364, "text": "La société émettrice ne peut valablement voter avec des actions"}, {"orientation_angle": 0, "polygon": [[1416.0, 6876.0], [6399.0, 6852.0], [6400.0, 6993.0], [1417.0, 7017.0]], "score": 0.9862978458404541, "text": "par elle souscrites, ou acquises ou prises en gage. Il n'est pas tenu"}, {"orientation_angle": 0, "polygon": [[1430.0, 7022.0], [4701.0, 7003.0], [4702.0, 7130.0], [1431.0, 7150.0]], "score": 0.9975201487541199, "text": "compte de ces actions pour le calcul du quorum."}, {"orientation_angle": 0, "polygon": [[1774.0, 7282.0], [6404.0, 7262.0], [6405.0, 7404.0], [1774.0, 7423.0]], "score": 0.9855642318725586, "text": "IV. - Le vote a lieu et les suffrages sont exprimés, à main levée"}, {"orientation_angle": 0, "polygon": [[1426.0, 7428.0], [6404.0, 7399.0], [6405.0, 7546.0], [1426.0, 7575.0]], "score": 0.9942148327827454, "text": "ou par assis et levés, ou par appel nominal, selon ce qu'en décide le"}, {"orientation_angle": 0, "polygon": [[1435.0, 7579.0], [2966.0, 7569.0], [2966.0, 7683.0], [1436.0, 7693.0]], "score": 0.9965053200721741, "text": "bureau de l'assemblée."}, {"orientation_angle": 0, "polygon": [[6418.0, 7770.0], [6469.0, 7784.0], [6458.0, 7823.0], [6406.0, 7808.0]], "score": 0.25482845306396484, "text": "-"}, {"orientation_angle": 0, "polygon": [[1502.0, 7981.0], [4444.0, 7966.0], [4445.0, 8098.0], [1503.0, 8113.0]], "score": 0.9822642803192139, "text": "Article 29 .- ASSEMBLEE GENERALE ORDINAIRE"}, {"orientation_angle": 0, "polygon": [[1779.0, 8254.0], [6423.0, 8240.0], [6424.0, 8368.0], [1779.0, 8382.0]], "score": 0.9928909540176392, "text": "I. - L'assemblée générale ordinaire est celle qui est appelée à"}, {"orientation_angle": 0, "polygon": [[1445.0, 8406.0], [5484.0, 8386.0], [5484.0, 8514.0], [1445.0, 8533.0]], "score": 0.981509268283844, "text": "prendre toutes décisions qui ne modifient pas les statuts."}, {"orientation_angle": 0, "polygon": [[1783.0, 8661.0], [6423.0, 8651.0], [6424.0, 8797.0], [1784.0, 8807.0]], "score": 0.987542986869812, "text": "Elle est réunie au moins une fois l'an, dans les délais légaux et"}, {"orientation_angle": 0, "polygon": [[1445.0, 8826.0], [6428.0, 8792.0], [6429.0, 8934.0], [1446.0, 8968.0]], "score": 0.9913472533226013, "text": "règlementaires envigueur, pour statuer sur les comptes de l'exercice"}, {"orientation_angle": 0, "polygon": [[1459.0, 8972.0], [2632.0, 8972.0], [2632.0, 9085.0], [1459.0, 9085.0]], "score": 0.9939379096031189, "text": "social précédent."}], "page": 17, "pdf": "63e8ebb854febda17c19ee6e__63e8ebb854febda17c19ee6e.pdf", "skew_angle": 0.0}