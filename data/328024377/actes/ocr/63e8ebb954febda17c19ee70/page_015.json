, "score": 0.9913415312767029, "text": "opposable aux tiers, vis-a-vis desquels chaque directeur général a les"}, {"orientation_angle": 0, "polygon": [[1455.0, 6668.0], [3686.0, 6673.0], [3686.0, 6800.0], [1454.0, 6795.0]], "score": 0.9854110479354858, "text": "mêmes pouvoirs que le président."}, {"orientation_angle": 0, "polygon": [[1803.0, 6946.0], [6433.0, 6965.0], [6433.0, 7093.0], [1802.0, 7074.0]], "score": 0.9891651272773743, "text": "Lorsqu'un directeur général est administrateur, la durée de ses"}, {"orientation_angle": 0, "polygon": [[1474.0, 7093.0], [4693.0, 7107.0], [4692.0, 7235.0], [1473.0, 7220.0]], "score": 0.9834872484207153, "text": "fonctions ne peut excéder celle de son mandat."}, {"orientation_angle": 0, "polygon": [[1803.0, 7362.0], [6452.0, 7376.0], [6452.0, 7523.0], [1802.0, 7508.0]], "score": 0.970104992389679, "text": "III. - Le conseil d'administration peut confiet à tous"}, {"orientation_angle": 0, "polygon": [[1464.0, 7513.0], [6452.0, 7527.0], [6452.0, 7669.0], [1464.0, 7655.0]], "score": 0.992442786693573, "text": "mandataires, choisis parmi ses membres ou hors de son sein, des"}, {"orientation_angle": 0, "polygon": [[1469.0, 7650.0], [6452.0, 7664.0], [6452.0, 7811.0], [1469.0, 7796.0]], "score": 0.9891987442970276, "text": "missions permanentes ou temporaires qu'il détermine, leur déléguer les"}, {"orientation_angle": 0, "polygon": [[1474.0, 7791.0], [5394.0, 7801.0], [5393.0, 7943.0], [1473.0, 7933.0]], "score": 0.9958983659744263, "text": "pouvoirs et fixer la rémunération qu'il juge convenable."}, {"orientation_angle": 0, "polygon": [[1483.0, 8217.0], [2661.0, 8217.0], [2661.0, 8363.0], [1483.0, 8363.0]], "score": 0.9127890467643738, "text": "Article 20 .- 1"}, {"orientation_angle": 0, "polygon": [[2609.0, 8235.0], [3476.0, 8235.0], [3476.0, 8349.0], [2609.0, 8349.0]], "score": 0.9997091889381409, "text": "REMUNERATION"}, {"orientation_angle": 0, "polygon": [[3572.0, 8231.0], [3820.0, 8231.0], [3820.0, 8358.0], [3572.0, 8358.0]],