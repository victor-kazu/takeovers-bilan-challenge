{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[3289.0, 399.0], [3541.0, 399.0], [3541.0, 525.0], [3289.0, 525.0]], "score": 0.9896072149276733, "text": "- 2 -"}, {"orientation_angle": 0, "polygon": [[857.0, 758.0], [1452.0, 775.0], [1448.0, 944.0], [852.0, 927.0]], "score": 0.998993992805481, "text": "réception,"}, {"orientation_angle": 0, "polygon": [[1280.0, 1064.0], [2655.0, 1089.0], [2652.0, 1248.0], [1277.0, 1223.0]], "score": 0.9896431565284729, "text": "- La feuille de présence,"}, {"orientation_angle": 0, "polygon": [[1279.0, 1378.0], [6144.0, 1440.0], [6143.0, 1581.0], [1278.0, 1519.0]], "score": 0.9951543211936951, "text": "- Ainsi que le dossier complet des documents et renseignements communiqués et mis"}, {"orientation_angle": 0, "polygon": [[846.0, 1524.0], [6182.0, 1586.0], [6180.0, 1745.0], [844.0, 1683.0]], "score": 0.9909625053405762, "text": "à la disposition des actionnaires, en application du droit d'information prescrit par la loi,"}, {"orientation_angle": 0, "polygon": [[854.0, 1693.0], [1302.0, 1693.0], [1302.0, 1829.0], [854.0, 1829.0]], "score": 0.9946550726890564, "text": "savoir :"}, {"orientation_angle": 0, "polygon": [[1270.0, 1983.0], [3593.0, 2003.0], [3591.0, 2162.0], [1268.0, 2143.0]], "score": 0.9894154071807861, "text": ". Le rapport du Conseil d'Administration,"}, {"orientation_angle": 0, "polygon": [[1275.0, 2143.0], [5090.0, 2186.0], [5088.0, 2331.0], [1273.0, 2288.0]], "score": 0.9966808557510376, "text": ". Le texte des résolutions proposées par le Conseil d'Administration,"}, {"orientation_angle": 0, "polygon": [[1275.0, 2288.0], [4479.0, 2327.0], [4477.0, 2482.0], [1273.0, 2443.0]], "score": 0.9995304942131042, "text": ". Le tableau de composition du Conseil d'Administration,"}, {"orientation_angle": 0, "polygon": [[1270.0, 2452.0], [2739.0, 2472.0], [2737.0, 2603.0], [1268.0, 2584.0]], "score": 0.9746189713478088, "text": ". La liste des actionnaires."}, {"orientation_angle": 0, "polygon": [[1256.0, 2898.0], [6140.0, 2955.0], [6138.0, 3110.0], [1254.0, 3053.0]], "score": 0.9928259253501892, "text": "Monsieur le Président rappelle que les documents énumérés ci-dessus et plus"}, {"orientation_angle": 0, "polygon": [[850.0, 3057.0], [6172.0, 3100.0], [6171.0, 3255.0], [849.0, 3212.0]], "score": 0.9954577684402466, "text": "généralement les documents et renseignements prescrits par la loi pour l'information préalable"}, {"orientation_angle": 0, "polygon": [[850.0, 3207.0], [6135.0, 3265.0], [6134.0, 3410.0], [848.0, 3353.0]], "score": 0.9899742007255554, "text": "des actionnaires ont été tenus à la disposition de ceux-ci au lieu et dans les délais prévus par"}, {"orientation_angle": 0, "polygon": [[846.0, 3362.0], [2506.0, 3382.0], [2504.0, 3532.0], [844.0, 3512.0]], "score": 0.997336745262146, "text": "la réglementation en vigueur."}, {"orientation_angle": 0, "polygon": [[1256.0, 3822.0], [3887.0, 3851.0], [3885.0, 3996.0], [1254.0, 3967.0]], "score": 0.9960630536079407, "text": "Monsieur le Président rappelle l'ordre du jour :"}, {"orientation_angle": 0, "polygon": [[1251.0, 4103.0], [6130.0, 4151.0], [6129.0, 4311.0], [1250.0, 4263.0]], "score": 0.9951359629631042, "text": "- Augmentation du capital social d'une somme de 750.000 Francs par incorporation de"}, {"orientation_angle": 0, "polygon": [[836.0, 4249.0], [4316.0, 4282.0], [4314.0, 4423.0], [835.0, 4389.0]], "score": 0.9845264554023743, "text": "réserves et élévation de la valeur nominale de chaque action."}, {"orientation_angle": 0, "polygon": [[1256.0, 4521.0], [3359.0, 4545.0], [3358.0, 4690.0], [1254.0, 4666.0]], "score": 0.9922664165496826, "text": "- Modification corrélative des statuts."}, {"orientation_angle": 0, "polygon": [[1251.0, 4807.0], [3103.0, 4822.0], [3102.0, 4962.0], [1250.0, 4948.0]], "score": 0.9854642748832703, "text": "- Pouvoirs en vue des formalités."}, {"orientation_angle": 0, "polygon": [[1242.0, 5079.0], [2440.0, 5089.0], [2439.0, 5248.0], [1240.0, 5238.0]], "score": 0.9996788501739502, "text": "- Questions diverses."}, {"orientation_angle": 0, "polygon": [[1232.0, 5693.0], [5015.0, 5727.0], [5014.0, 5872.0], [1231.0, 5839.0]], "score": 0.9986104369163513, "text": "Il est ensuite donné lecture du rapport du Conseil d'Administration."}, {"orientation_angle": 0, "polygon": [[1237.0, 5998.0], [6149.0, 6046.0], [6148.0, 6186.0], [1236.0, 6139.0]], "score": 0.9927036762237549, "text": "Cette lecture faite, Monsieur le Président invite les membres de l'assemblée à poser les"}, {"orientation_angle": 0, "polygon": [[826.0, 6158.0], [6140.0, 6191.0], [6139.0, 6336.0], [825.0, 6303.0]], "score": 0.9974146485328674, "text": "questions qu'ils souhaitent sur les points en rapport avec l'ordre du jour et, s'ils le désirent, à"}, {"orientation_angle": 0, "polygon": [[830.0, 6317.0], [2351.0, 6317.0], [2351.0, 6458.0], [830.0, 6458.0]], "score": 0.9722170829772949, "text": "expliquer leur vote à venir."}, {"orientation_angle": 0, "polygon": [[1228.0, 6608.0], [6140.0, 6641.0], [6139.0, 6796.0], [1227.0, 6763.0]], "score": 0.9976817965507507, "text": "Constatant que personne ne demande à intervenir, Monsieur le Président met aux voix"}, {"orientation_angle": 0, "polygon": [[817.0, 6763.0], [3677.0, 6787.0], [3675.0, 6932.0], [816.0, 6908.0]], "score": 0.9996551275253296, "text": "les résolutions suivantes figurant à l'ordre du jour :"}, {"orientation_angle": 0, "polygon": [[2599.0, 7222.0], [4330.0, 7237.0], [4328.0, 7378.0], [2598.0, 7363.0]], "score": 0.9977054595947266, "text": "PREMIERE RESOLUTION"}, {"orientation_angle": 0, "polygon": [[1223.0, 7522.0], [6140.0, 7556.0], [6139.0, 7697.0], [1222.0, 7663.0]], "score": 0.9939212203025818, "text": "L'assemblée générale donne acte à son Président de ses déclarations relatives à la"}, {"orientation_angle": 0, "polygon": [[817.0, 7672.0], [6140.0, 7715.0], [6138.0, 7861.0], [816.0, 7818.0]], "score": 0.9987714290618896, "text": "convocation des actionnaires et à la mise à leur disposition des documents et renseignements"}, {"orientation_angle": 0, "polygon": [[812.0, 7832.0], [5267.0, 7851.0], [5266.0, 8006.0], [812.0, 7987.0]], "score": 0.9919900894165039, "text": "prescrits par la réglementation en vigueur et utiles à leur information préalable."}, {"orientation_angle": 0, "polygon": [[1218.0, 8127.0], [3588.0, 8137.0], [3587.0, 8297.0], [1217.0, 8287.0]], "score": 0.9895079731941223, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[1801.0, 8585.0], [3025.0, 8491.0], [3050.0, 8824.0], [1827.0, 8918.0]], "score": 0.650690495967865, "text": "CH7"}], "page": 26, "pdf": "63e8ebb854febda17c19ee6c__63e8ebb854febda17c19ee6c.pdf", "skew_angle": 0.0}