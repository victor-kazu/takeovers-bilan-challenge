.0, 4972.0]], "score": 0.9936509132385254, "text": "Il est donné lecture du rapport du Conseil d'Administration, du projet de fusion, puis des rapports du"}, {"orientation_angle": 0, "polygon": [[1278.0, 4986.0], [2457.0, 4971.0], [2459.0, 5097.0], [1279.0, 5113.0]], "score": 0.9997369647026062, "text": "Commissaire à la fusion."}, {"orientation_angle": 0, "polygon": [[1287.0, 5267.0], [4314.0, 5238.0], [4316.0, 5365.0], [1288.0, 5394.0]], "score": 0.9935210347175598, "text": "Cette lecture terminée, le Président déclare la discussion ouverte."}, {"orientation_angle": 0, "polygon": [[1287.0, 5549.0], [6078.0, 5510.0], [6079.0, 5637.0], [1288.0, 5675.0]], "score": 0.9978005886077881, "text": "Diverses observations sont échangées puis personne ne demandant plus la parole, le Président met"}, {"orientation_angle": 0, "polygon": [[1292.0, 5699.0], [3675.0, 5674.0], [3676.0, 5787.0], [1293.0, 5811.0]], "score": 0.9860444068908691, "text": "successivement aux voix les résolutions suivantes :"}, {"orientation_angle": 0, "polygon": [[3657.0, 6233.0], [3718.0, 6233.0], [3718.0, 6294.0], [3657.0, 6294.0]], "score": 0.4053383767604828, "text": "O"}, {"orientation_angle": 0, "polygon": [[3475.0, 6514.0], [3541.0, 6514.0], [3541.0, 6580.0], [3475.0, 6580.0]], "score": 0.8393913507461548, "text": "o"}, {"orientation_angle": 0, "polygon": [[3839.0, 6514.0], [3909.0, 6514.0], [3909.0, 6575.0], [3839.0, 6575.0]], "score": 0.8339793682098389, "text": "o"}, {"orientation_angle": 0, "polygon": [[2967.0, 7077.0], [4422.0, 7067.0], [4423.0, 7180.0], [2967.0, 7190.0]], "score": 0.989213228225708, "text": "PREMIERE RESOLUTION"}, {"orientation_angle": 0, "polygon": [[1306.0, 7363.0], [2412.0, 7363.0], [2412.0, 7490.0], [1306.0, 7490.0]], "score": 0.9988670349121094, "text": "L'Assemblée Générale,"}, {"orientation_angle": 0, "polygon": [[1474.0, 7640.0], [6101.0, 7597.0], [6102.0, 7738.0], [1475.0, 7781.0]], "score": 0.9902433753013611, "text": "après avoir entendu la lecture du rapport du Conseil d'Administration et des rapports du"}, {"orientation_angle": 0, "polygon": [[1479.0, 7781.0], [5989.0, 7747.0], [5990.0, 7874.0], [1479.0, 7908.0]], "score": 0.9975661635398865, "text": "Commissaire à la fusion, désigné par Monsieur le Président du Tribunal de commerce de DOLE,"}, {"orientation_angle": 0, "polygon": [[1478.0, 8062.0], [6101.0, 8015.0], [6102.0, 8146.0], [1480.0, 8194.0]], "score": 0.9932167530059814, "text": "après avoir pris connaissance du projet de fusion, signé le 8 novembre 1996 avec la société LES"}, {"orientation_angle": 0, "polygon": [[1483.0, 8194.0], [6101.0, 8160.0], [6102.0, 8287.0], [1484.0, 8320.0]], "score": 0.9956884980201721, "text": "VIGNES, société civile au capital de 188.100 F, dont le siège est 7, rue des Vignes - 39100"}, {"orientation_angle": 0, "polygon": [[1483.0, 8339.0], [6106.0, 8296.0], [6107.0, 8423.0], [1484.0, 8466.0]], "score": 0.9884111881256104, "text": "BREVANS, immatriculée au Registre du commerce et des sociétés de DOLE, sous le numéro D"}, {"orientation_angle": 0, "polygon": [[1488.0, 8470.0], [6106.0, 8437.0], [6107.0, 8568.0], [1489.0, 8602.0]], "score": 0.9921169877052307, "text": "342 829 249, aux termes duquel la société LES VIGNES fait apport à titre de fusion à la société"}, {"orientation_angle": 0, "polygon": [[1488.0, 8611.0], [4454.0, 8587.0], [4455.0, 8714.0], [1489.0, 8738.0]], "score": 0.9962324500083923, "text": "ORTELLI & Cie de la totalité de son patrimoine, actif et passif,"}, {"orientation_angle": 0, "polygon": [[5901.0, 9145.0], [6270.0, 9145.0], [6270.0, 9422.0], [5901.0, 9422.0]], "score": 0.7169662117958069, "text": "RF"}], "page": 5, "pdf": "63ebd08aede2a73e4f0a8148__63ebd08aede2a73e4f0a8148.pdf", "skew_angle": 0.0}