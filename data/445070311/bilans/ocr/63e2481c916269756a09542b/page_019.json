.0, 433.0], [181.0, 435.0]], "score": 0.9959956407546997, "text": "Les conventions générales comptables ont été appliquées, dans le respect du principe de prudence,"}, {"orientation_angle": 0, "polygon": [[182.0, 435.0], [840.0, 432.0], [841.0, 471.0], [183.0, 475.0]], "score": 0.9954281449317932, "text": "conformément aux hypothèses de base :"}, {"orientation_angle": 0, "polygon": [[181.0, 488.0], [623.0, 487.0], [624.0, 528.0], [181.0, 529.0]], "score": 0.9923406839370728, "text": "- continuité de l'exploitation"}, {"orientation_angle": 0, "polygon": [[181.0, 540.0], [1202.0, 535.0], [1202.0, 576.0], [181.0, 581.0]], "score": 0.9980536699295044, "text": "- permanence des méthodes comptables d'un exercice à l'autre"}, {"orientation_angle": 0, "polygon": [[182.0, 586.0], [671.0, 582.0], [672.0, 624.0], [183.0, 627.0]], "score": 0.9943433403968811, "text": "- Indépendance des exercices"}, {"orientation_angle": 0, "polygon": [[183.0, 649.0], [1724.0, 646.0], [1724.0, 687.0], [183.0, 691.0]], "score": 0.996533215045929, "text": "et conformément aux règles générales d'établissement et de présentation des comptes annuels."}, {"orientation_angle": 0, "polygon": [[183.0, 725.0], [2117.0, 721.0], [2117.0, 761.0], [183.0, 764.0]], "score": 0.9933608770370483, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques"}, {"orientation_angle": 0, "polygon": [[177.0, 816.0], [1831.0, 810.0], [1831.0, 852.0], [177.0, 857.0]], "score": 0.9919686913490295, "text": "Les comptes annuels cet exercice ont été établis conformément au règlement de l'Autorité des Normes"}, {"orientation_angle": 0, "polygon": [[179.0, 864.0], [1901.0, 858.0], [1901.0, 899.0], [179.0, 905.0]], "score": 0.9778022170066833, "text": "Comptables n°2014-03 du 5 juin 2014, modifié par les règlements ANC n°2015-06 du 23 novembre 2015 et"}, {"orientation_angle": 0, "polygon": [[181.0, 912.0], [753.0, 912.0], [753.0, 951.0], [181.0, 951.0]], "score": 0.9889652729034424, "text": "ANC 2016-07 du 4 Novembre 2016"}, {"orientation_angle": 0, "polygon": [[179.0, 965.0], [1056.0, 963.0], [1056.0, 1004.0], [179.0, 1006.0]], "score": 0.9844562411308289, "text": "Les principales méthodes utilisées sont les suivantes :"}, {"orientation_angle": 0, "polygon": [[121.0, 1055.0], [160.0, 1055.0], [160.0, 1093.0], [121.0, 1093.0]], "score": 0.9884955883026123, "text": "a)"}, {"orientation_angle": 0, "polygon": [[158.0, 1050.0], [663.0, 1049.0], [663.0, 1091.0], [159.0, 1093.0]], "score": 0.9996821880340576, "text": "Immobilisations corporelles"}, {"orientation_angle": 0, "polygon": [[179.0, 1119.0], [2208.0, 1114.0], [2208.0, 1153.0], [179.0, 1158.0]], "score": 0.9950553178787231, "text": "Les immobilisations corporelles sont évaluées à leur coût d'acquisition (prix d'achat et frais accessoires, hors frais d'acquisition"}, {"orientation_angle": 0, "polygon": [[181.0, 1158.0], [963.0, 1156.0], [963.0, 1198.0], [181.0, 1199.0]], "score": 0.9987536668777466, "text": "des immobilisation) ou à leur coût de production."}, {"orientation_angle": 0, "polygon": [[184.0, 1223.0], [2192.0, 1216.0], [2192.0, 1258.0], [184.0, 1265.0]], "score": 0.9958838820457458, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire/dégressif en fonction de la durée de vie prévue :"}, {"orientation_angle": 0, "polygon": [[178.0, 1273.0], [432.0, 1277.0], [432.0, 1318.0], [177.0, 1314.0]], "score": 0.9800668358802795, "text": "- Constructions"}, {"orientation_angle": 0, "polygon": [[1870.0, 1275.0], [1987.0, 1275.0], [1987.0, 1312.0], [1870.0, 1312.0]], "score": 0.8569394946098328, "text": "....ans"}, {"orientation_angle": 0, "polygon": [[179.0, 1330.0], [1021.0, 1326.0], [1021.0, 1369.0], [179.0, 1372.0]], "score": 0.9869126081466675, "text": "- Agencements et aménagements des constructions"}, {"orientation_angle": 0, "polygon": [[1814.0, 1322.0], [1988.0, 1326.0], [1987.0, 1368.0], [1813.0, 1364.0]], "score": 0.8130106925964355, "text": "15 ....ans"}, {"orientation_angle": 0, "polygon": [[1816.0, 1377.0], [1986.0, 1383.0], [1985.0, 1424.0], [1815.0, 1418.0]], "score": 0.8712431192398071, "text": "10 ....ans"}, {"orientation_angle": 0, "polygon": [[183.0, 1388.0], [582.0, 1388.0], [582.0, 1424.0], [183.0, 1424.0]], "score": 0.9989833831787109, "text": "- Installations techniques"}, {"orientation_angle": 0, "polygon": [[179.0, 1439.0], [704.0, 1437.0], [704.0, 1479.0], [179.0, 1480.0]], "score": 0.9963231682777405, "text": "- Matériel et Outillage industriels"}, {"orientation_angle": 0, "polygon": [[1834.0, 1432.0], [1986.0, 1438.0], [1985.0, 1479.0], [1832.0, 1473.0]], "score": 0.7499523758888245, "text": "5 ....ans"}, {"orientation_angle": 0, "polygon": [[114.0, 1518.0], [162.0, 1518.0], [162.0, 1563.0], [114.0, 1563.0]], "score": 0.9904630184173584, "text": "b)"}, {"orientation_angle": 0, "polygon": [[174.0, 1515.0], [308.0, 1515.0], [308.0, 1563.0], [174.0, 1563.0]], "score": 0.9999023079872131, "text": "Stocks"}, {"orientation_angle": 0, "polygon": [[177.0, 1588.0], [1345.0, 1583.0], [1345.0, 1624.0], [178.0, 1629.0]], "score": 0.9982844591140747, "text": "Les stocks sont évalués suivant la méthode premier entré, premier sorti.."}, {"orientation_angle": 0, "polygon": [[177.0, 1638.0], [1887.0, 1631.0], [1888.0, 1670.0], [177.0, 1677.0]], "score": 0.9952875971794128, "text": "La valeur brute des marchandises et approvisionnements comprend le prix d'achat et les frais accessoires."}, {"orientation_angle": 0, "polygon": [[177.0, 1707.0], [2061.0, 1700.0], [2062.0, 1741.0], [177.0, 1748.0]], "score": 0.9959698915481567, "text": "Les produits fabriqués sont valorisés au coût de production comprenant les consommations et les charges directes et"}, {"orientation_angle": 0, "polygon": [[177.0, 1748.0], [2179.0, 1741.0], [2179.0, 1780.0], [177.0, 1787.0]], "score": 0.9871688485145569, "text": "indirectes de production, les amortissements des biens concourant à la production. Le coût de la sous-activité est exclu de la"}, {"orientation_angle": 0, "polygon": [[181.0, 1789.0], [474.0, 1789.0], [474.0, 1825.0], [181.0, 1825.0]], "score": 0.9843704700469971, "text": "valeur des stocks."}, {"orientation_angle": 0, "polygon": [[177.0, 1827.0], [1173.0, 1823.0], [1173.0, 1864.0], [177.0, 1868.0]], "score": 0.9985367059707642, "text": "Les intérêts sont toujours exclus de la valorisation des stocks."}, {"orientation_angle": 0, "polygon": [[179.0, 1898.0], [2077.0, 1890.0], [2077.0, 1931.0], [179.0, 1940.0]], "score": 0.9906994104385376, "text": "Une provision pour dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités"}, {"orientation_angle": 0, "polygon": [[177.0, 1938.0], [2070.0, 1931.0], [2070.0, 1972.0], [177.0, 1979.0]], "score": 0.988978385925293, "text": "indiquées ci-dessus et le cours du jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est"}, {"orientation_angle": 0, "polygon": [[179.0, 1977.0], [1367.0, 1974.0], [1367.0, 2015.0], [179.0, 2018.0]], "score": 0.9996660351753235, "text": "effectuée lorsque cette valeur brute est supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[119.0, 2061.0], [348.0, 2061.0], [348.0, 2107.0], [119.0, 2107.0]], "score": 0.9920232892036438, "text": "c) Créances"}, {"orientation_angle": 0, "polygon": [[174.0, 2126.0], [2037.0, 2121.0], [2037.0, 2161.0], [174.0, 2166.0]], "score": 0.9891914129257202, "text": "Les créances sont valorisées à leur valeur nominale. Une provision pour dépréciation est pratiquée lorsque la valeur"}, {"orientation_angle": 0, "polygon": [[176.0, 2166.0], [947.0, 2164.0], [947.0, 2205.0], [176.0, 2207.0]], "score": 0.9811398386955261, "text": "d'inventaire est inférieure à la valeur comptable."}, {"orientation_angle": 0, "polygon": [[127.0, 2253.0], [349.0, 2249.0], [350.0, 2297.0], [128.0, 2301.0]], "score": 0.997031033039093, "text": "d) Provision"}, {"orientation_angle": 0, "polygon": [[164.0, 2347.0], [2201.0, 2340.0], [2201.0, 2382.0], [164.0, 2388.0]], "score": 0.995772659778595, "text": "Les provisions sont comptabilisées lorsque, à la clôture de l'exercice, l'entreprise a une obligation à l'égard d'un tiers qui résulte"}, {"orientation_angle": 0, "polygon": [[165.0, 2388.0], [2204.0, 2382.0], [2204.0, 2423.0], [165.0, 2430.0]], "score": 0.9931387305259705, "text": "d'un fait générateur passé et dont il est probable ou certain qu'elle provoquera une sortie de ressources au bénéfice de ce tiers,"}, {"orientation_angle": 0, "polygon": [[164.0, 2430.0], [2209.0, 2421.0], [2210.0, 2462.0], [164.0, 2471.0]], "score": 0.9872679710388184, "text": "sans contrepartie au moins équivalente attendue de celui-ci. Cette obligation peut être d'ordre légale, réglementaire ou implicite."}, {"orientation_angle": 0, "polygon": [[165.0, 2469.0], [1781.0, 2464.0], [1781.0, 2505.0], [165.0, 2510.0]], "score": 0.9902905225753784, "text": "Ces provisions sont estimées selon leur nature en tenant compte des hypothèses les plus probables."}, {"orientation_angle": 0, "polygon": [[120.0, 2592.0], [796.0, 2589.0], [796.0, 2630.0], [121.0, 2634.0]], "score": 0.9797740578651428, "text": "e) Engagements de départ à la retraite"}, {"orientation_angle": 0, "polygon": [[177.0, 2654.0], [2122.0, 2644.0], [2122.0, 2685.0], [178.0, 2695.0]], "score": 0.9901252388954163, "text": "Les engagements de départs à la retraite ne font ni l'objet d'une provision comptable ni d'une assurance. Compte tenu de"}, {"orientation_angle": 0, "polygon": [[177.0, 2695.0], [1669.0, 2686.0], [1669.0, 2728.0], [178.0, 2736.0]], "score": 0.9950294494628906, "text": "l'âge des salariés et de leur ancienneté, l'IFC n'a pas était calculée mais est non significative."}, {"orientation_angle": 0, "polygon": [[114.0, 2777.0], [301.0, 2777.0], [301.0, 2832.0], [114.0, 2832.0]], "score": 0.9155749082565308, "text": "f Divers"}, {"orientation_angle": 0, "polygon": [[184.0, 2848.0], [1595.0, 2837.0], [1595.0, 2878.0], [184.0, 2889.0]], "score": 0.9934552907943726, "text": "La société n'a pour l'instant pas sollicité de prêt PGE mais bénéficié de l'activité partielle."}, {"orientation_angle": 0, "polygon": [[2032.0, 3152.0], [2159.0, 3076.0], [2188.0, 3124.0], [2061.0, 3201.0]], "score": 0.9686679840087891, "text": "Philippe"}, {"orientation_angle": 1, "polygon": [[53.0, 3162.0], [97.0, 3165.0], [89.0, 3285.0], [44.0, 3282.0]], "score": 0.9882655739784241, "text": "© Sage"}, {"orientation_angle": 0, "polygon": [[2122.0, 3190.0], [2262.0, 3194.0], [2261.0, 3228.0], [2121.0, 3224.0]], "score": 0.9993078708648682, "text": "Membre de la"}, {"orientation_angle": 0, "polygon": [[2041.0, 3202.0], [2065.0, 3202.0], [2065.0, 3226.0], [2041.0, 3226.0]], "score": 0.9556268453598022, "text": "*"}, {"orientation_angle": 0, "polygon": [[2083.0, 3228.0], [2299.0, 3232.0], [2299.0, 3268.0], [2082.0, 3264.0]], "score": 0.9964103698730469, "text": "Compagnie Régionale"}, {"orientation_angle": 0, "polygon": [[2057.0, 3266.0], [2209.0, 3376.0], [2167.0, 3433.0], [2015.0, 3323.0]], "score": 0.9653248190879822, "text": "MMISSAIRE"}, {"orientation_angle": 0, "polygon": [[2135.0, 3266.0], [2302.0, 3262.0], [2303.0, 3298.0], [2136.0, 3302.0]], "score": 0.9978688955307007, "text": "de ColmaPag"}, {"orientation_angle": 1, "polygon": [[2316.0, 3259.0], [2339.0, 3259.0], [2339.0, 3286.0], [2316.0, 3286.0]], "score": 0.6858861446380615, "text": "e", "text_original": "7"}, {"orientation_angle": 0, "polygon": [[224.0, 3269.0], [696.0, 3266.0], [696.0, 3305.0], [224.0, 3309.0]], "score": 0.9902247190475464, "text": "MBS CONSULTANTS SARL"}, {"orientation_angle": 1, "polygon": [[2311.0, 3285.0], [2331.0, 3295.0], [2315.0, 3326.0], [2295.0, 3316.0]], "score": 0.42320987582206726, "text": "1P"}, {"orientation_angle": 0, "polygon": [[2184.0, 3373.0], [2269.0, 3343.0], [2280.0, 3374.0], [2195.0, 3404.0]], "score": 0.8657031059265137, "text": "AUXC"}], "page": 19, "pdf": "CA_445070311_6751_2003B00059_2020_603__63e248