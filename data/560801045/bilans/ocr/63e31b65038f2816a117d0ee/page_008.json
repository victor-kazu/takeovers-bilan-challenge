3.0], [1934.0, 1804.0], [203.0, 1811.0]], "score": 0.9894253015518188, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques."}, {"orientation_angle": 0, "polygon": [[203.0, 1868.0], [1719.0, 1862.0], [1719.0, 1902.0], [203.0, 1907.0]], "score": 0.9923626184463501, "text": "Seules sont exprimées les informations significatives. Sauf mention, les montants sont exprimés en euros."}, {"orientation_angle": 0, "polygon": [[205.0, 1976.0], [1224.0, 1970.0], [1225.0, 2023.0], [205.0, 2029.0]], "score": 0.9950115084648132, "text": "Immobilisations corporelles et incorporelles"}, {"orientation_angle": 0, "polygon": [[205.0, 2082.0], [2179.0, 2077.0], [2179.0, 2118.0], [205.0, 2123.0]], "score": 0.9888890385627747, "text": "Les immobilisations corporelles et incorporelles sont évaluées à leur coût d'acquisition pour les actifs acquis à titre onéreux, à leur coût de"}, {"orientation_angle": 0, "polygon": [[205.0, 2131.0], [2029.0, 2126.0], [2029.0, 2167.0], [205.0, 2173.0]], "score": 0.9980437159538269, "text": "production pour les actifs produits par l'entreprise, à leur valeur vénale pour les actifs acquis à titre gratuit et par voie d'échange."}, {"orientation_angle": 0, "polygon": [[205.0, 2227.0], [2179.0, 2220.0], [2179.0, 2260.0], [205.0, 2267.0]], "score": 0.993690550327301, "text": "Le coût d'une immobilisation est constitué de son prix d'achat, y compris les droits de douane et taxes non récupérables, après déduction"}, {"orientation_angle": 0, "polygon": [[205.0, 2275.0], [2179.0, 2268.0], [2179.0, 2310.0], [205.0, 2317.0]], "score": 0.9931418299674988, "text": "des remises, rabais commerciaux et escomptes de règlement de tous les coûts directement attribuables engagés pour mettre l'actif en"}, {"orientation_angle": 0, "polygon": [[207.0, 2323.0], [2178.0, 2315.0], [2179.0, 2354.0], [207.0, 2363.0]], "score": 0.9902486205101013, "text": "place et en état de fonctionner selon l'utilisation prévue. Les droits de mutation, honoraires ou commissions et frais d'actes liés à"}, {"orientation_angle": 0, "polygon": [[205.0, 2370.0], [2180.0, 2364.0], [2180.0, 2406.0], [205.0, 2411.0]], "score": 0.9942564368247986, "text": "l'acquisition, sont rattachés à ce coût d'acquisition. Tous les coûts qui ne font pas partie du prix d'acquisition de l'immobilisation et qui ne"}, {"orientation_angle": 0, "polygon": [[207.0, 2421.0], [2182.0, 2412.0], [2182.0, 2452.0], [207.0, 2460.0]], "score": 0.9863108396530151, "text": "peuvent pas être rattachés directement aux coûts rendus nécessaires pour mettre l'actif en place et en état de fonctionner conformément"}, {"orientation_angle": 0, "polygon": [[208.0, 2467.0], [958.0, 2467.0], [958.0, 2507.0], [208.0, 2507.0]], "score": 0.9933452606201172, "text": "à l'utilisation prévue, sont comptabilisés en charges."}, {"orientation_angle": 0, "polygon": [[212.0, 2621.0], [563.0, 2621.0], [563.0, 2663.0], [212.0, 2663.0]], "score": 0.999987006187439, "text": "Amortissements"}, {"orientation_angle": 0, "polygon": [[210.0, 2673.0], [1846.0, 2669.0], [1846.0, 2709.0], [210.0, 2712.0]], "score": 0.9939705729484558, "text": "Les amortissements pour dépréciation sont calculés suivant le mode linéaire en fonction de la durée de vie prévue."}, {"orientation_angle": 0, "polygon": [[212.0, 2772.0], [883.0, 2772.0], [883.0, 2807.0], [212.0, 2807.0]], "score": 0.996026337146759, "text": "* Concessions, logiciels et brevets : 1 à 03 ans"}, {"orientation_angle": 0, "polygon": [[210.0, 2817.0], [753.0, 2819.0], [753.0, 2855.0], [210.0, 2853.0]], "score": 0.9669355750083923, "text": "* Installations techniques : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[210.0, 2865.0], [852.0, 2865.0], [852.0, 2904.0], [210.0, 2904.0]], "score": 0.9934277534484863, "text": "* Matériel et outillage industriels : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[210.0, 2911.0], [1256.0, 2913.0], [1255.0, 2952.0], [210.0, 2950.0]], "score": 0.9916704297065735, "text": "* Installations générales, agencements et aménagements divers : 10 ans"}, {"orientation_angle": 0, "polygon": [[210.0, 2959.0], [696.0, 2963.0], [696.0, 3002.0], [210.0, 2998.0]], "score": 0.9886552095413208, "text": "* Matériel de transport : 4 à 5 ans"}, {"orientation_angle": 0, "polygon": [[210.0, 3009.0], [687.0, 3010.0], [687.0, 3046.0], [210.0, 3045.0]], "score": 0.9783104658126831, "text": "* Matériel de bureau : 5 à 10 ans"}, {"orientation_angle": 0, "polygon": [[212.0, 3058.0], [649.0, 3060.0], [649.0, 3096.0], [212.0, 3094.0]], "score": 0.9953517913818359, "text": "* Matériel informatique : 3 ans"}, {"orientation_angle": 0, "polygon": [[212.0, 3104.0], [479.0, 3108.0], [478.0, 3144.0], [212.0, 3140.0]], "score": 0.9599213004112244, "text": "* Mobilier : 10 ans"}, {"orientation_angle": 0, "polygon": [[215.0, 3201.0], [1912.0, 3201.0], [1912.0, 3240.0], [215.0, 3240.0]], "score": 0.9959838390350342, "text": "La durée d'amortissement retenue par simplification est la durée d'usage pour les biens non décomposables à l'origine."}, {"orientation_angle": 0, "polygon": [[1135.0, 3312.0], [1474.0, 3312.0], [1474.0, 3348.0], [1135.0, 3348.0]], "score": 0.999019980430603, "text": "GRANT THORNTON"}, {"orientation_angle": 0, "polygon": [[2120.0, 3307.0], [2172.0, 3307.0], [2172.0, 3351.0], [2120.0, 3351.0]], "score": 0.9999687671661377, "text": "15"}], "page": 8, "pdf": "CA_560801045_3102_1956B00104_2017_B2018028713__63e31b65038f2816a117d0ee.pdf", "skew_angle": 0.9391909457355799}