{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[310.0, 243.0], [2213.0, 254.0], [2213.0, 305.0], [310.0, 295.0]], "score": 0.9979108572006226, "text": "Les commissaires aux comptes sont indéfiniment rééligibles. Leur renouvellement doit être"}, {"orientation_angle": 0, "polygon": [[310.0, 298.0], [2213.0, 307.0], [2213.0, 358.0], [310.0, 349.0]], "score": 0.9907602071762085, "text": "décidé par la collectivité des associés délibérant dans les conditions prévues pour les"}, {"orientation_angle": 0, "polygon": [[312.0, 353.0], [1958.0, 360.0], [1958.0, 408.0], [312.0, 401.0]], "score": 0.9961647391319275, "text": "décisions ordinaires, la reconduction tacite dans leurs fonctions étant inopérante."}, {"orientation_angle": 0, "polygon": [[308.0, 456.0], [2211.0, 466.0], [2211.0, 518.0], [308.0, 507.0]], "score": 0.9938536286354065, "text": "Les commissaires aux comptes peuvent démissionner de leurs fonctions, même pour simple"}, {"orientation_angle": 0, "polygon": [[308.0, 511.0], [2210.0, 517.0], [2209.0, 569.0], [308.0, 562.0]], "score": 0.9887462854385376, "text": "convenance personnelle, à condition de ne pas exercer ce droit d'une manière préjudiciable"}, {"orientation_angle": 0, "polygon": [[307.0, 562.0], [560.0, 566.0], [559.0, 614.0], [306.0, 610.0]], "score": 0.9783003926277161, "text": "à la société."}, {"orientation_angle": 0, "polygon": [[307.0, 666.0], [2210.0, 679.0], [2209.0, 730.0], [306.0, 718.0]], "score": 0.9926128387451172, "text": "En cas de démission du commissaire aux comptes titulaire, le commissaire aux comptes"}, {"orientation_angle": 0, "polygon": [[307.0, 721.0], [2210.0, 728.0], [2209.0, 781.0], [306.0, 774.0]], "score": 0.9884619116783142, "text": "suppléant accède de plein droit aux fonctions de ce dernier pour la durée restant à courir du"}, {"orientation_angle": 0, "polygon": [[308.0, 776.0], [698.0, 776.0], [698.0, 822.0], [308.0, 822.0]], "score": 0.9991455078125, "text": "mandat de celui-ci."}, 