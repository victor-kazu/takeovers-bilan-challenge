{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[176.0, 364.0], [219.0, 364.0], [219.0, 417.0], [176.0, 417.0]], "score": 0.5261133313179016, "text": "I"}, {"orientation_angle": 0, "polygon": [[6047.0, 828.0], [6228.0, 828.0], [6228.0, 962.0], [6047.0, 962.0]], "score": 0.9997692108154297, "text": "26"}, {"orientation_angle": 0, "polygon": [[1913.0, 1245.0], [6214.0, 1259.0], [6213.0, 1403.0], [1912.0, 1388.0]], "score": 0.9924639463424683, "text": "En cas de décès, de refus ou d'empêchement de l'un des arbitres désignés, il sera"}, {"orientation_angle": 0, "polygon": [[1264.0, 1412.0], [5479.0, 1412.0], [5479.0, 1542.0], [1264.0, 1542.0]], "score": 0.9740802049636841, "text": "procédé à son remplacement dans les mêmes formes que pour sa nomination."}, {"orientation_angle": 0, "polygon": [[1917.0, 1838.0], [6209.0, 1853.0], [6209.0, 1987.0], [1917.0, 1972.0]], "score": 0.9946459531784058, "text": "Le Tribunal arbitral procèdera librement à l'instruction du litige, sans être tenu de"}, {"orientation_angle": 0, "polygon": [[1254.0, 1996.0], [6204.0, 2006.0], [6204.0, 2135.0], [1254.0, 2126.0]], "score": 0.9936538338661194, "text": "suivre les règles applicables aux instances judiciaires : il statuera comme amiable compositeur,"}, {"orientation_angle": 0, "polygon": [[1255.0, 2144.0], [2246.0, 2155.0], [2245.0, 2274.0], [1254.0, 2264.0]], "score": 0.9998571872711182, "text": "en dernier ressort"}, {"orientation_angle": 0, "polygon": [[1913.0, 2580.0], [6204.0, 2595.0], [6204.0, 2724.0], [1912.0, 2710.0]], "score": 0.9888372421264648, "text": "Il devra rendre sa sentence dans les quatre mois de la date d'acceptation de ses"}, {"orientation_angle": 0, "polygon": [[1250.0, 2734.0], [5923.0, 2739.0], [5923.0, 2873.0], [1249.0, 2868.0]], "score": 0.985247015953064, "text": "fonctions par le troisième arbitre, sauf prorogation de ce délai avec l'accord des parties."}, {"orientation_angle": 0, "polygon": [[1912.0, 3169.0], [5737.0, 3174.0], [5737.0, 3303.0], [1912.0, 3299.0]], "score": 0.9912788271903992, "text": "Les honoraires des arbitres seront supportés également par les parties."}, {"orientation_angle": 0, "polygon": [[1917.0, 3610.0], [6209.0, 3620.0], [6209.0, 3749.0], [1917.0, 3739.0]], "score": 0.9954502582550049, "text": "En outre, la partie qui s'opposerait à l'exécution de la sentence supporterait seule"}, {"orientation_angle": 0, "polygon": [[1259.0, 3768.0], [3610.0, 3768.0], [3610.0, 3883.0], [1259.0, 3883.0]], "score": 0.9980719089508057, "text": "les frais de toute nature qui en résulteraient"}, {"orientation_angle": 0, "polygon": [[3681.0, 4208.0], [3796.0, 4208.0], [3796.0, 4318.0], [3681.0, 4318.0]], "score": 0.9993908405303955, "text": "*"}], "page": 33, "pdf": "63d9d64bb8ed6f35f60ae627__63d9d64bb8ed6f35f60ae627.pdf", "skew_angle": 0.0}