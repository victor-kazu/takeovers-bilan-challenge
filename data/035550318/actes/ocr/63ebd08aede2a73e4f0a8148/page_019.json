0, 7645.0]], "score": 0.9941264986991882, "text": "Que tous les livres de comptabilité qui se réfèrent auxdites années ont fait l'objet d'un inventaire"}, {"orientation_angle": 0, "polygon": [[1240.0, 7664.0], [2741.0, 7634.0], [2744.0, 7766.0], [1243.0, 7795.0]], "score": 0.98583984375, "text": "par les parties qui les ont visés ;"}, {"orientation_angle": 0, "polygon": [[1245.0, 7931.0], [5867.0, 7860.0], [5869.0, 8000.0], [1247.0, 8072.0]], "score": 0.989078938961029, "text": "Que la société LES VIGNES s'oblige à remettre et à livrer à la société ORTELLI & Cie, aussitôt"}, {"orientation_angle": 0, "polygon": [[1245.0, 8072.0], [5867.0, 8005.0], [5869.0, 8146.0], [1247.0, 8213.0]], "score": 0.9955707788467407, "text": "après la réalisation définitive de la présente fusion, les livres, documents et pièces comptables"}, {"orientation_angle": 0, "polygon": [[1249.0, 8222.0], [1817.0, 8206.0], [1820.0, 8324.0], [1252.0, 8340.0]], "score": 0.9981562495231628, "text": "inventoriés."}, {"orientation_angle": 0, "polygon": [[5682.0, 8808.0], [6382.0, 8808.0], [6382.0, 9399.0], [5682.0, 9399.0]], "score": 0.4137899577617645, "text": "0"}, {"orientation_angle": 0, "polygon": [[5283.0, 8990.0], [5761.0, 8956.0], [5786.0, 9315.0], [5309.0, 9348.0]], "score": 0.7050862312316895, "text": "Go"}], "page": 19, "pdf": "63ebd08aede2a73e4f0a8148__63ebd08aede2a73e4f0a8148.pdf", "skew_angle": 0.0}