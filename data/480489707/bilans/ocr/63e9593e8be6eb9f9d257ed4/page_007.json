orientation_angle": 0, "polygon": [[170.0, 2488.0], [1075.0, 2488.0], [1075.0, 2527.0], [170.0, 2527.0]], "score": 0.9894804954528809, "text": "2 - FRACTION RATTACHÉE AU RÉSULTAT DE L'EXERCICE."}, {"orientation_angle": 0, "polygon": [[169.0, 2558.0], [1338.0, 2558.0], [1338.0, 2592.0], [169.0, 2592.0]], "score": 0.9878795742988586, "text": "3 - FRACTION INCLUSE DANS LA PROVISION SPÉCIALE EN FIN D'EXERCICE"}, {"orientation_angle": 1, "polygon": [[67.0, 2696.0], [93.0, 2696.0], [93.0, 2773.0], [67.0, 2773.0]], "score": 0.7913433909416199, "text": "(IZoz)", "text_original": "(2021)"}, {"orientation_angle": 0, "polygon": [[184.0, 2710.0], [1791.0, 2710.0], [1791.0, 2744.0], [184.0, 2744.0]], "score": 0.9943251013755798, "text": "Le cadre B est servi par les seules entreprises qui ont imputé leurs défcits fiscalement reportables au 31 décembre sur la provision spéciale."}, {"orientation_angle": 1, "polygon": [[59.0, 2770.0], [105.0, 2771.0], [100.0, 3039.0], [53.0, 3038.0]], "score": 0.9988819360733032, "text": "Copyright Groupe ISA"}, {"orientation_angle": 0, "polygon": [[183.0, 2784.0], [2177.0, 2785.0], [2177.0, 2820.0], [183.0, 2818.0]], "score": 0.9891402721405029, "text": "Il est rappelé que cette imputation est purement fiscale et ne modifie pas les montants de la provision spéciale figurant au bilan. De même, les entreprises en cause continuent"}, {"orientation_angle": 0, "polygon": [[148.0, 2821.0], [1460.0, 2821.0], [1460.0, 2856.0], [148.0, 2856.0]], "score": 0.9981397390365601, "text": "à réintégrer chaque année dans leur résultat comptable le supplément d'amortissement consécutif à la réévaluation."}, {"orientation_angle": 0, "polygon": [[184.0, 2895.0], [2208.0, 2897.0], [2208.0, 2931.0], [184.0, 2929.0]], "score": 0.9861977100372314, "text": "Ligne 2, inscrire la partie de ce déficit incluse chaque année dans les montants portés aux colonnes 3 et 4 du cadre A. Cette partie est obtenue en multipliant les montants portés"}, {"orientation_angle": 0, "polygon": [[148.0, 2933.0], [2225.0, 2934.0], [2225.0, 2968.0], [148.0, 2967.0]], "score": 0.997978150844574, "text": "aux colonnes 3 et 4 par une fraction dont les éléments sont fixés au moment de l'imputation, le numérateur étant le montant du déficit imputé et le dénominateur celui de la provision."}, {"orientation_angle": 0, "polygon": [[109.0, 3025.0], [1252.0, 3027.0], [1252.0, 3066.0], [108.0, 3064.0]], "score": 0.9927939176559448, "text": "* Des explications concernant cette rubrique figurent dans la notice n°2032-NOT-SD"}], "page": 7, "pdf": "CA_480489707_8201_2005B00030_2020_181__63e9593e8be6eb9f9d257ed4.pdf", "skew_angle": 0.0}