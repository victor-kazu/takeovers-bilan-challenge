073.0, 4174.0], [6074.0, 4314.0], [1284.0, 4348.0]], "score": 0.9961613416671753, "text": "L'Assemblée est présidée par Monsieur Georges ORTELLI, en sa qualité de Président du Conseil"}, {"orientation_angle": 0, "polygon": [[1287.0, 4353.0], [2131.0, 4342.0], [2132.0, 4469.0], [1289.0, 4479.0]], "score": 0.9713565707206726, "text": "d'Administration."}, {"orientation_angle": 0, "polygon": [[1287.0, 4629.0], [6083.0, 4591.0], [6084.0, 4732.0], [1288.0, 4770.0]], "score": 0.9930195212364197, "text": "Madame Sylvie ORTELLI et Monsieur Jean-Baptiste ORTELLI, les deux actionnaires représentant"}, {"orientation_angle": 0, "polygon": [[1287.0, 4775.0], [6078.0, 4736.0], [6079.0, 4877.0], [1288.0, 4915.0]], "score": 0.9962019920349121, "text": "tant par eux-mêmes que comme mandataires le plus grand nombre de voix et acceptant cette fonction,"}, {"orientation_angle": 0, "polygon": [[1292.0, 4925.0], [2812.0, 4910.0], [2813.0, 5037.0], [1293.0, 5051.0]], "score": 0.9987102150917053, "text": "sont appelés comme scrutateurs."}, {"orientation_angle": 0, "polygon": [[1301.0, 5197.0], [4244.0, 5168.0], [4246.0, 5299.0], [1302.0, 5328.0]], "score": 0.9911962151527405, "text": "Monsieur Jean-Pascal FICHERE est désigné comme secrétaire."}, {"orientation_angle": 0, "polygon": [[1301.0, 5473.0], [6078.0, 5440.0], [6079.0, 5571.0], [1302.0, 5605.0]], "score": 0.9988211989402771, "text": "La feuille de présence, certifiée exacte par les membres du bureau, permet de constater que les"}, {"orientation_angle": 0, "polygon": [[1306.0, 5614.0], [6078.0, 5576.0], [6079.0, 5717.0], [1307.0, 5755.0]], "score": 0.9862410426139832, "text": "actionnaires présents, représentés ou ayant voté par correspondance, possèdent plus du tiers des"}, {"orientation_angle": 0, "polygon": [[1306.0, 5760.0], [2961.0, 5740.0], [2963.0, 5871.0], [1307.0, 5891.0]], "score": 0.9966905117034912, "text": "actions composant le capital social."}, {"orientation_angle": 0, "polygon": [[1301.0, 6027.0], [6092.0, 5998.0], [6093.0, 6139.0], [1302.0, 6168.0]], "score": 0.9926066994667053, "text": "En conséquence, l'Assemblée, réunissant plus que le quorum du tiers requis par la loi, est"}, {"orientation_angle": 0, "polygon": [[1310.0, 6177.0], [3876.0, 6153.0], [3877.0, 6284.0], [1312.0, 6308.0]], "score": 0.9951741099357605, "text": "régulièrement constituée et peut valablement délibérer."}, {"orientation_angle": 0, "polygon": [[1315.0, 6449.0], [6087.0, 6420.0], [6088.0, 6552.0], [1316.0, 6580.0]], "score": 0.9928553104400635, "text": "Monsieur Gérard MARY, Commissaire aux Comptes titulaire, régulièrement convoqué par lettre"}, {"orientation_angle": 0, "polygon": [[1315.0, 6599.0], [5784.0, 6561.0], [5785.0, 6688.0], [1316.0, 6726.0]], "score": 0.9919759631156921, "text": "recommandée avec demande d'avis de réception en date du 5 décembre 1996, est absent excusé."}, {"orientation_angle": 0, "polygon": [[1320.0, 6876.0], [5369.0, 6842.0], [5370.0, 6969.0], [1321.0, 7002.0]], "score": 0.9923773407936096, "text": "Le Président dépose sur le bureau et met à la disposition des membres de l'Assemblée :"}, {"orientation_angle": 0, "polygon": [[1329.0, 7157.0], [6092.0, 7119.0], [6093.0, 7246.0], [1330.0, 7284.0]], "score": 0.9894991517066956, "text": "- la copie des lettres recommandées de convocation adressées aux actionnaires et les récépissés"}, {"orientation_angle": 0, "polygon": [[1366.0, 7308.0], [1808.0, 7297.0], [1811.0, 7428.0], [1369.0, 7439.0]], "score": 0.9991008043289185, "text": "postaux,"}, {"orientation_angle": 0, "polygon": [[1325.0, 7434.0], [5458.0, 7405.0], [5458.0, 7532.0], [1325.0, 7560.0]], "score": 0.9935368895530701, "text": "- la copie et l'avis de réception de la lettre de convocation du Commissaire aux Comptes,"}, {"orientation_angle": 0, "polygon": [[1325.0, 7570.0], [5616.0, 7536.0], [5617.0, 7677.0], [1326.0, 7711.0]], "score": 0.9918120503425598, "text": "- la feuille de présence, les pouvoirs des actionnaires représentés, et la liste des actionnaires,"}, {"ori