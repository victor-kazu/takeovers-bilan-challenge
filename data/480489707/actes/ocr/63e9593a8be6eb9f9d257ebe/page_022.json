[446.0, 2258.0]], "score": 0.9921389222145081, "text": "comptes consolidés) et affectation des résultats ;"}, {"orientation_angle": 0, "polygon": [[446.0, 2258.0], [1598.0, 2265.0], [1598.0, 2318.0], [446.0, 2311.0]], "score": 0.9996585249900818, "text": "approbation des rapports du commissaire aux comptes ;"}, {"orientation_angle": 0, "polygon": [[446.0, 2309.0], [997.0, 2317.0], [997.0, 2365.0], [446.0, 2357.0]], "score": 0.9947810173034668, "text": "distribution de dividendes ;"}, {"orientation_angle": 0, "polygon": [[445.0, 2364.0], [1211.0, 2371.0], [1210.0, 2423.0], [444.0, 2416.0]], "score": 0.9961137771606445, "text": "paiement des dividendes en actions ;"}, {"orientation_angle": 0, "polygon": [[445.0, 2419.0], [1352.0, 2425.0], [1352.0, 2476.0], [444.0, 2471.0]], "score": 0.9834412336349487, "text": "achat par la société de ses propres actions ;"}, {"orientation_angle": 0, "polygon": [[445.0, 2474.0], [1319.0, 2479.0], [1319.0, 2526.0], [444.0, 2520.0]], "score": 0.9994774460792542, "text": "extension ou modification de l'objet social ;"}, {"orientation_angle": 0, "polygon": [[443.0, 2525.0], [1686.0, 2531.0], [1686.0, 2582.0], [443.0, 2577.0]], "score": 0.9989233016967773, "text": "augmentation, amortissement ou réduction du capital social ;"}, {"orientation_angle": 0, "polygon": [[443.0, 2577.0], [1703.0, 2586.0], [1703.0, 2637.0], [442.0, 2628.0]], "score": 0.9884501695632935, "text": "opérations de fusion ou d'apport partiel d'actif ou de scission ;"}, {"orientation_angle": 0, "polygon": [[443.0, 2628.0], [1039.0, 2634.0], [1038.0, 2685.0], [442.0, 2680.0]], "score": 0.9997250437736511, "text": "transformation de la société ;"}, {"orientation_angle": 0, "polygon": [[441.0, 2683.0], [1219.0, 2685.0], [1219.0, 2738.0], [441.0, 2736.0]], "score": 0.9997274875640869, "text": "prorogation de la durée de la société ;"}, {"orientation_angle": 0, "polygon": [[441.0, 2733.0], [965.0, 2738.0], [964.0, 2791.0], [441.0, 2786.0]], "score": 0.9803667664527893, "text": "dissolution de la société ;"}, {"orientation_angle": 1, "polygon": [[377.0, 2759.0], [386.0, 2765.0], [380.0, 2774.0], [370.0, 2768.0]], "score": 0.41135072708129883, "text": "-"}, {"orientation_angle": 0, "polygon": [[441.0, 2788.0], [1488.0, 2793.0], [1488.0, 2846.0], [441.0, 2841.0]], "score": 0.9989975094795227, "text": "et, plus généralement, toute modification statutaire."}, {"orientation_angle": 0, "polygon": [[291.0, 2892.0], [2191.0, 2908.0], [2190.0, 2959.0], [291.0, 2943.0]], "score": 0.987221360206604, "text": "Toute autre décision relève de la compétence du Président et/ou du directeur général, sous"}, {"orientation_angle": 0, "polygon": [[291.0, 2945.0], [1369.0, 2954.0], [1369.0, 3005.0], [291.0, 2997.0]], "score": 0.9940275549888611, "text": "réserve de ce qui est prévu à l'article 15.3.3 ci-avant."}, {"orientation_angle": 0, "polygon": [[2127.0, 3283.0], [2191.0, 3283.0], [2191.0, 3336.0], [2127.0, 3336.0]], "score": 0.9998406767845154, "text": "16"}], "page": 22, "pdf": "63e9593a8be6eb9f9d257ebe__63e9593a8be6eb9f9d257ebe.pdf", "skew_angle": 0.0}