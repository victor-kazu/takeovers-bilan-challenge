entation_angle": 0, "polygon": [[416.0, 2412.0], [607.0, 2417.0], [605.0, 2473.0], [415.0, 2469.0]], "score": 0.9999349117279053, "text": "stockage."}]}, {"bbox": [403.9608154296875, 753.4886474609375, 2201.66650390625, 922.385009765625], "label": "text", "score": 0.9761675596237183, "texts": [{"orientation_angle": 0, "polygon": [[410.0, 762.0], [2204.0, 753.0], [2205.0, 806.0], [410.0, 815.0]], "score": 0.9881392121315002, "text": "La valeur brute des éléments corporels de l'actif immobilisé correspond à la valeur"}, {"orientation_angle": 0, "polygon": [[412.0, 819.0], [2206.0, 810.0], [2206.0, 861.0], [412.0, 870.0]], "score": 0.991527259349823, "text": "d'entrée des biens dans le patrimoine compte tenu des frais nécessaires à la mise en état"}, {"orientation_angle": 0, "polygon": [[413.0, 872.0], [2061.0, 866.0], [2062.0, 920.0], [413.0, 925.0]], "score": 0.9947261810302734, "text": "d'utilisation de ces biens, mais à l'exclusion des frais engagés pour leur acquisition."}]}, {"bbox": [409.1416015625, 2640.326171875, 2206.56396484375, 2747.80078125], "label": "text", "score": 0.9623010158538818, "texts": [{"orientation_angle": 0, "polygon": [[420.0, 2646.0], [2208.0, 2646.0], [2208.0, 2692.0], [420.0, 2692.0]], "score": 0.9901444911956787, "text": "Les stocks et en cours ont, le cas échéant, été dépréciés par voie de provision pour tenir"}, {"orientation_angle": 0, "polygon": [[418.0, 2702.0], [1696.0, 2697.0], [1696.0, 2748.0], [419.0, 2754.0]], "score": 0.9795117378234863, "text": "compte de leur valeur actuelle à la date de clôture de l'exercice."}]}, {"bbox": [409.03326416015625, 1896.2952880859375, 2203.60986328125, 2002.1700439453125], "label": "text", "score": 0.934948742389679, "texts": [{"orientation_angle": 0, "polygon": [[417.0, 1901.0], [2206.0, 1897.0], [2206.0, 1945.0], [417.0, 1949.0]], "score": 0.9924768805503845, "text": "Les matières et marchandises ont été évaluées à leur coût d'acquisition selon la méthode"}, {"orientation_angle": 0, "polygon": [[420.0, 1957.0], [1047.0, 1957.0], [1047.0, 2004.0], [420.0, 2004.0]], "score": 0.9796072244644165, "text": "du coût d'achat moyen pondéré."}]}, {"bbox": [415.8182373046875, 2986.74853515625, 1724.4471435546875, 3034.171875], "label": "text", "score": 0.9230450987815857, "texts": [{"orientation_angle": 0, "polygon": [[417.0, 2986.0], [1727.0, 2985.0], [1727.0, 3036.0], [417.0, 3038.0]], "score": 0.9996447563171387, "text": "Les créances et dettes ont été évaluées pour leur valeur nominale."}]}, {"bbox": [1679.553466796875, 3348.818359375, 2060.029052734375, 3380.474609375], "label": "footer", "score": 0.9159162640571594, "texts": [{"orientation_angle": 0, "polygon": [[1702.0, 3353.0], [2048.0, 3353.0], [2048.0, 3382.0], [1702.0, 3382.0]], "score": 0.9997053146362305, "text": "Conseil et Audit MOI Mayotte"}]}, {"bbox": [410.7054443359375, 2010.2637939453125, 1980.3489990234375, 2061.4755859375], "label": "text", "score": 0.9052120447158813, "texts": [{"orientation_angle": 0, "polygon": [[415.0, 2010.0], [1984.0, 2009.0], [1984.0, 2062.0], [415.0, 2063.0]], "score": 0.9910847544670105, "text": "Les frais de stockage n'ont pas été pris en compte pour l'évaluation des stocks."}]}, {"bbox": [237.239013671875, 2846.1181640625, 1068.29248046875, 2895.69140625], "label": "paragraph_title", "score": 0.8676639199256897, "texts": [{"orientation_angle": 0, "polygon": [[279.0, 2846.0], [1032.0, 2844.0], [1032.0, 2896.0], [279.0, 2897.0]], "score": 0.9971235990524292, "text": "Evaluation des créances et des dettes"}]}, {"bbox": [251.226806640625, 2501.774658203125, 786.492431640625, 2548.973388671875], "label": "paragraph_title", "score": 0.8493330478668213, "texts": [{"orientation_angle": 0, "polygon": [[277.0, 2502.0], [765.0, 2502.0], [765.0, 2553.0], [277.0, 2553.0]], "score": 0.9997711777687073, "text": "Dépréciation des stocks"}]}, {"bbox": [221.93121337890625, 617.764892578125, 1195.17431640625, 669.470947265625], "label": "paragraph_title", "score": 0.7862194180488586, 