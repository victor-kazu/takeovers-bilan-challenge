{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[5846.0, 784.0], [5928.0, 784.0], [5928.0, 883.0], [5846.0, 883.0]], "score": 0.9999561309814453, "text": "4"}, {"orientation_angle": 0, "polygon": [[2661.0, 1053.0], [4239.0, 1053.0], [4239.0, 1181.0], [2661.0, 1181.0]], "score": 0.9888425469398499, "text": "Article 3 - DENOMINATION"}, {"orientation_angle": 0, "polygon": [[1645.0, 1615.0], [3581.0, 1615.0], [3581.0, 1742.0], [1645.0, 1742.0]], "score": 0.9985755085945129, "text": "La dénomination de la société est :"}, {"orientation_angle": 0, "polygon": [[1769.0, 2035.0], [3114.0, 2030.0], [3114.0, 2158.0], [1770.0, 2163.0]], "score": 0.9979548454284668, "text": "\"CEROV FORMATION\""}, {"orientation_angle": 0, "polygon": [[1650.0, 2460.0], [5942.0, 2446.0], [5942.0, 2573.0], [1650.0, 2588.0]], "score": 0.987533450126648, "text": "Dans tous documents émanant de la société, cette dénomination doit être"}, {"orientation_angle": 0, "polygon": [[1001.0, 2602.0], [5942.0, 2588.0], [5942.0, 2720.0], [1002.0, 2734.0]], "score": 0.9855243563652039, "text": "précédée ou suivie immédiatement des mots \"Société à Responsabilité Limitée\" ou des"}, {"orientation_angle": 0, "polygon": [[1006.0, 2744.0], [3958.0, 2739.0], [3958.0, 2866.0], [1006.0, 2871.0]], "score": 0.9772912263870239, "text": "initales \"S.A.R.L.\" et de l'énonciation du capital social"}, {"orientation_angle": 0, "polygon": [[1821.0, 3443.0], [5116.0, 3428.0], [5117.0, 3556.0], [1822.0, 3570.0]], "score": 0.9825840592384338, "text": "ArtiCle 4 - DUREE DE LA SOCIETE - EXERCICE SOCIAL"}, {"orientation_angle": 0, "polygon": [[1664.0, 3863.0], [5956.0, 3848.0], [5956.0, 3976.0], [1665.0, 3990.0]], "score": 0.9887662529945374, "text": "1°) La durée de la société est fixée à 99 années à compter de son"}, {"orientation_angle": 0, "polygon": [[1011.0, 4005.0], [5951.0, 3990.0], [5952.0, 4113.0], [1011.0, 4127.0]], "score": 0.9889009594917297, "text": "immatriculation au Registre du Commerce et des Sociétés, sauf prorogation ou dissolution"}, {"orientation_angle": 0, "polygon": [[1006.0, 4137.0], [1536.0, 4137.0], [1536.0, 4283.0], [1006.0, 4283.0]], "score": 0.9994028210639954, "text": "anticipée."}, {"orientation_angle": 0, "polygon": [[1659.0, 4415.0], [5965.0, 4401.0], [5966.0, 4543.0], [1660.0, 4557.0]], "score": 0.9876550436019897, "text": "2°) L'année sociale commence le 1er Avril de chaque année pour se terminer"}, {"orientation_angle": 0, "polygon": [[1011.0, 4566.0], [1636.0, 4566.0], [1636.0, 4694.0], [1011.0, 4694.0]], "score": 0.9566761255264282, "text": "le 31 Mars."}, {"orientation_angle": 1, "polygon": [[3557.0, 4746.0], [3592.0, 4762.0], [3558.0, 4835.0], [3523.0, 4820.0]], "score": 0.5458860397338867, "text": "w"}, {"orientation_angle": 0, "polygon": [[1674.0, 4982.0], [5961.0, 4968.0], [5961.0, 5095.0], [1674.0, 5110.0]], "score": 0.9864973425865173, "text": "Exceptionnellement, le premier exercice social comprend le temps écoulé depuis"}, {"orientation_angle": 0, "polygon": [[1016.0, 5114.0], [5961.0, 5105.0], [5961.0, 5237.0], [1016.0, 5246.0]], "score": 0.9896037578582764, "text": "l'immatriculation de la société au Registre du Commerce et des Sociétés jusqu'au 31 Mars"}, {"orientation_angle": 0, "polygon": [[1011.0, 5260.0], [1330.0, 5260.0], [1330.0, 5397.0], [1011.0, 5397.0]], "score": 0.9997864961624146, "text": "1998."}, {"orientation_angle": 0, "polygon": [[1669.0, 5667.0], [5970.0, 5652.0], [5971.0, 5794.0], [1669.0, 5808.0]], "score": 0.9935914874076843, "text": "En outre, les actes accomplis pour son compte pendant la période de constitution"}, {"orientation_angle": 0, "polygon": [[1030.0, 5823.0], [4005.0, 5798.0], [4006.0, 5926.0], [1031.0, 5950.0]], "score": 0.9878265261650085, "text": "et repris par la société seront rattachés à cet exercice."}, {"orientation_angle": 0, "polygon": [[2994.0, 6498.0], [4010.0, 6488.0], [4011.0, 6620.0], [2996.0, 6630.0]], "score": 0.9640463590621948, "text": "Article 5 - SIEGE"},