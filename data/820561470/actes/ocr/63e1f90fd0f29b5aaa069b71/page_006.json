60063171, "text": "Elle fonctionne indifféremment sous la forme de société à responsabilité limitée avec un ou plusieurs"}, {"orientation_angle": 0, "polygon": [[369.0, 1102.0], [530.0, 1102.0], [530.0, 1145.0], [369.0, 1145.0]], "score": 0.9997084736824036, "text": "associés."}, {"orientation_angle": 0, "polygon": [[367.0, 1221.0], [791.0, 1227.0], [790.0, 1275.0], [367.0, 1269.0]], "score": 0.9973312616348267, "text": "ARTICLE 2 - OBJET"}, {"orientation_angle": 0, "polygon": [[365.0, 1323.0], [1304.0, 1331.0], [1303.0, 1381.0], [365.0, 1372.0]], "score": 0.9862886071205139, "text": "La Société a pour objet en France et dans tous pays :"}, {"orientation_angle": 0, "polygon": [[507.0, 1424.0], [2179.0, 1436.0], [2178.0, 1484.0], [506.0, 1472.0]], "score": 0.989112377166748, "text": "Toutes activités de fabrication et de commercialisation de produits liés à la chocolaterie, la"}, {"orientation_angle": 0, "polygon": [[507.0, 1475.0], [980.0, 1481.0], [980.0, 1534.0], [506.0, 1528.0]], "score": 0.9818369746208191, "text": "confiserie et la pâtisserie ;"}, {"orientation_angle": 0, "polygon": [[507.0, 1566.0], [1581.0, 1573.0], [1581.0, 1621.0], [506.0, 1614.0]], "score": 0.9990149140357971, "text": "Toute activité de glacier, salon de thé, traiteur, sandwicherie"}, {"orientation_angle": 0, "polygon": [[441.0, 1590.0], [456.0, 1590.0], [456.0, 1600.0], [441.0, 1600.0]], "score": 0.27656129002571106, "text": "E"}, {"orientation_angle": 0, "polygon": [[505.0, 1653.0], [2179.0, 1667.0], [2178.0, 1714.0], [504.0, 1700.0]], "score": 0.9938046336174011, "text": "le tout directement ou indirectement, par voie de création de sociétés et groupements"}, {"orientation_angle": 0, "polygon": [[506.0, 1708.0], [2179.0, 1717.0], [2178.0, 1763.0], [506.0, 1754.0]], "score": 0.995802640914917, "text": "nouveaux, d'apport, de commandite, de souscription, d'achat de titres ou droits sociaux, de"}, {"orientation_angle": 0, "polygon": [[507.0, 1758.0], [2177.0, 1770.0], [2177.0, 1816.0], [506.0, 1804.0]], "score": 0.9882197976112366, "text": "fusion, d'alliance, d'association en participation ou de prise ou de mise en location ou"}, {"orientation_angle": 0, "polygon": [[507.0, 1809.0], [1333.0, 1816.0], [1333.0, 1863.0], [506.0, 1855.0]], "score": 0.9993372559547424, "text": "location-gérance de tous biens et autres droits,"}, {"orientation_angle": 0, "polygon": [[503.0, 1909.0], [2177.0, 1917.0], [2177.0, 1969.0], [503.0, 1960.0]], "score": 0.9908182621002197, "text": "et généralement, toutes opérations industrielles, commerciales, financières, civiles,"}, {"orientation_angle": 0, "polygon": [[505.0, 1960.0], [2175.0, 1970.0], [2175.0, 2018.0], [505.0, 2008.0]], "score": 0.9873409271240234, "text": "mobilières ou immobilières, pouvant se rattacher directement ou indirectement à l'un des"}, {"orientation_angle": 0, "polygon": [[507.0, 2013.0], [1603.0, 2020.0], [1603.0, 2068.0], [506.0, 2061.0]], "score": 0.9969220757484436, "text": "objets visés ci-dessus ou à tous objets similaires ou connexes."}, {"orientation_angle": 0, "polygon": [[362.0, 2136.0], [1002.0, 2140.0], [1002.0, 2188.0], [362.0, 2184.0]], "score": 0.9987115859985352, "text": "ARTICLE 3 - DENOMINATION"}, {"orientation_angle": 0, "polygon": [[360.0, 2236.0], [1307.0, 2239.0], [1307.0, 2286.0], [360.0, 2282.0]], "score": 0.9996668100357056, "text": "La dénomination de la Société est : SARL PAUTET"}, {"orientation_angle": 0, "polygon": [[360.0, 2325.0], [2175.0, 2334.0], [2175.0, 2380.0], [360.0, 2371.0]], "score": 0.9933601021766663, "text": "Dans tous les actes et documents émanant de la Société, la dénomination sociale doit être précédée"}, {"orientation_angle": 0, "polygon": [[358.0, 2376.0], [2174.0, 2385.0], [2173.0, 2433.0], [358.0, 2424.0]], "score": 0.9957426190376282, "text": "ou suivie immédiatement des mots \"société à responsabilité limitée\" ou des initiales \"S.A.R.L,\" et de"}, {"orientation_angle": 0, "polygon": [[357.0, 2426.0], [1121.0, 2431.0], [1121.0, 2483.0], [356.0, 2477.0]], "score": 0.9894528985023499, "text": "l'énonciation du montant du capital social."}, {"orientation_angle": 0, "polygon": [[358.0, 2553.0], [949.0, 2556.0], [949.0, 2603.0], [358.0, 2599.0]], "score": 0.9939220547676086, "text": "ARTICLE 4 - SIEGE SOCIAL"}, {"orientation_angle": 0, "polygon": [[355.0, 2652.0], [2008.0, 2659.0], [2008.0, 2711.0], [355.0, 2704.0]], "score": 0.9744669198989868, "text": "Le siège sOcial est fixé à ROUVRES EN PLAINE (21110) 4 RUE DE LA TOURNELLE"}, {"orientation_angle": 0, "polygon": [[355.0, 2752.0], [2175.0, 2764.0], [2175.0, 2815.0], [355.0, 2803.0]], "score": 0.9816327691078186, "text": "Il peut être transféré soit par décision de l'associé unique, soit, en cas de pluralité d'associés, par"}, {"orientation_angle": 0, "polygon": [[357.0, 2805.0], [1190.0, 2808.0], [1190.0, 2855.0], [356.0, 2851.0]], "score": 0.9994370341300964, "text": "décision collective extraordinaire des associés."}, {"orientation_angle": 0, "polygon": [[358.0, 2932.0], [789.0, 2932.0], [789.0, 2978.0], [358.0, 2978.0]], "score": 0.9922107458114624, "text": "ARTICLE 5 - DUREE"}, {"orientation_angle": 0, "polygon": [[355.0, 3027.0], [2177.0, 3040.0], [2177.0, 3086.0], [355.0, 3074.0]], "score": 0.9973790645599365, "text": "La durée de la Société est fixée à quatre-vingt-dix-neuf années à compter de la date de son"}, {"orientation_angle": 0, "polygon": [[357.0, 3081.0], [2153.0, 3093.0], [2153.0, 3139.0], [356.0, 3127.0]], "score": 0.9972963929176331, "text": "immatriculation au Registre du Commerce et des Sociétés, sauf dissolution anticipée ou prorogation."}, {"orientation_angle": 0, "polygon": [[1038.0, 3233.0], [1490.0, 3233.0], [1490.0, 3274.0], [1038.0, 3274.0]], "score": 0.9997588992118835, "text": "STATUTS SARL PAUTET"}, {"orientation_angle": 1, "polygon": [[2041.0, 3315.0], [2168.0, 3315.0], [2168.0, 3420.0], [2041.0, 3420.0]], "score": 0.219497412443161, "text": "X"}, {"orientation_angle": 1, "polygon": [[2139.0, 3314.0], [2347.0, 3314.0], [2347.