ygon": [[1317.0, 7890.0], [5942.0, 7953.0], [5941.0, 8080.0], [1316.0, 8018.0]], "score": 0.9594485759735107, "text": "La libération du surplus doit intervenir en una oy plu-"}, {"orientation_angle": 0, "polygon": [[912.0, 8018.0], [5800.0, 8085.0], [5798.0, 8227.0], [910.0, 8159.0]], "score": 0.9870385527610779, "text": "sieurs fois sur appel du conseil d'administration, dans le"}, {"orientation_angle": 0, "polygon": [[918.0, 8159.0], [1894.0, 8185.0], [1891.0, 8312.0], [914.0, 8286.0]], "score": 0.9459881782531738, "text": "délai légal."}], "page": 13, "pdf": "63f1035e3f2ad069a6132805__63f1035e3f2ad069a6132805.pdf", "skew_angle": 0.0}