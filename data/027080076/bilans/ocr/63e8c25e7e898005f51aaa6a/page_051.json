{"orientation_angle": 0, "polygon": [[475.0, 2296.0], [2222.0, 2291.0], [2222.0, 2337.0], [475.0, 2342.0]], "score": 0.9924855828285217, "text": "mais aussi un petit ensemble collectif d'une douzaine de logements environ, et la viabilisation des lots nus"}, {"orientation_angle": 0, "polygon": [[474.0, 2346.0], [2220.0, 2341.0], [2220.0, 2387.0], [474.0, 2392.0]], "score": 0.9892904758453369, "text": "destinés à la revente. Cette opération permettrait non seulement de favoriser la mixité sociale, mais aussi"}, {"orientation_angle": 0, "polygon": [[475.0, 2396.0], [1080.0, 2394.0], [1080.0, 2442.0], [475.0, 2444.0]], "score": 0.9866029024124146, "text": "assurerait une mixité générationnelle."}, {"orientation_angle": 0, "polygon": [[475.0, 2451.0], [2220.0, 2445.0], [2220.0, 2492.0], [475.0, 2497.0]], "score": 0.9914282560348511, "text": "Opération de Réhabilitation : 19 rue des impasses à Souché (réhabilitation d'une longère en 4 appartements"}, {"orientation_angle": 0, "polygon": [[477.0, 2500.0], [2220.0, 2495.0], [2220.0, 2543.0], [477.0, 2548.0]], "score": 0.9923185706138611, "text": "plus la constructrion de 8 logements neufs en villas individuelles) et la démolition/reconstruction de la maison"}, {"orientation_angle": 0, "polygon": [[477.0, 2552.0], [1516.0, 2552.0], [1516.0, 2598.0], [477.0, 2598.0]], "score": 0.9985025525093079, "text": "Bobois située rue de Ribray (potentiel d'environ 7 à 9 logements)"}, {"orientation_angle": 1, "polygon": [[2416.0, 2555.0], [2434.0, 2555.0], [2434.0, 2571.0], [2416.0, 2571.0]], "score": 0.5250117182731628, "text": "-"}, {"orientation_angle": 0, "polygon": [[475.0, 2603.0], [1412.0, 2602.0], [1412.0, 2650.0], [475.0, 2652.0]], "score": 0.9948068261146545, "text": "Producteur logement neuve Village Seniors aux Brizeaux."}, {"orientation_angle": 0, "polygon": [[372.0, 2928.0], [1197.0, 2924.0], [1197.0, 2978.0], [372.0, 2981.0]], "score": 0.9868096709251404, "text": "III - AUTRES INFORMATIONS"}, {"orientation_angle": 1, "polyg