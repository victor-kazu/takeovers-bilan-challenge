02.0, 4041.0]], "score": 0.9902110695838928, "text": "TEMPORAIREMENT DELEGUE DANS LES FONCTIONS DE PRESIDENT"}, {"orientation_angle": 0, "polygon": [[1712.0, 4213.0], [6414.0, 4228.0], [6414.0, 4376.0], [1712.0, 4361.0]], "score": 0.9881772994995117, "text": "En cas d'empêchement ou de décès du Président, l'administrateur délégué dans ces"}, {"orientation_angle": 0, "polygon": [[1302.0, 4361.0], [6419.0, 4381.0], [6418.0, 4529.0], [1302.0, 4510.0]], "score": 0.9889405369758606, "text": "fonctions en vertu de l'article 112 de la loi du 24 juillet 1966, aurait droit à une"}, {"orientation_angle": 0, "polygon": [[1307.0, 4529.0], [6424.0, 4544.0], [6423.0, 4687.0], [1307.0, 4673.0]], "score": 0.9875197410583496, "text": "rémunération fixée par le conseil d'administration, et, en outre, sur justification, au"}, {"orientation_angle": 0, "polygon": [[1302.0, 4687.0], [4893.0, 4692.0], [4893.0, 4840.0], [1302.0, 4835.0]], "score": 0.9913000464439392, "text": "remboursement de ses frais de représentation et de déplacement"}, {"orientation_angle": 0, "polygon": [[1717.0, 4989.0], [6419.0, 5003.0], [6418.0, 5147.0], [1717.0, 5132.0]], "score": 0.9898033142089844, "text": "En ce qui concerne le Président empêché, le conseil déciderait en considération de"}, {"orientation_angle": 0, "polygon": [[1307.0, 5137.0], [6419.0, 5156.0], [6418.0, 5300.0], [1306.0, 5281.0]], "score": 0.9888272881507874, "text": "la durée et des circonstances de l'empêchement s'il y a lieu de réduire sa rémunération et,"}, {"orientation_angle": 0, "polygon": [[1312.0, 5300.0], [5346.0, 5310.0], [5346.0, 5444.0], [1311.0, 5434.0]], "score": 0.9929484128952026, "text": "dans l'affirmative, fixerait le montant et les modalités de cette réduction."}, {"orientation_angle": 0, "polygon": [[2055.0, 5822.0], [5656.0, 5827.0], [5656.0, 5961.0], [2055.0, 5956.0]], "score": 0.9950783252716064, "text": "EXAMEN ET ARRETE DES COMPTES DE L'EXERCICE"}, {"orientation_angle": 0, "polygon": [[3138.0, 5989.0], [4583.0, 5989