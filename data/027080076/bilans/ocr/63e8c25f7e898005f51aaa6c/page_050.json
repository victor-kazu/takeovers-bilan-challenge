37.0, 2617.0], [327.0, 2619.0]], "score": 0.9893196821212769, "text": "laissant apparaître la comptabilisation distincte des activités agréées."}]}, {"bbox": [315.907470703125, 1513.04248046875, 2140.558837890625, 1678.59521484375], "label": "text", "score": 0.973678708076477, "texts": [{"orientation_angle": 0, "polygon": [[327.0, 1521.0], [2145.0, 1521.0], [2145.0, 1567.0], [327.0, 1567.0]], "score": 0.9859727621078491, "text": "Conformément à l'article 96 de la loi de finance 2004, la SEMlE peut désormais bénéficier du même"}, {"orientation_angle": 0, "polygon": [[323.0, 1576.0], [2145.0, 1572.0], [2145.0, 1624.0], [323.0, 1627.0]], "score": 0.9832369089126587, "text": "régime fiscal que les organismes d'HLM à savoir : l’exonération de l'impôt sur les sociétés pour l’activité"}, {"orientation_angle": 0, "polygon": [[321.0, 1631.0], [672.0, 1627.0], [672.0, 1680.0], [322.0, 1684.0]], "score": 0.9997769594192505, "text": "de logement social."}]}, {"bbox": [316.1307373046875, 955.205078125, 2022.4407958984375, 1241.656005859375], "label": "text", "score": 0.9731193780899048, "texts": [{"orientation_angle": 0, "polygon": [[327.0, 966.0], [2026.0, 966.0], [2026.0, 1012.0], [327.0, 1012.0]], "score": 0.9850293397903442, "text": "La Provision pour Gros Entretien est constatée à compter de l'exercice au titre duquel les"}, {"orientation_angle": 0, "polygon": [[327.0, 1021.0], [2026.0, 1017.0], [2026.0, 1069.0], [327.0, 1072.0]], "score": 0.9913034439086914, "text": "dépenses sont programmées et inscrites dans le programme pluriannuel. Une quote-part de la"}, {"orientation_angle": 0, "polygon": [[323.0, 1077.0], [2026.0, 1072.0], [2026.0, 1124.0], [323.0, 1129.0]], "score": 0.9930521249771118, "text": "provision correspondant à l'usage passé du bien sur sa durée d'usage total entre deux périodes"}, {"orientation_angle": 0, "polygon": [[327.0, 1132.0], [2025.0, 1132.0], [2025.0, 1179.0], [327.0, 1179.0]], "score": 0.9870553612709045, "text": "d'entretien est immédiatement constatée pour la période des 3 premières années dès lors que"}, {"orientation_angle": 0, "polygon": [[325.0, 1189.0], [1483.0, 1186.0], [1483.0, 1232.0], [325.0, 1235.0]], "score": 0.9989815354347229, "text": "son inscription dans le Plan Stratégique du Patrimoine est validée."}]}, {"bbox": [319.06005859375, 2122.45556640625, 2140.8525390625, 2231.22119140625], "label": "text", "score": 0.9642665386199951, "texts": [{"orientation_angle": 0, "polygon": [[325.0, 2127.0], [2145.0, 2127.0], [2145.0, 2179.0], [325.0, 2179.0]], "score": 0.9964665770530701, "text": "Cette disposition implique la répartition des charges mixtes entre les différents secteurs. Pour ce faire la"}, {"orientation_angle": 0, "polygon": [[325.0, 2180.0], [1939.0, 2182.0], [1939.0, 2234.0], [325.0, 2232.0]], "score": 0.985739529132843, "text": "SEMIE a calé l'affectation de ces charges au prorata du chiffre d'affaires de chaque secteur."}]}, {"bbox": [461.04388427734375, 1848.607421875, 2141.068359375, 1950.923828125], "label": "text", "score": 0.9559893608093262, "texts": [{"orientation_angle": 0, "polygon": [[538.0, 1851.0], [2145.0, 1851.0], [2145.0, 1902.0], [538.0, 1902.0]], "score": 0.988908052444458, "text": "Etudes et prestations de services pour les comptes d'autres Seml ou/et les collectivités"}, {"orientation_angle": 0, "polygon": [[533.0, 1904.0], [674.0, 1904.0], [674.0, 1959.0], [533.0, 1959.0]], "score": 0.997658371925354, "text": "locales"}]}, {"bbox": [460.751953125, 1736.6416015625, 2141.614013671875, 1843.1640625], "label": "text", "score": 0.9522247910499573, "texts": [{"orientation_angle": 0, "polygon": [[541.0, 1742.0], [2143.0, 1742.0], [2143.0, 1789.0], [541.0, 1789.0]], "score": 0.9932352900505066, "text": "Gestion des logements des secteurs intermédiaires ou libres : Boule d'Or 24 logements, le"}, {"orientation_angle": 0, "polygon": [[538.0, 1796.0], [1298.0, 1796.0], [1298.0, 1847.0], [538.0, 1847.0]], "score": 0.9744189977645874, "text": "Forum 3 logements, le SDiS 10 log