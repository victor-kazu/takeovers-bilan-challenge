{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[932.0, 239.0], [2165.0, 239.0], [2165.0, 281.0], [932.0, 281.0]], "score": 0.9947324395179749, "text": "Acte de cession de parts sociales Jacques BOCKEL à Véronique SCHOTT"}, {"orientation_angle": 0, "polygon": [[342.0, 340.0], [961.0, 340.0], [961.0, 387.0], [342.0, 387.0]], "score": 0.998529851436615, "text": "4. Agrément des cessionnaires"}, {"orientation_angle": 0, "polygon": [[345.0, 477.0], [2165.0, 477.0], [2165.0, 518.0], [345.0, 518.0]], "score": 0.9905533194541931, "text": "Aux termes de l’article 8 des statuts \"Cession et transmission des parts sociales\" les parts sociales sont librement"}, {"orientation_angle": 0, "polygon": [[345.0, 523.0], [1658.0, 523.0], [1658.0, 564.0], [345.0, 564.0]], "score": 0.9892284274101257, "text": "cessibles entre associés. Ainsi, il n'est pas nécessaire d'agréer la présente cession."}, {"orientation_angle": 0, "polygon": [[343.0, 614.0], [2165.0, 614.0], [2165.0, 653.0], [343.0, 653.0]], "score": 0.9903378486633301, "text": "Toutefois Monsieur Mathieu DOMENEGUETTY et Mr Jérémy BOCKEL ici présents déclarent donner leur"}, {"orientation_angle": 0, "polygon": [[343.0, 660.0], [1189.0, 658.0], [1189.0, 700.0], [344.0, 701.0]], "score": 0.999616801738739, "text": "consentement à la présente cession de parts sociales."}, {"orientation_angle": 0, "polygon": [[342.0, 850.0], [558.0, 850.0], [558.0, 898.0], [342.0, 898.0]], "score": 0.9994882345199585, "text": "5. Cession"}, {"orientation_angle": 0, "polygon": [[343.0, 965.0], [2165.0, 965.0], [2165.0, 1006.0], [343.0, 1006.0]], "score": 0.9819348454475403, "text": "Le cédant cède et transporte, sous les garanties ordinaires de fait et de droit, au cessionnaire qui accepte, 5,30%"}, {"orientation_angle": 0, "polygon": [[345.0, 1013.0], [2163.0, 1009.0], [2163.0, 1050.0], [345.0, 1054.0]], "score": 0.9954321980476379, "text": "du capital social soit 106 parts sociales de la Société, qui lui appartient, avec tous les droits et obligations"}, {"orientation_angle": 0, "polygon": [[347.0, 1059.0], [1010.0, 1059.0], [1010.0, 1098.0], [347.0, 1098.0]], "score": 0.9894700646400452, "text": "attachés dans les proportions ci-dessous :"}, {"orientation_angle": 0, "polygon": [[1306.0, 1149.0], [1507.0, 1149.0], [1507.0, 1190.0], [1306.0, 1190.0]], "score": 0.9998724460601807, "text": "Nombre de"}, {"orientation_angle": 0, "polygon": [[1585.0, 1144.0], [1888.0, 1148.0], [1887.0, 1194.0], [1585.0, 1190.0]], "score": 0.9795840978622437, "text": "Nombre de parts"}, {"orientation_angle": 0, "polygon": [[627.0, 1168.0], [767.0, 1168.0], [767.0, 1216.0], [627.0, 1216.0]], "score": 0.9967969655990601, "text": "Associé"}, {"orientation_angle": 0, "polygon": [[1285.0, 1196.0], [1525.0, 1192.0], [1525.0, 1235.0], [1286.0, 1239.0]], "score": 0.9883171319961548, "text": "parts sociales"}, {"orientation_angle": 0, "polygon": [[1609.0, 1194.0], [1865.0, 1194.0], [1865.0, 1235.0], [1609.0, 1235.0]], "score": 0.9998410940170288, "text": "sociales cédées"}, {"orientation_angle": 0, "polygon": [[627.0, 1252.0], [1018.0, 1248.0], [1019.0, 1295.0], [628.0, 1298.0]], "score": 0.9905868768692017, "text": "Mr Jacques BOCKEL"}, {"orientation_angle": 0, "polygon": [[1355.0, 1250.0], [1457.0, 1250.0], [1457.0, 1295.0], [1355.0, 1295.0]], "score": 0.9999863505363464, "text": "1.700"}, {"orientation_angle": 0, "polygon": [[1700.0, 1249.0], [1775.0, 1249.0], [1775.0, 1297.0], [1700.0, 1297.0]], "score": 0.9999120831489563, "text": "106"}, {"orientation_angle": 0, "polygon": [[627.0, 1319.0], [780.0, 1319.0], [780.0, 1367.0], [627.0, 1367.0]], "score": 0.9998778104782104, "text": "TOTAL"}, {"orientation_angle": 0, "polygon": [[1354.0, 1319.0], [1461.0, 1319.0], [1461.0, 1368.0], [1354.0, 1368.0]], "score": 0.9998809695243835, "text": "1.700"}, {"orientation_angle": 0, "polygon": [[1700.0, 1319.0], [1777.0, 1319.0], [1777.0, 1370.0], [1700.0, 1370.0]], "score": 0.9994616508483887, "text": "106"}, {