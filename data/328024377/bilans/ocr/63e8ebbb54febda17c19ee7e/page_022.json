, {"orientation_angle": 0, "polygon": [[410.0, 1067.0], [2305.0, 1065.0], [2305.0, 1112.0], [410.0, 1113.0]], "score": 0.9906536340713501, "text": "raisonnable que les comptes annuels pris dans leur ensemble ne comportent pas d'anomalies"}, {"orientation_angle": 0, "polygon": [[410.0, 1131.0], [2307.0, 1131.0], [2307.0, 1177.0], [410.0, 1177.0]], "score": 0.9901219606399536, "text": "significatives. L'assurance raisonnable correspond à un niveau élevé d’assurance, sans toutefois garantir"}, {"orientation_angle": 0, "polygon": [[410.0, 1190.0], [2305.0, 1190.0], [2305.0, 1237.0], [410.0, 1237.0]], "score": 0.9905562400817871, "text": "qu'un audit réalisé conformément aux normes d’exercice professionnel permet de systématiquement"}, {"orientation_angle": 0, "polygon": [[412.0, 1257.0], [2305.0, 1257.0], [2305.0, 1298.0], [412.0, 1298.0]], "score": 0.9878683090209961, "text": "détecter toute anomalie significative. Les anomalies peuvent provenir de fraudes ou résulter d’erreurs"}, {"orientation_angle": 0, "polygon": [[412.0, 1319.0], [2305.0, 1319.0], [2305.0, 1360.0], [412.0, 1360.0]], "score": 0.991787314414978, "text": "et sont considérées comme significatives lorsque l’on peut raisonnablement s’attendre à ce qu'elles"}, {"orientation_angle": 0, "polygon": [[412.0, 1381.0], [2305.0, 1381.0], [2305.0, 1427.0], [412.0, 1427.0]], "score": 0.9946973919868469, "text": "puissent, prises individuellement ou en cumulé, influencerles décisions économiques que les"}, {"orientation_angle": 0, "polygon": [[412.0, 1442.0], [1525.0, 1442.0], [1525.0, 1489.0], [412.0, 1489.0]], "score": 0.9868243932723999, "text": "utilisateurs des comptes prennent en se fondant sur ceux-ci."}, {"orientation_angle": 0, "polygon": [[412.0, 1569.0], [2304.0, 1569.0], [2304.0, 1610.0], [412.0, 1610.0]], "score": 0.9875342845916748, "text": "Comme précisé par l’article L.823-10-1 du Code de Commerce, notre mission de certification des"}, {"orientation_angle": 0, "polygon": [[408.0, 1629.0], [2045.0, 1