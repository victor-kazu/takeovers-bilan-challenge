{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[882.0, 811.0], [5831.0, 816.0], [5831.0, 961.0], [882.0, 957.0]], "score": 0.9966187477111816, "text": "& Cie pour 10 actions de LESUEUR INVEST et l'augmentation de capital qui en résulte,"}, {"orientation_angle": 0, "polygon": [[751.0, 1130.0], [5463.0, 1130.0], [5463.0, 1271.0], [751.0, 1271.0]], "score": 0.9965446591377258, "text": "4. Décide que la fusion de LESUEUR & Cie avec LESUEUR INVEST est définitive."}, {"orientation_angle": 0, "polygon": [[756.0, 1449.0], [3074.0, 1449.0], [3074.0, 1590.0], [756.0, 1590.0]], "score": 0.9961298704147339, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[756.0, 1759.0], [2496.0, 1759.0], [2496.0, 1899.0], [756.0, 1899.0]], "score": 0.9746562838554382, "text": "DEUXIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[756.0, 2068.0], [6069.0, 2068.0], [6069.0, 2223.0], [756.0, 2223.0]], "score": 0.9984360337257385, "text": "L'assemblée générale constate que par suite de l'adoption de la résolution qui précède, le capital"}, {"orientation_angle": 0, "polygon": [[765.0, 2228.0], [6069.0, 2223.0], [6069.0, 2368.0], [765.0, 2373.0]], "score": 0.9977388978004456, "text": "social est augmenté d'une somme de 93.750 francs par la création de 250 actions de 375 francs"}, {"orientation_angle": 0, "polygon": [[760.0, 2383.0], [6078.0, 2373.0], [6079.0, 2533.0], [761.0, 2542.0]], "score": 0.9938805103302002, "text": "chacune entièrement libérées, attribuées à l'actionnaire unique de la société LESUEUR"}, {"orientation_angle": 0, "polygon": [[765.0, 2537.0], [5052.0, 2542.0], [5052.0, 2701.0], [765.0, 2697.0]], "score": 0.9917196035385132, "text": "INVEST ; ces actions porteront jouissance à compter du 1er novembre 1995."}, {"orientation_angle": 0, "polygon": [[779.0, 2870.0], [3093.0, 2870.0], [3093.0, 3011.0], [779.0, 3011.0]], "score": 0.9949615597724915, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[784.0, 3189.0], [2556.0, 3189.0], [2556.0, 3330.0], [784.0, 3330.0]], "score": 0.9994818568229675, "text": "TROISIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[770.0, 3503.0], [6093.0, 3513.0], [6092.0, 3668.0], [770.0, 3658.0]], "score": 0.9886220693588257, "text": "L'assemblée générale constate que parmi les biens transmis par la société absorbée figurent"}, {"orientation_angle": 0, "polygon": [[779.0, 3667.0], [5318.0, 3686.0], [5318.0, 3827.0], [779.0, 3808.0]], "score": 0.9821458458900452, "text": "3.820 actions de la société LESUEUR & Cie, que cette société ne peut conserver."}, {"orientation_angle": 0, "polygon": [[788.0, 3991.0], [6097.0, 3991.0], [6097.0, 4132.0], [788.0, 4132.0]], "score": 0.9874947667121887, "text": "En conséquence, l'assemblée générale décide d'annuler les 3.820 actions susvisées et de réduire"}, {"orientation_angle": 0, "polygon": [[784.0, 4141.0], [6097.0, 4151.0], [6097.0, 4291.0], [784.0, 4282.0]], "score": 0.9884622097015381, "text": "le capital d'une somme de 1 432 500 francs correspondant à la valeur des actions annulées; le"}, {"orientation_angle": 0, "polygon": [[798.0, 4301.0], [6102.0, 4301.0], [6102.0, 4455.0], [798.0, 4455.0]], "score": 0.9879248738288879, "text": "capital social de LESUEUR & Cie se trouvant ainsi ramené de 2.169.375 francs à 736 875"}, {"orientation_angle": 0, "polygon": [[792.0, 4440.0], [1186.0, 4452.0], [1181.0, 4612.0], [787.0, 4600.0]], "score": 0.9987908601760864, "text": "francs."}, {"orientation_angle": 0, "polygon": [[798.0, 4770.0], [6107.0, 4774.0], [6107.0, 4920.0], [798.0, 4915.0]], "score": 0.993914008140564, "text": "L'assemblée générale décide que compte tenu de la valeur estimative des actions de LESUEUR"}, {"orientation_angle": 0, "polygon": [[803.0, 4929.0], [6111.0, 4939.0], [6111.0, 5084.0], [802.0, 5074.0]], "score": 0.9889218807220459, "text": "& Cie retenue pour l'apport-fusion (3.052.180 francs) d'une part, le montant de la réduction de"}, {"orientation_angle": 0, "polygon": [[807.0, 5093.0], [6111.0, 5098.0], [6111.0, 5243.0], [807.0, 5239.0]], "score": 0.996051013469696, "text": "capital pour annulation des 3.820 actions (1.432.500 francs) d'autre part, la différence dégagée"}, {"orientation_angle": 0, "polygon": [[813.0, 5243.0], [2631.0, 5258.0], [2630.0, 5403.0], [811.0, 5388.0]], "score": 0.9795308113098145, "text": "soit 1.619.680 frans, s'imputera :"}, {"orientation_angle": 0, "polygon": [[4797.0, 5576.0], [5510.0, 5586.0], [5508.0, 5736.0], [4795.0, 5726.0]], "score": 0.9684770107269287, "text": "3.586 francs"}, {"orientation_angle": 0, "polygon": [[956.0, 5586.0], [2519.0, 5586.0], [2519.0, 5731.0], [956.0, 5731.0]], "score": 0.990013062953949, "text": "sur la prime de fusion, pour"}, {"orientation_angle": 0, "polygon": [[947.0, 5633.0], [984.0, 5633.0], [984.0, 5675.0], [947.0, 5675.0]], "score": 0.7235835194587708, "text": "−"}, {"orientation_angle": 0, "polygon": [[4732.0, 5749.0], [5515.0, 5760.0], [5513.0, 5905.0], [4730.0, 5895.0]], "score": 0.9978654384613037, "text": "95.779 francs"}, {"orientation_angle": 0, "polygon": [[821.0, 5759.0], [3028.0, 5769.0], [3027.0, 5914.0], [821.0, 5904.0]], "score": 0.9910010099411011, "text": "•sur le compte prime d'émission, pour"}, {"orientation_angle": 0, "polygon": [[821.0, 5933.0], [2930.0, 5942.0], [2929.0, 6083.0], [821.0, 6073.0]], "score": 0.9881713390350342, "text": "•sur le compte autres réserves, pour"}, {"orientation_angle": 0, "polygon": [[4568.0, 5928.0], [5519.0, 5938.0], [5518.0, 6083.0], [4567.0, 6073.0]], "score": 0.9994372129440308, "text": "1.520.315 francs"}, {"orientation_angle": 0, "polygon": [[830.0, 6256.0], [3135.0, 6256.0], [3135.0, 6397.0], [830.0, 6397.0]], "score": 0.9987762570381165, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[825.0, 6566.0], [2673.0, 6556.0], [2673.0, 6716.0], [826.0, 6726.0]], "score": 0.9933723211288452, "text": "QUATRIEME RESOLUTION"}