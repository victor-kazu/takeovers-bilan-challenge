": [[350.0, 1110.0], [830.0, 1118.0], [830.0, 1166.0], [349.0, 1158.0]], "score": 0.9970216751098633, "text": "tribunal du siège de la Société."}, {"orientation_angle": 0, "polygon": [[1094.0, 1273.0], [1332.0, 1277.0], [1331.0, 1323.0], [1093.0, 1319.0]], "score": 0.999488890171051, "text": "PUBLICATION"}, {"orientation_angle": 0, "polygon": [[343.0, 1420.0], [496.0, 1420.0], [496.0, 1470.0], [343.0, 1470.0]], "score": 0.9888912439346313, "text": "Article 44"}, {"orientation_angle": 0, "polygon": [[341.0, 1569.0], [2060.0, 1583.0], [2060.0, 1629.0], [341.0, 1615.0]], "score": 0.987151563167572, "text": "Pour faire les dépôts et publications prescrits par la loi, tous pouvoirs sont donnés aux porteurs d'expéditions ou"}, {"orientation_angle": 0, "polygon": [[338.0, 1617.0], [1989.0, 1629.0], [1989.0, 1681.0], [337.0, 1669.0]], "score": 0.9853454232215881, "text": "d'extraits ou de copies, tant des présents statuts que des actes et délibérations constitutifs qui y feront suite."}, {"orientation_angle": 0, "polygon": [[338.0, 1776.0], [872.0, 1780.0], [871.0, 1826.0], [337.0, 1823.0]], "score": 0.9803323745727539, "text": "Fait à Niort, le 18 décembre 2012"}, {"orientation_angle": 0, "polygon": [[335.0, 1925.0], [625.0, 1931.0], [625.0, 1979.0], [334.0, 1973.0]], "score": 0.9995417594909668, "text": "En deux originaux"}, {"orientation_angle": 0, "polygon": [[1152.0, 3118.0], [1219.0, 3118.0], [1219.0, 3170.0], [1152.0, 3170.0]], "score": 0.9999723434448242, "text": "23"}, {"orientation_angle": 0, "polygon": [[2265.0, 3302.0], [2296.0, 3297.0], [2300.0, 3319.0], [2269.0, 3325.0]], "score": 0.7051918506622314, "text": "-. 1"}], "page": 27, "pdf": "64991df024dc95084f0329e3__64991df024dc95084f0329e3.pdf", "skew_angle": 0.0}