rientation_angle": 0, "polygon": [[269.0, 905.0], [2136.0, 906.0], [2136.0, 942.0], [269.0, 941.0]], "score": 0.9897254705429077, "text": "commerciaux, remises, escomptes de règlement et autres éléments similaires sont déduits pour déterminer les coûts d'acquisition."}, {"orientation_angle": 0, "polygon": [[269.0, 1001.0], [2244.0, 1002.0], [2244.0, 1038.0], [269.0, 1037.0]], "score": 0.9947406649589539, "text": "Les produits fabriqués sont valorisés au coût de production comprenant les consommations, les charges directes et indirectes de"}, {"orientation_angle": 0, "polygon": [[270.0, 1050.0], [2248.0, 1050.0], [2248.0, 1085.0], [270.0, 1085.0]], "score": 0.9918721318244934, "text": "production, les amortissements des biens concourant à la production. Le coût de la sous activité est exclu de la valeur des stocks. Les"}, {"orientation_angle": 0, "polygon": [[270.0, 1098.0], [1001.0, 1098.0], [1001.0, 1133.0], [270.0, 1133.0]], "score": 0.9873377084732056, "text": "intérêts sont exclus pour la valorisation des stocks."}, {"orientation_angle": 0, "polygon": [[267.0, 1193.0], [2251.0, 1194.0], [2251.0, 1230.0], [267.0, 1228.0]], "score": 0.996337890625, "text": "Les stocks sont évalués suivant la méthode du premier entré, premier sorti. Pour des raisons pratiques et sauf écart significatif, le dernier"}, {"orientation_angle": 0, "polygon": [[270.0, 1242.0], [725.0, 1242.0], [725.0, 1276.0], [270.0, 1276.0]], "score": 0.9977551698684692, "text": "prix d'achat connu a été retenu."}, {"orientation_angle": 0, "polygon": [[267.0, 1336.0], [2249.0, 1340.0], [2249.0, 1376.0], [267.0, 1372.0]], "score": 0.9951230883598328, "text": "Une dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités indiquées ci-dessus et le cours du"}, {"orientation_angle": 0, "polygon": [[265.0, 1386.0], [2248.0, 1390.0], [2247.0, 1424.0], [265.0, 1420.0]], "score": 0.986964225769043, "text": "jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est prise en compte lorsque cette valeur brute est"}, {"orientation_angle": 0, "polygon": [[269.0, 1436.0], [763.0, 1436.0], [763.0, 1470.0], [269.0, 1470.0]], "score": 0.9939382076263428, "text": "supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[267.0, 1494.0], [494.0, 1494.0], [494.0, 1542.0], [267.0, 1542.0]], "score": 0.999921441078186, "text": "Créances"}, {"orientation_angle": 0, "polygon": [[267.0, 1600.0], [2251.0, 1605.0], [2251.0, 1641.0], [267.0, 1636.0]], "score": 0.997938871383667, "text": "Les créances sont valorisées à leur valeur nominale. Une dépréciation est pratiquée lorsque la valeur d'inventaire est inférieure à la valeur"}, {"orientation_angle": 0, "polygon": [[264.0, 1648.0], [432.0, 1648.0], [432.0, 1689.0], [264.0, 1689.0]], "score": 0.9999264478683472, "text": "comptable."}, {"orientation_angle": 0, "polygon": [[267.0, 1708.0], [985.0, 1712.0], [985.0, 1761.0], [267.0, 1758.0]], "score": 0.9926566481590271, "text": "Frais d'émission des emprunts"}, {"orientation_angle": 0, "polygon": [[264.0, 1816.0], [1731.0, 1818.0], [1731.0, 1859.0], [263.0, 1857.0]], "score": 0.9911302328109741, "text": "Les frais d'émission des emprunts sont pris en compte immédiatement dans les charges de l'exercice."}, {"orientation_angle": 0, "polygon": [[265.0, 1876.0], [1063.0, 1878.0], [1063.0, 1931.0], [265.0, 1929.0]], "score": 0.9873409867286682, "text": "Produits et charges exceptionnels"}, {"orientation_angle": 0, "polygon": [[265.0, 1984.0], [2036.0, 1988.0], [2036.0, 2027.0], [265.0, 2023.0]], "score": 0.9924293160438538, "text": "Les produits et charges exceptionnels tiennent compte des éléments qui ne sont pas liés à l'activité normale de l'entreprise."}, {"orientation_angle": 0, "polygon": [[265.0, 2092.0], [1142.0, 2094.0], [1142.0, 2147.0], [265.0, 2145.0]], "score": 0.9993616342544556, "text": "Crédit d'impôt compétitivité et emploi"}, {"orientation_angle": 0, "polygon": [[265.0, 2200.0], [2242.0, 2205.0], [2242.0, 2245.0], [265.0, 2239.0]], "score": 0.9920295476913452, "text": "Conformément à la recommandation de l'Autorité des normes comptables, le produit du crédit d'impôt compétitivité emploi (CiCE)"}, {"orientation_angle": 0, "polygon": [[265.0, 2250.0], [2115.0, 2251.0], [2115.0, 2293.0], [265.0, 2291.0]], "score": 0.9863271117210388, "text": "correspondant à l'exercice pour un montant de 22 727 euros a été porté au crédit du compte 649 - Charges de personnel - CICE."}, {"orientation_angle": 0, "polygon": [[267.0, 2347.0], [1683.0, 2351.0], [1683.0, 2387.0], [267.0, 2383.0]], "score": 0.9952570796012878, "text": "Ce produit du CiCE comptabilisé à la date de clôture vient en diminution des charges d'exploitation"}, {"orientation_angle": 0, "polygon": [[265.0, 2443.0], [2246.0, 2447.0], [2246.0, 2483.0], [265.0, 2479.0]], "score": 0.9834700226783752, "text": "Le montant de la créance du CiCE définitif au titre de l'année civile 2016 est imputé sur l'impôt sur les sociétés dû au titre de cet exercice"}, {"orientation_angle": 0, "polygon": [[265.0, 2493.0], [1956.0, 2495.0], [1956.0, 2531.0], [265.0, 2529.0]], "score": 0.9922431707382202, "text": "alors que le CiCE théorique couru à la date de clôture sera imputable sur l'impôt sur les sociétés de l'exercice suivant."}, {"orientation_angle": 0, "polygon": [[2016.0, 3297.0], [2231.0, 3293.0], [2232.0, 3373.0], [2018.0, 3378.0]], "score": 0.9972297549247742, "text": "Page7"}, {"orientation_angle": 0, "polygon": [[2036.0, 3303.0], [2105.0, 3303.0], [2105.0, 3321.0], [2036.0, 3321.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[530.0, 3331.0], [940.0, 3331.0], [940.0, 3353.0], [530.0, 3353.0]], "score": 0.9972178936004639, "text": "CERFRANCE MIDI MEDITERRANEE"}, {"orientation_angle": 0, "polygon": [[1025.0, 3327.0], [1691.0, 3327.0], [1691.0, 3357.0], [1025.0, 3357.0]], "score": 0.9111005663871765, "text": "638 Avenue DE LA LIBERATION 13160 CHATEAURENARD"}, {"orientation_angle": 0, "polygon": [[1760.0, 3329.0], [1974.0, 3329.0], [1974.0, 3358.0], [1760.0, 3358.0]], "score": 0.9953786134719849, "text": "Tél. 04 90 26 30 23"}], "page": 10, "pdf": "CA_401009741_8401_1995B40188_2017_9141__63e881148be6eb9f9d1ff970.pdf", "skew_angle": 0.0}