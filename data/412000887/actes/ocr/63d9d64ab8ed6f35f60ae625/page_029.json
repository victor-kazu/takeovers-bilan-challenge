{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[5770.0, 770.0], [5942.0, 770.0], [5942.0, 907.0], [5770.0, 907.0]], "score": 0.9999209046363831, "text": "28"}, {"orientation_angle": 0, "polygon": [[1664.0, 1209.0], [5937.0, 1190.0], [5937.0, 1322.0], [1665.0, 1341.0]], "score": 0.9943089485168457, "text": "2°) Toutefois, la gérance est expressément autorisée à passer et à souscrire,"}, {"orientation_angle": 0, "polygon": [[1001.0, 1351.0], [5946.0, 1327.0], [5947.0, 1473.0], [1002.0, 1497.0]], "score": 0.9912294149398804, "text": "pour le compte de la société en formation, les engagements suivants entrant dans l'objet"}, {"orientation_angle": 0, "polygon": [[1006.0, 1497.0], [3232.0, 1478.0], [3234.0, 1605.0], [1007.0, 1625.0]], "score": 0.994055986404419, "text": "statutaire et conformes à l'intérêt social :"}, {"orientation_angle": 0, "polygon": [[1659.0, 1908.0], [5951.0, 1893.0], [5952.0, 2030.0], [1660.0, 2045.0]], "score": 0.9878842234611511, "text": "- Ouverture d'un compte bancaire auprès du Crédit Mutuel Océan, Agence du"}, {"orientation_angle": 0, "polygon": [[1011.0, 2054.0], [2765.0, 2044.0], [2766.0, 2191.0], [1012.0, 2201.0]], "score": 0.9882988333702087, "text": "CHATEAU D'OLONNE (Vendée)."}, {"orientation_angle": 0, "polygon": [[1664.0, 2470.0], [5956.0, 2451.0], [5956.0, 2592.0], [1665.0, 2612.0]], "score": 0.9849953651428223, "text": "- Acquisition de l'ensemble des éléments d'exploitation de l'établissement"}, {"orientation_angle": 0, "polygon": [[1020.0, 2626.0], [5951.0, 2597.0], [5952.0, 2724.0], [1021.0, 2753.0]], "score": 0.9786386489868164, "text": "d'enseignement de conduite de véhicules à moteur, connu sous le nom \"AUtO-ECOLE"}, {"orientation_angle": 0, "polygon": [[1016.0, 2763.0], [4067.0, 2748.0], [4068.0, 2876.0], [1016.0, 2890.0]], "score": 0.9776424765586853, "text": "CEROV\", moyennant le prix principal de 890.000 Francs."}, {"orientation_angle": 0, "polygon": [[1678.0, 3594.0], [5970.0, 3570.0], [5971.0, 3711.0], [1679.0, 3736.0]], "score": 0.9741486310958862, "text": "3°) La gérance est expressément habilitée à passer et à souscrire dès ce jour"}, {"orientation_angle": 0, "polygon": [[1025.0, 3740.0], [5975.0, 3707.0], [5976.0, 3853.0], [1026.0, 3887.0]], "score": 0.9905111193656921, "text": "pour le compte de la société en formation, les actes et engagements entrant dans l'objet"}, {"orientation_angle": 0, "polygon": [[1025.0, 3887.0], [5965.0, 3863.0], [5966.0, 3990.0], [1026.0, 4014.0]], "score": 0.9829641580581665, "text": "statutaire et conforme à l'intérêt social, à l'exclusion de ceux pour lesqueis l'article 14 requiert,"}, {"orientation_angle": 0, "polygon": [[1030.0, 4033.0], [5975.0, 3999.0], [5976.0, 4127.0], [1031.0, 4161.0]], "score": 0.9878337979316711, "text": "pendant le cours de la vie sociale et dans les rapports entre associés, une autorisation de"}, {"orientation_angle": 0, "polygon": [[1030.0, 4165.0], [2493.0, 4150.0], [2494.0, 4278.0], [1031.0, 4293.0]], "score": 0.9878159761428833, "text": "la collectivité des associés."}, {"orientation_angle": 0, "polygon": [[1688.0, 4434.0], [5979.0, 4410.0], [5980.0, 4552.0], [1689.0, 4576.0]], "score": 0.9925488829612732, "text": "Ces actes et engagements seront réputés avoir été faits et souscrits dès l'origine"}, {"orientation_angle": 0, "polygon": [[1030.0, 4581.0], [5989.0, 4538.0], [5990.0, 4684.0], [1031.0, 4727.0]], "score": 0.9772935509681702, "text": "par la société, après vérification par l'assemblée des associés, postérieurement à"}, {"orientation_angle": 0, "polygon": [[1039.0, 4722.0], [5979.0, 4689.0], [5980.0, 4816.0], [1040.0, 4850.0]], "score": 0.9804714918136597, "text": "l'immatriculation de la société au Registre du Commerce et des Sociétés, de leur conformité"}, {"orientation_angle": 0, "polygon": [[1035.0, 4864.0], [5980.0, 4835.0], [5980.0, 4963.0], [1035.0, 4992.0]], "score": 0.9794251322746277, "text": "avec le mandat ci-dessus défini, et au plus tard par l'approbation des comptes du premier"}, {"orientation_angle": 0, "polygon": [[1039.0, 5011.0], [1868.0, 4995.0], [1870.0, 5113.0], [1041.0, 5129.0]], "score": 0.9996053576469421, "text": "exercice social."}, {"orientation_angle": 0, "polygon": [[1983.0, 5549.0], [5035.0, 5525.0], [5036.0, 5652.0], [1984.0, 5676.0]], "score": 0.9252882599830627, "text": "ArtiCle 31 - NOMINATION DES PREMIERS GERANTS"}, {"orientation_angle": 0, "polygon": [[1712.0, 6101.0], [5722.0, 6072.0], [5723.0, 6214.0], [1713.0, 6243.0]], "score": 0.9985995888710022, "text": "Les premiers gérants de la société nommés sans limitation de durée est :"}, {"orientation_angle": 0, "polygon": [[1717.0, 6654.0], [4716.0, 6644.0], [4716.0, 6786.0], [1717.0, 6795.0]], "score": 0.9608719944953918, "text": "- Monsieur Jean-Marie PREAULT, associé soussigné"}, {"orientation_angle": 0, "polygon": [[1717.0, 6942.0], [4635.0, 6927.0], [4635.0, 7059.0], [1717.0, 7074.0]], "score": 0.9886432886123657, "text": "- Madame Roseline PREAULT, associée soussignée"}, {"orientation_angle": 0, "polygon": [[1731.0, 7353.0], [6008.0, 7333.0], [6009.0, 7475.0], [1731.0, 7494.0]], "score": 0.9848669767379761, "text": "Les gérants ainsi nommés sont tenus de consacrer tout le temps nécessaire aux"}, {"orientation_angle": 0, "polygon": [[1078.0, 7504.0], [1965.0, 7504.0], [1965.0, 7631.0], [1078.0, 7631.0]], "score": 0.9969749450683594, "text": "affaires sociales."}, {"orientation_angle": 0, "polygon": [[4635.0, 7771.0], [5724.0, 7722.0], [5737.0, 8006.0], [4648.0, 8055.0]], "score": 0.8851847052574158, "text": "SP. RP"}, {"orientation_angle": 1, "polygon": [[5103.0, 8112.0], [5815.0, 8033.0], [5846.0, 8307.0], [5134.0, 8386.0]], "score": 0.0, "text": ""}, {"orientation_angle": 1, "polygon": [[4652.0, 8176.0], [5060.0, 8135.0], [5085.0, 8380.0], [4678.0, 8421.0]], "score": 0.9056574106216431, "text": "US"}, {"orientation_angle": 1, "polygon": [[4660.0, 8475.0], [5505.0, 8373.0], [5555.0, 8780.0], [4710.0, 8882.0]], "score": 0.0, "text": ""}],