7.0]], "score": 0.994431734085083, "text": "Les actes ou opérations ci-après limitativement énumérés sont obligatoirement accomplis sur"}, {"orientation_angle": 0, "polygon": [[288.0, 2284.0], [1095.0, 2287.0], [1095.0, 2339.0], [288.0, 2335.0]], "score": 0.9958851933479309, "text": "décision collective des associés, savoir :"}, {"orientation_angle": 0, "polygon": [[288.0, 2400.0], [1070.0, 2404.0], [1069.0, 2452.0], [288.0, 2448.0]], "score": 0.9873411059379578, "text": "21.1. Décisions collectives ordinaires"}, {"orientation_angle": 0, "polygon": [[286.0, 2513.0], [1982.0, 2519.0], [1982.0, 2572.0], [286.0, 2567.0]], "score": 0.9953653216362, "text": "Les décisions collectives ci-après sont qualifiées de décisions collectives ordinaires :"}, {"orientation_angle": 0, "polygon": [[365.0, 2630.0], [1343.0, 2634.0], [1343.0, 2685.0], [365.0, 2681.0]], "score": 0.9991613030433655, "text": "Agrément des cessions et transmission d'actions."}, {"orientation_angle": 0, "polygon": [[362.0, 2686.0], [2206.0, 2695.0], [2206.0, 2747.0], [362.0, 2738.0]], "score": 0.993058979511261, "text": "Nomination et révocation du Président. Fixation des éventuelles limitations de ses pouvoirs."}, {"orientation_angle": 0, "polygon": [[362.0, 2745.0], [1510.0, 2750.0], [1510.0, 2801.0], [362.0, 2796.0]], "score": 0.9951428174972534, "text": "Fixation, le cas échéant, de la rémunération du Président."}, {"orientation_angle": 0, "polygon": [[296.0, 2772.0], [305.0, 2772.0], [305.0, 2783.0], [296.0, 2783.0]], "score": 0.5052576661109924, "text": "•"}, {"orientation_angle": 0, "polygon": [[362.0, 2801.0], [2273.0, 2810.0], [2273.0, 2861.0], [362.0, 2853.0]], "score": 0.9979376792907715, "text": "Le cas échéant, adoption des autorisations préalables à conférer au Président et/ou au Directeur"}, {"orientation_angle": 0, "polygon": [[363.0, 2858.0], [1450.0, 2860.0], [1450.0, 2913.0], [363.0, 2911.0]], "score": 0.9996812343597412, "text": "général conformément à leurs limitations de pouvoirs."}, {