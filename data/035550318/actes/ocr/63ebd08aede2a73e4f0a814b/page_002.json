e": 0, "polygon": [[1313.0, 2824.0], [2198.0, 2840.0], [2196.0, 2975.0], [1311.0, 2959.0]], "score": 0.9918018579483032, "text": "Le 19 décembre,"}, {"orientation_angle": 0, "polygon": [[1319.0, 2973.0], [2002.0, 2989.0], [1999.0, 3129.0], [1315.0, 3113.0]], "score": 0.9996377825737, "text": "A 19 heures,"}, {"orientation_angle": 0, "polygon": [[1308.0, 3253.0], [6114.0, 3292.0], [6113.0, 3437.0], [1307.0, 3398.0]], "score": 0.9942194819450378, "text": "Les actionnaires de la société ORTELLI & CIE, société anonyme au capital de 164 750 €,"}, {"orientation_angle": 0, "polygon": [[1317.0, 3412.0], [6104.0, 3446.0], [6103.0, 3577.0], [1316.0, 3542.0]], "score": 0.9890114665031433, "text": "divisé en 6 590 actions de 25 € chacune, dont le siège est 7, rue des Vignes, 39100"}, {"orientation_angle": 0, "polygon": [[1317.0, 3557.0], [6109.0, 3591.0], [6108.0, 3721.0], [1316.0, 3687.0]], "score": 0.997187077999115, "text": "BREVANS, se sont réunis en Assemblée Générale Extraordinaire, au siège social, sur"}, {"orientation_angle": 0, "polygon": [[1312.0, 3706.0], [6104.0, 3736.0], [6103.0, 3866.0], [1311.0, 3836.0]], "score": 0.9745869636535645, "text": "convocation faite par le Conseil d'Administration selon lettre simple adressée le 4 décembre"}, {"orientation_angle": 0, "polygon": [[1313.0, 3846.0], [2710.0, 3861.0], [2709.0, 3996.0], [1311.0, 3981.0]], "score": 0.993657648563385, "text": "2002 à chaque actionnaire."}, {"orientation_angle": 0, "polygon": [[1308.0, 4130.0], [6104.0, 4160.0], [6103.0, 4304.0], [1307.0, 4275.0]], "score": 0.9913860559463501, "text": "Il a été établi une feuille de présence, qui a été émargée par chaque membre de l'Assemblée"}, {"orientation_angle": 0, "polygon": [[1312.0, 4290.0], [4711.0, 4299.0], [4710.0, 4434.0], [1312.0, 4424.0]], "score": 0.988571047782898, "text": "en entrant en séance, tant en son nom qu'en qualité de mandataire."}, {"orientation_angle": 0, "polygon": [[1308.0, 4564.0], [6104.0, 4598.0], [6103.0, 4743.0], [1307.0, 4709.0]], "score": 0.9810398817062378, "text": "L'Assemblée est présidée par Monsieur Jean-Baptiste ORTELLI, en sa qualité de Président"}, {"orientation_angle": 0, "polygon": [[1313.0, 4713.0], [2806.0, 4734.0], [2804.0, 4864.0], [1311.0, 4843.0]], "score": 0.9997603297233582, "text": "du Conseil d'Administration."}, {"orientation_angle": 0, "polygon": [[1308.0, 4998.0], [6104.0, 5027.0], [6103.0, 5172.0], [1307.0, 5142.0]], "score": 0.9879849553108215, "text": "Madame Sylvie ORTELLI et Monsieur Georges ORTELLI, les deux actionnaires"}, {"orientation_angle": 0, "polygon": [[1307.0, 5152.0], [6104.0, 5172.0], [6103.0, 5316.0], [1307.0, 5297.0]], "score": 0.9813618659973145, "text": "représentant tant par eux-mêmes que comme mandataires le plus grand nombre de voix et"}, {"orientation_angle": 0, "polygon": [[1312.0, 5306.0], [4266.0, 5316.0], [4265.0, 5451.0], [1312.0, 5441.0]], "score": 0.993104875087738, "text": "acceptant cette fonction, sont appelés comme scrutateurs."}, {"orientation_angle": 0, "polygon": [[1303.0, 5581.0], [4563.0, 5601.0], [4562.0, 5746.0], [1302.0, 5726.0]], "score": 0.999252438545227, "text": "Monsieur Jean-Pascal FICHERE est désigné comme secrétaire."}, {"orientation_angle": 0, "polygon": [[1303.0, 5870.0], [6104.0, 5909.0], [6103.0, 6054.0], [1302.0, 6015.0]], "score": 0.9972544312477112, "text": "Monsieur Gérard MARY, Commissaire aux Comptes titulaire, régulièrement convoqué par"}, {"orientation_angle": 0, "polygon": [[1303.0, 6025.0], [6099.0, 6054.0], [6098.0, 6184.0], [1302.0, 6155.0]], "score": 0.9903411865234375, "text": "lettre recommandée avec demande d'avis de réception en date du 4 décembre 2002, est"}, {"orientation_angle": 0, "polygon": [[1302.0, 6179.0], [1743.0, 6179.0], [1743.0, 6319.0], [1302.0, 6319.0]], "score": 0.9996834993362427, "text": "présent."}, {"orientation_angle": 0, "polygon": [[1298.0, 6453.0], [6099.0, 6488.0], [6098.0, 6632.0], [1297.0, 6598.0]], "score": 0.9950829744338989, "text": "La feuille de présence, certifiée exacte par les membres du bureau, permet de constater que"}, {"orientation_angle": 0, "polygon": [[1303.0, 6608.0], [6099.0, 6637.0], [6098.0, 6767.0], [1302.0, 6738.0]], "score": 0.9920995235443115, "text": "tous les actionnaires sont présents ou représentés. En conséquence, l'Assemblée est"}, {"orientation_angle": 0, "polygon": [[1302.0, 6748.0], [4146.0, 6758.0], [4145.0, 6902.0], [1302.0, 6892.0]], "score": 0.9914948344230652, "text": "régulièrement constituée et peut valablement délibérer."}, {"orientation_angle": 0, "polygon": [[1298.0, 7032.0], [5783.0, 7056.0], [5782.0, 7201.0], [1297.0, 7176.0]], "score": 0.9982717037200928, "text": "Le Président dépose sur le bureau et met à la disposition des membres de l'Assemblée :"}, {"orientation_angle": 0, "polygon": [[1308.0, 7326.0], [4677.0, 7351.0], [4677.0, 7481.0], [1307.0, 7456.0]], "score": 0.993584156036377, "text": "- les copies des lettres de convocation adressées aux actionnaires,"}, {"orientation_angle": 0, "polygon": [[1303.0, 7466.0], [5870.0, 7500.0], [5868.0, 7645.0], [1302.0, 7610.0]], "score": 0.9850990176200867, "text": "- la copie et l'avis de réception de la lettre de convocation du Commissaire aux Comptes,"}, {"orientation_angle": 0, "polygon": [[1308.0, 7610.0], [6056.0, 7645.0], [6055.0, 7789.0], [1307.0, 7755.0]], "score": 0.9884215593338013, "text": "- la feuille de présence, les pouvoirs des actionnaires représentés, et la liste des actionnaires,"}, {"orientation_angle": 0, "polygon": [[1303.0, 7760.0], [3409.0, 7775.0], [3408.0, 7910.0], [1302.0, 7895.0]], "score": 0.9960392713546753, "text": "- un exemplaire des statuts de la Société,"}, {"orientation_angle": 0, "polygon": [[1308.0, 7904.0], [3399.0, 7919.0], [3398.0, 8054.0], [1307.0, 8039.0]], "score": 0.9967319965362549, "text": "- le rapport du Conseil d'Administration,"}, {"orientation_angle": 0, "polygon": [[1307.0, 8054.0], [6085.0, 8078.0], [6084.0, 8213.0], [1307.0, 8189.0]], "score": 0.9910573363304138, "text": "- le rapp