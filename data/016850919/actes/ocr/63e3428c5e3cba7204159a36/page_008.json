.0, 5497.0], [1192.0, 5532.0]], "score": 0.9908427000045776, "text": "Conformément aux normes applicables, j'ai vérifié que le montant des"}, {"orientation_angle": 0, "polygon": [[789.0, 5541.0], [5538.0, 5497.0], [5540.0, 5680.0], [790.0, 5724.0]], "score": 0.99435955286026, "text": "Capitaux Propres était au moins égal au montant du Capital Social. Cette"}, {"orientation_angle": 0, "polygon": [[789.0, 5734.0], [5997.0, 5689.0], [5999.0, 5862.0], [790.0, 5907.0]], "score": 0.995456337928772, "text": "vérification consiste notamment à, apprécier l'incidence éventuelle sur la valeur"}, {"orientation_angle": 0, "polygon": [[794.0, 5921.0], [5964.0, 5877.0], [5965.0, 6055.0], [795.0, 6099.0]], "score": 0.9964479804039001, "text": "comptable des éléments entrant dans la détermination des Capitaux Propres des"}, {"orientation_angle": 0, "polygon": [[794.0, 6118.0], [5964.0, 6074.0], [5965.0, 6237.0], [795.0, 6281.0]], "score": 0.9978184700012207, "text": "événements survenus entre la date des derniers comptes annuels et la date de ce"}, {"orientation_angle": 0, "polygon": [[789.0, 6295.0], [1382.0, 6295.0], [1382.0, 6483.0], [789.0, 6483.0]], "score": 0.9994630813598633, "text": "Rapport."}, {"orientation_angle": 0, "polygon": [[1214.0, 6671.0], [5993.0, 6631.0], [5994.0, 6809.0], [1216.0, 6849.0]], "score": 0.996074378490448, "text": "Sur cette base, j'atteste que le montant des Capitaux Propres est au moins"}, {"orientation_angle": 0, "polygon": [[803.0, 6873.0], [3045.0, 6843.0], [3048.0, 7020.0], [805.0, 7051.0]], "score": 0.9862412214279175, "text": "égal au montant du Capital Social"}, {"orientation_angle": 0, "polygon": [[3257.0, 7589.0], [5653.0, 7568.0], [5654.0, 7746.0], [3258.0, 7766.0]], "score": 0.9904088377952576, "text": "Fait à DIJON, le 20 Septembre 2005"}, {"orientation_angle": 1, "polygon": [[3389.0, 8369.0], [4825.0, 8182.0], [4925.0, 8956.0], [3489.0, 9143.0]], "score": 0.19098666310310364, "text": "H"}, {"orientation_angle": 0, "polygon": [[4514.0, 