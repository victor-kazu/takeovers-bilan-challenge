.0, 6485.0], [9137.0, 6594.0], [9133.0, 6808.0], [1901.0, 6699.0]], "score": 0.997860312461853, "text": "Personne ne demandant la parole, le Président met successivement aux voix les résolutions"}, {"orientation_angle": 0, "polygon": [[1899.0, 6705.0], [2772.0, 6730.0], [2766.0, 6930.0], [1893.0, 6905.0]], "score": 0.9996938705444336, "text": "suivantes :"}, {"orientation_angle": 0, "polygon": [[5468.0, 7442.0], [5569.0, 7442.0], [5569.0, 7535.0], [5468.0, 7535.0]], "score": 0.5993764400482178, "text": "O"}, {"orientation_angle": 0, "polygon": [[5160.0, 7877.0], [5260.0, 7877.0], [5260.0, 7970.0], [5160.0, 7970.0]], "score": 0.7658774852752686, "text": "O"}, {"orientation_angle": 1, "polygon": [[5770.0, 7892.0], [5870.0, 7892.0], [5870.0, 7984.0], [5770.0, 7984.0]], "score": 0.5718048214912415, "text": "O"}, {"orientation_angle": 0, "polygon": [[4301.0, 8504.0], [6697.0, 8549.0], [6693.0, 8742.0], [4297.0, 8697.0]], "score": 0.9993428587913513, "text": "PREMIERE RESOLUTION"}, {"orientation_angle": 0, "polygon": [[1854.0, 8882.0], [9137.0, 9006.0], [9133.0, 9241.0], [1850.0, 9118.0]], "score": 0.9836548566818237, "text": "L'Assemblée Générale, après avoir pris connaissance du rapport de gestion du Président et"}, {"orientation_angle": 0, "polygon": [[1861.0, 9125.0], [9115.0, 9241.0], [9112.0, 9455.0], [1858.0, 9339.0]], "score": 0.9792546629905701, "text": "du rapport général du Commissaire aux Comptes, approuve les comptes annuels, à savoir le"}, {"orientation_angle": 0, "polygon": [[1868.0, 9339.0], [9108.0, 9462.0], [9104.0, 9677.0], [1865.0, 9553.0]], "score": 0.9876426458358765, "text": "bilan, le compte de résultat et l'annexe arrêtés le 30 juin 2010, tels qu'ils lui ont été présentés,"}, {"orientation_angle": 0, "polygon": [[1861.0, 9560.0], [8204.0, 9677.0], [8200.0, 9891.0], [1857.0, 9774.0]], "score": 0.9872244596481323, "text": "ainsi que les opérations traduites dans ces comptes et résumées dans ces rapports."}, {"orientation_angle": 0, "polygon": [[1847.0, 9995.0], [9108.0, 10133.0], [9104.0, 10347.0], [1843.0, 10209.0]], "score": 0.994873583316803, "text": "En conséquence, l'Assemblée donne au Président quitus de l'exécution de son mandat pour"}, {"orientation_angle": 0, "polygon": [[1847.0, 10223.0], [3216.0, 10255.0], [3212.0, 10455.0], [1843.0, 10423.0]], "score": 0.9986294507980347, "text": "l'exercice écoulé."}, {"orientation_angle": 0, "polygon": [[1840.0, 10659.0], [9094.0, 10790.0], [9090.0, 11011.0], [1836.0, 10880.0]], "score": 0.9948179721832275, "text": "Elle prend acte que les comptes de l'exercice écoulé ne comportent pas de dépenses non"}, {"orientation_angle": 0, "polygon": [[1840.0, 10880.0], [9022.0, 11011.0], [9018.0, 11232.0], [1836.0, 11101.0]], "score": 0.9929161667823792, "text": "admises dans les charges déductibles au regard de l'article 39, 4 du Code général des impôts."}, {"orientation_angle": 0, "polygon": [[1826.0, 11315.0], [6769.0, 11418.0], [6764.0, 11632.0], [1821.0, 11529.0]], "score": 0.9882544875144958, "text": "Cette résolution est adoptée à l'unanimité des voix des associés."}, {"orientation_angle": 0, "polygon": [[4222.0, 12257.0], [6647.0, 12302.0], [6643.0, 12495.0], [4219.0, 12450.0]], "score": 0.9993215799331665, "text": "DEUXIEME RESOLUTION"}, {"orientation_angle": 0, "polygon": [[1797.0, 12643.0], [9058.0, 12773.0], [9054.0, 12973.0], [1793.0, 12842.0]], "score": 0.9900164008140564, "text": "L'Assemblée Générale décide d'affecter le bénéfice de l'exercice s'élevant à 25 289 € de la"}, {"orientation_angle": 0, "polygon": [[1798.0, 12863.0], [3253.0, 12902.0], [3247.0, 13095.0], [1792.0, 13056.0]], "score": 0.9933671951293945, "text": "manière suivante :"}, {"orientation_angle": 0, "polygon": [[7218.0, 13274.0], [8144.0, 13227.0], [8183.0, 13997.0], [7257.0, 14044.0]], "score": 0.7140781879425049, "text": "J0"}, {"orientation_angle": 0, "polygon": [[8483.0, 14491.0], [9265.0, 14506.0], [9264.0, 14578.0], [8482.0, 14563.0]], "score": 0.961448073387146, "text": "Donnez des