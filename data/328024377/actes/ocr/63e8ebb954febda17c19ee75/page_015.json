{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[1156.0, 308.0], [1400.0, 308.0], [1400.0, 355.0], [1156.0, 355.0]], "score": 0.9809840321540833, "text": "TITRE IV"}, {"orientation_angle": 0, "polygon": [[603.0, 363.0], [1950.0, 367.0], [1949.0, 413.0], [603.0, 409.0]], "score": 0.9907289743423462, "text": "REPRÉSENTATION - ADMINISTRATION ET DIRECTION"}, {"orientation_angle": 0, "polygon": [[279.0, 535.0], [2273.0, 538.0], [2273.0, 595.0], [279.0, 591.0]], "score": 0.9922494888305664, "text": "La société est représentée à l'égard des tiers par un Président et, le cas échéant, par ses Directeurs"}, {"orientation_angle": 0, "polygon": [[281.0, 598.0], [486.0, 598.0], [486.0, 653.0], [281.0, 653.0]], "score": 0.9997933506965637, "text": "généraux."}, {"orientation_angle": 0, "polygon": [[284.0, 756.0], [542.0, 756.0], [542.0, 804.0], [284.0, 804.0]], "score": 0.9677457809448242, "text": "Article 16 -"}, {"orientation_angle": 0, "polygon": [[574.0, 756.0], [870.0, 756.0], [870.0, 804.0], [574.0, 804.0]], "score": 0.9996498823165894, "text": "PRESIDENT"}, {"orientation_angle": 0, "polygon": [[555.0, 771.0], [577.0, 771.0], [577.0, 786.0], [555.0, 786.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[284.0, 872.0], [942.0, 872.0], [942.0, 918.0], [284.0, 918.0]], "score": 0.9998717308044434, "text": "16.1. Nomination du Président"}, {"orientation_angle": 0, "polygon": [[281.0, 987.0], [2273.0, 987.0], [2273.0, 1038.0], [281.0, 1038.0]], "score": 0.9959617257118225, "text": "Le Président, personne morale ou personne physique, associée ou non, est nommé avec ou sans"}, {"orientation_angle": 0, "polygon": [[284.0, 1047.0], [1407.0, 1047.0], [1407.0, 1093.0], [284.0, 1093.0]], "score": 0.9910019636154175, "text": "limitation de durée, par décision collective des associés."}, {"orientation_angle": 0, "polygon": [[284.0, 1160.0], [1204.0, 1162.0], [1204.0, 1210.0], [284.0, 1208.0]], "score": 0.9948651790618896, "text": "16.2. Attributions et pouvoirs du Président"}, {"orientation_angle": 0, "polygon": [[288.0, 1275.0], [887.0, 1275.0], [887.0, 1326.0], [288.0, 1326.0]], "score": 0.9854941368103027, "text": "16.2.1. Direction de la société"}, {"orientation_angle": 0, "polygon": [[282.0, 1391.0], [2273.0, 1390.0], [2273.0, 1443.0], [282.0, 1444.0]], "score": 0.993625819683075, "text": "Dans ses rapports avec les tiers, le Président est investi des pouvoirs les plus étendus pour agir en"}, {"orientation_angle": 0, "polygon": [[282.0, 1450.0], [1688.0, 1446.0], [1688.0, 1497.0], [283.0, 1501.0]], "score": 0.9939522743225098, "text": "toute circonstance au nom de la société dans la limite de l'objet social."}, {"orientation_angle": 0, "polygon": [[282.0, 1563.0], [2275.0, 1563.0], [2275.0, 1619.0], [282.0, 1619.0]], "score": 0.9953444600105286, "text": "La société est engagée même par les actes du Président qui ne relèvent pas de l'objet social, à moins"}, {"orientation_angle": 0, "polygon": [[284.0, 1624.0], [2275.0, 1619.0], [2275.0, 1672.0], [284.0, 1677.0]], "score": 0.9910359978675842, "text": "qu'elle ne prouve que les tiers savaient que l'acte dépassait cet objet ou qu'ils ne pouvaient l'ignorer"}, {"orientation_angle": 0, "polygon": [[284.0, 1683.0], [909.0, 1683.0], [909.0, 1734.0], [284.0, 1734.0]], "score": 0.9998885989189148, "text": "compte tenu des circonstances."}, {"orientation_angle": 0, "polygon": [[284.0, 1794.0], [2273.0, 1792.0], [2273.0, 1844.0], [284.0, 1845.0]], "score": 0.9787631034851074, "text": "A titre de mesure d’ordre interne inopposable au tiers, les associés pourront, par décision collective"}, {"orientation_angle": 0, "polygon": [[284.0, 1854.0], [2273.0, 1850.0], [2273.0, 1904.0], [284.0, 1907.0]], "score": 0.9921358823776245, "text": "adoptée soit lors de sa désignation soit ultérieurement, déterminer les actes et/ou opérations que le"}, {"orientation_angle": 0, "polygon": [[284.0, 1910.0], [1648.0, 1909.0], [1648.0, 1962.0], [284.0, 1964.0]], "score": 0.9818615317344666, "text": "Président ne pourra réaliser sans autorisation préalable des associés."}, {"orientation_angle": 0, "polygon": [[284.0, 2025.0], [2277.0, 2025.0], [2277.0, 2082.0], [284.0, 2082.0]], "score": 0.9952918887138367, "text": "Le Président peut donner toutes délégations de pouvoirs à toute personne de son choix pour un ou"}, {"orientation_angle": 0, "polygon": [[284.0, 2085.0], [849.0, 2082.0], [849.0, 2140.0], [284.0, 2144.0]], "score": 0.9996858239173889, "text": "plusieurs objets déterminés."}, {"orientation_angle": 0, "polygon": [[289.0, 2200.0], [944.0, 2200.0], [944.0, 2251.0], [289.0, 2251.0]], "score": 0.9966734647750854, "text": "16.2.2. Attributions particulières"}, {"orientation_angle": 0, "polygon": [[284.0, 2315.0], [1677.0, 2313.0], [1677.0, 2366.0], [284.0, 2368.0]], "score": 0.9994369745254517, "text": "Le Président sera seul compétent pour adopter les décisions ci-après :"}, {"orientation_angle": 0, "polygon": [[362.0, 2431.0], [2273.0, 2428.0], [2273.0, 2481.0], [362.0, 2484.0]], "score": 0.991825520992279, "text": "Transfert du siège social dans le ressort du même département et des départements limitrophes,"}, {"orientation_angle": 0, "polygon": [[362.0, 2490.0], [1621.0, 2486.0], [1621.0, 2539.0], [362.0, 2543.0]], "score": 0.9908242225646973, "text": "Mise à jour des statuts corrélative aux décisions qui précèdent."}, {"orientation_angle": 0, "polygon": [[294.0, 2514.0], [312.0, 2514.0], [312.0, 2529.0], [294.0, 2529.0]], "score": 0.7566425800323486, "text": "="}, {"orientation_angle": 0, "polygon": [[286.0, 2604.0], [2275.0, 2604.0], [2275.0, 2656.0], [286.0, 2656.0]], "score": 0.9881466031074524, "text": "Ces décisions donneront lieu à la rédaction de procès-verbaux qui seront conservés dans le registre"}, {"orientation_angle": 0, "polygon": [[289.0, 2666.0], [1049.0, 2666.0], [1049.0, 2712.0], [289.0, 2712.0]], "score": 0.9987848997116089, "text": "des décisions collectives des associés."}, {"orientation_angle": 0, "polygon": [[289.0, 2781.0], [1002.0, 2781.0], [1002.0, 2827.0], [289.0, 2827.0]], "score": 0.999618649482727, "text": "16.3. Rémunération du Président"}, {"orientation_angle": 0, "polygon": [[286.0, 2894.0], [2278.0, 2889.0], [2279.0, 2942.0], [286.0, 2947.0]], "score": 0.9920076131820679, "text": "Il appartient aux associés de décider par décision collective si les fonctions de Président donnent"}, {"orientation_angle": 0, "polygon": [[288.0, 2954.0], [1490.0, 2950.0], [1490.0, 2998.0], [288.0, 3002.0]], "score": 0.9936262369155884, "text": "lieu à rémunération et, le cas échéant, d'en fixer le montant."}, {"orientation_angle": 0, "polygon": [[1266.0, 3333.0], [1304.0, 3333.0], [1304.0, 3379.0], [1266.0, 3379.0]], "score": 0.9998134970664978, "text": "9"}], "page": 15, "pdf": "63e8ebb954febda17c19ee75__63e8ebb954febda17c19ee75.pdf", "skew_angle": 0.0}