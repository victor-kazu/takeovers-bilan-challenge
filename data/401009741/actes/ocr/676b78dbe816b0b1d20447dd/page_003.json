{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[298.0, 337.0], [2199.0, 327.0], [2199.0, 373.0], [298.0, 384.0]], "score": 0.9768732190132141, "text": "Les actions rachetées à Monsieur Philippe SILVAiN sont annulées et la réduction du capital social est"}, {"orientation_angle": 0, "polygon": [[300.0, 394.0], [2194.0, 382.0], [2194.0, 428.0], [300.0, 440.0]], "score": 0.9915445446968079, "text": "définitivement réalisée à compter du jour de l’Assemblée Générale Extraordinaire, soit le 31 octobre"}, {"orientation_angle": 0, "polygon": [[298.0, 449.0], [417.0, 449.0], [417.0, 498.0], [298.0, 498.0]], "score": 0.999919056892395, "text": "2024."}, {"orientation_angle": 0, "polygon": [[301.0, 562.0], [1056.0, 556.0], [1056.0, 603.0], [302.0, 608.0]], "score": 0.9981403946876526, "text": "En conséquence, le Président constate :"}, {"orientation_angle": 0, "polygon": [[300.0, 671.0], [1867.0, 661.0], [1867.0, 712.0], [300.0, 723.0]], "score": 0.99024897813797, "text": "- que le capital social est réduit d'une somme de 5.400 euros et fixé à 24.600 euros,"}, {"orientation_angle": 0, "polygon": [[301.0, 730.0], [2199.0, 717.0], [2199.0, 762.0], [302.0, 774.0]], "score": 0.9892930388450623, "text": "- le caractère définitif de la modification statutaire décidée par l’Assemblée Générale Extraordinaire"}, {"orientation_angle": 0, "polygon": [[305.0, 788.0], [690.0, 784.0], [691.0, 827.0], [305.0, 831.0]], "score": 0.9994810223579407, "text": "du 31 octobre 2024."}, {"orientation_angle": 0, "polygon": [[305.0, 954.0], [2203.0, 942.0], [2203.0, 988.0], [305.0, 1000.0]], "score": 0.9943483471870422, "text": "Le Président donne tous pouvoirs au porteur d'un original, d'une copie ou d'un extrait du présent"}, {"orientation_angle": 0, "polygon": [[306.0, 1010.0], [1493.0, 1002.0], [1493.0, 1048.0], [307.0, 1057.0]], "score": 0.9860703349113464, "text": "procès-verbal pour accomplir toutes les formalités nécessaires."}, {"orientation_angle": 0, "polygon": [[308.0, 1120.0], [2053.0, 1110.0], [2053.0, 1158.0], [308.0, 1168.0]], "score": 0.9885603189468384, "text": "De tout ce que dessus, il a été dressé le présent procès-verbal qui a été signé par le Président."}, {"orientation_angle": 0, "polygon": [[1380.0, 1337.0], [1619.0, 1337.0], [1619.0, 1384.0], [1380.0, 1384.0]], "score": 0.9993472695350647, "text": "Le Président"}, {"orientation_angle": 1, "polygon": [[709.0, 1438.0], [1806.0, 1372.0], [1842.0, 1986.0], [745.0, 2051.0]], "score": 0.0, "text": ""}], "page": 3, "pdf": "676b78dbe816b0b1d20447dd__676b78dbe816b0b1d20447dd.pdf", "skew_angle": 0.9829193891732694}