nts :"}, {"orientation_angle": 0, "polygon": [[1316.0, 2220.0], [1961.0, 2220.0], [1961.0, 2266.0], [1316.0, 2266.0]], "score": 0.990939736366272, "text": "Réfaction art. 158-3-2º du C.G.I."}, {"orientation_angle": 0, "polygon": [[494.0, 2259.0], [673.0, 2259.0], [673.0, 2309.0], [494.0, 2309.0]], "score": 0.9998784065246582, "text": "Exercice"}, {"orientation_angle": 0, "polygon": [[861.0, 2261.0], [1169.0, 2261.0], [1169.0, 2308.0], [861.0, 2308.0]], "score": 0.9997363686561584, "text": "Dividende total"}, {"orientation_angle": 0, "polygon": [[1313.0, 2295.0], [1477.0, 2295.0], [1477.0, 2351.0], [1313.0, 2351.0]], "score": 0.9992424249649048, "text": "Eligible"}, {"orientation_angle": 0, "polygon": [[1709.0, 2299.0], [1953.0, 2299.0], [1953.0, 2347.0], [1709.0, 2347.0]], "score": 0.9997679591178894, "text": "Non éligible"}, {"orientation_angle": 0, "polygon": [[474.0, 2361.0], [692.0, 2361.0], [692.0, 2409.0], [474.0, 2409.0]], "score": 0.9999750256538391, "text": "30.06.2020"}, {"orientation_angle": 1, "polygon": [[997.0, 2361.0], [1033.0, 2361.0], [1033.0, 2409.0], [997.0, 2409.0]], "score": 0.9999028444290161, "text": "0", "text_original": "0"}, {"orientation_angle": 0, "polygon": [[1381.0, 2364.0], [1409.0, 2364.0], [1409.0, 2404.0], [1381.0, 2404.0]], "score": 0.9048434495925903, "text": "/"}, {"orientation_angle": 0, "polygon": [[1815.0, 2359.0], [1850.0, 2359.0], [1850.0, 2408.0], [1815.0, 2408.0]], "score": 0.9510785341262817, "text": "/"}, {"orientation_angle": 0, "polygon": [[470.0, 2420.0], [694.0, 2416.0], [695.0, 2469.0], [471.0, 2473.0]], "score": 0.9999198913574219, "text": "30.06.2019"}, {"orientation_angle": 0, "polygon": [[916.0, 2420.0], [1114.0, 2420.0], [1114.0, 2468.0], [916.0, 2468.0]], "score": 0.9994175434112549, "text": "200 000 €"}, {"orientation_angle": 0, "polygon": [[1294.0, 2418.0], [1496.0, 2418.0], [1496.0, 2471.0], [1294.0, 2471.0]], "score": 0.9979731440544128, "text": "200 000 €"}, {"orientation_angle": 1, "polygon": [[1810.0, 2