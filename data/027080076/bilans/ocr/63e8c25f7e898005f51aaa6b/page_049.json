0, 1817.0], [2247.0, 1832.0], [2247.0, 1884.0], [277.0, 1868.0]], "score": 0.9923356771469116, "text": "Après une année de gel imposé aux bailleurs sociaux conformément aux dispositions de la loi de finances pour 2018,"}, {"orientation_angle": 0, "polygon": [[269.0, 1868.0], [2247.0, 1885.0], [2247.0, 1939.0], [268.0, 1921.0]], "score": 0.982445240020752, "text": "la SEMIE a procédé à une augmentation des loyers composant l'ensemble de son patrimoine géré à concurrence de"}, {"orientation_angle": 0, "polygon": [[265.0, 1923.0], [1799.0, 1935.0], [1799.0, 1987.0], [265.0, 1974.0]], "score": 0.98975670337677, "text": "l'évolution de l’indice IRL (Indice de Référence des Loyers base 2ème trimestre), soit 1,25 %."}]}, {"bbox": [258.8740234375, 2678.006591796875, 2233.9736328125, 2834.593017578125], "label": "text", "score": 0.9678583145141602, "texts": [{"orientation_angle": 0, "polygon": [[267.0, 2672.0], [2242.0, 2691.0], [2241.0, 2744.0], [267.0, 2725.0]], "score": 0.9862304329872131, "text": "Conformément à l'article L 481-6 du Code de la Construction et de l'Habitation la SEMIE a organisé ses élections pour"}, {"orientation_angle": 0, "polygon": [[265.0, 2728.0], [2238.0, 2744.0], [2238.0, 2797.0], [265.0, 2781.0]], "score": 0.99343341588974, "text": "élire ses Représentants des Locataires au Conseil d'Administration et à la Commission d'Attribution de ses Logements"}, {"orientation_angle": 0, "polygon": [[265.0, 2781.0], [556.0, 2785.0], [555.0, 2833.0], [265.0, 2829.0]], "score": 0.99985671043396, "text": "Locatifs Sociaux."}]}, {"bbox": [266.2467041015625, 2141.206787109375, 2239.43603515625, 2302.194580078125], "label": "text", "score": 0.9659761190414429, "texts": [{"orientation_angle": 0, "polygon": [[269.0, 2139.0], [2245.0, 2154.0], [2245.0, 2206.0], [268.0, 2190.0]], "score": 0.9736095666885376, "text": "L'article 126 de la loi de finance pour 2018 impact pour le second exercice consécutif le chiffre d'affaires de la SEMIE"}, {"orientation_angle": 0, "poly