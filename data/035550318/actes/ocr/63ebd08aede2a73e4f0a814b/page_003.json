895.0], [3868.0, 5962.0], [3801.0, 5962.0]], "score": 0.7910103797912598, "text": "o"}, {"orientation_angle": 0, "polygon": [[2848.0, 6334.0], [4427.0, 6313.0], [4429.0, 6444.0], [2850.0, 6464.0]], "score": 0.9996544718742371, "text": "PREMIERE RESOLUTION"}, {"orientation_angle": 0, "polygon": [[1249.0, 6623.0], [6050.0, 6588.0], [6051.0, 6733.0], [1250.0, 6767.0]], "score": 0.9978500604629517, "text": "L'Assemblée Générale, après avoir entendu la lecture du rapport du Commissaire à la"}, {"orientation_angle": 0, "polygon": [[1244.0, 6772.0], [6050.0, 6733.0], [6051.0, 6878.0], [1245.0, 6917.0]], "score": 0.9861695766448975, "text": "transformation désigné par décision unanime des actionnaires en date du 31 octobre 2002, en"}, {"orientation_angle": 0, "polygon": [[1249.0, 6917.0], [6050.0, 6878.0], [6051.0, 7027.0], [1250.0, 7066.0]], "score": 0.991169810295105, "text": "ce qui concerne l'évaluation des biens composant l'actif social et les avantages particuliers"}, {"orientation_angle": 0, "polygon": [[1254.0, 7066.0], [6046.0, 7027.0], [6047.0, 7162.0], [1255.0, 7201.0]], "score": 0.9996289014816284, "text": "consentis au profit d'actionnaires ou de tiers, conformément aux dispositions de l'article"}, {"orientation_angle": 0, "polygon": [[1249.0, 7206.0], [6051.0, 7176.0], [6051.0, 7311.0], [1250.0, 7341.0]], "score": 0.9975293278694153, "text": "L. 224-3 du Code de commerce, approuve expressément cette évaluation et constate"}, {"orientation_angle": 0, "polygon": [[1259.0, 7351.0], [5409.0, 7316.0], [5410.0, 7461.0], [1260.0, 7495.0]], "score": 0.9904278516769409, "text": "qu'aucun avantage particulier n'a été consenti au profit d'actionnaires ou de tiers."}, {"orientation_angle": 0, "polygon": [[1259.0, 7640.0], [3417.0, 7620.0], [3418.0, 7750.0], [1260.0, 7770.0]], "score": 0.9824162721633911, "text": "Cette résolution est adoptée à l'unanimité."}, {"orientation_angle": 0, "polygon": [[6209.0, 8468.0], [6482.0, 8468.0], [6482.0, 8854.0], [6209.0, 8854.0]], "sco