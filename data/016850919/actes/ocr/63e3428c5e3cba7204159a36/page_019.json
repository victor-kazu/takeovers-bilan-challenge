{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[3489.0, 641.0], [3575.0, 641.0], [3575.0, 742.0], [3489.0, 742.0]], "score": 0.9998130202293396, "text": "9"}, {"orientation_angle": 0, "polygon": [[3237.0, 1193.0], [3830.0, 1205.0], [3827.0, 1354.0], [3235.0, 1343.0]], "score": 0.9978011250495911, "text": "TITRE V"}, {"orientation_angle": 0, "polygon": [[2130.0, 1473.0], [4911.0, 1488.0], [4910.0, 1633.0], [2130.0, 1618.0]], "score": 0.9995084404945374, "text": "DECISIONS COLLECTIVES DES ASSOCIES"}, {"orientation_angle": 0, "polygon": [[881.0, 2056.0], [4394.0, 2076.0], [4393.0, 2216.0], [880.0, 2196.0]], "score": 0.995298445224762, "text": "ARTICLE 19 - DECISIONS COLLECTIVES OBLIGATOIRES"}, {"orientation_angle": 0, "polygon": [[862.0, 2335.0], [5562.0, 2370.0], [5561.0, 2529.0], [861.0, 2494.0]], "score": 0.9940477013587952, "text": "La collectivité des associés est seule compétente pour prendre les décisions suivantes :"}, {"orientation_angle": 0, "polygon": [[1073.0, 2619.0], [5131.0, 2654.0], [5130.0, 2798.0], [1072.0, 2764.0]], "score": 0.9922726154327393, "text": "modification du capital social : augmentation, amortissement et réduction ;"}, {"orientation_angle": 0, "polygon": [[1073.0, 2764.0], [3212.0, 2779.0], [3211.0, 2924.0], [1072.0, 2909.0]], "score": 0.9898090958595276, "text": "fusion, scission, apport partiel d'actifs ;"}, {"orientation_angle": 0, "polygon": [[1064.0, 2894.0], [1767.0, 2905.0], [1764.0, 3054.0], [1062.0, 3043.0]], "score": 0.9959922432899475, "text": "dissolution ;"}, {"orientation_angle": 0, "polygon": [[1063.0, 3038.0], [3518.0, 3058.0], [3517.0, 3208.0], [1062.0, 3188.0]], "score": 0.9965160489082336, "text": "nomination des Commissaires aux comptes ;"}, {"orientation_angle": 0, "polygon": [[1063.0, 3178.0], [3911.0, 3193.0], [3910.0, 3338.0], [1062.0, 3323.0]], "score": 0.978576123714447, "text": "nomination, rémunération, révocation du Président ;"}, {"orientation_angle": 0, "polygon": [[1067.0, 3318.0], [4394.0, 3323.0], [4394.0, 3472.0], [1067.0, 3467.0]], "score": 0.9970110654830933, "text": "approbation des comptes annuels et affectation des résultats ;"}, {"orientation_angle": 0, "polygon": [[1068.0, 3448.0], [4973.0, 3463.0], [4972.0, 3622.0], [1067.0, 3607.0]], "score": 0.9954109787940979, "text": "approbation des conventions conclues entre la Société et ses dirigeants ;"}, {"orientation_angle": 0, "polygon": [[1063.0, 3578.0], [4040.0, 3603.0], [4039.0, 3752.0], [1062.0, 3727.0]], "score": 0.9966397881507874, "text": "modification des statuts, sauf transfert du siège social ;"}, {"orientation_angle": 0, "polygon": [[1068.0, 3718.0], [5370.0, 3747.0], [5369.0, 3896.0], [1067.0, 3867.0]], "score": 0.9911712408065796, "text": "nomination du Liquidateur et décisions relatives aux opérations de liquidation ;"}, {"orientation_angle": 0, "polygon": [[1073.0, 3862.0], [2877.0, 3872.0], [2876.0, 4022.0], [1072.0, 4011.0]], "score": 0.9825881123542786, "text": "agrément des cessions d'actions ;"}, {"orientation_angle": 0, "polygon": [[871.0, 4281.0], [3159.0, 4286.0], [3159.0, 4431.0], [871.0, 4426.0]], "score": 0.9942484498023987, "text": "ARTICLE 20 - REGLES DE MAJORITE"}, {"orientation_angle": 0, "polygon": [[862.0, 4565.0], [6160.0, 4595.0], [6159.0, 4739.0], [861.0, 4710.0]], "score": 0.9871925115585327, "text": "Les décisions collectives des associés sont adoptées à la majorité simple des voix des associés"}, {"orientation_angle": 0, "polygon": [[867.0, 4700.0], [3628.0, 4720.0], [3627.0, 4864.0], [866.0, 4845.0]], "score": 0.9832062125205994, "text": "disposant du droit de vote, présents ou représentés."}, {"orientation_angle": 0, "polygon": [[862.0, 4974.0], [6155.0, 5019.0], [6154.0, 5163.0], [861.0, 5119.0]], "score": 0.9890828132629395, "text": "Le droit de vote attaché aux actions est proportionnel à la quotité du capital qu'elles représentent."}, {"orientation_angle": 0, "polygon": [[867.0, 5114.0], [3470.0, 5134.0], [3469.0, 5283.0], [866.0, 5263.0]], "score": 0.9970112442970276, "text": "Chaque action donne droit à une voix au moins."}, {"orientation_angle": 0, "polygon": [[862.0, 5528.0], [4475.0, 5558.0], [4474.0, 5702.0], [861.0, 5673.0]], "score": 0.9938972592353821, "text": "ARTICLE 21 - MODALITES DES DECISIONS COLLECTIVES"}, {"orientation_angle": 0, "polygon": [[857.0, 5813.0], [5299.0, 5842.0], [5298.0, 5991.0], [856.0, 5962.0]], "score": 0.9870482683181763, "text": "Les décisions collectives sont prises sur convocation ou à l'initiative du Président."}, {"orientation_angle": 0, "polygon": [[862.0, 6082.0], [5959.0, 6121.0], [5958.0, 6271.0], [861.0, 6231.0]], "score": 0.990509033203125, "text": "Elles résultent de la réunion d'une assemblée ou d'un procès-verbal signé par tous les associés."}, {"orientation_angle": 0, "polygon": [[853.0, 6347.0], [6170.0, 6391.0], [6168.0, 6550.0], [851.0, 6506.0]], "score": 0.998307466506958, "text": "Pendant la période de liquidation de la Société, les décisions collectives sont prises sur"}, {"orientation_angle": 0, "polygon": [[858.0, 6491.0], [3250.0, 6511.0], [3249.0, 6656.0], [856.0, 6636.0]], "score": 0.996135950088501, "text": "convocation ou à l'initiative du Liquidateur."}, {"orientation_angle": 0, "polygon": [[853.0, 6761.0], [6160.0, 6805.0], [6159.0, 6950.0], [852.0, 6906.0]], "score": 0.9968472719192505, "text": "Tout associé a le droit de participer aux décisions collectives, personnellement ou par mandataire,"}, {"orientation_angle": 0, "polygon": [[853.0, 6901.0], [6165.0, 6935.0], [6164.0, 7094.0], [852.0, 7060.0]], "score": 0.9883548021316528, "text": "quel que soit le nombre d'actions qu'il possède. il doit justifier de son identité et de l'inscription"}, {"orientation_angle": 0, "polygon": [[852.0, 7050.0], [3987.0, 7060.0], [3987.0, 7205.0], [852.0, 7195.0]], "score": 0.9803788661956787, "text": "en compte de ses actions au jour de la décision collective."}, {"orientation_angle": 0, "polygon": [[852.0, 7455.0], [2590.0, 7465.0], [2589.0, 7609.0], [852.0, 7599.0]], "score": 0.9919759631156921, "text": "ARTICLE 22 - ASSEMBLEES"}, {"orientation_angle": 0, "polygon": [[848.0, 7734.0], [6155.0, 7783.0], [6154.0, 7927.0], [847.0, 7878.0]], "score": 0.9895140528678894, "text": "Les associés se réunissent en assemblée sur convocation du Président au siège social ou en tout"}, {"orientation_angle": 0, "polygon": [[852.0, 7883.0], [3116.0, 7893.0], [3115.0, 8028.0], [852.0, 8018.0]], "score": 0.9972196221351624, "text": "autre lieu mentionné dans la convocation."}, {"orientation_angle": 0, "polygon": [[843.0, 8138.0], [5193.0, 8183.0], [5192.0, 8342.0], [842.0, 8297.0]], "score": 0.9944780468940735, "text": "Toutefois, l'assemblée peut se réunir sans délai si tous les associés y consentent."}, {"orientation_angle": 0, "polygon": [[848.0, 8432.0], [6155.0, 8481.0], [6154.0, 8631.0], [847.0, 8582.0]], "score": 0.9950540661811829, "text": "L'assemblée est présidée par le Président ou, en son absence par un associé désigné par"}, {"orientation_angle": 0, "polygon": [[852.0, 8596.0], [1517.0, 8596.0], [1517.0, 8731.0], [852.0, 8731.0]], "score": 0.9981970191001892, "text": "l'assemblée."}], "page": 19, "pdf": "63e3428c5e3cba7204159a36__63e3428c5e3cba7204159a36.pdf", "skew_angle": 0.0}