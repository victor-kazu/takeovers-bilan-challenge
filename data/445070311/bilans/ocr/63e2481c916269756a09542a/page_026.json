, 1984.0], [2186.0, 1984.0], [2186.0, 2035.0], [367.0, 2035.0]], "score": 0.9922316074371338, "text": "que des circonstances ou événements ultérieurs pourraient mettre en cause la continuité"}, {"orientation_angle": 0, "polygon": [[365.0, 2037.0], [2184.0, 2041.0], [2184.0, 2094.0], [365.0, 2090.0]], "score": 0.9717977643013, "text": "d’exploitation. S'il conclut à l'existence d'une incertitude significative, il attire l'attention"}, {"orientation_angle": 0, "polygon": [[365.0, 2094.0], [2182.0, 2101.0], [2182.0, 2154.0], [365.0, 2147.0]], "score": 0.9959193468093872, "text": "des lecteurs de son rapport sur les informations fournies dans les comptes annuels au sujet"}, {"orientation_angle": 0, "polygon": [[365.0, 2150.0], [2180.0, 2159.0], [2180.0, 2212.0], [365.0, 2203.0]], "score": 0.9910531640052795, "text": "de cette incertitude ou, si ces informations ne sont pas fournies ou ne sont pas pertinentes,"}, {"orientation_angle": 0, "polygon": [[362.0, 2208.0], [1652.0, 2215.0], [1651.0, 2267.0], [362.0, 2260.0]], "score": 0.9934186339378357, "text": "il formule une certification avec réserve ou un refus de certifier ;"}, {"orientation_angle": 0, "polygon": [[303.0, 2263.0], [2182.0, 2270.0], [2182.0, 2329.0], [303.0, 2322.0]], "score": 0.9865807294845581, "text": "> il apprécie la présentation d’ensemble des comptes annuels et évalue si les comptes"}, {"orientation_angle": 0, "polygon": [[363.0, 2323.0], [2182.0, 2329.0], [2182.0, 2382.0], [363.0, 2376.0]], "score": 0.9982907772064209, "text": "annuels reflètent les opérations et événements sous-jacents de manière à en donner une"}, {"orientation_angle": 0, "polygon": [[362.0, 2380.0], [630.0, 2380.0], [630.0, 2438.0], [362.0, 2438.0]], "score": 0.9971466064453125, "text": "image fidèle."}, {"orientation_angle": 0, "polygon": [[305.0, 2551.0], [939.0, 2551.0], [939.0, 2603.0], [305.0, 2603.0]], "score": 0.9915818572044373, "text": "Strasbourg, le 4 décembre 2019"}, {"orientation_angle": 0, "polygon": [[304.0, 2721.