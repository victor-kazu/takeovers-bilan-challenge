, 3301.0]], "score": 0.9893864393234253, "text": "I. - Tout actionnaire a le droit d'assister aux assemblées"}, {"orientation_angle": 0, "polygon": [[1345.0, 3291.0], [6290.0, 3277.0], [6290.0, 3423.0], [1345.0, 3438.0]], "score": 0.9979541897773743, "text": "générales et de participer aux délibérations, personnellement ou par"}, {"orientation_angle": 0, "polygon": [[1330.0, 3433.0], [6290.0, 3419.0], [6290.0, 3560.0], [1331.0, 3575.0]], "score": 0.9952020645141602, "text": "mandataire, quel que soit le nombre d'actions qu'il possède, sur simple"}, {"orientation_angle": 0, "polygon": [[1354.0, 3575.0], [6290.0, 3560.0], [6290.0, 3693.0], [1355.0, 3707.0]], "score": 0.9845090508460999, "text": "justification de son identité et également de la propriété de ses"}, {"orientation_angle": 0, "polygon": [[1349.0, 3712.0], [6276.0, 3702.0], [6276.0, 3830.0], [1350.0, 3839.0]], "score": 0.9983802437782288, "text": "titres sous la forme et dans le délai mentionnés dans la convocation,"}, {"orientation_angle": 0, "polygon": [[1349.0, 3853.0], [6294.0, 3834.0], [6295.0, 3962.0], [1350.0, 3981.0]], "score": 0.9862260818481445, "text": "sans toutefois que ce délai puisse excéder cinq jours avant la réunion"}, {"orientation_angle": 0, "polygon": [[1359.0, 3995.0], [2399.0, 3995.0], [2399.0, 4108.0], [1359.0, 4108.0]], "score": 0.9982590079307556, "text": "de l'assemblée."}, {"orientation_angle": 0, "polygon": [[1693.0, 4259.0], [6309.0, 4250.0], [6309.0, 4392.0], [1693.0, 4401.0]], "score": 0.984395444393158, "text": "II. - Tout actionnaire ne peut se faire représenter que par son"}, {"orientation_angle": 0, "polygon": [[1359.0, 4415.0], [6294.0, 4391.0], [6295.0, 4519.0], [1360.0, 4543.0]], "score": 0.9955441951751709, "text": "conjoint ou par un autre actionnaire. A cet effet, le mandataire doit"}, {"orientation_angle": 0, "polygon": [[1364.0, 4552.0], [3014.0, 4547.0], [3014.0, 4680.0], [1364.0, 4685.0]], "score": 0.9859949946403503, "text": "justifier de son mandat."}, {"orientation_angle": 0, "polygon": [[1683.0, 4821.0], [6299.0, 4807.0], [6300.0, 4949.0], [1684.0, 4963.0]], "score": 0.997103750705719, "text": "Les représentants légaux d'actionnaires juridiquement incapables"}, {"orientation_angle": 0, "polygon": [[1349.0, 4973.0], [6299.0, 4958.0], [6300.0, 5090.0], [1350.0, 5105.0]], "score": 0.9905926585197449, "text": "et les personnes physiques représentant des personnes morales"}, {"orientation_angle": 0, "polygon": [[1354.0, 5109.0], [6323.0, 5100.0], [6323.0, 5242.0], [1355.0, 5251.0]], "score": 0.9880568385124207, "text": "actionnaires prennent part aux assemblées, qu'ils soient ou non"}, {"orientation_angle": 0, "polygon": [[1359.0, 5266.0], [3375.0, 5241.0], [3377.0, 5373.0], [1360.0, 5398.0]], "score": 0.9993911981582642, "text": "personnellement actionnaires."}, {"orientation_angle": 0, "polygon": [[1707.0, 5530.0], [6314.0, 5525.0], [6314.0, 5657.0], [1707.0, 5662.0]], "score": 0.9793578386306763, "text": "IIl. - Tout actionnaire peut voter par correspondance au moyen"}, {"orientation_angle": 0, "polygon": [[1368.0, 5671.0], [6304.0, 5652.0], [6304.0, 5785.0], [1369.0, 5804.0]], "score": 0.986036479473114, "text": "d'un formulaire établi et adressé à la société dans les conditions"}, {"orientation_angle": 0, "polygon": [[1373.0, 5818.0], [2617.0, 5808.0], [2618.0, 5935.0], [1374.0, 5946.0]], "score": 0.9738309383392334, "text": "fixées par la loi."}, {"orientation_angle": 0, "polygon": [[1435.0, 6233.0], [5560.0, 6214.0], [5561.0, 6342.0], [1436.0, 6361.0]], "score": 0.9787522554397583, "text": "Article 27 .- FEUILLE DE PRESENCE - BUREAU - PROCES-VERBAUX"}, {"orientation_angle": 0, "polygon": [[1721.0, 6512.0], [6323.0, 6502.0], [6323.0, 6630.0], [1722.0, 6639.0]], "score": 0.9908021688461304, "text": "I.- A chaque assemblée est tenue une feuille de présence contenant"}, {"orientation_angle": 0, "polygon": [[1383.0, 6654.0], [4015.0, 6644.0], [4015.0, 6776.0], [1383.0, 6786.0]], "score": 0.9912834167480469, "text": "les indications prescrites par la loi."}, {"orientation_angle": 0, "polygon": [[1717.0, 6928.0], [6332.0, 6908.0], [6333.0, 7055.0], [1717.0, 7074.0]], "score": 0.9906152486801147, "text": "Cette feuille de présence, dûment émargée par les actionnaires"}, {"orientation_angle": 0, "polygon": [[1383.0, 7074.0], [6328.0, 7045.0], [6328.0, 7187.0], [1384.0, 7216.0]], "score": 0.9924877882003784, "text": "présents et les mandataires et à laquelle sont annexés les pouvoirs"}, {"orientation_angle": 0, "polygon": [[1383.0, 7216.0], [6337.0, 7192.0], [6338.0, 7329.0], [1383.0, 7353.0]], "score": 0.9883844256401062, "text": "donnés à chaque mandataire, et le cas échéant les formulaires de vote"}, {"orientation_angle": 0, "polygon": [[1387.0, 7367.0], [6246.0, 7333.0], [6247.0, 7461.0], [1388.0, 7494.0]], "score": 0.9972462058067322, "text": "par correspondance, est certifiée exacte par le bureau de l'assemblée."}, {"orientation_angle": 0, "polygon": [[1731.0, 7626.0], [6333.0, 7612.0], [6333.0, 7754.0], [1731.0, 7768.0]], "score": 0.9860865473747253, "text": "II. - Les assemblées sont présidées par le président du conseil"}, {"orientation_angle": 0, "polygon": [[1388.0, 7763.0], [6404.0, 7754.0], [6405.0, 7900.0], [1388.0, 7910.0]], "score": 0.9910998940467834, "text": "d'administration ou, en son absence, par un administrateur spécialement-"}, {"orientation_angle": 0, "polygon": [[1397.0, 7910.0], [3824.0, 7900.0], [3825.0, 8032.0], [1398.0, 8042.0]], "score": 0.9788227677345276, "text": "délégué à cet effet par le conseil."}, {"orientation_angle": 0, "polygon": [[1731.0, 8174.0], [6352.0, 8174.0], [6352.0, 8316.0], [1731.0, 8316.0]], "score": 0.9795640707015991, "text": "Si l'assemblée est convoquée par le ou les commissaires aux"}, {"orientation_angle": 0, "polygon": [[1407.0, 8330.0], [4807.0, 8316.0], [4807.0, 8448.0], [1407.0, 8462.0]], "score": 0.9971522092819214, "text": "comptes, l'assemblée est présidée par l'un d'eux."}, {"orientation_angle": 0, "polygon": [[1740.0, 859