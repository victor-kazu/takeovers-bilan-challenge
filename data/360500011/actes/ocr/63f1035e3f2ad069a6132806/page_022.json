0]], "score": 0.9911343455314636, "text": "violation de cette disposition est nulle ; toutefois"}, {"orientation_angle": 0, "polygon": [[1215.0, 8000.0], [5594.0, 8100.0], [5591.0, 8232.0], [1212.0, 8131.0]], "score": 0.9846644997596741, "text": "cette nullité n'entraine pas celle des délibérations"}, {"orientation_angle": 0, "polygon": [[1210.0, 8141.0], [5856.0, 8251.0], [5853.0, 8387.0], [1207.0, 8277.0]], "score": 0.9910139441490173, "text": "auxquelles a pris part l'administrateur irrégulièrement"}, {"orientation_angle": 0, "polygon": [[1208.0, 8297.0], [1693.0, 8297.0], [1693.0, 8414.0], [1208.0, 8414.0]], "score": 0.9913914203643799, "text": "nommé."}, {"orientation_angle": 0, "polygon": [[1621.0, 8427.0], [5594.0, 8518.0], [5591.0, 8649.0], [1618.0, 8558.0]], "score": 0.9660958051681519, "text": "le nombre des administrateurs liés à la société"}, {"orientation_angle": 0, "polygon": [[1210.0, 8563.0], [5506.0, 8658.0], [5503.0, 8785.0], [1207.0, 8690.0]], "score": 0.9882076978683472, "text": "rar un contrat de travail ne peut dépasser le tiers"}, {"orientation_angle": 0, "polygon": [[1215.0, 8694.0], [3892.0, 8762.0], [3889.0, 8888.0], [1212.0, 8821.0]], "score": 0.9752035140991211, "text": "des administrateurs en fonction."}, {"orientation_angle": 0, "polygon": [[1621.0, 8835.0], [5846.0, 8940.0], [5843.0, 9081.0], [1618.0, 8975.0]], "score": 0.994391679763794, "text": "En cas de fusion, le contrat de travail peut avoir"}, {"orientation_angle": 0, "polygon": [[1210.0, 8980.0], [5058.0, 9067.0], [5055.0, 9193.0], [1207.0, 9107.0]], "score": 0.9366652369499207, "text": "été conclu avec l'une des sociétes fusionnées."}], "page": 22, "pdf": "63f1035e3f2ad069a6132806__63f1035e3f2ad069a6132806.pdf", "skew_angle": 0.0}