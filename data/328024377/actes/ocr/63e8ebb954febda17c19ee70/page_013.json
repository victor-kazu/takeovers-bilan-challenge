], [4317.0, 5205.0], [4293.0, 5237.0], [4267.0, 5217.0]], "score": 0.7128120064735413, "text": "−"}, {"orientation_angle": 0, "polygon": [[1860.0, 5426.0], [6500.0, 5421.0], [6500.0, 5567.0], [1860.0, 5572.0]], "score": 0.9780644178390503, "text": "I. - Le conseil d'administration se réunit aussi souvenc que"}, {"orientation_angle": 0, "polygon": [[1545.0, 5567.0], [6495.0, 5563.0], [6495.0, 5704.0], [1545.0, 5709.0]], "score": 0.9707664251327515, "text": "l'incérèt de la société l'exige, sur la convocacion de son président ou"}, {"orientation_angle": 0, "polygon": [[1531.0, 5714.0], [6500.0, 5700.0], [6500.0, 5841.0], [1531.0, 5856.0]], "score": 0.9842811822891235, "text": "celle du tiers au moins de ses membres, même si la dernière réunion"}, {"orientation_angle": 0, "polygon": [[1531.0, 5870.0], [3409.0, 5865.0], [3410.0, 5992.0], [1531.0, 5997.0]], "score": 0.9900491237640381, "text": "date de moins de deux mois."}, {"orientation_angle": 0, "polygon": [[1869.0, 6144.0], [6504.0, 6129.0], [6505.0, 6271.0], [1870.0, 6285.0]], "score": 0.9877682328224182, "text": "La réunion a lieu soit au siège social, soit en cout autre endroit"}, {"orientation_angle": 0, "polygon": [[1550.0, 6304.0], [3476.0, 6304.0], [3476.0, 6417.0], [1550.0, 6417.0]], "score": 0.9817267656326294, "text": "indiqué dans la convocation."}, {"orientation_angle": 0, "polygon": [[1879.0, 6583.0], [6504.0, 6559.0], [6505.0, 6691.0], [1879.0, 6715.0]], "score": 0.9620242714881897, "text": "En principe, la convocacion doit étre faite crois jours à l'avance"}, {"orientation_angle": 0, "polygon": [[1540.0, 6729.0], [6514.0, 6700.0], [6514.0, 6842.0], [1541.0, 6871.0]], "score": 0.9838371276855469, "text": "par leccre, télégramme ou célex. Mais elle peut étre verbale et sans"}, {"orientation_angle": 0, "polygon": [[1555.0, 6875.0], [4845.0, 6875.0], [4845.0, 7003.0], [1555.0, 7003.0]], "score": 0.9849036931991577, "text": "délai si tous les administrateurs y consentent."}, {"orientation_angle": 0, "polyg