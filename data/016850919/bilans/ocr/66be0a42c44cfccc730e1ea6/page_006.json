": [[181.0, 1854.0], [587.0, 1852.0], [587.0, 1886.0], [181.0, 1888.0]], "score": 0.9985606074333191, "text": "production et des produits finis."}]}, {"bbox": [176.3692626953125, 1692.0234375, 2323.30029296875, 1769.8544921875], "label": "text", "score": 0.9565632343292236, "texts": [{"orientation_angle": 0, "polygon": [[181.0, 1693.0], [2325.0, 1693.0], [2325.0, 1727.0], [181.0, 1727.0]], "score": 0.9914427995681763, "text": "Les coûts d'acquisition des stocks comprennent le prix d'achat, les droits de douane et autres taxes, à l'exclusion des taxes ultérieurement récupérables par l'entité auprès"}, {"orientation_angle": 0, "polygon": [[184.0, 1741.0], [539.0, 1741.0], [539.0, 1770.0], [184.0, 1770.0]], "score": 0.9947884678840637, "text": "des administrations fiscales,"}]}, {"bbox": [175.8759765625, 1990.810791015625, 2312.7646484375, 2071.115966796875], "label": "text", "score": 0.9526405930519104, "texts": [{"orientation_angle": 0, "polygon": [[181.0, 1993.0], [2303.0, 1991.0], [2303.0, 2025.0], [181.0, 2027.0]], "score": 0.9869204163551331, "text": "Une provision pour dépréciation des stocks, ou une décote directe, égale à la différence entre la valeur brute déterminée suivant les modalités indiquées ci-dessus et le"}, {"orientation_angle": 0, "polygon": [[181.0, 2037.0], [2320.0, 2035.0], [2320.0, 2070.0], [181.0, 2071.0]], "score": 0.9939057230949402, "text": "cours du jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est effectuée lorsque cette valeur brute est supérieure à l'autre terme énoncé."}]}, {"bbox": [177.622314453125, 1924.4241943359375, 1956.912353515625, 1956.4156494140625], "label": "text", "score": 0.9053296446800232, "texts": [{"orientation_angle": 0, "polygon": [[184.0, 1928.0], [1956.0, 1928.0], [1956.0, 1957.0], [184.0, 1957.0]], "score": 0.984246551990509, "text": "Les rabais commerciaux, remises, escomptes de règlement et autres éléments similaires sont déduits pour déterminer les coûts d'acquisition."}]}