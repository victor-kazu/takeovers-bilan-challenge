{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 1, "polygon": [[6293.0, 232.0], [6335.0, 212.0], [6373.0, 287.0], [6331.0, 308.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[1655.0, 1237.0], [6276.0, 1237.0], [6276.0, 1365.0], [1655.0, 1365.0]], "score": 0.9886404275894165, "text": "L'ancien administrateur (ou ses ayants droit) recouvre la libre"}, {"orientation_angle": 0, "polygon": [[1316.0, 1379.0], [6280.0, 1369.0], [6281.0, 1516.0], [1316.0, 1525.0]], "score": 0.9987459182739258, "text": "disposition des actions de garantie du seul fait de l'approbation par"}, {"orientation_angle": 0, "polygon": [[1326.0, 1525.0], [6280.0, 1520.0], [6280.0, 1648.0], [1326.0, 1653.0]], "score": 0.9793314337730408, "text": "l'assemblée générale ordinaire des comptes du dernier exercice pendant"}, {"orientation_angle": 0, "polygon": [[1325.0, 1672.0], [3266.0, 1652.0], [3267.0, 1780.0], [1327.0, 1800.0]], "score": 0.982185423374176, "text": "lequel il a été en fonction."}, {"orientation_angle": 0, "polygon": [[2494.0, 2073.0], [3728.0, 2063.0], [3730.0, 2195.0], [2495.0, 2206.0]], "score": 0.9983253479003906, "text": "BUREAU DU CONSEIL"}, {"orientation_angle": 0, "polygon": [[1382.0, 2083.0], [2420.0, 2063.0], [2423.0, 2209.0], [1385.0, 2230.0]], "score": 0.9539986252784729, "text": "Article 16 . -"}, {"orientation_angle": 0, "polygon": [[3714.0, 2108.0], [3772.0, 2124.0], [3759.0, 2167.0], [3701.0, 2151.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[1655.0, 2342.0], [6304.0, 2337.0], [6304.0, 2498.0], [1655.0, 2503.0]], "score": 0.9925335049629211, "text": "Le conseil d'administration nomme, parmi ses membres personnes"}, {"orientation_angle": 0, "polygon": [[1321.0, 2493.0], [6304.0, 2474.0], [6305.0, 2635.0], [1321.0, 2654.0]], "score": 0.9966534376144409, "text": "physiques, un président dont il fixe la durée des fonctions sans"}, {"orientation_angle": 0, "polygon": [[1330.0, 2640.0], [5727.0, 2625.0], [5727.0, 2772.0], [1331.0, 2786.0]], "score": 0.9983569979667664, "text": "qu'elle puisse excéder la durée de son mandat d'administrateur."}, {"orientation_angle": 0, "polygon": [[1669.0, 2918.0], [6299.0, 2904.0], [6300.0, 3046.0], [1669.0, 3060.0]], "score": 0.9812895059585571, "text": "Le conseil peut nommer également un secrétaire même en dehors de"}, {"orientation_angle": 0, "polygon": [[1330.0, 3075.0], [2169.0, 3064.0], [2170.0, 3182.0], [1331.0, 3193.0]], "score": 0.9971107840538025, "text": "ses membres."}, {"orientation_angle": 0, "polygon": [[1669.0, 3339.0], [6304.0, 3329.0], [6304.0, 3471.0], [1669.0, 3480.0]], "score": 0.9894490242004395, "text": "En cas d'absence ou d'empêchement du président, le conseil désigne"}, {"orientation_angle": 0, "polygon": [[1325.0, 3490.0], [4210.0, 3475.0], [4211.0, 3617.0], [1326.0, 3632.0]], "score": 0.9915682077407837, "text": "parmi ses membres le président de séance."}, {"orientation_angle": 0, "polygon": [[1678.0, 3764.0], [5808.0, 3744.0], [5809.0, 3886.0], [1679.0, 3905.0]], "score": 0.9908245801925659, "text": "Le président et le secrétaire peuvent toujours être réélus."}, {"orientation_angle": 0, "polygon": [[1850.0, 4085.0], [6476.0, 4080.0], [6476.0, 4222.0], [1850.0, 4226.0]], "score": 0.9935312867164612, "text": "Nul ne peut être nommé Président Directeur Général s'il est âgé"}, {"orientation_angle": 0, "polygon": [[1016.0, 4236.0], [6466.0, 4212.0], [6467.0, 4354.0], [1016.0, 4378.0]], "score": 0.9917657971382141, "text": "de plus de quatre vingts ans. D'autre part, si le Président Directeur Général"}, {"orientation_angle": 0, "polygon": [[1011.0, 4368.0], [6480.0, 4354.0], [6481.0, 4495.0], [1011.0, 4510.0]], "score": 0.9850080609321594, "text": "vient à dépasser cet âge, il est réputé démissionnaire d'office à l'issue de"}, {"orientation_angle": 0, "polygon": [[1020.0, 4515.0], [4835.0, 4495.0], [4836.0, 4628.0], [1021.0, 4647.0]], "score": 0.9946331977844238, "text": "la plus prochaine réunion du Conseil d'Administration."}, {"orientation_angle": 0, "polygon": [[1416.0, 4873.0], [4115.0, 4864.0], [4116.0, 4991.0], [1417.0, 5001.0]], "score": 0.9905674457550049, "text": "Article 17. - DELIBERATIONS DU CONSEIL"}, {"orientation_angle": 0, "polygon": [[4080.0, 4889.0], [4166.0, 4904.0], [4156.0, 4966.0], [4070.0, 4952.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[1693.0, 5138.0], [6342.0, 5138.0], [6342.0, 5294.0], [1693.0, 5294.0]], "score": 0.9923519492149353, "text": "I. - Le conseil d'administration se réunit aussi souvent que"}, {"orientation_angle": 0, "polygon": [[1369.0, 5289.0], [6323.0, 5279.0], [6323.0, 5412.0], [1369.0, 5421.0]], "score": 0.9703622460365295, "text": "l'intérêt de la société l'exige, sur la convocation de son président ou"}, {"orientation_angle": 0, "polygon": [[1368.0, 5440.0], [6333.0, 5421.0], [6333.0, 5548.0], [1369.0, 5568.0]], "score": 0.9925516843795776, "text": "celle du tiers au moins de ses membres, même si la dernière réunion"}, {"orientation_angle": 0, "polygon": [[1364.0, 5582.0], [3252.0, 5572.0], [3253.0, 5699.0], [1364.0, 5709.0]], "score": 0.9966611266136169, "text": "date de moins de deux mois."}, {"orientation_angle": 0, "polygon": [[1702.0, 5846.0], [6337.0, 5832.0], [6338.0, 5973.0], [1703.0, 5988.0]], "score": 0.9870917797088623, "text": "La réunion a lieu soit au siège social, soit en tout autre endroit"}, {"orientation_angle": 0, "polygon": [[1373.0, 5997.0], [3324.0, 5992.0], [3324.0, 6125.0], [1374.0, 6129.0]], "score": 0.9931765794754028, "text": "indiqué dans la convocation."}, {"orientation_angle": 0, "polygon": [[1712.0, 6271.0], [6342.0, 6247.0], [6343.0, 6389.0], [1712.0, 6413.0]], "score": 0.9908115267753601, "text": "En principe, la convocation doit étre faite trois jours à l'avance"}, {"orientation_angle": 0, "polygon": [[1368.0, 6418.0], [6342.0, 6389.0], [6343.0, 6531.0], [1369.0, 6559.0]], "score": 0.9928155541419983, "text": "par lettre, télégramme ou télex. Mais elle peut être verbale et sans"}, {"orientation_angle": 0, "polygon": [[1378.0, 6554.0], [4659.0, 6545.0], [4659.0, 6686.0], [1378.0, 6696.0]], "score": 0.9938169717788696, "text": "délai si tous les administrateurs y consentent."}, {"orientation_angle": 0, "polygon": [[1707.0, 6824.0], [6347.0, 6814.0], [6347.0, 6975.0], [1707.0, 6984.0]], "score": 0.9893845319747925, "text": "Toute convocation doit mentionner les principales questions"}, {"orientation_angle": 0, "polygon": [[1392.0, 6984.0], [3262.0, 6979.0], [3262.0, 7111.0], [1393.0, 7116.0]], "score": 0.9715014100074768, "text": "figurant à l'ordre du jour."}, {"orientation_angle": 0, "polygon": [[1721.0, 7253.0], [6347.0, 7244.0], [6347.0, 7385.0], [1722.0, 7395.0]], "score": 0.9861328601837158, "text": "II. - Pour la validité des délibérations, la présence effective de"}, {"orientation_angle": 0, "polygon": [[1392.0, 7400.0], [5160.0, 7395.0], [5160.0, 7522.0], [1393.0, 7527.0]], "score": 0.9852228760719299, "text": "la moitié au moins des administrateurs est nécessaire."}, {"orientation_angle": 0, "polygon": [[1717.0, 7664.0], [6414.0, 7659.0], [6414.0, 7806.0], [1717.0, 7811.0]], "score": 0.9890581965446472, "text": "Les décisions sont prises à la majorité des voix des membres."}, {"orientation_angle": 0, "polygon": [[1383.0, 7811.0], [6361.0, 7791.0], [6362.0, 7933.0], [1383.0, 7952.0]], "score": 0.9977217316627502, "text": "présents ou représentés, chaque administrateur disposant d'une voix et"}, {"orientation_angle": 0, "polygon": [[1383.0, 7957.0], [4878.0, 7947.0], [4879.0, 8075.0], [1383.0, 8084.0]], "score": 0.99344801902771, "text": "ne pouvant représenter plus d'un de ses collègues."}, {"orientation_angle": 0, "polygon": [[1712.0, 8212.0], [6376.0, 8202.0], [6376.0, 8358.0], [1712.0, 8368.0]], "score": 0.9944462180137634, "text": "En cas de partage, la voix du président de séance est"}, {"orientation_angle": 0, "polygon": [[1387.0, 8373.0], [2369.0, 8363.0], [2371.0, 8490.0], [1389.0, 8500.0]], "score": 0.9948963522911072, "text": "prépondérante."}, {"orientation_angle": 0, "polygon": [[1731.0, 8632.0], [6371.0, 8627.0], [6371.0, 8769.0], [1731.0, 8774.0]], "score": 0.9924108982086182, "text": "III. - Il est tenu un registre de présence qui est signé par les"}, {"orientation_angle": 0, "polygon": [[1397.0, 8793.0], [6146.0, 8769.0], [6147.0, 8896.0], [1398.0, 8920.0]], "score": 0.9991803169250488, "text": "administrateurs participant à la séance du conseil d'administration."}], "page": 11, "pdf": "63e8ebb854febda17c19ee6e__63e8ebb854febda17c19ee6e.pdf", "skew_angle": 0.0}