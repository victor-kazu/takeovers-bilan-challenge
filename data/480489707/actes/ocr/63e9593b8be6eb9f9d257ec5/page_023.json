673.0]], "score": 0.9945257306098938, "text": "patrimoine à ce dernier, sans qu'il y ait lieu à liquidation mais les créanciers peuvent faire opposition à"}, {"orientation_angle": 0, "polygon": [[823.0, 2673.0], [4795.0, 2663.0], [4796.0, 2793.0], [823.0, 2803.0]], "score": 0.9912989735603333, "text": "cette dissolution comme relaté au deuxième alinéa de l'article 1844-5 précité."}, {"orientation_angle": 0, "polygon": [[828.0, 2961.0], [5404.0, 2961.0], [5404.0, 3091.0], [828.0, 3091.0]], "score": 0.9954466223716736, "text": "Cette disposition n'est pas applicable lorsque l'associé unique est une personne physique."}, {"orientation_angle": 0, "polygon": [[818.0, 3236.0], [6030.0, 3231.0], [6031.0, 3375.0], [819.0, 3380.0]], "score": 0.9851568937301636, "text": "En cas de pluralité d'associés, ces derniers délibérant collectivement règlent le mode de liquidation et"}, {"orientation_angle": 0, "polygon": [[828.0, 3385.0], [6054.0, 3380.0], [6054.0, 3514.0], [828.0, 3519.0]], "score": 0.9930129647254944, "text": "nomment un ou plusieurs liquidateurs dont ils déterminent les pouvoirs et qui exercent leurs fonctions"}, {"orientation_angle": 0, "polygon": [[828.0, 3524.0], [2967.0, 3524.0], [2967.0, 3668.0], [828.0, 3668.0]], "score": 0.98618483543396, "text": "conformément à la législation en vigueur."}, {"orientation_angle": 0, "polygon": [[823.0, 3803.0], [5935.0, 3793.0], [5935.0, 3942.0], [823.0, 3952.0]], "score": 0.9847139120101929, "text": "La personnalité morale de la société subsiste pour les besoins de sa liquidation jusqu'à la clôture de"}, {"orientation_angle": 0, "polygon": [[823.0, 3952.0], [5863.0, 3947.0], [5863.0, 4077.0], [823.0, 4082.0]], "score": 0.9844605326652527, "text": "celle-ci, mais sa dénomination devra être suivie de la mention \"société en liquidation\" ainsi que du"}, {"orientation_angle": 0, "polygon": [[828.0, 4096.0], [5714.0, 4086.0], [5715.0, 4216.0], [828.0, 4226.0]], "score": 0.993246853351593, "text": "nom du liquidateur sur tous les actes et documents émanant de la société et destinés aux tiers."}, {"orientation_angle": 0, "polygon": [[833.0, 4380.0], [4413.0, 4380.0], [4413.0, 4510.0], [833.0, 4510.0]], "score": 0.9865979552268982, "text": "Les actions demeurent négociables jusqu'à la clôture de la liquidation."}, {"orientation_angle": 0, "polygon": [[823.0, 4798.0], [2541.0, 4793.0], [2542.0, 4923.0], [823.0, 4928.0]], "score": 0.9990803599357605, "text": "ARTICLE 32 - CONTESTATIONS"}, {"orientation_angle": 0, "polygon": [[828.0, 5082.0], [6083.0, 5082.0], [6083.0, 5211.0], [828.0, 5211.0]], "score": 0.9953176379203796, "text": "Toutes les contestations qui pourraient s'élever pendant la durée de la société ou lors de sa liquidation"}, {"orientation_angle": 0, "polygon": [[828.0, 5226.0], [5892.0, 5226.0], [5892.0, 5356.0], [828.0, 5356.0]], "score": 0.9911397099494934, "text": "entre la société, l'associé unique ou les associés concernant les affaires sociales, l'interprétation ou"}, {"orientation_angle": 0, "polygon": [[823.0, 5365.0], [5973.0, 5365.0], [5973.0, 5510.0], [823.0, 5510.0]], "score": 0.9937318563461304, "text": "l'exécution des présents statuts, seront jugées conformément à la loi et soumises à la juridiction des"}, {"orientation_angle": 0, "polygon": [[828.0, 5514.0], [1991.0, 5514.0], [1991.0, 5644.0], [828.0, 5644.0]], "score": 0.9991680383682251, "text": "tribunaux compétents."}, {"orientation_angle": 0, "polygon": [[833.0, 5933.0], [5853.0, 5933.0], [5853.0, 6062.0], [833.0, 6062.0]], "score": 0.9868001937866211, "text": "ARTICLE 33 - REPRISE DES ENGAGEMENTS ANTERIEURS A LA SIGNATURE DES STATUTS ET A"}, {"orientation_angle": 0, "polygon": [[833.0, 6086.0], [4111.0, 6086.0], [4111.0, 6202.0], [833.0, 6202.0]], "score": 0.9951925873756409, "text": "L'IMMATRICULATION DE LA SOCIETE - PUBLICITE - POUVOIRS"}, {"orientation_angle": 0, "polygon": [[833.0, 6365.0], [5652.0, 6365.0], [5652.0, 6495.0], [833.0, 6495.0]], "score": 0.9799152612686157, "text": "La Société ne jouira de