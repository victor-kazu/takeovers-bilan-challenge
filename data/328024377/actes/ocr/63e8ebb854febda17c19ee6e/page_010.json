6347.0, 4297.0], [6347.0, 4429.0], [1402.0, 4448.0]], "score": 0.9764014482498169, "text": "surveillance de sociétés anonymes ayant leur siège en France"}, {"orientation_angle": 0, "polygon": [[1397.0, 4458.0], [5216.0, 4434.0], [5217.0, 4566.0], [1398.0, 4590.0]], "score": 0.9866804480552673, "text": "métropolitaine, sauf les exceptions prévues par la loi."}, {"orientation_angle": 0, "polygon": [[1740.0, 4722.0], [6361.0, 4698.0], [6362.0, 4840.0], [1741.0, 4864.0]], "score": 0.9821679592132568, "text": "Un salarié de la société peut étre nommé administrateur si son"}, {"orientation_angle": 0, "polygon": [[1402.0, 4869.0], [6366.0, 4840.0], [6367.0, 4982.0], [1403.0, 5010.0]], "score": 0.9859772324562073, "text": "contrat de travail est antérieur de deux années au moins à sa"}, {"orientation_angle": 0, "polygon": [[1411.0, 5015.0], [6356.0, 4986.0], [6357.0, 5114.0], [1412.0, 5143.0]], "score": 0.988236129283905, "text": "nomination et correspond à un emploi effectif. Toutefois, le nombre des"}, {"orientation_angle": 0, "polygon": [[1416.0, 5157.0], [6356.0, 5138.0], [6357.0, 5251.0], [1417.0, 5270.0]], "score": 0.9847500920295715, "text": "administrateurs liés à la société par un contrat de travail ne peut"}, {"orientation_angle": 0, "polygon": [[1421.0, 5299.0], [4887.0, 5270.0], [4888.0, 5397.0], [1422.0, 5426.0]], "score": 0.9973481893539429, "text": "dépasser le tiers des administrateurs en fonction."}, {"orientation_angle": 0, "polygon": [[1755.0, 5563.0], [6370.0, 5529.0], [6371.0, 5671.0], [1756.0, 5705.0]], "score": 0.9854723215103149, "text": "Nul ne peut être nommé administrateur si, ayant dépassé l'age de"}, {"orientation_angle": 0, "polygon": [[1468.0, 5714.0], [6375.0, 5671.0], [6376.0, 5813.0], [1470.0, 5856.0]], "score": 0.970013439655304, "text": "quatre vingts ans, sa nomination a pour effet de porter à plus de la"}, {"orientation_angle": 0, "polygon": [[1411.0, 5856.0], [6375.0, 5827.0], [6376.0, 5954.0], [1412.0, 5983.0]], "score": 0.9910839796066284, "text": "moitié des membres du conseil le nombre d'administrateur ayant dépassé"}, {"orientation_angle": 0, "polygon": [[1416.0, 5993.0], [6375.0, 5959.0], [6376.0, 6101.0], [1417.0, 6134.0]], "score": 0.9830528497695923, "text": "cet age. Si du fait qu'un administrateur en fonctions vient à dépasser"}, {"orientation_angle": 0, "polygon": [[1425.0, 6139.0], [6375.0, 6101.0], [6376.0, 6242.0], [1427.0, 6281.0]], "score": 0.975928783416748, "text": "l'âge de quatre vingts ans. la proportion de la moitié ci-dessus"}, {"orientation_angle": 0, "polygon": [[1426.0, 6276.0], [6375.0, 6252.0], [6376.0, 6379.0], [1426.0, 6403.0]], "score": 0.9757980108261108, "text": "visée est dépassée, l'administrateur le plus agé est réputé"}, {"orientation_angle": 0, "polygon": [[1421.0, 6403.0], [6380.0, 6379.0], [6381.0, 6521.0], [1422.0, 6545.0]], "score": 0.9855601787567139, "text": "démissionnaire d'office à l'issue de la plus prochaine assemblée"}, {"orientation_angle": 0, "polygon": [[1430.0, 6560.0], [2750.0, 6535.0], [2752.0, 6676.0], [1432.0, 6702.0]], "score": 0.9988703727722168, "text": "générale ordinaire."}, {"orientation_angle": 0, "polygon": [[1492.0, 6965.0], [4062.0, 6951.0], [4063.0, 7092.0], [1493.0, 7107.0]], "score": 0.9626071453094482, "text": "Article 15 . - ACTIONS DE GARANTIE ."}, {"orientation_angle": 0, "polygon": [[1769.0, 7225.0], [6404.0, 7206.0], [6405.0, 7366.0], [1770.0, 7386.0]], "score": 0.9852151870727539, "text": "Les administrateurs doivent être chacun propriétaire d 'une action"}, {"orientation_angle": 0, "polygon": [[1440.0, 7386.0], [5274.0, 7366.0], [5274.0, 7508.0], [1441.0, 7527.0]], "score": 0.9836992621421814, "text": "affectée à la garantie de tous les actes de la gestion."}, {"orientation_angle": 0, "polygon": [[1788.0, 7650.0], [6409.0, 7636.0], [6409.0, 7782.0], [1789.0, 7796.0]], "score": 0.9977993965148926, "text": "Ces actions sont inaliénables, frappées d'un timbre indiquant leur"}, {"orientation_angle": 0, "polygon": [[1450.0, 7796.0], [4926.0, 7792.0], [4926.0, 7924.0], [1450.0, 7929.0]], "score": 0.9986374378204346, "text": "inaliénabilité et déposées dans la caisse sociale."}, {"orientation_angle": 0, "polygon": [[1788.0, 8080.0], [6409.0, 8065.0], [6409.0, 8193.0], [1789.0, 8207.0]], "score": 0.9963799715042114, "text": "Les administrateurs nommés en cours de société peuvent ne pas être"}, {"orientation_angle": 0, "polygon": [[1450.0, 8212.0], [6414.0, 8198.0], [6414.0, 8339.0], [1450.0, 8354.0]], "score": 0.9960364699363708, "text": "actionnaires au moment de leur nomination, mais doivent le devenir dans"}, {"orientation_angle": 0, "polygon": [[1450.0, 8354.0], [6409.0, 8349.0], [6409.0, 8481.0], [1450.0, 8486.0]], "score": 0.9760041832923889, "text": "le délai de trois mois, à défaut de quoi ils seront réputés"}, {"orientation_angle": 0, "polygon": [[1454.0, 8496.0], [3194.0, 8481.0], [3195.0, 8608.0], [1455.0, 8623.0]], "score": 0.9986542463302612, "text": "démissionnaires d'office."}], "page": 10, "pdf": "63e8ebb854febda17c19ee6e__63e8ebb854febda17c19ee6e.pdf", "skew_angle": 0.0}