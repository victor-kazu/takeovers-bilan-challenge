0, 2068.0], [2164.0, 2071.0], [2164.0, 2123.0], [393.0, 2119.0]], "score": 0.9907948970794678, "text": "falsification, les omissions volontaires, les fausses déclarations ou le contournement du"}, {"orientation_angle": 0, "polygon": [[393.0, 2123.0], [731.0, 2126.0], [730.0, 2179.0], [393.0, 2176.0]], "score": 0.9973368048667908, "text": "contrôle interne ;"}, {"orientation_angle": 0, "polygon": [[336.0, 2234.0], [2162.0, 2236.0], [2162.0, 2289.0], [336.0, 2287.0]], "score": 0.9887291789054871, "text": "> il prend connaissance du contrôle interne pertinent pour l'audit afin de définir des"}, {"orientation_angle": 0, "polygon": [[389.0, 2287.0], [2166.0, 2291.0], [2166.0, 2347.0], [389.0, 2344.0]], "score": 0.980078935623169, "text": "procédures d’audit appropriées en la circonstance, et non dans le but d’exprimer une"}, {"orientation_angle": 0, "polygon": [[396.0, 2347.0], [1240.0, 2347.0], [1240.0, 2398.0], [396.0, 2398.0]], "score": 0.9988716244697571, "text": "opinion sur l'efficacité du contrôle interne ;"}, {"orientation_angle": 0, "polygon": [[341.0, 2448.0], [2161.0, 2448.0], [2161.0, 2494.0], [341.0, 2494.0]], "score": 0.9904066324234009, "text": "> il apprécie le caractère approprié des méthodes comptables retenues et le caractère"}, {"orientation_angle": 0, "polygon": [[389.0, 2499.0], [2162.0, 2505.0], [2162.0, 2556.0], [389.0, 2551.0]], "score": 0.9926735162734985, "text": "raisonnable des estimations comptables faites par la direction, ainsi que les informations"}, {"orientation_angle": 0, "polygon": [[389.0, 2556.0], [1368.0, 2559.0], [1368.0, 2611.0], [389.0, 2607.0]], "score": 0.9799854755401611, "text": "les concernant fournies dans les comptes annuels ;"}, {"orientation_angle": 0, "polygon": [[339.0, 2657.0], [2162.0, 2657.0], [2162.0, 2708.0], [339.0, 2708.0]], "score": 0.9850486516952515, "text": "> il apprécie le caractère approprié de l'application par la direction de la convention"}, {"orientation_angle": 0, "polygon": [[395.0, 2717.0], [2162.0, 2717.0], [2162.0, 2763.0], [395.0, 2763.0]], "score": 0.9830286502838135, "text": "comptable de continuité d'exploitation et, selon les éléments collectés, l'existence ou non"}, {"orientation_angle": 0, "polygon": [[393.0, 2766.0], [2161.0, 2768.0], [2161.0, 2816.0], [393.0, 2814.0]], "score": 0.9834705591201782, "text": "d’une incertitude significative liée à des événements ou à des circonstances susceptibles de"}, {"orientation_angle": 0, "polygon": [[393.0, 2826.0], [2161.0, 2826.0], [2161.0, 2873.0], [393.0, 2873.0]], "score": 0.9813737869262695, "text": "mettre en cause la capacité de la société à poursuivre son exploitation. Cette appréciation"}, {"orientation_angle": 0, "polygon": [[389.0, 2878.0], [2162.0, 2876.0], [2162.0, 2927.0], [389.0, 2929.0]], "score": 0.9938933253288269, "text": "s’appuie sur les éléments collectés jusqu'à la date de son rapport, étant toutefois rappelé"}, {"orientation_angle": 0, "polygon": [[391.0, 2934.0], [2162.0, 2931.0], [2162.0, 2982.0], [391.0, 2986.0]], "score": 0.9987601041793823, "text": "que des circonstances ou événements ultérieurs pourraient mettre en cause la continuité"}, {"orientation_angle": 0, "polygon": [[395.0, 2991.0], [2161.0, 2991.0], [2161.0, 3037.0], [395.0, 3037.0]], "score": 0.9842739105224609, "text": "d'exploitation. S'il conclut à l'existence d'une incertitude significative, il attire l'attention"}, {"orientation_angle": 0, "polygon": [[391.0, 3040.0], [2161.0, 3042.0], [2161.0, 3093.0], [391.0, 3092.0]], "score": 0.9895462393760681, "text": "des lecteurs de son rapport sur les informations fournies dans les comptes annuels au sujet"}, {"orientation_angle": 0, "polygon": [[393.0, 3099.0], [2150.0, 3100.0], [2150.0, 3147.0], [393.0, 3145.0]], "score": 0.997237503528595, "text": "de cette incertitude ou, si ces informations ne sont pas fournies ou ne sont pas pertinentes"}, {"orientation_angle": 0, "polygon": [[391.0, 3152.0], [1642.0, 3153.0], [1642.0, 3201.0], [391.0, 3200.0]], "score": 0.9941433072090149, "text": "il formule une certification avec réserve ou un refus de certifier ;"}, {"orientation_angle": 0, "polygon": [[2185.0, 3175.0], [2309.0, 3179.0], [2308.0, 3210.0], [2184.0, 3206.0]], "score": 0.5572496652603149, "text": "Memoar d ia"}, {"orientation_angle": 0, "polygon": [[2164.0, 3213.0], [2336.0, 3213.0], [2336.0, 3242.0], [2164.0, 3242.0]], "score": 0.41363808512687683, "text": "acpecric Regid"}, {"orientation_angle": 0, "polygon": [[2197.0, 3244.0], [2293.0, 3244.0], [2293.0, 3275.0], [2197.0, 3275.0]], "score": 0.5277025103569031, "text": ":: Lar."}, {"orientation_angle": 0, "polygon": [[383.0, 3327.0], [772.0, 3219.0], [787.0, 3270.0], [397.0, 3379.0]], "score": 0.9348166584968567, "text": "Certifiée conforme"}, {"orientation_angle": 0, "polygon": [[259.0, 3367.0], [394.0, 3328.0], [408.0, 3375.0], [273.0, 3414.0]], "score": 0.8666696548461914, "text": "(Copie"}, {"orientation_angle": 0, "polygon": [[405.0, 3383.0], [778.0, 3251.0], [802.0, 3317.0], [428.0, 3450.0]], "score": 0.7515636086463928, "text": "grantniènde"}], "page": 29, "pdf": "CA_445070311_6751_2003B00059_2023_C__6860f28ca0138eae340c7453.pdf", "skew_angle": 0.0}