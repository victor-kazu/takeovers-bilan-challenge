{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[5317.0, 217.0], [5346.0, 246.0], [5322.0, 269.0], [5293.0, 241.0]], "score": 0.9864761829376221, "text": "*"}, {"orientation_angle": 0, "polygon": [[6331.0, 226.0], [6377.0, 291.0], [6340.0, 317.0], [6294.0, 252.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[1717.0, 1180.0], [6347.0, 1185.0], [6347.0, 1327.0], [1717.0, 1322.0]], "score": 0.9800994992256165, "text": "La répartition entre les actionnaires acheteurs des actions"}, {"orientation_angle": 0, "polygon": [[1388.0, 1327.0], [6328.0, 1336.0], [6328.0, 1469.0], [1388.0, 1459.0]], "score": 0.986415684223175, "text": "offertes est effectuée par le conseil d'administration,"}, {"orientation_angle": 0, "polygon": [[1388.0, 1469.0], [6357.0, 1464.0], [6357.0, 1605.0], [1388.0, 1610.0]], "score": 0.9957893490791321, "text": "proportionnellement à leur participation dans le capital et dans la"}, {"orientation_angle": 0, "polygon": [[1402.0, 1605.0], [6347.0, 1615.0], [6347.0, 1743.0], [1402.0, 1733.0]], "score": 0.970706582069397, "text": "limite de leurs demandes. S'il y a lieu, les actions non réparties sont"}, {"orientation_angle": 0, "polygon": [[1393.0, 1747.0], [6347.0, 1757.0], [6347.0, 1884.0], [1392.0, 1875.0]], "score": 0.9806185364723206, "text": "attribuées par voie de tirage au sort - auquel il est procédé par le"}, {"orientation_angle": 0, "polygon": [[1402.0, 1884.0], [6357.0, 1894.0], [6357.0, 2021.0], [1402.0, 2012.0]], "score": 0.9986228346824646, "text": "conseil d'administration, en présence des actionnaires acheteurs ou eux"}, {"orientation_angle": 0, "polygon": [[1397.0, 2021.0], [6352.0, 2026.0], [6352.0, 2168.0], [1397.0, 2163.0]], "score": 0.9709509015083313, "text": "dûment appelés - à autant d'actionnaires acheteurs qu'il reste"}, {"orientation_angle": 0, "polygon": [[1412.0, 2172.0], [2923.0, 2172.0], [2923.0, 2286.0], [1412.0, 2286.0]], "score": 0.9969228506088257, "text": "d'acti