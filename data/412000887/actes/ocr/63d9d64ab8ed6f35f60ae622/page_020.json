{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[2134.0, 301.0], [2194.0, 301.0], [2194.0, 353.0], [2134.0, 353.0]], "score": 0.9997808933258057, "text": "10"}, {"orientation_angle": 0, "polygon": [[865.0, 409.0], [1731.0, 411.0], [1731.0, 457.0], [865.0, 455.0]], "score": 0.9624215960502625, "text": "Article 15 - DISSOLUTION - LIQUIDATION"}, {"orientation_angle": 0, "polygon": [[644.0, 560.0], [2189.0, 567.0], [2189.0, 614.0], [644.0, 607.0]], "score": 0.983058750629425, "text": "1°) A l'expiration de la société ou en cas de dissolution pour quelque cause"}, {"orientation_angle": 0, "polygon": [[408.0, 613.0], [2191.0, 613.0], [2191.0, 664.0], [408.0, 664.0]], "score": 0.9959263801574707, "text": "que ce soit, la liquidation est faite par le ou les gérants alors en fonction sauf décision"}, {"orientation_angle": 0, "polygon": [[408.0, 662.0], [2189.0, 667.0], [2189.0, 714.0], [408.0, 708.0]], "score": 0.9861070513725281, "text": "contraire du ou des associés qui désignent alors, dans les conditions prévues pour les"}, {"orientation_angle": 0, "polygon": [[406.0, 714.0], [1502.0, 715.0], [1502.0, 762.0], [406.0, 760.0]], "score": 0.9939635992050171, "text": "décisions ordinaires, un ou plusieurs autres liquidateurs."}, {"orientation_angle": 0, "polygon": [[641.0, 861.0], [2191.0, 866.0], [2191.0, 917.0], [641.0, 912.0]], "score": 0.982774555683136, "text": "2°) Les liquidateurs ont les pouvoirs les plus étendus à l'effet de réaliser aux"}, {"orientation_angle": 0, "polygon": [[408.0, 916.0], [2186.0, 919.0], [2185.0, 965.0], [408.0, 962.0]], "score": 0.9864773750305176, "text": "prix, charges et conditions qu'ils aviseront, tout l'actif de la société et d'éteindre son passif."}, {"orientation_angle": 0, "polygon": [[408.0, 967.0], [961.0, 967.0], [961.0, 1013.0], [408.0, 1013.0]], "score": 0.9916566014289856, "text": "Ils peuvent agir séparément."}, {"orientation_angle": 0, "polygon": [[641.0, 1167.0], [2184.0, 1172.0], [2184.0, 1219.0], [641.0, 1213.0]], "score": 0.9891262650489807, "text": "3°) Le boni de liquidation, après remboursement du nominal des parts sociales,"}, {"orientation_angle": 0, "polygon": [[405.0, 1219.0], [2184.0, 1222.0], [2184.0, 1268.0], [405.0, 1265.0]], "score": 0.9898733496665955, "text": "est attribué à l'associé unique ou, en cas de pluralité d'associés, partagé entre les associés"}, {"orientation_angle": 0, "polygon": [[408.0, 1273.0], [1478.0, 1273.0], [1478.0, 1314.0], [408.0, 1314.0]], "score": 0.9928687810897827, "text": "proportionnellement au nombre de leurs parts sociales."}, {"orientation_angle": 0, "polygon": [[1054.0, 1468.0], [1533.0, 1470.0], [1533.0, 1516.0], [1054.0, 1515.0]], "score": 0.9989898204803467, "text": "STATUTS MIS A JOUR"}, {"orientation_angle": 0, "polygon": [[1121.0, 1521.0], [1467.0, 1521.0], [1467.0, 1568.0], [1121.0, 1568.0]], "score": 0.9984359741210938, "text": "Le 17 mars 2015"}], "page": 20, "pdf": "63d9d64ab8ed6f35f60ae622__63d9d64ab8ed6f35f60ae622.pdf", "skew_angle": 0.0}