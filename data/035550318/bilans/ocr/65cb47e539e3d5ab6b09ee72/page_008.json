entation_angle": 0, "polygon": [[155.0, 1954.0], [1524.0, 1945.0], [1524.0, 1981.0], [155.0, 1990.0]], "score": 0.9919378757476807, "text": "La valeur brute des marchandises et des approvisionnements comprend le prix d'achat et les frais accessoires."}, {"orientation_angle": 0, "polygon": [[155.0, 2026.0], [2228.0, 2010.0], [2229.0, 2046.0], [155.0, 2062.0]], "score": 0.9988565444946289, "text": "Les travaux en cours sont valorisés au coût de revient comprenant les consommations et les charges directes et indirectes de production, les amortissements des biens"}, {"orientation_angle": 0, "polygon": [[155.0, 2072.0], [497.0, 2067.0], [498.0, 2103.0], [155.0, 2108.0]], "score": 0.9989187717437744, "text": "concourant à la production."}, {"orientation_angle": 0, "polygon": [[157.0, 2142.0], [2299.0, 2125.0], [2299.0, 2161.0], [157.0, 2178.0]], "score": 0.9892218708992004, "text": "Une provision pour dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités indiquées ci-dessus et le cours du jour ou la valeur de"}, {"orientation_angle": 0, "polygon": [[155.0, 2183.0], [1846.0, 2171.0], [1846.0, 2211.0], [155.0, 2223.0]], "score": 0.9879871606826782, "text": "réalisation déduction faites des frais professionnels de vente, effectuée lorsque cette valeur brute est supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[2197.0, 2809.0], [2292.0, 2805.0], [2293.0, 2827.0], [2198.0, 2831.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[1206.0, 3245.0], [1252.0, 3245.0], [1252.0, 3283.0], [1206.0, 3283.0]], "score": 0.9999524354934692, "text": "30"}], "page": 8, "pdf": "CA_035550318_3902_1955B80031_2023_C__65cb47e539e3d5ab6b09ee72.pdf", "skew_angle": 0.0}