tion_angle": 0, "polygon": [[581.0, 774.0], [1723.0, 774.0], [1723.0, 803.0], [581.0, 803.0]], "score": 0.9686974287033081, "text": "Annexe au bian avant répartution de l'exercice cios le 30/06/2021, dont le tolal est de 4 823 304 euros"}, {"orientation_angle": 0, "polygon": [[581.0, 814.0], [1816.0, 814.0], [1816.0, 843.0], [581.0, 843.0]], "score": 0.989524781703949, "text": "et au compte de résuitat de l'exercice, présenté sous forme de liste, dégageant un bénéfice de 451 909 euros."}, {"orientation_angle": 0, "polygon": [[581.0, 891.0], [1563.0, 891.0], [1563.0, 916.0], [581.0, 916.0]], "score": 0.9818867444992065, "text": "L'exercice a une durée de 12 mois, recouvrant la pérode du 01/07/2020 au 30/o6/2021."}, {"orientation_angle": 0, "polygon": [[579.0, 962.0], [1412.0, 962.0], [1412.0, 991.0], [579.0, 991.0]], "score": 0.9773434996604919, "text": "Les notes ou tableaux ci-après font partie intégrante des comptes annueis"}, {"orientation_angle": 0, "polygon": [[581.0, 1043.0], [1348.0, 1043.0], [1348.0, 1072.0], [581.0, 1072.0]], "score": 0.9806150794029236, "text": "Ces comptes annuels ont été arrêtés le 13/10/2021 par le Présıdent."}, {"orientation_angle": 0, "polygon": [[581.0, 1129.0], [898.0, 1129.0], [898.0, 1171.0], [581.0, 1171.0]], "score": 0.997523307800293, "text": "Règles générales"}, {"orientation_angle": 0, "polygon": [[579.0, 1214.0], [2127.0, 1214.0], [2127.0, 1243.0], [579.0, 1243.0]], "score": 0.9718043208122253, "text": "Les comptes annuels de l’exercice au 30/os/2o21 ont été établis conformément au règlement de l’Autonté des Normes Comptables"}, {"orientation_angle": 0, "polygon": [[576.0, 1247.0], [2129.0, 1250.0], [2129.0, 1284.0], [576.0, 1281.0]], "score": 0.966762900352478, "text": "n'2018-07 du 10 décembre 2018, à jour des differents réglements complémentaires à la date de l'établissement des dits comptes"}, {"orientation_angle": 0, "polygon": [[578.0, 1290.0], [676.0, 1290.0], [676.0, 1321.0], [578.0, 1321.0]], "score": 0.9976595640182495, "text": "annuels"}, {"orientation_angle": 0, "polygon": [[579.0, 1331.0], [2130.0, 1331.0], [2130.0, 1360.0], [579.0, 1360.0]], "score": 0.9905511140823364, "text": "Les conventions comptables ont été appliquées avec sincérité dans le respect du principe de prudence, conformément aux hypothèses de"}, {"orientation_angle": 0, "polygon": [[577.0, 1365.0], [659.0, 1369.0], [657.0, 1402.0], [575.0, 1398.0]], "score": 0.9267373085021973, "text": "base :"}, {"orientation_angle": 0, "polygon": [[595.0, 1407.0], [916.0, 1407.0], [916.0, 1436.0], [595.0, 1436.0]], "score": 0.9662984013557434, "text": "- continuité de l'exploitation,"}, {"orientation_angle": 0, "polygon": [[595.0, 1443.0], [1319.0, 1443.0], [1319.0, 1472.0], [595.0, 1472.0]], "score": 0.9951946139335632, "text": "- permanence des méthodes comptables d'un exercice à l'autre,"}, {"orientation_angle": 0, "polygon": [[592.0, 1476.0], [941.0, 1478.0], [940.0, 1512.0], [591.0, 1510.0]], "score": 0.9896126389503479, "text": "- indépendance des exercices"}, {"orientation_angle": 0, "polygon": [[579.0, 1559.0], [1651.0, 1559.0], [1651.0, 1588.0], [579.0, 1588.0]], "score": 0.994730532169342, "text": "et conformément aux règles générales d'établissement et de présentation des comptes annuets"}, {"orientation_angle": 0, "polygon": [[578.0, 1638.0], [1936.0, 1638.0], [1936.0, 1667.0], [578.0, 1667.0]], "score": 0.9965469837188721, "text": "La méthode de base retenue pour l'évaluation des éléments inscrits en comptabilité est la méthode des coûts historiques."}, {"orientation_angle": 0, "polygon": [[579.0, 1712.0], [1768.0, 1712.0], [1768.0, 1741.0], [579.0, 1741.0]], "score": 0.9962322115898132, "text": "Seules sont exprimées les informations significativesSauf mention, les montants sont exprimés en euros."}, {"orientation_angle": 0, "polygon": [[581.0, 1798.0], [1379.0, 1798.0], [1379.0, 1838.0], [581.0, 1838.0]], "score": 0.9996641278266907, "text": "Immobilisations corporelles et incorporelles"}, {"orientation_a