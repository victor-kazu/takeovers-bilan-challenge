343.0], [6484.0, 4329.0], [6485.0, 4460.0], [1843.0, 4474.0]], "score": 0.9818084836006165, "text": "Un an au moins avant la date d’expiration de la société, la gérance doit provoquer une"}, {"orientation_angle": 0, "polygon": [[1021.0, 4493.0], [6041.0, 4469.0], [6041.0, 4596.0], [1022.0, 4620.0]], "score": 0.9757646918296814, "text": "réunion de la collectivité des associés à l’effet de décider, dans les conditions requises pour la"}, {"orientation_angle": 0, "polygon": [[1026.0, 4634.0], [4044.0, 4624.0], [4045.0, 4751.0], [1027.0, 4760.0]], "score": 0.9947019219398499, "text": "modification des statuts, si la société doit être prorogée."}, {"orientation_angle": 0, "polygon": [[1035.0, 5051.0], [5999.0, 5023.0], [6000.0, 5149.0], [1036.0, 5178.0]], "score": 0.9794691801071167, "text": "Article 25 - CAPITAUX PROPRES INFERIEURS A LA MOITIE DU CAPITAL SOCIAL"}, {"orientation_angle": 0, "polygon": [[1861.0, 5600.0], [6545.0, 5576.0], [6545.0, 5703.0], [1862.0, 5727.0]], "score": 0.9892396330833435, "text": "Si, du fait de pertes constatées dans les documents comptables, les capitaux propres de"}, {"orientation_angle": 0, "polygon": [[1035.0, 5741.0], [6461.0, 5717.0], [6461.0, 5844.0], [1036.0, 5867.0]], "score": 0.9938423037528992, "text": "la société deviennent inférieurs à la moitié du capital social, la gérance doit, dans les quatre mois qui"}, {"orientation_angle": 0, "polygon": [[1035.0, 5877.0], [6255.0, 5848.0], [6256.0, 5989.0], [1036.0, 6017.0]], "score": 0.9892390370368958, "text": "suivent l'approbation des comptes ayant fait apparaître cette perte, consulter les associés afin de"}, {"orientation_angle": 0, "polygon": [[1045.0, 6022.0], [4063.0, 6008.0], [4063.0, 6134.0], [1045.0, 6149.0]], "score": 0.9890580773353577, "text": "décider, s'il y a lieu à dissolution anticipée de la société."}, {"orientation_angle": 0, "polygon": [[1861.0, 6294.0], [6265.0, 6270.0], [6265.0, 6411.0], [1862.0, 6435.0]], "score": 0.996821403503418, "text": "L’assemblée délibère aux conditions de majorité prévues pour la modification des"}, {"orientation_angle": 0, "polygon": [[1045.0, 6453.0], [1465.0, 6453.0], [1465.0, 6566.0], [1045.0, 6566.0]], "score": 0.9990993738174438, "text": "statuts."}, {"orientation_angle": 0, "polygon": [[1871.0, 6707.0], [6452.0, 6692.0], [6452.0, 6833.0], [1871.0, 6847.0]], "score": 0.9844780564308167, "text": "Si la dissolution n'est pas prononcée, le capital doit être, dans le délai fixé par la Loi,"}, {"orientation_angle": 0, "polygon": [[1045.0, 6857.0], [6456.0, 6838.0], [6457.0, 6974.0], [1045.0, 6993.0]], "score": 0.989190936088562, "text": "réduit d’un montant égal au montant des pertes qui n'ont pu être imputées sur les réserves si, dans ce"}, {"orientation_angle": 0, "polygon": [[1054.0, 6993.0], [6419.0, 6969.0], [6419.0, 7114.0], [1055.0, 7138.0]], "score": 0.9849668741226196, "text": "délai, les capitaux propres n'ont pas été reconstitués à concurrence d’une valeur au moins égale à la"}, {"orientation_angle": 0, "polygon": [[1054.0, 7143.0], [2374.0, 7133.0], [2375.0, 7260.0], [1055.0, 7270.0]], "score": 0.9995906352996826, "text": "moitié du capital social."}, {"orientation_angle": 0, "polygon": [[1875.0, 7406.0], [6484.0, 7382.0], [6485.0, 7522.0], [1876.0, 7546.0]], "score": 0.9813830256462097, "text": "La réduction du capital à un montant inférieur au minimum légal ne peut être décidée"}, {"orientation_angle": 0, "polygon": [[1063.0, 7556.0], [6661.0, 7522.0], [6662.0, 7663.0], [1064.0, 7696.0]], "score": 0.9811059236526489, "text": "que sous la condition suspensive d'une augmentation de capital destinée à amener celui-ci au moins à ce"}, {"orientation_angle": 0, "polygon": [[1063.0, 7706.0], [2122.0, 7696.0], [2123.0, 7808.0], [1064.0, 7818.0]], "score": 0.99977707862854, "text": "montant minimum."}, {"orientation_angle": 0, "polygon": [[1884.0, 7964.0], [6573.0, 7945.0], [6573.0, 8085.0], [1885.0, 8104.0]], "score": 0.9856016039848328, "text": "En cas d'inobservation des prescriptions de l’un ou plusieurs des alinéas qui précèdent,"}, {"orientation_angle": 0, "polygon": [[1068.0, 8109.0], [6372.0, 8090.0], [6373.0, 8221.0], [1069.0, 8240.0]], "score": 0.9968969821929932, "text": "tout intéressé peut demander en justice la dissolution de la société. Il en est de même si les associés"}, {"orientation_angle": 0, "polygon": [[1068.0, 8254.0], [2785.0, 8249.0], [2785.0, 8376.0], [1069.0, 8381.0]], "score": 0.9773386716842651, "text": "n'ont pu délibérer valablement."}, {"orientation_angle": 0, "polygon": [[3606.0, 8687.0], [4254.0, 8653.0], [4273.0, 9018.0], [3625.0, 9053.0]], "score": 0.8434858322143555, "text": "SC"}, {"orientation_angle": 0, "polygon": [[2293.0, 8714.0], [2906.0, 8741.0], [2890.0, 9112.0], [2277.0, 9085.0]], "score": 0.9846844673156738, "text": "P.S"}, {"orientation_angle": 0, "polygon": [[5374.0, 8723.0], [6023.0, 8723.0], [6023.0, 9155.0], [5374.0, 9155.0]], "score": 0.7491888999938965, "text": "R.S"}, {"orientation_angle": 1, "polygon": [[728.0, 8770.0], [1320.0, 8770.0], [1320.0, 9169.0], [728.0, 9169.0]], "score": 0.9734547138214111, "text": "4"}], "page": 20, "pdf": "63e881148be6eb9f9d1ff96a__63e881148be6eb9f9d1ff96a.pdf", "skew_angle": 0.970507989226942}