{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[1707.0, 1214.0], [6337.0, 1199.0], [6338.0, 1322.0], [1707.0, 1337.0]], "score": 0.9908181428909302, "text": "Tout retard dans le versement des sommes dues sur le montant non"}, {"orientation_angle": 0, "polygon": [[1368.0, 1346.0], [6333.0, 1332.0], [6333.0, 1473.0], [1369.0, 1488.0]], "score": 0.9848644137382507, "text": "libéré des actions porte, de plein droit et sans qu'il soit besoin de"}, {"orientation_angle": 0, "polygon": [[1373.0, 1502.0], [6337.0, 1478.0], [6338.0, 1605.0], [1374.0, 1629.0]], "score": 0.9799333214759827, "text": "procéder à une formalité quelconque, intérêt au taux légal, à partir de"}, {"orientation_angle": 0, "polygon": [[1368.0, 1639.0], [6342.0, 1624.0], [6343.0, 1752.0], [1369.0, 1766.0]], "score": 0.993848443031311, "text": "la date d'exigibilité, sans préjudice de l'action personnelle que la"}, {"orientation_angle": 0, "polygon": [[1368.0, 1776.0], [6342.0, 1756.0], [6343.0, 1893.0], [1369.0, 1913.0]], "score": 0.9895588755607605, "text": "société peut exercer contre l'actionnaire défaillant et des mesures"}, {"orientation_angle": 0, "polygon": [[1364.0, 1913.0], [4020.0, 1908.0], [4020.0, 2035.0], [1364.0, 2040.0]], "score": 0.9763556122779846, "text": "d'exécution forcée prévues par la loi."}, {"orientation_angle": 0, "polygon": [[1444.0, 2612.0], [2497.0, 2597.0], [2499.0, 2729.0], [1446.0, 2744.0]], "score": 0.9947641491889954, "text": "Article 10 . -"}, {"orientation_angle": 0, "polygon": [[2566.0, 2607.0], [3772.0, 2607.0], [3772.0, 2720.0], [2566.0, 2720.0]], "score": 0.9963733553886414, "text": "FORME DES ACTIONS"}, {"orientation_angle": 0, "polygon": [[1726.0, 2895.0], [3753.0, 2885.0], [3753.0, 3013.0], [1727.0, 3022.0]], "score": 0.9848371744155884, "text": "Les actions sont nominatives."}, {"orientation_angle": 0, "polygon": [[1736.0, 3178.0], [6356.0, 3159.0], [6357.0, 3286.0], [1736.0, 3306.0]], "score": 0.986141562461853, "text": "Elles donnent lieu à une inscription en compte dans les conditions"}, {"orientation_angle": 0, "polygon": [[1392.0, 3329.0], [4325.0, 3310.0], [4326.0, 3437.0], [1393.0, 3457.0]], "score": 0.9879500865936279, "text": "et selon les modalités prévues par la loi."}, {"orientation_angle": 0, "polygon": [[1469.0, 4151.0], [5064.0, 4151.0], [5064.0, 4292.0], [1469.0, 4292.0]], "score": 0.9599881768226624, "text": "Article II . - CESSION ET TRANSMISSION DES ACTIONS"}, {"orientation_angle": 0, "polygon": [[1741.0, 4425.0], [2313.0, 4425.0], [2313.0, 4571.0], [1741.0, 4571.0]], "score": 0.8977434635162354, "text": "I. - 1"}, {"orientation_angle": 0, "polygon": [[2251.0, 4420.0], [6390.0, 4406.0], [6390.0, 4547.0], [2251.0, 4562.0]], "score": 0.9973386526107788, "text": "La propriété des actions résulte de leur inscription en"}, {"orientation_angle": 0, "polygon": [[1411.0, 4571.0], [6385.0, 4552.0], [6386.0, 4684.0], [1412.0, 4703.0]], "score": 0.9790602326393127, "text": "compte au nom du ou des titulaires. Leur cession s'opère à l'égard des"}, {"orientation_angle": 0, "polygon": [[1416.0, 4713.0], [6380.0, 4698.0], [6381.0, 4826.0], [1417.0, 4840.0]], "score": 0.9913207292556763, "text": "tiers et de la société, par un ordre de mouvement signé du cédant ou de"}, {"orientation_angle": 0, "polygon": [[1421.0, 4855.0], [5603.0, 4840.0], [5603.0, 4968.0], [1421.0, 4982.0]], "score": 0.9931596517562866, "text": "son mandataire, et mentionné sur le registre des mouvements."}, {"orientation_angle": 0, "polygon": [[1759.0, 5261.0], [6414.0, 5241.0], [6414.0, 5383.0], [1760.0, 5402.0]], "score": 0.986370325088501, "text": "Si les actions ne sont pas entiarement libérées, l'ordre de"}, {"orientation_angle": 0, "polygon": [[1421.0, 5417.0], [5269.0, 5392.0], [5270.0, 5520.0], [1422.0, 5544.0]], "score": 0.9867433309555054, "text": "mouvement doit être signé en outre par le cessionnaire."}, {"orientation_angle": 0, "polygon": [[1774.0, 5690.0], [6404.0, 5671.0], [6405.0, 5799.0], [1774.0, 5818.0]], "score": 0.9912335872650146, "text": "La société peut exiger que la signature des parties soit certifiée"}, {"orientation_angle": 0, "polygon": [[1426.0, 5832.0], [6409.0, 5808.0], [6409.0, 5950.0], [1426.0, 5974.0]], "score": 0.9912905693054199, "text": "par un Officier Public ou le maire de leur domicile, sous réserve des"}, {"orientation_angle": 0, "polygon": [[1435.0, 5979.0], [3528.0, 5964.0], [3529.0, 6091.0], [1436.0, 6106.0]], "score": 0.9975700974464417, "text": "exceptions prévues par la loi."}, {"orientation_angle": 0, "polygon": [[1769.0, 6233.0], [6404.0, 6219.0], [6405.0, 6365.0], [1770.0, 6380.0]], "score": 0.9932737946510315, "text": "La transmission d'actions, à titre gratuit ou en suite de décès,"}, {"orientation_angle": 0, "polygon": [[1440.0, 6389.0], [6418.0, 6370.0], [6419.0, 6498.0], [1440.0, 6517.0]], "score": 0.9879652261734009, "text": "s'opère également par un ordre de mouvement mentionné sur le registre"}, {"orientation_angle": 0, "polygon": [[1440.0, 6531.0], [6414.0, 6507.0], [6414.0, 6630.0], [1441.0, 6654.0]], "score": 0.9870299100875854, "text": "des mouvements sur justification de la mutation dans les conditions"}, {"orientation_angle": 0, "polygon": [[1445.0, 6668.0], [6423.0, 6653.0], [6424.0, 6781.0], [1445.0, 6795.0]], "score": 0.9868627786636353, "text": "légales et sous réserve, le cas échéant, du respect de la procèdure"}, {"orientation_angle": 0, "polygon": [[1450.0, 6805.0], [2623.0, 6805.0], [2623.0, 6918.0], [1450.0, 6918.0]], "score": 0.9980024695396423, "text": "définie ci-après."}, {"orientation_angle": 0, "polygon": [[1788.0, 7083.0], [6433.0, 7064.0], [6433.0, 7192.0], [1789.0, 7211.0]], "score": 0.9906973242759705, "text": "Les frais de cession sont à la charge des cessionnaires sauf"}, {"orientation_angle": 0, "polygon": [[1454.0, 7230.0], [5093.0, 7211.0], [5093.0, 7338.0], [1455.0, 7357.0]], "score": 0.9974388480186462, "text": "convention contraire entre cédants et cessionnaires."}, {"orientation_angle": 0, "polygon": [[1654.0, 7703.0], [6498.0, 7616.0], [6501.0, 7744.0], [1656.0, 7830.0]], "score": 0.9939635992050171, "text": "Les actions non libérées des versements exigibles ne sont pas admises"}, {"orientation_angle": 0, "polygon": [[1463.0, 7864.0], [2363.0, 7833.0], [2367.0, 7946.0], [1467.0, 7977.0]], "score": 0.9997430443763733, "text": "au transfert."}], "page": 5, "pdf": "63e8ebb854febda17c19ee6e__63e8ebb854febda17c19ee6e.pdf", "skew_angle": 0.9737721724975449}