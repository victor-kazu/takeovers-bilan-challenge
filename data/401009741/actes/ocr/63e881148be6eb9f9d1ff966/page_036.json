{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[205.0, 298.0], [925.0, 302.0], [925.0, 348.0], [205.0, 344.0]], "score": 0.9862170219421387, "text": "Article 34 - Dissolution - Liguidation :"}, {"orientation_angle": 0, "polygon": [[203.0, 411.0], [2253.0, 420.0], [2253.0, 466.0], [203.0, 457.0]], "score": 0.9887461066246033, "text": "La dissolution de la société intervient soit suite à une décision extraordinaire des associés, soit par"}, {"orientation_angle": 0, "polygon": [[203.0, 468.0], [718.0, 471.0], [718.0, 518.0], [203.0, 514.0]], "score": 0.9971801042556763, "text": "extinction de l’objet social."}, {"orientation_angle": 0, "polygon": [[203.0, 581.0], [2251.0, 589.0], [2251.0, 636.0], [203.0, 627.0]], "score": 0.9871168732643127, "text": "La dissolution de la société entraîne sa liquidation qui est effectuée conformément aux présents statuts et"}, {"orientation_angle": 0, "polygon": [[203.0, 641.0], [665.0, 641.0], [665.0, 687.0], [203.0, 687.0]], "score": 0.9819023609161377, "text": "aux dispositions légales."}, {"orientation_angle": 0, "polygon": [[202.0, 749.0], [2249.0, 761.0], [2249.0, 809.0], [201.0, 797.0]], "score": 0.9883478879928589, "text": "Une décision extraordinaire des associés nomme le liquidateur. Si les associés n'ont pu nommer un"}, {"orientation_angle": 0, "polygon": [[200.0, 807.0], [2249.0, 814.0], [2249.0, 865.0], [200.0, 858.0]], "score": 0.9958702325820923, "text": "liquidateur dans un délai de quinze jours à compter de la dissolution, celui-ci est désigné par le président du"}, {"orientation_angle": 0, "polygon": [[198.0, 863.0], [1380.0, 869.0], [1379.0, 917.0], [198.0, 911.0]], "score": 0.9993552565574646, "text": "Tribunal de Commerce statuant sur requête de tout intéressé."}, {"orientation_angle": 0, "polygon": [[200.0, 977.0], [2108.0, 984.0], [2108.0, 1030.0], [200.0, 1023.0]], "score": 0.9726468920707703, "text": "Le boni de liquidation est réparti entre les associés proportionnellement au nombre de leurs actions."}, {"orientation_angle": 0, "polygon": [[200.0, 1090.0], [913.0, 1090.0], [913.0, 1136.0], [200.0, 1136.0]], "score": 0.9928597807884216, "text": "Article 35 - Forme des notifications :"}, {"orientation_angle": 0, "polygon": [[198.0, 1199.0], [2244.0, 1210.0], [2244.0, 1256.0], [198.0, 1246.0]], "score": 0.9947852492332458, "text": "Les notifications et demandes prévues aux présents statuts seront valablement faites soit par acte"}, {"orientation_angle": 0, "polygon": [[198.0, 1259.0], [1536.0, 1263.0], [1536.0, 1309.0], [198.0, 1306.0]], "score": 0.9951579570770264, "text": "extrajudiciaire, soit par lettre recommandée avec accusé de réception."}, {"orientation_angle": 0, "polygon": [[198.0, 1485.0], [806.0, 1485.0], [806.0, 1525.0], [198.0, 1525.0]], "score": 0.9947158098220825, "text": "Statuts refondus le 31 mai 2017"}, {"orientation_angle": 1, "polygon": [[785.0, 1776.0], [1677.0, 1689.0], [1733.0, 2258.0], [841.0, 2344.0]], "score": 0.0, "text": ""}, {"orientation_angle": 1, "polygon": [[1106.0, 1907.0], [1157.0, 1907.0], [1157.0, 1933.0], [1106.0, 1933.0]], "score": 0.3073168992996216, "text": "po"}, {"orientation_angle": 0, "polygon": [[2186.0, 3315.0], [2244.0, 3315.0], [2244.0, 3367.0], [2186.0, 3367.0]], "score": 0.999904453754425, "text": "23"}], "page": 36, "pdf": "63e881148be6eb9f9d1ff966__63e881148be6eb9f9d1ff966.pdf", "skew_angle": 0.0}