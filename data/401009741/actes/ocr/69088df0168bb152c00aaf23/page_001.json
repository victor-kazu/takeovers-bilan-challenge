0, 1277.0], [2156.0, 1272.0], [2156.0, 1323.0], [463.0, 1328.0]], "score": 0.9837015271186829, "text": "Il a été établi une feuille de présence qui a été émargée par chaque associé présent ou"}, {"orientation_angle": 0, "polygon": [[356.0, 1338.0], [957.0, 1335.0], [958.0, 1376.0], [357.0, 1379.0]], "score": 0.9992506504058838, "text": "mandataire en entrant en séance."}, {"orientation_angle": 0, "polygon": [[467.0, 1441.0], [1665.0, 1434.0], [1665.0, 1480.0], [467.0, 1487.0]], "score": 0.9829927086830139, "text": "L'Assemblée est présidée par Monsieur Philippe SILVAiN, Président."}, {"orientation_angle": 0, "polygon": [[467.0, 1552.0], [1681.0, 1544.0], [1681.0, 1585.0], [467.0, 1593.0]], "score": 0.9878499507904053, "text": "Madame Maryline CHAUBARD assume le secrétariat de l'Assemblée."}, {"orientation_angle": 0, "polygon": [[467.0, 1655.0], [1722.0, 1650.0], [1722.0, 1696.0], [467.0, 1701.0]], "score": 0.9841977953910828, "text": "La feuille de présence est certifiée sincère et véritable par le Président."}, {"orientation_angle": 0, "polygon": [[463.0, 1763.0], [2161.0, 1756.0], [2161.0, 1802.0], [463.0, 1809.0]], "score": 0.9898690581321716, "text": "L‘Assemblée est déclarée régulièrement constituée et peut valablement délibérer à la majorité"}, {"orientation_angle": 0, "polygon": [[350.0, 1819.0], [506.0, 1819.0], [506.0, 1869.0], [350.0, 1869.0]], "score": 0.9999539852142334, "text": "requise."}, {"orientation_angle": 0, "polygon": [[465.0, 1927.0], [1977.0, 1915.0], [1977.0, 1961.0], [465.0, 1973.0]], "score": 0.9777299165725708, "text": "Monsieur Philippe SILVAIN dépose sur le bureau et met à la disposition des associés :"}, {"orientation_angle": 0, "polygon": [[536.0, 2035.0], [1243.0, 2031.0], [1244.0, 2072.0], [536.0, 2076.0]], "score": 0.9860988855361938, "text": "la copie des convocations des associés ;"}, {"orientation_angle": 0, "polygon": [[536.0, 2088.0], [940.0, 2088.0], [940.0, 2129.0], [536.0, 2129.0]], "score": 0.9640571475028992, "text": "la feuille de présence ;"}, {"orientation_angle": 0, "polygon": [[534.0, 2143.0], [1595.0, 2138.0], [1595.0, 2180.0], [534.0, 2186.0]], "score": 0.9990572333335876, "text": "les pouvoirs des associés représentés par des mandataires ;"}, {"orientation_angle": 0, "polygon": [[529.0, 2189.0], [749.0, 2193.0], [748.0, 2246.0], [528.0, 2242.0]], "score": 0.9705166220664978, "text": "les statuts ;"}, {"orientation_angle": 0, "polygon": [[532.0, 2249.0], [975.0, 2245.0], [975.0, 2291.0], [532.0, 2295.0]], "score": 0.9792861938476562, "text": "le rapport du Président ;"}, {"orientation_angle": 0, "polygon": [[532.0, 2302.0], [1560.0, 2297.0], [1560.0, 2343.0], [532.0, 2348.0]], "score": 0.9951176643371582, "text": "le projet des résolutions qui sont soumises à l'Assemblée."}, {"orientation_angle": 0, "polygon": [[467.0, 2410.0], [2160.0, 2401.0], [2160.0, 2447.0], [467.0, 2456.0]], "score": 0.9905840158462524, "text": "Puis, le Président déclare que le texte des résolutions ainsi que tous les documents et"}, {"orientation_angle": 0, "polygon": [[351.0, 2468.0], [2158.0, 2458.0], [2158.0, 2499.0], [351.0, 2509.0]], "score": 0.9931626915931702, "text": "informations permettant aux associés de se prononcer en toute connaissance de cause sur les"}, {"orientation_angle": 0, "polygon": [[351.0, 2521.0], [2158.0, 2511.0], [2158.0, 2552.0], [351.0, 2562.0]], "score": 0.9860182404518127, "text": "résolutions présentées à leur approbation ont été tenus à leur disposition au siège social ou leur ont"}, {"orientation_angle": 0, "polygon": [[351.0, 2576.0], [1496.0, 2567.0], [1497.0, 2608.0], [352.0, 2617.0]], "score": 0.9961712956428528, "text": "été adressés, le tout conformément aux dispositions statutaires."}, {"orientation_angle": 0, "polygon": [[465.0, 2680.0], [1314.0, 2673.0], [1314.0, 2714.0], [465.0, 2721.0]], "score": 0.9963699579238892, "text": "L’Assemblée lui donne acte de ces déclarations."}, {"orientation_angle": 0, "polygon": [[463.0, 2786.0], [2159.0, 2776.0], [2160.0, 2820.0], [463.0, 2831.0]], "score": 0.9796643257141113, "text": "Monsieur Philippe SILvAIN rappelle ensuite que l'Assemblée est appelée à délibérer sur l'ordre"}, {"orientation_angle": 0, "polygon": [[350.0, 2841.0], [646.0, 2841.0], [646.0, 2887.0], [350.0, 2887.0]], "score": 0.9995564818382263, "text": "du jour suivant :"}, {"orientation_angle": 0, "polygon": [[463.0, 2949.0], [1068.0, 2945.0], [1068.0, 2986.0], [463.0, 2990.0]], "score": 0.9992547035217285, "text": "- Lecture du rapport du Président,"}, {"orientation_angle": 0, "polygon": [[461.0, 3000.0], [1984.0, 2991.0], [1984.0, 3038.0], [462.0, 3046.0]], "score": 0.9956498146057129, "text": "- Rectification d’une erreur matérielle sur le montant du capital souscrit de la société."}, {"orientation_angle": 0, "polygon": [[463.0, 3108.0], [1123.0, 3104.0], [1123.0, 3151.0], [463.0, 3154.0]], "score": 0.9660537838935852, "text": "Puis, il donne lecture de son rapport."}, {"orientation_angle": 0, "polygon": [[194.0, 3254.0], [415.0, 3289.0], [388.0, 3455.0], [167.0, 3420.0]], "score": 0.9017365574836731, "text": "PhS"}], "page": 1, "pdf": "69088df0168bb152c00aaf23__69088df0168bb152c00aaf23.pdf", "skew_angle": 0.0}