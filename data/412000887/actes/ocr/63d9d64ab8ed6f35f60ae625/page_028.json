{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[5791.0, 758.0], [5963.0, 769.0], [5954.0, 915.0], [5782.0, 904.0]], "score": 0.9999513626098633, "text": "27"}, {"orientation_angle": 0, "polygon": [[1664.0, 1180.0], [5961.0, 1190.0], [5961.0, 1327.0], [1664.0, 1317.0]], "score": 0.9922855496406555, "text": "En cas de décès, de refus ou d'empêchement de l'un des arbitres désignés, il"}, {"orientation_angle": 0, "polygon": [[1006.0, 1332.0], [5584.0, 1327.0], [5584.0, 1469.0], [1006.0, 1473.0]], "score": 0.9911730885505676, "text": "sera procédé à son remplacement dans les mêmes formes que pour sa nomination."}, {"orientation_angle": 0, "polygon": [[1664.0, 1747.0], [5956.0, 1747.0], [5956.0, 1875.0], [1664.0, 1875.0]], "score": 0.9955445528030396, "text": "Le Tribunal arbitral procèdera librement à l'instruction du litige, sans être tenu de"}, {"orientation_angle": 0, "polygon": [[1011.0, 1889.0], [5966.0, 1884.0], [5966.0, 2026.0], [1011.0, 2031.0]], "score": 0.9907523393630981, "text": "suivre les règles applicables aux instances judiciaires : il statuera comme amiable"}, {"orientation_angle": 0, "polygon": [[1016.0, 2040.0], [2732.0, 2035.0], [2733.0, 2167.0], [1016.0, 2172.0]], "score": 0.9858500361442566, "text": "compositeur, en dernier ressort."}, {"orientation_angle": 0, "polygon": [[1674.0, 2460.0], [5961.0, 2460.0], [5961.0, 2574.0], [1674.0, 2574.0]], "score": 0.9896583557128906, "text": "Il devra rendre sa sentence dans les quatre mois de la date d'acceptation de ses"}, {"orientation_angle": 0, "polygon": [[1016.0, 2597.0], [5794.0, 2592.0], [5794.0, 2720.0], [1016.0, 2725.0]], "score": 0.9947719573974609, "text": "fonctions par le troisième arbitre, sauf prorogation de ce délai avec l'accord des parties."}, {"orientation_angle": 0, "polygon": [[1683.0, 3017.0], [5541.0, 3017.0], [5541.0, 3145.0], [1683.0, 3145.0]], "score": 0.9900375008583069, "text": "Les honoraires des arbitres seront supportés également par les parties."}, {"orientation_angle": 0, "polygon": [[1688.0, 3438.0], [5961.0, 3438.0], [5961.0, 3551.0], [1688.0, 3551.0]], "score": 0.9910392761230469, "text": "En outre, la partie qui s'opposerait à l'exécution de la sentence supporterait seule"}, {"orientation_angle": 0, "polygon": [[1035.0, 3584.0], [3434.0, 3584.0], [3434.0, 3697.0], [1035.0, 3697.0]], "score": 0.9903398752212524, "text": "les frais de toute nature qui en résulteraient"}, {"orientation_angle": 0, "polygon": [[2971.0, 4274.0], [4030.0, 4274.0], [4030.0, 4387.0], [2971.0, 4387.0]], "score": 0.9330986142158508, "text": "-TITRE IX-"}, {"orientation_angle": 0, "polygon": [[2289.0, 4689.0], [3810.0, 4689.0], [3810.0, 4817.0], [2289.0, 4817.0]], "score": 0.9996974468231201, "text": "PERSONNALITE"}, {"orientation_angle": 0, "polygon": [[3915.0, 4694.0], [4702.0, 4694.0], [4702.0, 4807.0], [3915.0, 4807.0]], "score": 0.9997715950012207, "text": "MORALE"}, {"orientation_angle": 0, "polygon": [[3395.0, 4963.0], [4983.0, 4963.0], [4983.0, 5090.0], [3395.0, 5090.0]], "score": 0.9998199939727783, "text": "CONSTITUTIVES"}, {"orientation_angle": 0, "polygon": [[2017.0, 4973.0], [3285.0, 4963.0], [3286.0, 5090.0], [2018.0, 5100.0]], "score": 0.9998019933700562, "text": "FORMALITES"}, {"orientation_angle": 0, "polygon": [[1798.0, 5662.0], [5212.0, 5652.0], [5212.0, 5780.0], [1798.0, 5790.0]], "score": 0.9710919260978699, "text": "ArtiCle 30 - JOUISSANCE DE LA PERSONNALITE MORALE"}, {"orientation_angle": 0, "polygon": [[1254.0, 5941.0], [5775.0, 5926.0], [5775.0, 6054.0], [1254.0, 6068.0]], "score": 0.9804174900054932, "text": "REPRISE DES ENGAGEMENTS ANTERIEURS A LA SIGNATURE DES STATUTS"}, {"orientation_angle": 0, "polygon": [[1469.0, 6219.0], [5555.0, 6210.0], [5556.0, 6337.0], [1469.0, 6347.0]], "score": 0.9857581853866577, "text": "IMMATRICULATION AU REGISTRE DU COMMERCE ET DES SOCIETES"}, {"orientation_angle": 0, "polygon": [[1712.0, 6786.0], [5999.0, 6771.0], [5999.0, 6899.0], [1712.0, 6913.0]], "score": 0.979