.0], [6283.0, 6533.0], [1628.0, 6505.0]], "score": 0.9907085299491882, "text": "I.- A chaque assemblée est tenue une feuille de présence contenant"}, {"orientation_angle": 0, "polygon": [[1288.0, 6519.0], [3947.0, 6533.0], [3946.0, 6660.0], [1287.0, 6645.0]], "score": 0.9985617399215698, "text": "les indications prescrites par la loi."}, {"orientation_angle": 0, "polygon": [[1615.0, 6786.0], [6298.0, 6805.0], [6297.0, 6965.0], [1614.0, 6946.0]], "score": 0.9776226282119751, "text": "Cette feuille de présence, dûment émargée par les actionnaires"}, {"orientation_angle": 0, "polygon": [[1288.0, 6941.0], [6284.0, 6960.0], [6284.0, 7087.0], [1287.0, 7068.0]], "score": 0.9975273013114929, "text": "présents et les mandataires et à laquelle sont annexés les pouvoirs"}, {"orientation_angle": 0, "polygon": [[1279.0, 7077.0], [6289.0, 7096.0], [6288.0, 7237.0], [1278.0, 7218.0]], "score": 0.9744081497192383, "text": "donnés à chaque mandataire, et le cas échéant les formulaires de vote"}, {"orientation_angle": 0, "polygon": [[1283.0, 7227.0], [6205.0, 7237.0], [6204.0, 7368.0], [1283.0, 7358.0]], "score": 0.9952357411384583, "text": "par correspondance, est certifiée exacte par le bureau de l'assemblée."}, {"orientation_angle": 0, "polygon": [[1619.0, 7485.0], [6289.0, 7509.0], [6288.0, 7664.0], [1619.0, 7640.0]], "score": 0.9849303364753723, "text": "II. - Les assemblées sont présidées par le président du conseil"}, {"orientation_angle": 0, "polygon": [[1279.0, 7621.0], [6359.0, 7650.0], [6358.0, 7809.0], [1278.0, 7780.0]], "score": 0.9896214604377747, "text": "d'administration ou, en son absence, par un administrateur spécialement-"}, {"orientation_angle": 0, "polygon": [[1293.0, 7771.0], [3737.0, 7790.0], [3736.0, 7917.0], [1292.0, 7898.0]], "score": 0.9906571507453918, "text": "délégué à cet effet par le conseil."}, {"orientation_angle": 0, "polygon": [[1615.0, 8034.0], [6308.0, 8067.0], [6306.0, 8222.0], [1614.0, 8188.0]], "score": 0.9935646653175354, "text": "Si l'assemblée est convoquée par le ou les commissaires aux"}, {"orientation_angle": 0, "polygon": [[1293.0, 8188.0], [4740.0, 8208.0], [4739.0, 8344.0], [1292.0, 8324.0]], "score": 0.9861677289009094, "text": "comptes, l'assemblée est présidée par l'un d'eux."}, {"orientation_angle": 0, "polygon": [[1638.0, 8470.0], [6293.0, 8494.0], [6293.0, 8625.0], [1637.0, 8601.0]], "score": 0.9629648327827454, "text": "Dans tous les cas, à défaut de la personne habilitée ou désignée"}, {"orientation_angle": 0, "polygon": [[1288.0, 8606.0], [5169.0, 8625.0], [5168.0, 8766.0], [1287.0, 8747.0]], "score": 0.9847662448883057, "text": "pour présider l'assemblée, celle-ci élit son Président."}], "page": 18, "pdf": "63e8ebb854febda17c19ee6c__63e8ebb854febda17c19ee6c.pdf", "skew_angle": 0.0}