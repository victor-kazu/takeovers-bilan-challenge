{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[942.0, 212.0], [2165.0, 216.0], [2165.0, 262.0], [942.0, 259.0]], "score": 0.9778956174850464, "text": "Acte de cession de parts sociales Jacques BOCKEL à Véronique SCHOTT"}, {"orientation_angle": 0, "polygon": [[360.0, 305.0], [977.0, 308.0], [976.0, 360.0], [360.0, 356.0]], "score": 0.9993764162063599, "text": "4. Agrément des cessionnaires"}, {"orientation_angle": 0, "polygon": [[365.0, 444.0], [2160.0, 454.0], [2160.0, 495.0], [365.0, 485.0]], "score": 0.9932724237442017, "text": "Aux termes de l’article 8 des statuts \"Cession et transmission des parts sociales\" les parts sociales sont librement"}, {"orientation_angle": 0, "polygon": [[365.0, 488.0], [1662.0, 499.0], [1662.0, 540.0], [365.0, 529.0]], "score": 0.9936754107475281, "text": "cessibles entre associés. Ainsi, il n'est pas nécessaire d’agréer la présente cession."}, {"orientation_angle": 0, "polygon": [[362.0, 576.0], [2161.0, 584.0], [2161.0, 632.0], [362.0, 624.0]], "score": 0.9865245223045349, "text": "Toutefois Monsieur Mathieu DOMENEGLETTY et Mr Jérémy BOCKEL ici présents déclarent donner leur"}, {"orientation_angle": 0, "polygon": [[365.0, 627.0], [1199.0, 631.0], [1199.0, 673.0], [365.0, 670.0]], "score": 0.9938019514083862, "text": "consentement à la présente cession de parts'sociales."}, {"orientation_angle": 0, "polygon": [[360.0, 814.0], [577.0, 814.0], [577.0, 867.0], [360.0, 867.0]], "score": 0.9542304873466492, "text": "5. Cession"}, {"orientation_angle": 0, "polygon": [[362.0, 929.0], [2161.0, 939.0], [2161.0, 985.0], [362.0, 975.0]], "score": 0.9971973299980164, "text": "Le cédant cède et transporte, sous les garanties ordinaires de fait et de droit, au cessionnaire qui accepte, 5,30%"}, {"orientation_angle": 0, "polygon": [[364.0, 975.0], [2161.0, 987.0], [2161.0, 1032.0], [363.0, 1019.0]], "score": 0.9964329600334167, "text": "du capital social soit 106 parts sociales de la Société, qui lui appartient, avec tous les droits et obligations"}, {"orientation_angle": 0, "polygon": [[365.0, 1021.0], [1023.0, 1026.0], [1023.0, 1068.0], [365.0, 1062.0]], "score": 0.9928947687149048, "text": "attachés dans les proportions ci-dessous :"}, {"orientation_angle": 0, "polygon": [[1313.0, 1119.0], [1512.0, 1123.0], [1512.0, 1165.0], [1312.0, 1161.0]], "score": 0.9993951320648193, "text": "Nombre de"}, {"orientation_angle": 0, "polygon": [[1590.0, 1120.0], [1888.0, 1124.0], [1887.0, 1170.0], [1589.0, 1167.0]], "score": 0.9996992349624634, "text": "Nombre de parts"}, {"orientation_angle": 0, "polygon": [[642.0, 1138.0], [782.0, 1138.0], [782.0, 1186.0], [642.0, 1186.0]], "score": 0.9967491030693054, "text": "Associé"}, {"orientation_angle": 0, "polygon": [[1293.0, 1167.0], [1531.0, 1167.0], [1531.0, 1213.0], [1293.0, 1213.0]], "score": 0.9915761947631836, "text": "parts sociales"}, {"orientation_angle": 0, "polygon": [[1612.0, 1170.0], [1867.0, 1170.0], [1867.0, 1211.0], [1612.0, 1211.0]], "score": 0.9998428821563721, "text": "sociales cédées"}, {"orientation_angle": 0, "polygon": [[643.0, 1218.0], [1032.0, 1222.0], [1031.0, 1270.0], [642.0, 1266.0]], "score": 0.9932733178138733, "text": "Mr Jacques BOCKEL"}, {"orientation_angle": 0, "polygon": [[1361.0, 1222.0], [1466.0, 1222.0], [1466.0, 1271.0], [1361.0, 1271.0]], "score": 0.9999744296073914, "text": "1.700"}, {"orientation_angle": 0, "polygon": [[1703.0, 1219.0], [1782.0, 1224.0], [1778.0, 1279.0], [1699.0, 1274.0]], "score": 0.999870240688324, "text": "106"}, {"orientation_angle": 0, "polygon": [[642.0, 1290.0], [794.0, 1290.0], [794.0, 1338.0], [642.0, 1338.0]], "score": 0.9999047517776489, "text": "TOTAL"}, {"orientation_angle": 0, "polygon": [[1361.0, 1294.0], [1466.0, 1294.0], [1466.0, 1347.0], [1361.0, 1347.0]], "score": 0.9999171495437622, "text": "1.700"}, {"orientation_angle": 0, "polygon": [[1700.0, 1295.0], [1779.0, 1295.0], [1779.0, 1350.0], [1700.0, 1350.0]], "score": 0.9995213150978088, "text": "106"}, {"or