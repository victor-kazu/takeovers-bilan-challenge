{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[208.0, 384.0], [1302.0, 377.0], [1302.0, 423.0], [209.0, 430.0]], "score": 0.9894230961799622, "text": "Les fonctions du « Président par intérim » cesseront alors :"}, {"orientation_angle": 0, "polygon": [[577.0, 493.0], [2204.0, 481.0], [2205.0, 527.0], [577.0, 539.0]], "score": 0.9815874695777893, "text": "soit à la date du retour du Président de vacance ; la collectivité des associés se"}, {"orientation_angle": 0, "polygon": [[513.0, 510.0], [532.0, 516.0], [527.0, 532.0], [509.0, 526.0]], "score": 0.4374818503856659, "text": "O"}, {"orientation_angle": 0, "polygon": [[579.0, 551.0], [2206.0, 536.0], [2206.0, 584.0], [579.0, 599.0]], "score": 0.9967902898788452, "text": "prononcera sur la nomination du Président en vacance aux fonctions de nouveau"}, {"orientation_angle": 0, "polygon": [[579.0, 606.0], [2204.0, 592.0], [2205.0, 638.0], [579.0, 652.0]], "score": 0.9935302734375, "text": "Président de la Société, en remplacement du « Président par intérim » démissionnaire."}, {"orientation_angle": 0, "polygon": [[579.0, 661.0], [2204.0, 650.0], [2205.0, 697.0], [579.0, 707.0]], "score": 0.9821333885192871, "text": "A défaut de démission du « Président par intérim », la collectivité des associés pourra"}, {"orientation_angle": 0, "polygon": [[577.0, 723.0], [1167.0, 712.0], [1168.0, 760.0], [578.0, 771.0]], "score": 0.9976344704627991, "text": "se prononcer sur sa révocation."}, {"orientation_angle": 0, "polygon": [[577.0, 830.0], [2202.0, 816.0], [2203.0, 864.0], [577.0, 878.0]], "score": 0.9897158741950989, "text": "soit au terme de la durée maximale de son mandat, savoir une durée de DouzE (12)"}, {"orientation_angle": 0, "polygon": [[510.0, 846.0], [534.0, 846.0], [534.0, 868.0], [510.0, 868.0]], "score": 0.9722166657447815, "text": "O"}, {"orientation_angle": 0, "polygon": [[579.0, 887.0], [2206.0, 873.0], [2206.0, 919.0], [579.0, 933.0]], "score": 0.9886083006858826, "text": "mois entiers et consécutifs, à compter de la date de prise de fonctions, tel qu'il sera dit"}, {"orientation_angle": 0, "polygon": [[579.0, 942.0], [746.0, 942.0], [746.0, 991.0], [579.0, 991.0]], "score": 0.9994272589683533, "text": "ci-après."}, {"orientation_angle": 0, "polygon": [[207.0, 1056.0], [2208.0, 1041.0], [2208.0, 1087.0], [207.0, 1103.0]], "score": 0.9923785924911499, "text": "En tout état de cause, la prise de fonctions du « Président par intérim » donnera lieu à l’accomplissement"}, {"orientation_angle": 0, "polygon": [[207.0, 1113.0], [2128.0, 1095.0], [2129.0, 1142.0], [207.0, 1159.0]], "score": 0.9876206517219543, "text": "des publicités légales, afin d'informer les tiers de la nomination d'un nouveau président pour la Société."}, {"orientation_angle": 0, "polygon": [[207.0, 1224.0], [2209.0, 1208.0], [2210.0, 1255.0], [207.0, 1270.0]], "score": 0.9702300429344177, "text": "III - Les fonctions de « Président par intérim » ont une durée maximale de DOuzE (12) mois entiers et"}, {"orientation_angle": 0, "polygon": [[205.0, 1277.0], [2208.0, 1262.0], [2208.0, 1313.0], [205.0, 1329.0]], "score": 0.9916560649871826, "text": "consécutifs, à compter de la date de prise de fonctions et prennent automatiquement fin au terme de cette"}, {"orientation_angle": 0, "polygon": [[208.0, 1337.0], [907.0, 1330.0], [908.0, 1376.0], [209.0, 1383.0]], "score": 0.9678141474723816, "text": "durée maximale de DOUzE (12) mois."}, {"orientation_angle": 0, "polygon": [[207.0, 1448.0], [2208.0, 1431.0], [2208.0, 1477.0], [207.0, 1495.0]], "score": 0.9939182996749878, "text": "Au terme du mandat du « Président par intérim », la collectivité des associés désignera le nouveau"}, {"orientation_angle": 0, "polygon": [[207.0, 1501.0], [2158.0, 1484.0], [2158.0, 1535.0], [207.0, 1553.0]], "score": 0.9947324991226196, "text": "Président de la Société. Le « Président par intérim » pourra être nommé nouveau Président de la Société."}, {"orientation_angle": 0, "polygon": [[205.0, 1613.0], [2208.0, 1597.0], [2208.0, 1648.0], [205.0, 1664.0]], "score": 0.989808976650238, "text": "Le « Président par intérim » est révocable à tout moment par décision de la collectivité des associés,"}, {"orientation_angle": 0, "polygon": [[208.0, 1671.0], [1319.0, 1662.0], [1319.0, 1708.0], [209.0, 1717.0]], "score": 0.9913240671157837, "text": "conformément à l'article 26.1. des statuts, sans juste motif."}, {"orientation_angle": 0, "polygon": [[205.0, 1779.0], [2209.0, 1765.0], [2210.0, 1816.0], [205.0, 1830.0]], "score": 0.9834186434745789, "text": "La fin des fonctions du Président par intérim donnera lieu, le cas échéant, à l'accomplissement des"}, {"orientation_angle": 0, "polygon": [[208.0, 1841.0], [545.0, 1835.0], [546.0, 1883.0], [209.0, 1888.0]], "score": 0.9882664680480957, "text": "publicités légales."}, {"orientation_angle": 0, "polygon": [[208.0, 1950.0], [809.0, 1945.0], [810.0, 1991.0], [209.0, 1996.0]], "score": 0.9884849190711975, "text": "Article 24 - Conseil de direction"}, {"orientation_angle": 0, "polygon": [[208.0, 2063.0], [845.0, 2058.0], [846.0, 2102.0], [209.0, 2107.0]], "score": 0.9975310564041138, "text": "Membres du Conseil de direction"}, {"orientation_angle": 0, "polygon": [[210.0, 2172.0], [451.0, 2172.0], [451.0, 2220.0], [210.0, 2220.0]], "score": 0.9988853335380554, "text": "Désignation"}, {"orientation_angle": 0, "polygon": [[208.0, 2286.0], [1874.0, 2273.0], [1874.0, 2320.0], [209.0, 2332.0]], "score": 0.9789693355560303, "text": "Le Conseil de direction est composé de trois membres au moins et cinq membres au plus."}, {"orientation_angle": 0, "polygon": [[208.0, 2397.0], [2211.0, 2381.0], [2211.0, 2429.0], [209.0, 2445.0]], "score": 0.9879481792449951, "text": "Les membres du Conseil de direction, personnes physiques ou morales, sont élus par l'assemblée des"}, {"orientation_angle": 0, "polygon": [[210.0, 2453.0], [2209.0, 2438.0], [2210.0, 2484.0], [210.0, 2500.0]], "score": 0.9921114444732666, "text": "actionnaires à la majorité des voix des associés présents ou représentés, qu'ils soient associés ou non de la"}, {"orientation_angle": 0, "polygon": [[210.0, 2512.0], [1157.0, 2501.0], [1158.0, 2547.0], [210.0, 2558.0]], "score": 0.9933283925056458, "text": "société, sur proposition du Président de la société."}, {"orientation_angle": 0, "polygon": [[210.0, 2621.0], [2209.0, 2605.0], [2210.0, 2652.0], [210.0, 2667.0]], "score": 0.9935603141784668, "text": "Le Président de la société est membre de droit du Conseil de direction et exercera les fonctions de"}, {"orientation_angle": 0, "polygon": [[210.0, 2676.0], [844.0, 2672.0], [844.0, 2718.0], [210.0, 2722.0]], "score": 0.9958602786064148, "text": "Président du Conseil de direction."}, {"orientation_angle": 0, "polygon": [[210.0, 2791.0], [2211.0, 2773.0], [2211.0, 2819.0], [210.0, 2837.0]], "score": 0.9905918836593628, "text": "Les membres du Conseil de direction sont convoqués aux séances du Conseil par tous moyens, même"}, {"orientation_angle": 0, "polygon": [[210.0, 2845.0], [470.0, 2845.0], [470.0, 2891.0], [210.0, 2891.0]], "score": 0.9999508857727051, "text": "verbalement."}, {"orientation_angle": 0, "polygon": [[212.0, 2958.0], [1627.0, 2948.0], [1628.0, 2992.0], [212.0, 3003.0]], "score": 0.9946840405464172, "text": "Les membres du Conseil de direction exercent leurs fonctions gratuitement."}, {"orientation_angle": 1, "polygon": [[231.0, 3275.0], [480.0, 3295.0], [467.0, 3460.0], [217.0, 3439.0]], "score": 0.6800676584243774, "text": "SW"}, {"orientation_angle": 0, "polygon": [[2158.0, 3319.0], [2219.0, 3313.0], [2223.0, 3363.0], [2163.0, 3369.0]], "score": 0.9999619126319885, "text": "14"}, {"orientation_angle": 0, "polygon": [[2439.0, 3356.0], [2458.0, 3359.0], [2452.0, 3408.0], [2433.0, 3405.0]], "score": 0.5255835652351379, "text": "—"}], "page": 18, "pdf": "653d476c43618e043e05ad4c__653d476c43618e043e05ad4c.pdf", "skew_angle": 1.008301617525644}