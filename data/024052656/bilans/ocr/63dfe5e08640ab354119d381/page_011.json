, 2308.0], [2225.0, 2360.0], [431.0, 2367.0]], "score": 0.991209864616394, "text": "charges indirectes de fabrication ont été prises en compte sur la base des capacités"}, {"orientation_angle": 0, "polygon": [[429.0, 2370.0], [2230.0, 2361.0], [2230.0, 2414.0], [429.0, 2423.0]], "score": 0.9905362725257874, "text": "normales de production de l'entreprise, à l'exclusion de tous coûts de sous activité et de"}, {"orientation_angle": 0, "polygon": [[426.0, 2421.0], [622.0, 2425.0], [621.0, 2485.0], [425.0, 2481.0]], "score": 0.9999456405639648, "text": "stockage."}]}, {"bbox": [415.8582763671875, 764.1224365234375, 2217.875, 932.6607666015625], "label": "text", "score": 0.9713592529296875, "texts": [{"orientation_angle": 0, "polygon": [[422.0, 765.0], [2223.0, 772.0], [2223.0, 824.0], [422.0, 817.0]], "score": 0.986860990524292, "text": "La valeur brute des éléments corporels de l'actif immobilisé correspond à la valeur"}, {"orientation_angle": 0, "polygon": [[424.0, 822.0], [2223.0, 827.0], [2223.0, 879.0], [424.0, 873.0]], "score": 0.9943839311599731, "text": "d'entrée des biens dans le patrimoine compte tenu des frais nécessaires à la mise en état"}, {"orientation_angle": 0, "polygon": [[424.0, 878.0], [2080.0, 882.0], [2080.0, 933.0], [424.0, 930.0]], "score": 0.9953454732894897, "text": "d'utilisation de ces biens, mais à l'exclusion des frais engagés pour leur acquisition."}]}, {"bbox": [423.779541015625, 2648.69482421875, 2225.04052734375, 2758.61328125], "label": "text", "score": 0.9674789905548096, "texts": [{"orientation_angle": 0, "polygon": [[429.0, 2654.0], [2230.0, 2647.0], [2230.0, 2699.0], [429.0, 2706.0]], "score": 0.9836737513542175, "text": "Les stocks et en cours ont, le cas échéant, été dépréciés par voie de provision pour tenir"}, {"orientation_angle": 0, "polygon": [[432.0, 2713.0], [1713.0, 2702.0], [1714.0, 2753.0], [433.0, 2764.0]], "score": 0.9955418705940247, "text": "compte de leur valeur actuelle à la date de clôture de l'exercice."}]}, {"b