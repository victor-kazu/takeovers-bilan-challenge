{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[2693.0, 192.0], [2736.0, 192.0], [2736.0, 236.0], [2693.0, 236.0]], "score": 0.3578318655490875, "text": "1"}, {"orientation_angle": 0, "polygon": [[3434.0, 644.0], [3607.0, 644.0], [3607.0, 784.0], [3434.0, 784.0]], "score": 0.9999270439147949, "text": "12"}, {"orientation_angle": 0, "polygon": [[3181.0, 1399.0], [3851.0, 1399.0], [3851.0, 1529.0], [3181.0, 1529.0]], "score": 0.9906800389289856, "text": "TITRE VII"}, {"orientation_angle": 0, "polygon": [[1990.0, 1658.0], [5042.0, 1668.0], [5041.0, 1813.0], [1990.0, 1803.0]], "score": 0.9903513193130493, "text": "DISSOLUTION- LIQUIDATION DE LA SOCIETE"}, {"orientation_angle": 0, "polygon": [[871.0, 2231.0], [4626.0, 2236.0], [4625.0, 2370.0], [871.0, 2365.0]], "score": 0.9821232557296753, "text": "ARTICLE 28 - DISSOLUTION - LIQUIDATION DE LA SOCIETE"}, {"orientation_angle": 0, "polygon": [[866.0, 2509.0], [6151.0, 2524.0], [6151.0, 2668.0], [866.0, 2654.0]], "score": 0.9925171136856079, "text": "La Société est dissoute dans les cas prévus par la loi ou en cas de dissolution anticipée décidée"}, {"orientation_angle": 0, "polygon": [[866.0, 2654.0], [2822.0, 2649.0], [2822.0, 2798.0], [866.0, 2803.0]], "score": 0.9955961108207703, "text": "par décision collective des associés."}, {"orientation_angle": 0, "polygon": [[861.0, 2923.0], [6156.0, 2938.0], [6156.0, 3082.0], [861.0, 3067.0]], "score": 0.9900684356689453, "text": "La décision collective des associés qui constate ou décide la dissolution nomme un ou plusieurs"}, {"orientation_angle": 0, "polygon": [[866.0, 3067.0], [1602.0, 3067.0], [1602.0, 3216.0], [866.0, 3216.0]], "score": 0.9998188018798828, "text": "Liquidateurs."}, {"orientation_angle": 0, "polygon": [[866.0, 3336.0], [6151.0, 3346.0], [6151.0, 3495.0], [866.0, 3485.0]], "score": 0.9894071221351624, "text": "Le Liquidateur, ou chacun d'eux s'ils sont plusieurs, représente la Société. Il dispose des pouvoirs"}, {"orientation_angle": 0, "polygon": [[866.0, 3481.0], [6151.0, 3486.0], [6151.0, 3635.0], [866.0, 3630.0]], "score": 0.9905241131782532, "text": "les plus étendus pour réaliser l'actif même à l'amiable. Il est habilité à payer les créanciers"}, {"orientation_angle": 0, "polygon": [[866.0, 3625.0], [3989.0, 3620.0], [3989.0, 3764.0], [866.0, 3769.0]], "score": 0.9994151592254639, "text": "sociaux et à répartir le solde disponible entre les associés."}, {"orientation_angle": 0, "polygon": [[866.0, 3884.0], [6156.0, 3894.0], [6156.0, 4038.0], [866.0, 4029.0]], "score": 0.9962155222892761, "text": "Les associés peuvent autoriser le Liquidateur à continuer les affaires sociales en cours et à en"}, {"orientation_angle": 0, "polygon": [[871.0, 4034.0], [4171.0, 4034.0], [4171.0, 4178.0], [871.0, 4178.0]], "score": 0.9909180402755737, "text": "engager de nouvelles pour les seuls besoins de la liquidation."}, {"orientation_angle": 0, "polygon": [[866.0, 4298.0], [6161.0, 4308.0], [6161.0, 4457.0], [866.0, 4447.0]], "score": 0.9908601641654968, "text": "Le produit net de la liquidation, après apurement du passif, est employé au remboursement"}, {"orientation_angle": 0, "polygon": [[871.0, 4442.0], [3654.0, 4442.0], [3654.0, 4586.0], [871.0, 4586.0]], "score": 0.9880529046058655, "text": "intégral du capital libéré et non amorti des actions ."}, {"orientation_angle": 0, "polygon": [[866.0, 4711.0], [6161.0, 4716.0], [6161.0, 4861.0], [866.0, 4856.0]], "score": 0.9925943613052368, "text": "Le surplus, s'il en existe, est réparti entre les associés proportionnellement au nombre d'actions de"}, {"orientation_angle": 0, "polygon": [[875.0, 4856.0], [1622.0, 4856.0], [1622.0, 4990.0], [875.0, 4990.0]], "score": 0.9882325530052185, "text": "chacun d'eux."}, {"orientation_angle": 0, "polygon": [[866.0, 5120.0], [6166.0, 5125.0], [6166.0, 5274.0], [866.0, 5269.0]], "score": 0.9920509457588196, "text": "Les pertes, s'il en existe, sont supportées par les associés jusqu'à concurrence du montant de leurs"}, {"orientation_angle": 0, "polygon": [[855.0, 5275.0], [1322.0, 5263.0], [1326.0, 5417.0], [859.0, 5429.0]], "score": 0.9998800158500671, "text": "apports."}, {"orientation_angle": 0, "polygon": [[3187.0, 5812.0], [3851.0, 5823.0], [3849.0, 5943.0], [3185.0, 5932.0]], "score": 0.9932028651237488, "text": "TITRE VII"}, {"orientation_angle": 0, "polygon": [[2942.0, 6096.0], [4104.0, 6096.0], [4104.0, 6211.0], [2942.0, 6211.0]], "score": 0.9970232844352722, "text": "CONTESTATIONS"}, {"orientation_angle": 0, "polygon": [[875.0, 6365.0], [2860.0, 6365.0], [2860.0, 6495.0], [875.0, 6495.0]], "score": 0.9953027963638306, "text": "ARTICLE 29 - CONTESTATIONS"}, {"orientation_angle": 0, "polygon": [[871.0, 6663.0], [6166.0, 6683.0], [6165.0, 6827.0], [870.0, 6807.0]], "score": 0.9944687485694885, "text": "Les contestations relatives aux affaires sociales, survenant pendant la durée de la société ou au"}, {"orientation_angle": 0, "polygon": [[866.0, 6827.0], [6166.0, 6841.0], [6165.0, 6986.0], [866.0, 6971.0]], "score": 0.9987392425537109, "text": "cours de sa liquidation entre les associés ou entre un associé et la Société, seront soumises au"}, {"orientation_angle": 0, "polygon": [[867.0, 6975.0], [3401.0, 6995.0], [3400.0, 7140.0], [865.0, 7120.0]], "score": 0.9905696511268616, "text": "Tribunal de Commerce du lieu du siège social."}, {"orientation_angle": 1, "polygon": [[871.0, 7447.0], [6166.0, 7466.0], [6165.0, 7601.0], [870.0, 7581.0]], "score": 0.31746405363082886, "text": "NN N STN SI IR NN RS SIT S"}, {"orientation_angle": 0, "polygon": [[871.0, 7606.0], [5166.0, 7620.0], [5166.0, 7750.0], [870.0, 7735.0]], "score": 0.9989199042320251, "text": "ASSEMBLEE GENERALE EXTRAORDINAIRE LE 30 SEPTEMBRE 2005."}, {"orientation_angle": 0, "polygon": [[2923.0, 8409.0], [3602.0, 8409.0], [3602.0, 8957.0], [2923.0, 8957.0]], "score": 0.6075060963630676, "text": "1"}, {"orientation_angle": 0, "polygon": [[1827.0, 8466.0], [2358.0, 8466.0], [2358.0, 8735.0], [1827.0, 8735.0]], "score": 0.2733016908168793, "text": "2"}], "page": 22, "pdf": "63e3428c5e3cba7204159a36__63e3428c5e3cba7204159a36.pdf", "skew_angle": 0.0}