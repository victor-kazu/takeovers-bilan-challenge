8.0]], "score": 0.9996578097343445, "text": "patrimoine."}, {"orientation_angle": 0, "polygon": [[876.0, 3273.0], [6174.0, 3298.0], [6174.0, 3442.0], [876.0, 3418.0]], "score": 0.9878430962562561, "text": "Action ou Valeur mobilière : signifie les valeurs mobilières émises par la Société donnant accès"}, {"orientation_angle": 0, "polygon": [[872.0, 3408.0], [6179.0, 3437.0], [6178.0, 3587.0], [871.0, 3557.0]], "score": 0.991033136844635, "text": "de façon immédiate ou différée et de quelque manière que ce soit, à l'attribution d'un droit au"}, {"orientation_angle": 0, "polygon": [[876.0, 3548.0], [6179.0, 3577.0], [6178.0, 3721.0], [876.0, 3692.0]], "score": 0.9912037253379822, "text": "capital et/ou d'un droit de vote de la Société, ainsi que les bons et droits de souscription et"}, {"orientation_angle": 0, "polygon": [[876.0, 3687.0], [3374.0, 3702.0], [3374.0, 3832.0], [876.0, 3817.0]], "score": 0.9889523386955261, "text": "d'attribution attachés à ces valeurs mobilières."}, {"orientation_angle": 0, "polygon": [[876.0, 3957.0], [3073.0, 3967.0], [3072.0, 4102.0], [876.0, 4092.0]], "score": 0.9931683540344238, "text": "2. Modalités de transmission des actions"}, {"orientation_angle": 0, "polygon": [[872.0, 4226.0], [6174.0, 4265.0], [6173.0, 4410.0], [871.0, 4371.0]], "score": 0.9879886507987976, "text": "La transmission des actions émises par la Société s'opère par un virement de compte à compte sur"}, {"orientation_angle": 0, "polygon": [[872.0, 4371.0], [6174.0, 4395.0], [6174.0, 4545.0], [871.0, 4520.0]], "score": 0.9970059394836426, "text": "production d'un ordre de mouvement. Ce mouvement est inscrit sur le registre des mouvements"}, {"orientation_angle": 0, "polygon": [[876.0, 4511.0], [1742.0, 4511.0], [1742.0, 4660.0], [876.0, 4660.0]], "score": 0.9939061403274536, "text": "coté et paraphé."}, {"orientation_angle": 0, "polygon": [[872.0, 4900.0], [2590.0, 4915.0], [2588.0, 5065.0], [871.0, 5049.0]], "score": 0.9803978204727173, "text": "ARTICLE 11 - PREEMPTION"}, {"orientation_angle": 0, "polygon": [[881.0, 5184.0], [6170.0, 5223.0], [6169.0, 5363.0], [880.0, 5324.0]], "score": 0.9944522380828857, "text": "1. Toute cession des actions de la Société même entre associés est soumise au respect du droit"}, {"orientation_angle": 0, "polygon": [[1073.0, 5324.0], [4882.0, 5349.0], [4881.0, 5498.0], [1072.0, 5473.0]], "score": 0.9944404363632202, "text": "de préemption conféré aux associés et ce, dans les conditions ci-après."}, {"orientation_angle": 0, "polygon": [[867.0, 5728.0], [6165.0, 5767.0], [6164.0, 5912.0], [866.0, 5873.0]], "score": 0.9902039170265198, "text": "2. L'associé cédant notifie au Président et à chacun des associés par lettre recommandée avec"}, {"orientation_angle": 0, "polygon": [[1068.0, 5863.0], [5973.0, 5897.0], [5972.0, 6056.0], [1067.0, 6022.0]], "score": 0.9881996512413025, "text": "demande d'avis de réception ou remise en main propre son projet de cession mentionnant :"}, {"orientation_angle": 0, "polygon": [[1069.0, 6127.0], [2849.0, 6158.0], [2846.0, 6302.0], [1067.0, 6272.0]], "score": 0.9978024959564209, "text": "le nombre d'actions concernées ;"}, {"orientation_angle": 0, "polygon": [[893.0, 6208.0], [923.0, 6218.0], [915.0, 6242.0], [884.0, 6232.0]], "score": 0.4886093735694885, "text": "—"}, {"orientation_angle": 0, "polygon": [[1068.0, 6263.0], [6174.0, 6302.0], [6173.0, 6461.0], [1067.0, 6421.0]], "score": 0.9946257472038269, "text": "les informations sur le cessionnaire envisagé : nom, prénoms, adresse et nationalité ou s'il"}, {"orientation_angle": 0, "polygon": [[1068.0, 6412.0], [6165.0, 6451.0], [6164.0, 6595.0], [1067.0, 6556.0]], "score": 0.9837818741798401, "text": "s'agit d'une personne morale : dénomination, siège social, numéro RCS, montant et répartition"}, {"orientation_angle": 0, "polygon": [[1073.0, 6542.0], [3538.0, 6572.0], [3536.0, 6716.0], [1072.0, 6686.0]], "score": 0.9924996495246887, "text": "du capital, identité de ses dirigeants sociaux ;"}, {"orientation_angle": 0, "polygon": [[1068.0, 6681.0], [3571.0, 6701.0], [3570.0, 6851.0], [1067.0, 6831.0]], "score": 0.9960799217224121, "text": "le prix et les conditions de la cession projetée."}, {"orientation_angle": 0, "polygon": [[867.0, 6946.0], [6175.0, 6995.0], [6173.0, 7140.0], [866.0, 7091.0]], "score": 0.9979413747787476, "text": "La date de réception de la notification de l'associé cédant fait courir un délai de trois (3) mois, à"}, {"orientation_angle": 0, "polygon": [[872.0, 7091.0], [6165.0, 7130.0], [6164.0, 7274.0], [871.0, 7235.0]], "score": 0.9876834750175476, "text": "l'expiration duquel, si les droits de préemption n'ont pas été exercé en totalité sur les actions"}, {"orientation_angle": 0, "polygon": [[867.0, 7225.0], [6165.0, 7269.0], [6164.0, 7414.0], [866.0, 7370.0]], "score": 0.9973818063735962, "text": "concernées, le cédant pourra réaliser librement la cession projetée, sous réserve de respecter la"}, {"orientation_angle": 0, "polygon": [[872.0, 7355.0], [3882.0, 7380.0], [3881.0, 7539.0], [871.0, 7514.0]], "score": 0.9895679354667664, "text": "procédure d'agrément prévue à l'article \"12\" des statuts."}, {"orientation_angle": 0, "polygon": [[862.0, 7620.0], [6160.0, 7669.0], [6159.0, 7818.0], [861.0, 7769.0]], "score": 0.9846925139427185, "text": "3. Chaque associé bénéficie d'un droit de préemption sur les actions faisant l'objet du projet de"}, {"orientation_angle": 0, "polygon": [[1068.0, 7764.0], [6160.0, 7813.0], [6159.0, 7958.0], [1067.0, 7909.0]], "score": 0.9926980137825012, "text": "cession. Ce droit de préemption est exercé par notification au Président dans les deux (2)"}, {"orientation_angle": 0, "polygon": [[1063.0, 7904.0], [6170.0, 7943.0], [6169.0, 8088.0], [1062.0, 8049.0]], "score": 0.9930256605148315, "text": "mois au plus tard de la réception de la notification ci-dessus visée. Cette notification est"}, {"orientation_angle": 0, "polygon": [[1064.0, 8034.0], [6165.0, 8093.0], [6163.0, 8237.0], [1062.0, 8178.0]], "score": 0.9895133972167969, "text": "effectuée par lettre recommandée avec demande d'avis de réception ou remise en main propre"}, {"orientation_angle": 0, "polygon": [[1063.0, 8174.0], [4715.0, 8208.0], [4713.0, 8357.0], [1062.0, 8323.0]], "score": 0.9984939098358154, "text": "précisant le nombre d'actions que chaque associé souhaite acquérir."}, {"orientation_angle": 0, "polygon": [[792.0, 8701.0], [1036.0, 8710.0], [1022.0, 9120.0], [778.0, 9112.0]], "score": 0.3368334472179413, "text": "V"}, {"orientation_angle": 0, "polygon": [[1465.0, 8896.0], [1699.0, 8896.0], [1699.0, 9084.0], [1465.0, 9084.0]], "score": 0.6745005249977112, "text": "PJ"}, {"orientation_angle": 1, "polygon": [[1541.0, 9137.0], [1632.0, 9137.0], [1632.0, 9175.0], [1541.0, 9175.0]], "score": 0.8461837768554688, "text": "F7"}, {"orientation_angle": 0, "polygon": [[1637.0, 9132.0], [1670.0, 9132.0], [1670.0, 9156.0], [1637.0, 9156.0]], "score": 0.6354359984397888, "text": "-"}], "page": 14, "pdf": "63e3428c5e3cba7204159a36__63e3428c5e3cba7204159a36.pdf", "skew_angle": 0.0}