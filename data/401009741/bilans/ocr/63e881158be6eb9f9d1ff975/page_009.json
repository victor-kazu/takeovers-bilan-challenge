 0.9894288182258606, "text": "récupérables par l'entité auprès des administrations fiscales, ainsi que les frais de transport, de manutention et autres coûts directement"}, {"orientation_angle": 0, "polygon": [[214.0, 926.0], [2259.0, 929.0], [2259.0, 965.0], [214.0, 962.0]], "score": 0.992993950843811, "text": "attribuables au coût de revient des matières premières, des marchandises, des encours de production et des produits finis. Les rabais"}, {"orientation_angle": 0, "polygon": [[215.0, 977.0], [2143.0, 977.0], [2143.0, 1016.0], [215.0, 1016.0]], "score": 0.9907398819923401, "text": "commerciaux, remises, escomptes de règlement et autres éléments similaires sont déduits pour déterminer les coûts d'acquisition."}, {"orientation_angle": 0, "polygon": [[215.0, 1076.0], [2255.0, 1078.0], [2255.0, 1117.0], [215.0, 1115.0]], "score": 0.9931578636169434, "text": "Les produits fabriqués sont valorisés au coût de production comprenant les consommations, les charges directes et indirectes de"}, {"orientation_angle": 0, "polygon": [[215.0, 1127.0], [2260.0, 1127.0], [2260.0, 1166.0], [215.0, 1166.0]], "score": 0.9885035753250122, "text": "production, les amortissements des biens concourant à la production. Le coût de la sous activité est exclu de la valeur des stocks. Les"}, {"orientation_angle": 0, "polygon": [[215.0, 1176.0], [968.0, 1178.0], [968.0, 1214.0], [215.0, 1212.0]], "score": 0.9994875192642212, "text": "intérêts sont exclus pour la valorisation des stocks."}, {"orientation_angle": 0, "polygon": [[214.0, 1275.0], [2260.0, 1279.0], [2260.0, 1318.0], [214.0, 1315.0]], "score": 0.9917581081390381, "text": "Les stocks sont évalués suivant la méthode du premier entré, premier sorti. Pour des raisons pratiques et sauf écart significatif, le dernier"}, {"orientation_angle": 0, "polygon": [[215.0, 1328.0], [687.0, 1328.0], [687.0, 1367.0], [215.0, 1367.0]], "score": 0.9990909695625305, "text": "prix d'achat connu a été retenu."}, {"orientation_angle": 0, "polygon": [[215.0, 1429.0], [2259.0, 1431.0], [2259.0, 1466.0], [215.0, 1465.0]], "score": 0.992201566696167, "text": "Une dépréciation des stocks égale à la différence entre la valeur brute déterminée suivant les modalités indiquées ci-dessus et le cours du"}, {"orientation_angle": 0, "polygon": [[210.0, 1477.0], [2257.0, 1478.0], [2257.0, 1519.0], [210.0, 1518.0]], "score": 0.9930152297019958, "text": "jour ou la valeur de réalisation déduction faite des frais proportionnels de vente, est prise en compte lorsque cette valeur brute est"}, {"orientation_angle": 0, "polygon": [[212.0, 1529.0], [724.0, 1529.0], [724.0, 1569.0], [212.0, 1569.0]], "score": 0.9817709922790527, "text": "supérieure à l'autre terme énoncé."}, {"orientation_angle": 0, "polygon": [[213.0, 1637.0], [448.0, 1641.0], [447.0, 1695.0], [212.0, 1691.0]], "score": 0.9993045926094055, "text": "Créances"}, {"orientation_angle": 0, "polygon": [[210.0, 1751.0], [2260.0, 1755.0], [2260.0, 1794.0], [210.0, 1790.0]], "score": 0.9956234097480774, "text": "Les créances sont valorisées à leur valeur nominale. Une dépréciation est pratiquée lorsque la valeur d'inventaire est inférieure à la valeur"}, {"orientation_angle": 0, "polygon": [[212.0, 1804.0], [385.0, 1804.0], [385.0, 1845.0], [212.0, 1845.0]], "score": 0.9999804496765137, "text": "comptable."}, {"orientation_angle": 0, "polygon": [[212.0, 1915.0], [951.0, 1917.0], [951.0, 1969.0], [212.0, 1968.0]], "score": 0.9923266172409058, "text": "Frais d'émission des emprunts"}, {"orientation_angle": 0, "polygon": [[212.0, 2027.0], [1723.0, 2031.0], [1723.0, 2070.0], [212.0, 2067.0]], "score": 0.9918420314788818, "text": "Les frais d'émission des emprunts sont pris en compte immédiatement dans les charges de l'exercice."}, {"orientation_angle": 0, "polygon": [[212.0, 2140.0], [1033.0, 2142.0], [1033.0, 2194.0], [212.0, 2193.0]], "score": 0.9793912768363953, "text": "Produits et charges exceptionnels"}, {"orientation_angle": 0, "polygon": [[214.0, 2256.0], [2036.0, 2256.0], [2036.0, 2295.0], [214.0, 2295.0]], "score": 0.9880203604698181, "text": "Les produits et charges exceptionnels tiennent compte des éléments qui ne sont pas liés à l'activité normale de l'entreprise."}, {"orientation_angle": 0, "polygon": [[215.0, 2420.0], [1173.0, 2420.0], [1173.0, 2471.0], [215.0, 2471.0]], "score": 0.9993686676025391, "text": "Conséquences de l'événement Covid-19"}, {"orientation_angle": 0, "polygon": [[210.0, 2605.0], [2254.0, 2607.0], [2254.0, 2646.0], [210.0, 2645.0]], "score": 0.9900038838386536, "text": "L'événement Covid-19 est susceptible d'avoir des impacts significatifs sur le patrimoine, la situation financière et les résultats des"}, {"orientation_angle": 0, "polygon": [[214.0, 2658.0], [2140.0, 2658.0], [2140.0, 2697.0], [214.0, 2697.0]], "score": 0.9937336444854736, "text": "entreprises. Une information comptable pertinente sur ces impacts constitue un élément clé des comptes de la période concernée."}, {"orientation_angle": 0, "polygon": [[210.0, 2757.0], [2262.0, 2759.0], [2262.0, 2798.0], [210.0, 2796.0]], "score": 0.9942609667778015, "text": "Pour cela, l'entreprise a retenu une approche ciblée pour exprimer les principaux impacts pertinents sur la performance de l'exercice et sur"}, {"orientation_angle": 0, "polygon": [[210.0, 2807.0], [2259.0, 2808.0], [2259.0, 2847.0], [210.0, 2846.0]], "score": 0.993068516254425, "text": "sa situation financière. Cette approche est recommandée par l'Autorité des Normes Comptables dans la note du 18 mai 2020 pour fournir"}, {"orientation_angle": 0, "polygon": [[210.0, 2856.0], [1404.0, 2859.0], [1404.0, 2900.0], [210.0, 2897.0]], "score": 0.9973822236061096, "text": "les informations concernant les effets de l'événement Covid-19 sur ses comptes."}, {"orientation_angle": 0, "polygon": [[2027.0, 3327.0], [2160.0, 3336.0], [2156.0, 3399.0], [2023.0, 3390.0]], "score": 0.9998462796211243, "text": "Page"}, {"orientation_angle": 0, "polygon": [[2184.0, 3325.0], [2262.0, 3325.0], [2262.0, 3390.0], [2184.0, 3390.0]], "score": 0.999497652053833, "text": "11"}, {"orientation_angle": 0, "polygon": [[480.0, 3349.0], [907.0, 3351.0], [907.0, 3380.0], [480.0, 3378.0]], "score": 0.9909405708312988, "text": "CERFRANCE MIDI MEDITERRANEE"}, {"orientation_angle": 0, "polygon": [[997.0, 3350.0], [1684.0, 3350.0], [1684.0, 3379.0], [997.0, 3379.0]], "score": 0.9124481678009033, "text": "638 Avenue DE LA LIBERATION 13160 CHATEAURENARD"}, {"orientation_angle": 0, "polygon": [[1749.0, 3345.0], [1974.0, 3349.0], [1973.0, 3385.0], [1748.0, 3381.0]], "score": 0.9702726602554321, "text": "Tél. 04 90 26 30 23"}, {"orientation_angle": 0, "polygon": [[161.0, 3407.0], [358.0, 3407.0], [358.0, 3441.0], [161.0, 3441.0]], "score": 0.999617874622345, "text": "CERFRANCE"}, {"orientation_angle": 0, "polygon": [[210.0, 3441.0], [351.0, 3441.0], [351.0, 3453.0], [210.0, 3453.0]], "score": 0.3600309491157532, "text": "\" xt-t*"}], "page": 9, "pdf": "CA_401009741_8401_1995B40188_2022_21801__63e881158be6eb9f9d1ff975.pdf", "skew_angle": 0.0}