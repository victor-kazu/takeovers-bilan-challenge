.0], [1965.0, 3858.0], [1965.0, 3957.0], [1416.0, 3957.0]], "score": 0.9828534722328186, "text": "demande."}, {"orientation_angle": 0, "polygon": [[1745.0, 4108.0], [6376.0, 4108.0], [6376.0, 4264.0], [1745.0, 4264.0]], "score": 0.994451105594635, "text": "En cas d'accord, le conseil convoque une assemblée générale"}, {"orientation_angle": 0, "polygon": [[1412.0, 4250.0], [6366.0, 4255.0], [6366.0, 4401.0], [1411.0, 4396.0]], "score": 0.9868434071540833, "text": "extraordinaire des actionnaires, à l'effet de décider, s'il y a lieu,"}, {"orientation_angle": 0, "polygon": [[1426.0, 4411.0], [6366.0, 4411.0], [6366.0, 4524.0], [1426.0, 4524.0]], "score": 0.9977098703384399, "text": "du rachat des actions par la Société et de la réduction corrélative du"}, {"orientation_angle": 0, "polygon": [[1421.0, 4543.0], [6366.0, 4538.0], [6366.0, 4665.0], [1421.0, 4670.0]], "score": 0.9626167416572571, "text": "capital social. Cette convocation doit étre effectuée suffisamment töt"}, {"orientation_angle": 0, "polygon": [[1421.0, 4680.0], [5808.0, 4680.0], [5808.0, 4821.0], [1421.0, 4821.0]], "score": 0.9940299391746521, "text": "pour que soit respecté le délai de trois mois indiqué ci-après."}, {"orientation_angle": 0, "polygon": [[1764.0, 4963.0], [6376.0, 4963.0], [6376.0, 5090.0], [1764.0, 5090.0]], "score": 0.9911941885948181, "text": "Dans tous les cas d'achat ou de rachat visés ci-dessus, le prix"}, {"orientation_angle": 0, "polygon": [[1421.0, 5090.0], [5317.0, 5100.0], [5317.0, 5232.0], [1421.0, 5223.0]], "score": 0.98658686876297, "text": "des actions est fixé ainsi qu'il est dit au 6° ci-après."}, {"orientation_angle": 0, "polygon": [[2099.0, 5359.0], [6400.0, 5379.0], [6399.0, 5520.0], [2098.0, 5501.0]], "score": 0.9701201915740967, "text": "5° - Si la totalité des actions n'a pas été achetée ou"}, {"orientation_angle": 0, "polygon": [[1426.0, 5530.0], [6385.0, 5530.0], [6385.0, 5643.0], [1426.0, 5643.0]], "score": 0.9918481707572937, "text": "rachetée dans le délai de trois mois, à compter de la notification du"}, {"orientation_angle": 0, "polygon": [[1426.0, 5657.0], [6390.0, 5662.0], [6390.0, 5789.0], [1426.0, 5785.0]], "score": 0.97900390625, "text": "refus d'autorisation de cession, l'actionnaire vendeur peut réaliser la"}, {"orientation_angle": 0, "polygon": [[1435.0, 5818.0], [6381.0, 5818.0], [6381.0, 5931.0], [1435.0, 5931.0]], "score": 0.9865310788154602, "text": "vente au profit du cessionnaire primitif, pour la totalité des actions"}, {"orientation_angle": 0, "polygon": [[1426.0, 5945.0], [6395.0, 5950.0], [6395.0, 6077.0], [1426.0, 6073.0]], "score": 0.991693377494812, "text": "cédées, nonobstant les offres d'achat partielles qui auraient été"}, {"orientation_angle": 0, "polygon": [[1431.0, 6073.0], [4492.0, 6087.0], [4492.0, 6215.0], [1430.0, 6200.0]], "score": 0.9930205941200256, "text": "faites dans les conditions visées ci-dessus."}, {"orientation_angle": 0, "polygon": [[1765.0, 6351.0], [6409.0, 6366.0], [6409.0, 6507.0], [1764.0, 6493.0]], "score": 0.9821692109107971, "text": "Ce délai de trois mois peut étre prolongé par ordonnance non"}, {"orientation_angle": 0, "polygon": [[1440.0, 6502.0], [6400.0, 6507.0], [6400.0, 6635.0], [1440.0, 6630.0]], "score": 0.989987313747406, "text": "susceptible de recours du président du Tribunal de Commerce statuant"}, {"orientation_angle": 0, "polygon": [[1426.0, 6649.0], [6404.0, 6644.0], [6404.0, 6786.0], [1426.0, 6791.0]], "score": 0.9895704984664917, "text": "par ordonnance de référé, l'actionnaire cédant et le cessionnaire"}, {"orientation_angle": 0, "polygon": [[1436.0, 6785.0], [2475.0, 6796.0], [2474.0, 6923.0], [1435.0, 6913.0]], "score": 0.9659548997879028, "text": "dûment appelés."}, {"orientation_angle": 0, "polygon": [[2308.0, 7055.0], [6405.0, 7064.0], [6404.0, 7197.0], [2308.0, 7187.0]], "score": 0.9946433901786804, "text": "- Dans le cas où les actions offertes sont acquises par"}, {"orientation_angle": 0, "polygon": [[2119.0, 7067.0], [2286.0, 7052.0], [2297.0, 7171.0], [2130.0, 7185.0]], "score": 0.821556568145752, "text": "6°"}, {"orientation_angle": 0, "polygon": [[1440.0, 7201.0], [6404.0, 7201.0], [6404.0, 7329.0], [1440.0, 7329.0]], "score": 0.987137496471405, "text": "des actionnaires ou par des tiers, le conseil d'administration notifie"}, {"orientation_angle": 0, "polygon": [[1431.0, 7324.0], [6390.0, 7343.0], [6390.0, 7485.0], [1430.0, 7466.0]], "score": 0.9914356470108032, "text": "à l'actionnaire cédant les nom, prénoms, domicile du ou des acquéreurs."}, {"orientation_angle": 0, "polygon": [[1770.0, 7603.0], [6471.0, 7617.0], [6471.0, 7759.0], [1769.0, 7744.0]], "score": 0.9868625402450562, "text": "Le prix de cession des actions est fixé d'accord entre eux et le-"}, {"orientation_angle": 0, "polygon": [[1436.0, 7744.0], [6424.0, 7759.0], [6423.0, 7900.0], [1435.0, 7886.0]], "score": 0.9839527010917664, "text": "cédant. Faute d'accord sur le prix, celui-ci est déterminé par un"}, {"orientation_angle": 0, "polygon": [[1440.0, 7905.0], [6409.0, 7905.0], [6409.0, 8032.0], [1440.0, 8032.0]], "score": 0.9752720594406128, "text": "expert, conformément aux dispositions de 1'article l843-4 du Code"}, {"orientation_angle": 0, "polygon": [[1445.0, 8037.0], [1860.0, 8037.0], [1860.0, 8155.0], [1445.0, 8155.0]], "score": 0.9998698830604553, "text": "Civil."}, {"orientation_angle": 0, "polygon": [[1779.0, 8301.0], [6419.0, 8325.0], [6418.0, 8467.0], [1778.0, 8443.0]], "score": 0.9983971118927002, "text": "Les frais d'expertise sont supportés par moitié par le vendeur et"}, {"orientation_angle": 0, "polygon": [[1445.0, 8462.0], [3539.0, 8467.0], [3538.0, 8594.0], [1445.0, 8590.0]], "score": 0.998275101184845, "text": "par moitié par les acquéreurs."}, {"orientation_angle": 0, "polygon": [[2137.0, 8717.0], [6424.0, 8731.0], [6423.0, 8873.0], [2136.0, 8859.0]], "score": 0.9914821982383728, "text": "7° - La cession au nom du ou des acquéreurs désignés est"}, {"orientation_angle": 0, "polygon": [[1459.0, 8873.0], [6419.0, 8873.0], [6419.0, 9000.0], [1459.0, 9000.0]], "score": 0.988297700881958, "text": "régularisée d'office sur la signature du président du conseil"}, {"orientation_angle": 0, "polygon": [[1450.0, 9000.0], [6428.0, 9005.0], [6428.0, 9147.0], [1450.0, 9142.0]], "score": 0.9875282645225525, "text": "d'administration ou d'un délégué du conseil sans qu'il soit besoin de"}, {"orientation_angle": 0, "polygon": [[1459.0, 9161.0], [3605.0, 9161.0], [3605.0, 9274.0], [1459.0, 9274.0]], "score": 0.9755898714065552, "text": "celle du titulaire des actions."}], "page": 7, "pdf": "63e8ebb854febda17c19ee6e__63e8ebb854febda17c19ee6e.pdf", "skew_angle": 0.0}