], [1560.0, 1572.0], [262.0, 1569.0]], "score": 0.9914749264717102, "text": "L'Assemblée est placée sous la Présidence de Monsieur Luc DELAGARDE."}, {"orientation_angle": 0, "polygon": [[262.0, 1620.0], [2163.0, 1630.0], [2163.0, 1683.0], [262.0, 1673.0]], "score": 0.9929479360580444, "text": "Monsieur Jean-Pierre SIBERT représentant le CIL SOLENDI et Monsieur Patrick MENARD représentant la"}, {"orientation_angle": 0, "polygon": [[262.0, 1675.0], [2163.0, 1685.0], [2163.0, 1736.0], [262.0, 1726.0]], "score": 0.9961481690406799, "text": "Caisse Fédérale de CREDIT MUTUEL OCEAN, présents et acceptants, sont appelés aux fonctions de"}, {"orientation_angle": 0, "polygon": [[263.0, 1731.0], [475.0, 1731.0], [475.0, 1779.0], [263.0, 1779.0]], "score": 0.9998826384544373, "text": "Scrutateurs."}, {"orientation_angle": 0, "polygon": [[262.0, 1834.0], [1447.0, 1839.0], [1447.0, 1890.0], [262.0, 1885.0]], "score": 0.9886845350265503, "text": "Madame Nadine CousIN est désignée comme Secrétaire de séance."}, {"orientation_angle": 0, "polygon": [[259.0, 1938.0], [2165.0, 1950.0], [2165.0, 2001.0], [258.0, 1989.0]], "score": 0.9880614280700684, "text": "1 - Le bureau ainsi constitué, Monsieur le Président constate d'après la feuille de présence arrêtée et certifiée par"}, {"orientation_angle": 0, "polygon": [[262.0, 1994.0], [2163.0, 2003.0], [2163.0, 2051.0], [262.0, 2042.0]], "score": 0.9916930198669434, "text": "les Membres du bureau que cinq Actionnaires présents ou représentés possèdent 54.480 des actions ayant le droit"}, {"orientation_angle": 0, "polygon": [[262.0, 2047.0], [2163.0, 2058.0], [2163.0, 2104.0], [262.0, 2093.0]], "score": 0.9888678789138794, "text": "de vote. L'Assemblée, réunissant ainsi, plus de la moitié des actions composant le capital social est régulièrement"}, {"orientation_angle": 0, "polygon": [[264.0, 2100.0], [1460.0, 2104.0], [1460.0, 2152.0], [263.0, 2148.0]], "score": 0.9984962344169617, "text": "constituée, elle peut donc délibérer comme Assemblée Générale Mixte."}, {"orientation_angle": 0, "polygon": [[262.0, 2203.0], [1786.0, 2210.0], [1786.0, 2261.0], [262.0, 2254.0]], "score": 0.9965469837188721, "text": "Madame le Président dépose ensuite sur le bureau et met à la disposition de l'Assemblée :"}, {"orientation_angle": 0, "polygon": [[260.0, 2307.0], [775.0, 2311.0], [775.0, 2362.0], [260.0, 2358.0]], "score": 0.9904016852378845, "text": "1. Les Statuts de la Société,"}, {"orientation_angle": 0, "polygon": [[253.0, 2357.0], [2131.0, 2369.0], [2130.0, 2427.0], [253.0, 2415.0]], "score": 0.9911053776741028, "text": "2. Les copies des avis de convocation adressés aux Actionnaires auxquels sont joints les récépissés postaux,"}, {"orientation_angle": 1, "polygon": [[41.0, 2403.0], [53.0, 2403.0], [53.0, 2427.0], [41.0, 2427.0]], "score": 0.48536747694015503, "text": "-,"}, {"orientation_angle": 0, "polygon": [[250.0, 2406.0], [2165.0, 2418.0], [2165.0, 2482.0], [250.0, 2469.0]], "score": 0.9872627854347229, "text": "3.La copie de la lettre de convocation adressée sous forme recommandée au Commissaire aux Comptes, avec"}, {"orientation_angle": 0, "polygon": [[336.0, 2471.0], [666.0, 2471.0], [666.0, 2519.0], [336.0, 2519.0]], "score": 0.9966456294059753, "text": "le récépissé postal,"}, {"orientation_angle": 0, "polygon": [[262.0, 2524.0], [312.0, 2524.0], [312.0, 2567.0], [262.0, 2567.0]], "score": 0.9990440607070923, "text": "4."}, {"orientation_angle": 0, "polygon": [[327.0, 2519.0], [1461.0, 2526.0], [1460.0, 2579.0], [327.0, 2572.0]], "score": 0.993589460849762, "text": "La feuille de présence à laquelle est jointe la liste des Actionnaires,"}, {"orientation_angle": 0, "polygon": [[258.0, 2575.0], [344.0, 2575.0], [344.0, 2625.0], [258.0, 2625.0]], "score": 0.9998185634613037, "text": "5."}, {"orientation_angle": 0, "polygon": [[331.0, 2579.0], [858.0, 2579.0], [858.0, 2625.0], [331.0, 2625.0]], "score": 0.9843818545341492, "text": "Les pouvoirs des Actionnaires,"}, {"orientation_angle": 0, "polygon": [[