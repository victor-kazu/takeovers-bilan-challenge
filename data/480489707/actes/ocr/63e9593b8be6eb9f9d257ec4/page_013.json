{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[2809.0, 736.0], [4111.0, 736.0], [4111.0, 866.0], [2809.0, 866.0]], "score": 0.9935563206672668, "text": "ARCHEAN Technologies"}, {"orientation_angle": 0, "polygon": [[2656.0, 871.0], [4298.0, 871.0], [4298.0, 1001.0], [2656.0, 1001.0]], "score": 0.9969050288200378, "text": "Société par Actions Simplifiée"}, {"orientation_angle": 0, "polygon": [[2680.0, 1006.0], [4231.0, 1001.0], [4231.0, 1131.0], [2680.0, 1136.0]], "score": 0.9982471466064453, "text": "au capital de 150.000 Euros"}, {"orientation_angle": 0, "polygon": [[1919.0, 1136.0], [5001.0, 1131.0], [5002.0, 1265.0], [1919.0, 1270.0]], "score": 0.9994283318519592, "text": "Siège social : Montauban (82) 721 avenue de Beausoleil"}, {"orientation_angle": 0, "polygon": [[3130.0, 1824.0], [3786.0, 1824.0], [3786.0, 1978.0], [3130.0, 1978.0]], "score": 0.999913215637207, "text": "STATUTS"}, {"orientation_angle": 0, "polygon": [[981.0, 2396.0], [2312.0, 2396.0], [2312.0, 2512.0], [981.0, 2512.0]], "score": 0.9814349412918091, "text": "3 - Démission - Révocation."}, {"orientation_angle": 0, "polygon": [[976.0, 2661.0], [5786.0, 2656.0], [5786.0, 2786.0], [976.0, 2791.0]], "score": 0.9845975637435913, "text": "Les fonctions de président prennent fin soit par le décès, la démission, la révocation, l'expiration de"}, {"orientation_angle": 0, "polygon": [[971.0, 2801.0], [5777.0, 2791.0], [5777.0, 2921.0], [972.0, 2931.0]], "score": 0.9906737208366394, "text": "son mandat, soit par l'ouverture à son encontre d'une procédure de redressement ou de liquidation"}, {"orientation_angle": 0, "polygon": [[961.0, 2927.0], [1515.0, 2915.0], [1518.0, 3064.0], [964.0, 3076.0]], "score": 0.9986531138420105, "text": "judiciaires."}, {"orientation_angle": 0, "polygon": [[981.0, 3200.0], [5743.0, 3200.0], [5743.0, 3330.0], [981.0, 3330.0]], "score": 0.9835135340690613, "text": "Le président peut démissionner de son mandat sous réserve de respecter un préavis de deux mois"}, {"orientation_angle": 0, "polygon": [[976.0, 3335.0], [5839.0, 3325.0], [5839.0, 3455.0], [977.0, 3465.0]], "score": 0.9856827855110168, "text": "lequel pourra être réduit par l'associé unique ou, en cas de pluralité d'associés, par la collectivité des"}, {"orientation_angle": 0, "polygon": [[976.0, 3465.0], [4714.0, 3460.0], [4714.0, 3590.0], [976.0, 3595.0]], "score": 0.9954995512962341, "text": "associés qui aura à statuer sur le remplacement du président démissionnaire."}, {"orientation_angle": 0, "polygon": [[991.0, 3729.0], [5858.0, 3729.0], [5858.0, 3859.0], [991.0, 3859.0]], "score": 0.9929507970809937, "text": "La démission du président n'est recevable que si elle est adressée à l'associé unique ou à chacun des"}, {"orientation_angle": 0, "polygon": [[991.0, 3869.0], [2618.0, 3869.0], [2618.0, 3984.0], [991.0, 3984.0]], "score": 0.9973325133323669, "text": "associés par lettre recommandée."}, {"orientation_angle": 0, "polygon": [[981.0, 4124.0], [5925.0, 4119.0], [5925.0, 4254.0], [981.0, 4259.0]], "score": 0.993342399597168, "text": "Le président personne physique sera considéré comme démissionnaire à la date où il aura atteint l'âge"}, {"orientation_angle": 0, "polygon": [[981.0, 4259.0], [1886.0, 4259.0], [1886.0, 4389.0], [981.0, 4389.0]], "score": 0.9787596464157104, "text": "de 75 ans révolus."}, {"orientation_angle": 0, "polygon": [[981.0, 4519.0], [5609.0, 4514.0], [5609.0, 4658.0], [981.0, 4663.0]], "score": 0.9887593984603882, "text": "Le président personne morale associée sera démissionnaire d'office au jour de l'ouverture d'une"}, {"orientation_angle": 0, "polygon": [[991.0, 4668.0], [3700.0, 4668.0], [3700.0, 4783.0], [991.0, 4783.0]], "score": 0.9961275458335876, "text": "procédure de redressement ou de liquidation judiciaires."}, {"orientation_angle": 0, "polygon": [[991.0, 4923.0], [5715.0, 4923.0], [5715.0, 5053.0], [991.0, 5053.0]], "score": 0.9942905306816101, "text": "Le président est révocable à tout moment par décision de l'associé unique ou de la collectivité des"}, {"orientation_angle": 0, "polygon": [[986.0, 5053.0], [5686.0, 5053.0], [5686.0, 5183.0], [986.0, 5183.0]], "score": 0.9831187725067139, "text": "associés délibérant dans les conditions prévues pour les décisions ordinaires et prise à la majorité"}, {"orientation_angle": 0, "polygon": [[981.0, 5193.0], [1971.0, 5182.0], [1972.0, 5317.0], [982.0, 5327.0]], "score": 0.9847086668014526, "text": "simple des associés."}, {"orientation_angle": 0, "polygon": [[981.0, 5447.0], [4121.0, 5437.0], [4121.0, 5582.0], [981.0, 5592.0]], "score": 0.9962581396102905, "text": "La décision de révocation du président peut ne pas être motivée."}, {"orientation_angle": 0, "polygon": [[991.0, 5721.0], [5825.0, 5721.0], [5825.0, 5851.0], [991.0, 5851.0]], "score": 0.9914413690567017, "text": "En outre, le président est révocable par le Tribunal de commerce pour cause légitime, à la demande"}, {"orientation_angle": 0, "polygon": [[981.0, 5857.0], [1760.0, 5846.0], [1762.0, 5966.0], [982.0, 5977.0]], "score": 0.9730254411697388, "text": "de tout associé."}, {"orientation_angle": 0, "polygon": [[996.0, 6126.0], [5648.0, 6126.0], [5648.0, 6241.0], [996.0, 6241.0]], "score": 0.995831310749054, "text": "La révocation du président personne morale ou du président personne physique, dont le mandat"}, {"orientation_angle": 0, "polygon": [[981.0, 6251.0], [5944.0, 6246.0], [5944.0, 6381.0], [981.0, 6386.0]], "score": 0.9918723106384277, "text": "social n'est pas rémunéré, ne peut en aucun cas ouvrir droit à versement par la société d'indemnité de"}, {"orientation_angle": 0, "polygon": [[986.0, 6386.0], [2101.0, 6386.0], [2101.0, 6515.0], [986.0, 6515.0]], "score": 0.9759771823883057, "text": "cessation de fonctions."}, {"orientation_angle": 0, "polygon": [[986.0, 6641.0], [1881.0, 6641.0], [1881.0, 6771.0], [986.0, 6771.0]], "score": 0.9970146417617798, "text": "4 - Rémunération."}, {"orientation_angle": 0, "polygon": [[996.0, 6915.0], [5724.0, 6915.0], [5724.0, 7045.0], [996.0, 7045.0]], "score": 0.9958083033561707, "text": "Le président peut recevoir une rémunération en compensation de la responsabilité et de la charge"}, {"orientation_angle": 0, "polygon": [[996.0, 7050.0], [5940.0, 7050.0], [5940.0, 7165.0], [996.0, 7165.0]], "score": 0.9922348260879517, "text": "attachées à ses fonctions dont les modalités de fixation et de règlement sont déterminées par l'associé"}, {"orientation_angle": 0, "polygon": [[986.0, 7180.0], [5844.0, 7175.0], [5844.0, 7305.0], [986.0, 7309.0]], "score": 0.9880322217941284, "text": "unique ou, en cas de pluralité d'associés, par une décision collective des associés délibérant dans les"}, {"orientation_angle": 0, "polygon": [[986.0, 7309.0], [3326.0, 7314.0], [3326.0, 7444.0], [986.0, 7439.0]], "score": 0.9981812238693237, "text": "conditions prévues pour les décisions ordinaires."}, {"orientation_angle": 0, "polygon": [[981.0, 7569.0], [5418.0, 7574.0], [5418.0, 7704.0], [981.0, 7699.0]], "score": 0.9915592074394226, "text": "Cette rémunération peut consister en un traitement fixe ou proportionnel ou à la fois fixe et"}, {"orientation_angle": 0, "polygon": [[996.0, 7718.0], [3384.0, 7718.0], [3384.0, 7834.0], [996.0, 7834.0]], "score": 0.9874331951141357, "text": "proportionnel au bénéfice ou au chiffre d'affaires."}, {"orientation_angle": 0, "polygon": [[986.0, 7844.0], [5336.0, 7839.0], [5337.0, 7969.0], [986.0, 7974.0]], "score": 0.9897969365119934, "text": "En outre, le président est remboursé de ses frais de représentation et de déplacement sur"}, {"orientation_angle": 0, "polygon": [[981.0, 7978.0], [1594.0, 7978.0], [1594.0, 8113.0], [981.0, 8113.0]], "score": 0.9994500875473022, "text": "justification."}, {"orientation_angle": 0, "polygon": [[991.0, 8108.0], [4944.0, 8108.0], [4944.0, 8238.0], [991.0, 8238.0]], "score": 0.9933093786239624, "text": "Cette rémunération et ces frais sont comptabilisés en frais généraux de la société."}, {"orientation_angle": 0, "polygon": [[986.0, 8368.0], [5614.0, 8363.0], [5614.0, 8508.0], [986.0, 8513.0]], "score": 0.991738498210907, "text": "Le président, personne physique, ou le représentant de la personne morale président, peut être"}, {"orientation_angle": 0, "polygon": [[986.0, 8513.0], [5935.0, 8503.0], [5935.0, 8633.0], [986.0, 8642.0]], "score": 0.9947930574417114, "text": "également lié à la société par un contrat de travail à condition que ce contrat corresponde à un emploi"}, {"orientation_angle": 0, "polygon": [[986.0, 8642.0], [1369.0, 8642.0], [1369.0, 8763.0], [986.0, 8763.0]], "score": 0.9998152256011963, "text": "effectif."}, {"orientation_angle": 0, "polygon": [[5715.0, 9109.0], [5954.0, 9109.0], [5954.0, 9220.0], [5715.0, 9220.0]], "score": 0.920374870300293, "text": "- 10 -"}, {"orientation_angle": 0, "polygon": [[1000.0, 9119.0], [2072.0, 9119.0], [2072.0, 9215.0], [1000.0, 9215.0]], "score": 0.9917356967926025, "text": "Statuts de la SAS ARCHEAN"}, {"orientation_angle": 0, "polygon": [[445.0, 9470.0], [479.0, 9470.0], [479.0, 9528.0], [445.0, 9528.0]], "score": 0.39743372797966003, "text": "−"}], "page": 13, "pdf": "63e9593b8be6eb9f9d257ec4__63e9593b8be6eb9f9d257ec4.pdf", "skew_angle": 0.0}