5.0]], "score": 0.9890499711036682, "text": "partir de 2025. En revanche, les composants précédents resteront amortissables sur une durée de 17 ans,"}, {"orientation_angle": 0, "polygon": [[167.0, 2151.0], [522.0, 2147.0], [522.0, 2190.0], [167.0, 2194.0]], "score": 0.9998700618743896, "text": "sans modification."}, {"orientation_angle": 0, "polygon": [[167.0, 2252.0], [2272.0, 2252.0], [2272.0, 2299.0], [167.0, 2299.0]], "score": 0.9872364401817322, "text": "La production immobilisée a été valorisée dans les comptes pour toutes les opérations en cours de"}, {"orientation_angle": 0, "polygon": [[165.0, 2306.0], [620.0, 2306.0], [620.0, 2352.0], [165.0, 2352.0]], "score": 0.9991218447685242, "text": "travaux ou d'études."}, {"orientation_angle": 0, "polygon": [[169.0, 2412.0], [2273.0, 2412.0], [2273.0, 2459.0], [169.0, 2459.0]], "score": 0.9921292662620544, "text": "Une provision pour dépréciation est comptabilisée quand la valeur probable des actifs en cours est"}, {"orientation_angle": 0, "polygon": [[169.0, 2464.0], [874.0, 2464.0], [874.0, 2511.0], [169.0, 2511.0]], "score": 0.9991649389266968, "text": "inférieure à la valeur comptable."}, {"orientation_angle": 0, "polygon": [[169.0, 2574.0], [702.0, 2574.0], [702.0, 2621.0], [169.0, 2621.0]], "score": 0.9862160682678223, "text": "Immobilisations en cours"}, {"orientation_angle": 0, "polygon": [[167.0, 2681.0], [2228.0, 2681.0], [2228.0, 2728.0], [167.0, 2728.0]], "score": 0.993725597858429, "text": "Sont comptabilisées à ce poste les immobilisations dont la mise en service ou la mise en location"}, {"orientation_angle": 0, "polygon": [[167.0, 2735.0], [722.0, 2735.0], [722.0, 2781.0], [167.0, 2781.0]], "score": 0.9815059304237366, "text": "n'est pas encore réalisée."}, {"orientation_angle": 0, "polygon": [[165.0, 2788.0], [2220.0, 2792.0], [2219.0, 2838.0], [165.0, 2835.0]], "score": 0.9965111613273621, "text": "Les terrains, constructions et travaux sont comptabilisés en immobilisations en cours à leur valeur"}, {"orientation_angle": 0, "polygon": [[165.0, 2840.0], [2186.0, 2843.0], [2186.0, 2895.0], [165.0, 2891.0]], "score": 0.9809545874595642, "text": "d'acquisition ou de production. Ils seront transférés, à l'achèvement des travaux, en compte «"}, {"orientation_angle": 0, "polygon": [[165.0, 2895.0], [2009.0, 2897.0], [2009.0, 2948.0], [165.0, 2947.0]], "score": 0.9944841265678406, "text": "immeuble de rapport » après ventilation du coût global par composants, hors terrains."}, {"orientation_angle": 0, "polygon": [[169.0, 3005.0], [886.0, 3005.0], [886.0, 3057.0], [169.0, 3057.0]], "score": 0.9847511053085327, "text": "Renouvellement des composants"}, {"orientation_angle": 0, "polygon": [[167.0, 3115.0], [1960.0, 3115.0], [1960.0, 3167.0], [167.0, 3167.0]], "score": 0.9973095655441284, "text": "Le renouvellement d'un ou plusieurs composants entraîne la substitution du (ou des)"}, {"orientation_angle": 0, "polygon": [[167.0, 3169.0], [2199.0, 3172.0], [2199.0, 3224.0], [167.0, 3221.0]], "score": 0.9926297664642334, "text": "composant(s) identifié(s), avec sortie d'actif immobilisé du (ou des) composant(s) remplacé(s)."}, {"orientation_angle": 0, "polygon": [[1196.0, 3265.0], [1248.0, 3265.0], [1248.0, 3314.0], [1196.0, 3314.0]], "score": 0.9999420046806335, "text": "14"}, {"orientation_angle": 0, "polygon": [[2294.0, 3389.0], [2423.0, 3389.0], [2423.0, 3515.0], [2294.0, 3515.0]], "score": 0.5375306010246277, "text": "J"}], "page": 10, "pdf": "CA_027080076_7901_1970B00007_2024_C__68b1b2aeb138a6b36d071512.pdf", "skew_angle": 0.0}