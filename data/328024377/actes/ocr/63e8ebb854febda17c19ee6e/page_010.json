{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[510.0, 260.0], [553.0, 260.0], [553.0, 302.0], [510.0, 302.0]], "score": 0.17800621688365936, "text": "E"}, {"orientation_angle": 0, "polygon": [[1693.0, 1233.0], [6318.0, 1209.0], [6319.0, 1364.0], [1693.0, 1389.0]], "score": 0.9878301620483398, "text": "IV. - Si un ou plusieurs sièges d'administrateurs deviennent"}, {"orientation_angle": 0, "polygon": [[1364.0, 1389.0], [6309.0, 1360.0], [6309.0, 1492.0], [1364.0, 1521.0]], "score": 0.9854453206062317, "text": "vacants entre deux assemblées générales, par suite de décès ou de"}, {"orientation_angle": 0, "polygon": [[1373.0, 1521.0], [6314.0, 1511.0], [6314.0, 1639.0], [1374.0, 1648.0]], "score": 0.9902581572532654, "text": "démission, le conseil d'administration peut procèder à une ou à des"}, {"orientation_angle": 0, "polygon": [[1373.0, 1672.0], [3524.0, 1657.0], [3524.0, 1785.0], [1374.0, 1799.0]], "score": 0.9874480366706848, "text": "nominations à titre provisoire."}, {"orientation_angle": 0, "polygon": [[1702.0, 1932.0], [6313.0, 1912.0], [6314.0, 2059.0], [1703.0, 2078.0]], "score": 0.9791034460067749, "text": "Les nominations d'administrateurs faites par le conseil"}, {"orientation_angle": 0, "polygon": [[1378.0, 2073.0], [6314.0, 2064.0], [6314.0, 2196.0], [1378.0, 2205.0]], "score": 0.9982127547264099, "text": "d'administration sont soumises à la ratification de la plus prochaine"}, {"orientation_angle": 0, "polygon": [[1373.0, 2220.0], [6332.0, 2196.0], [6333.0, 2337.0], [1374.0, 2361.0]], "score": 0.9837694764137268, "text": "assemblée générale ordinaire. A défaut de ratification, les"}, {"orientation_angle": 0, "polygon": [[1378.0, 2366.0], [6328.0, 2347.0], [6328.0, 2474.0], [1379.0, 2493.0]], "score": 0.982851505279541, "text": "délibérations prises et les actes accomplis antérieurement n'en"}, {"orientation_angle": 0, "polygon": [[1383.0, 2508.0], [3390.0, 2493.0], [3391.0, 2625.0], [1384.0, 2640.0]], "score": 0.