, 1918.0], [408.0, 1914.0]], "score": 0.9999272227287292, "text": "stockage."}]}, {"bbox": [402.1019287109375, 2083.193603515625, 2200.77783203125, 2189.894287109375], "label": "text", "score": 0.968749463558197, "texts": [{"orientation_angle": 0, "polygon": [[413.0, 2089.0], [2204.0, 2089.0], [2204.0, 2135.0], [413.0, 2135.0]], "score": 0.9856980443000793, "text": "Les stocks et en cours ont, le cas échéant, été dépréciés par voie de provision pour tenir"}, {"orientation_angle": 0, "polygon": [[413.0, 2146.0], [1691.0, 2142.0], [1691.0, 2188.0], [413.0, 2192.0]], "score": 0.9896540641784668, "text": "compte de leur valeur actuelle à la date de clôture de l'exercice."}]}, {"bbox": [406.29742431640625, 2725.885986328125, 2201.671875, 2832.766845703125], "label": "text", "score": 0.9645458459854126, "texts": [{"orientation_angle": 0, "polygon": [[412.0, 2730.0], [2204.0, 2730.0], [2204.0, 2781.0], [412.0, 2781.0]], "score": 0.991512656211853, "text": "Les créances ont, le cas échéant, été dépréciées par voie de provision pour tenir compte"}, {"orientation_angle": 0, "polygon": [[413.0, 2783.0], [2086.0, 2781.0], [2086.0, 2832.0], [413.0, 2834.0]], "score": 0.9903748631477356, "text": "des difficultés de recouvrement auxquelles elles étaient susceptibles de donner lieu."}]}, {"bbox": [400.796875, 1340.5689697265625, 2197.36572265625, 1445.1673583984375], "label": "text", "score": 0.9491406083106995, "texts": [{"orientation_angle": 0, "polygon": [[410.0, 1344.0], [2201.0, 1343.0], [2201.0, 1390.0], [410.0, 1392.0]], "score": 0.9855126738548279, "text": "Les matières et marchandises ont été évaluées à leur coût d'acquisition selon la méthode"}, {"orientation_angle": 0, "polygon": [[413.0, 1402.0], [1044.0, 1402.0], [1044.0, 1449.0], [413.0, 1449.0]], "score": 0.9938512444496155, "text": "du coût d'achat moyen pondéré."}]}, {"bbox": [405.47088623046875, 2432.087158203125, 1718.092529296875, 2478.545654296875], "label": "text", "score": 0.9441891312599182, "texts": [{"orie