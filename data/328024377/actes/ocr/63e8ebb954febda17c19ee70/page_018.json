ygon": [[1416.0, 4694.0], [3076.0, 4694.0], [3076.0, 4821.0], [1416.0, 4821.0]], "score": 0.9993073344230652, "text": "justifier de son mandat."}, {"orientation_angle": 0, "polygon": [[1736.0, 4963.0], [6443.0, 4992.0], [6442.0, 5133.0], [1736.0, 5104.0]], "score": 0.9880946278572083, "text": "Les représentants légaux d'actionnaires juridiquement incapables"}, {"orientation_angle": 0, "polygon": [[1383.0, 5114.0], [6438.0, 5143.0], [6437.0, 5284.0], [1383.0, 5256.0]], "score": 0.9839920401573181, "text": "et les personnes physiques représentant des personnes morales"}, {"orientation_angle": 0, "polygon": [[1388.0, 5260.0], [6452.0, 5284.0], [6452.0, 5431.0], [1387.0, 5407.0]], "score": 0.9788997769355774, "text": "actionnaires prennent part aux assemblées, qu'ils soient ou non"}, {"orientation_angle": 0, "polygon": [[1402.0, 5421.0], [3438.0, 5421.0], [3438.0, 5549.0], [1402.0, 5549.0]], "score": 0.9883803129196167, "text": "personnellement actionnaires."}, {"orientation_angle": 0, "polygon": [[1741.0, 5685.0], [6448.0, 5728.0], [6447.0, 5861.0], [1740.0, 5817.0]], "score": 0.976196825504303, "text": "III. - Tout actionnaire peut voter par correspondance au moyen"}, {"orientation_angle": 0, "polygon": [[1393.0, 5832.0], [6443.0, 5856.0], [6442.0, 5983.0], [1392.0, 5959.0]], "score": 0.9857775568962097, "text": "d'un formulaire établi et adressé à la société dans les conditions"}, {"orientation_angle": 0, "polygon": [[1407.0, 5988.0], [2656.0, 5988.0], [2656.0, 6101.0], [1407.0, 6101.0]], "score": 0.9679205417633057, "text": "fixées par la loi."}, {"orientation_angle": 0, "polygon": [[1455.0, 6398.0], [5680.0, 6418.0], [5679.0, 6559.0], [1454.0, 6540.0]], "score": 0.9759706258773804, "text": "Article 27 .- FEUILLE DE PRESENCE - BUREAU - PROCES-VERBAUX"}, {"orientation_angle": 0, "polygon": [[1746.0, 6686.0], [6448.0, 6715.0], [6447.0, 6857.0], [1745.0, 6828.0]], "score": 0.9901288151741028, "text": "I.- A chaque assemblée est tenue une feuille de présence contenant"}