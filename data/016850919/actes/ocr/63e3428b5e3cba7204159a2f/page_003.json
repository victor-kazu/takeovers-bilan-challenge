{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[1059.0, 305.0], [1488.0, 301.0], [1488.0, 353.0], [1059.0, 357.0]], "score": 0.9871150255203247, "text": "ORDRE DU JOUR"}, {"orientation_angle": 0, "polygon": [[313.0, 423.0], [2154.0, 415.0], [2155.0, 468.0], [314.0, 476.0]], "score": 0.983930766582489, "text": "- Nomination d'un nouveau Président en remplacement du Président démissionnaire,"}, {"orientation_angle": 0, "polygon": [[312.0, 482.0], [1391.0, 476.0], [1392.0, 529.0], [312.0, 535.0]], "score": 0.9962615966796875, "text": "- Pouvoirs pour l'accomplissement des formalités."}, {"orientation_angle": 0, "polygon": [[308.0, 595.0], [1264.0, 591.0], [1264.0, 642.0], [308.0, 646.0]], "score": 0.9999067187309265, "text": "Puis le Président déclare la discussion ouverte."}, {"orientation_angle": 0, "polygon": [[308.0, 711.0], [2234.0, 701.0], [2234.0, 752.0], [308.0, 763.0]], "score": 0.9986974596977234, "text": "Personne ne demandant la parole, le Président met successivement aux voix les résolutions"}, {"orientation_angle": 0, "polygon": [[313.0, 773.0], [539.0, 773.0], [539.0, 819.0], [313.0, 819.0]], "score": 0.9997527599334717, "text": "suivantes :"}, {"orientation_angle": 0, "polygon": [[312.0, 942.0], [945.0, 941.0], [946.0, 989.0], [312.0, 990.0]], "score": 0.9992917776107788, "text": "PREMIERE RESOLUTION"}, {"orientation_angle": 0, "polygon": [[312.0, 1054.0], [2235.0, 1045.0], [2236.0, 1098.0], [312.0, 1107.0]], "score": 0.9938888549804688, "text": "L'Assemblée Générale, prenant acte de la démission de Monsieur Bruno JACQUENET de son"}, {"orientation_angle": 0, "polygon": [[312.0, 1114.0], [2237.0, 1107.0], [2237.0, 1158.0], [312.0, 1165.0]], "score": 0.9835414290428162, "text": "mandat de Président à compter de ce jour, nomme en qualité de nouveau Président, pour une"}, {"orientation_angle": 0, "polygon": [[313.0, 1170.0], [641.0, 1170.0], [641.0, 1218.0], [313.0, 1218.0]], "score": 0.9991950988769531, "text": "durée