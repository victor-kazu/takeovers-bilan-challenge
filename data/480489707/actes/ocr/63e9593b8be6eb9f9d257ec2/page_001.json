.0], [731.0, 4845.0]], "score": 0.9856076836585999, "text": "ordinaire, 20 place Prax Paris à MONTAUBAN (8200O), sur convocation faite par lettre simple"}, {"orientation_angle": 0, "polygon": [[731.0, 4859.0], [3000.0, 4859.0], [3000.0, 4989.0], [731.0, 4989.0]], "score": 0.9863693118095398, "text": "adressée le 22 juillet 2005 à chaque associé."}, {"orientation_angle": 0, "polygon": [[717.0, 5139.0], [5996.0, 5143.0], [5996.0, 5288.0], [717.0, 5283.0]], "score": 0.9988637566566467, "text": "Il a été établi une feuille de présence qui a été émargée par chaque associé participant à l'assemblée en"}, {"orientation_angle": 0, "polygon": [[721.0, 5293.0], [4505.0, 5293.0], [4505.0, 5437.0], [721.0, 5437.0]], "score": 0.9939445853233337, "text": "entrant en séance, tant en son nom personnel qu'en qualité de mandataire."}, {"orientation_angle": 0, "polygon": [[712.0, 5577.0], [5991.0, 5582.0], [5991.0, 5726.0], [712.0, 5721.0]], "score": 0.985404372215271, "text": "L’assemblée est présidée par Monsieur Xavier AUMONT, en qualité de directeur général de la"}, {"orientation_angle": 0, "polygon": [[717.0, 5731.0], [1137.0, 5731.0], [1137.0, 5866.0], [717.0, 5866.0]], "score": 0.9977663159370422, "text": "société."}, {"orientation_angle": 0, "polygon": [[722.0, 6015.0], [5996.0, 6030.0], [5996.0, 6164.0], [721.0, 6150.0]], "score": 0.9935207366943359, "text": "Monsieur Antonio BLANCO MARINA et Monsieur Xavier AUMONT, associés représentant tant par"}, {"orientation_angle": 0, "polygon": [[721.0, 6174.0], [5996.0, 6174.0], [5996.0, 6304.0], [721.0, 6304.0]], "score": 0.9966747760772705, "text": "eux-mêmes que comme mandataires le plus grand nombre de voix et acceptant cette fonction, sont"}, {"orientation_angle": 0, "polygon": [[731.0, 6323.0], [2150.0, 6323.0], [2150.0, 6453.0], [731.0, 6453.0]], "score": 0.9980396032333374, "text": "appelés comme scrutateurs."}, {"orientation_angle": 0, "polygon": [[726.0, 6612.0], [3373.0, 6612.0], [3373.0, 6742.0], [726.0, 6742.0]], "score": 0.9984773397445679, "text": "Monsieur GICQUEL est désigné comme secrétaire."}, {"orientation_angle": 0, "polygon": [[712.0, 6891.0], [5996.0, 6901.0], [5996.0, 7046.0], [712.0, 7036.0]], "score": 0.9894591569900513, "text": "Monsieur Richard DESPRATS, commissaire aux comptes de la société, régulièrement convoqué, est"}, {"orientation_angle": 0, "polygon": [[726.0, 7060.0], [1605.0, 7060.0], [1605.0, 7176.0], [726.0, 7176.0]], "score": 0.9930698275566101, "text": "absent et excusé."}, {"orientation_angle": 0, "polygon": [[722.0, 7339.0], [5987.0, 7349.0], [5986.0, 7479.0], [721.0, 7469.0]], "score": 0.9948429465293884, "text": "La feuille de présence, certifiée exacte par les membres du bureau, permet de constater que les"}, {"orientation_angle": 0, "polygon": [[726.0, 7494.0], [5987.0, 7494.0], [5987.0, 7624.0], [726.0, 7624.0]], "score": 0.9930977821350098, "text": "associés présents ou ayant donné pouvoir possèdent 1500 actions sur les 1500 actions ayant le droit de"}, {"orientation_angle": 0, "polygon": [[712.0, 7638.0], [1003.0, 7638.0], [1003.0, 7778.0], [712.0, 7778.0]], "score": 0.9731292724609375, "text": "vote."}, {"orientation_angle": 0, "polygon": [[731.0, 7932.0], [5991.0, 7932.0], [5991.0, 8062.0], [731.0, 8062.0]], "score": 0.9946653842926025, "text": "En conséquence, l'assemblée générale, réunissant au moins la majorité du capital, est régulièrement"}, {"orientation_angle": 0, "polygon": [[721.0, 8081.0], [2809.0, 8076.0], [2809.0, 8206.0], [722.0, 8211.0]], "score": 0.9897406101226807, "text": "constituée et peut valablement délibérer."}, {"orientation_angle": 0, "polygon": [[731.0, 8370.0], [4448.0, 8370.0], [4448.0, 8500.0], [731.0, 8500.0]], "score": 0.9973703622817993, "text": "Le président dépose sur le bureau et met à la disposition de l'assemblée :"}, {"orientation_angle": 0, "polygon": [[3899.0, 8645.0], [3937.0, 8645.0], [3937.0, 8688.0], [3899.0, 8688.0]], "score": 0.4017178416252136, "text": "*"}, {"orientation_angle": 0, "polygon": [[731.0, 8659.0], [3703.0, 8659.0], [3703.0, 8789.0], [731.0, 8789.0]], "score": 0.9889417886734009, "text": "- les justificatifs des convocations régulières des associés,"}, {"orientation_angle": 0, "polygon": [[731.0, 9174.0], [4826.0, 9184.0], [4825.0, 9300.0], [731.0, 9290.0]], "score": 0.9882731437683105, "text": "PROCÈS-VERBAL DES DELIBERATIONS DE L'ASSEMBLÉE GENERALE ORDINAIRE DU 2/09/2005"}], "page": 1, "pdf": "63e9593b8be6eb9f9d257ec2__63e9593b8be6eb9f9d257ec2.pdf", "skew_angle": 0.0}