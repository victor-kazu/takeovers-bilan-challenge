entation_angle": 0, "polygon": [[112.0, 2632.0], [291.0, 2632.0], [291.0, 2668.0], [112.0, 2668.0]], "score": 0.999245822429657, "text": "- La clientèle"}, {"orientation_angle": 0, "polygon": [[111.0, 2705.0], [319.0, 2709.0], [318.0, 2745.0], [110.0, 2741.0]], "score": 0.9997473955154419, "text": "- L'achalandage"}, {"orientation_angle": 0, "polygon": [[112.0, 2784.0], [1560.0, 2784.0], [1560.0, 2819.0], [112.0, 2819.0]], "score": 0.9871838092803955, "text": "En l’absence d’amortissement du fonds de commerce (avant 2016), un test de dépréciation annuel est réalisé."}, {"orientation_angle": 0, "polygon": [[1194.0, 3345.0], [1240.0, 3345.0], [1240.0, 3380.0], [1194.0, 3380.0]], "score": 0.9999663829803467, "text": "27"}], "page": 6, "pdf": "CA_035550318_3902_K00211427042_2025_C__6984b6e6e339c7d5710f17c2.pdf", "skew_angle": 0.0}