128241539001, "text": " le rapport du gérant,"}, {"orientation_angle": 0, "polygon": [[296.0, 2203.0], [1278.0, 2198.0], [1278.0, 2244.0], [296.0, 2250.0]], "score": 0.9912862181663513, "text": " le texte des résolutions proposées au vote de l'assemblée."}, {"orientation_angle": 0, "polygon": [[296.0, 2323.0], [2170.0, 2316.0], [2170.0, 2363.0], [296.0, 2370.0]], "score": 0.9916020035743713, "text": "Le président déclare que les documents et renseignements prévus par les dispositions législatives et"}, {"orientation_angle": 0, "polygon": [[298.0, 2371.0], [2168.0, 2364.0], [2168.0, 2411.0], [298.0, 2418.0]], "score": 0.9931855201721191, "text": "règlementaires ont été adréssés aux associés ou tenus à leur disposition au siège social pendant le délai fixé par"}, {"orientation_angle": 0, "polygon": [[300.0, 2419.0], [644.0, 2419.0], [644.0, 2466.0], [300.0, 2466.0]], "score": 0.999930739402771, "text": "lesdites dispositions."}, {"orientation_angle": 0, "polygon": [[2080.0, 2448.0], [2094.0, 2448.0], [2094.0, 2466.0], [2080.0, 2466.0]], "score": 0.13307690620422363, "text": "7"}, {"orientation_angle": 0, "polygon": [[298.0, 2490.0], [1989.0, 2483.0], [1989.0, 2529.0], [298.0, 2536.0]], "score": 0.9888737797737122, "text": "L’assemblée sur sa demande lui donne acte de sa déclaration et reconnait la validité de la convocation."}, {"orientation_angle": 0, "polygon": [[298.0, 2560.0], [1980.0, 2555.0], [1981.0, 2603.0], [298.0, 2608.0]], "score": 0.976712703704834, "text": "Puis le président rappelle que l'Assemblée est réunie à l’effet de délibérer sur l'ordre du jour suivant :"}, {"orientation_angle": 0, "polygon": [[301.0, 2637.0], [704.0, 2637.0], [704.0, 2678.0], [301.0, 2678.0]], "score": 0.9885059595108032, "text": "Changement de gérance."}, {"orientation_angle": 0, "polygon": [[303.0, 2779.0], [1044.0, 2779.0], [1044.0, 2820.0], [303.0, 2820.0]], "score": 0.9919610619544983, "text": "Puis, lecture est donnée du rapport du gérant"}, {"orientation_angle": 0, "polygon": [[301.0, 2848.0], [844.0, 2844.0], [844.0, 2890.0], [302.0, 2894.0]], "score": 0.996251106262207, "text": "Le président ouvre la discussion."}, {"orientation_angle": 0, "polygon": [[300.0, 2918.0], [2172.0, 2909.0], [2172.0, 2956.0], [300.0, 2964.0]], "score": 0.9919980764389038, "text": "Personne ne demandant plus la parole, le Président met successivement aux voix les résolutions inscrites à"}, {"orientation_angle": 0, "polygon": [[300.0, 2966.0], [558.0, 2966.0], [558.0, 3012.0], [300.0, 3012.0]], "score": 0.9889954328536987, "text": "l'ordre du jour."}, {"orientation_angle": 1, "polygon": [[2043.0, 3287.0], [2279.0, 3294.0], [2276.0, 3402.0], [2040.0, 3395.0]], "score": 0.0, "text": ""}, {"orientation_angle": 0, "polygon": [[1870.0, 3305.0], [2001.0, 3305.0], [2001.0, 3384.0], [1870.0, 3384.0]], "score": 0.9202711582183838, "text": "MC"}, {"orientation_angle": 0, "polygon": [[1524.0, 3316.0], [1801.0, 3293.0], [1809.0, 3383.0], [1532.0, 3407.0]], "score": 0.8653184175491333, "text": "B"}], "page": 2, "pdf": "63e34290d0f29b5aaa0ced2c__63e34290d0f29b5aaa0ced2c.pdf", "skew_angle": 0.0}