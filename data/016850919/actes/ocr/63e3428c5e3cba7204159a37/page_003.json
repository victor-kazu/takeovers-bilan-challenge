{"layout": [], "most_frequent_angle": 0, "ocr": [{"orientation_angle": 0, "polygon": [[175.0, 146.0], [227.0, 190.0], [198.0, 223.0], [146.0, 180.0]], "score": 0.839934229850769, "text": "**"}, {"orientation_angle": 0, "polygon": [[1044.0, 368.0], [6185.0, 359.0], [6185.0, 500.0], [1045.0, 510.0]], "score": 0.9862605929374695, "text": "A la demande du Président, l'Assemblée lui donne acte de ses déclarations."}, {"orientation_angle": 0, "polygon": [[91.0, 496.0], [124.0, 496.0], [124.0, 529.0], [91.0, 529.0]], "score": 0.18856137990951538, "text": "M"}, {"orientation_angle": 0, "polygon": [[734.0, 581.0], [777.0, 581.0], [777.0, 637.0], [734.0, 637.0]], "score": 0.6002781391143799, "text": "7"}, {"orientation_angle": 0, "polygon": [[1059.0, 656.0], [3777.0, 656.0], [3777.0, 798.0], [1059.0, 798.0]], "score": 0.9943414330482483, "text": "Le Président rappelle l'ordre du jour :"}, {"orientation_angle": 1, "polygon": [[949.0, 897.0], [1006.0, 897.0], [1006.0, 940.0], [949.0, 940.0]], "score": 0.22855144739151, "text": "C"}, {"orientation_angle": 0, "polygon": [[1068.0, 949.0], [4449.0, 949.0], [4449.0, 1077.0], [1068.0, 1077.0]], "score": 0.9897013306617737, "text": "- lecture du rapport du conseil d'administration,"}, {"orientation_angle": 0, "polygon": [[1178.0, 1086.0], [3286.0, 1091.0], [3285.0, 1218.0], [1178.0, 1214.0]], "score": 0.9952135682106018, "text": "démission d'un Administrateur,"}, {"orientation_angle": 0, "polygon": [[1168.0, 1147.0], [1192.0, 1124.0], [1211.0, 1143.0], [1187.0, 1166.0]], "score": 0.5560323596000671, "text": "−"}, {"orientation_angle": 0, "polygon": [[1063.0, 1232.0], [2532.0, 1232.0], [2532.0, 1360.0], [1063.0, 1360.0]], "score": 0.9843359589576721, "text": "- questions diverses."}, {"orientation_angle": 0, "polygon": [[1054.0, 1492.0], [6295.0, 1483.0], [6295.0, 1624.0], [1054.0, 1634.0]], "score": 0.9916288256645203, "text": "Le Président donne alors lecture du rapport du conseil d'administration"}, {"orientation_angle": 0, "polygon": [[1063.0, 1643.0], [3500.0, 1634.0], [3500.0, 1766.0], [1064.0, 1776.0]], "score": 0.989884614944458, "text": "puis déclare la discussion ouverte."}, {"orientation_angle": 0, "polygon": [[1054.0, 1917.0], [6304.0, 1898.0], [6304.0, 2040.0], [1054.0, 2059.0]], "score": 0.9973837733268738, "text": "Personne ne demandant plus la parole, le Président met aux voix les"}, {"orientation_angle": 0, "polygon": [[1073.0, 2064.0], [2680.0, 2064.0], [2680.0, 2191.0], [1073.0, 2191.0]], "score": 0.9997313022613525, "text": "résolutions suivantes :"}, {"orientation_angle": 0, "polygon": [[1073.0, 2489.0], [2546.0, 2479.0], [2547.0, 2611.0], [1074.0, 2621.0]], "score": 0.9965745210647583, "text": "PREMIERE RESOLUTION :"}, {"orientation_angle": 0, "polygon": [[1078.0, 2767.0], [6309.0, 2753.0], [6309.0, 2880.0], [1078.0, 2895.0]], "score": 0.9967725872993469, "text": "L'Assemblée Générale, ayant pris acte de la démission remise le 2 novembre"}, {"orientation_angle": 0, "polygon": [[1073.0, 2900.0], [6299.0, 2885.0], [6300.0, 3032.0], [1073.0, 3046.0]], "score": 0.9841219782829285, "text": "1992 par Monsieur Jean-Paul JACQUENET de ses fonctions d'administrateur,"}, {"orientation_angle": 0, "polygon": [[1082.0, 3046.0], [6314.0, 3041.0], [6314.0, 3169.0], [1083.0, 3173.0]], "score": 0.9904833436012268, "text": "décide de ne pas procéder à son remplacement, le nombre d'administrateurs"}, {"orientation_angle": 0, "polygon": [[1082.0, 3188.0], [4211.0, 3183.0], [4211.0, 3310.0], [1083.0, 3315.0]], "score": 0.9994537234306335, "text": "restant conforme à la législation en vigueur."}, {"orientation_angle": 0, "polygon": [[1078.0, 3457.0], [5078.0, 3442.0], [5079.0, 3584.0], [1078.0, 3598.0]], "score": 0.9855849146842957, "text": "MISE AUX VOIX, CETTE RESOLUTION EST ADOPTEE A L'UNANIMITE"}, {"orientation_angle": 0, "polygon": [[1097.0, 3877.0], [2570.0, 3877.0], [2570.0, 4004.0], [1097.0, 4004.0]], "score": 0.9774994850158691, "text": "DEUXIEME RESOLUTION :"}, {"orientation_angle": 0, "polygon": [[1087.0, 4146.0], [6328.0, 4141.0], [6328.0, 4288.0], [1087.0, 4292.0]], "score": 0.9925832748413086, "text": "L'assemblée générale confère tous pouvoirs au Président du conseil"}, {"orientation_angle": 0, "polygon": [[1092.0, 4297.0], [6333.0, 4292.0], [6333.0, 4425.0], [1092.0, 4429.0]], "score": 0.9938601851463318, "text": "d'administration avec faculté de se substituer tout mandataire de son choix"}, {"orientation_angle": 0, "polygon": [[1092.0, 4434.0], [6338.0, 4434.0], [6338.0, 4576.0], [1092.0, 4576.0]], "score": 0.9839979410171509, "text": "à l'effet d'accomplir toutes formalités requises par la loi en conséquence"}, {"orientation_angle": 0, "polygon": [[1102.0, 4585.0], [3119.0, 4585.0], [3119.0, 4713.0], [1102.0, 4713.0]], "score": 0.9972196221351624, "text": "de la résolution qui précède."}, {"orientation_angle": 0, "polygon": [[1097.0, 4850.0], [5093.0, 4845.0], [5093.0, 4987.0], [1097.0, 4991.0]], "score": 0.9970809817314148, "text": "MISE AUX VOIX, CETTE RESOLUTION EST ADOPTEE A L'UNANIMITE"}, {"orientation_angle": 0, "polygon": [[1102.0, 5128.0], [6342.0, 5124.0], [6342.0, 5265.0], [1102.0, 5270.0]], "score": 0.9899280667304993, "text": "L'ordre du jour étant épuisé et personne ne demandant la parole, la séance"}, {"orientation_angle": 0, "polygon": [[1111.0, 5279.0], [2923.0, 5279.0], [2923.0, 5407.0], [1111.0, 5407.0]], "score": 0.9937736988067627, "text": "est levée à quinze heures."}, {"orientation_angle": 0, "polygon": [[1111.0, 5544.0], [6342.0, 5534.0], [6343.0, 5676.0], [1111.0, 5686.0]], "score": 0.9919411540031433, "text": "De tout ce que dessus, il a été dressé le présent procès verbal qui a été"}, {"orientation_angle": 0, "polygon": [[1116.0, 5695.0], [4382.0, 5681.0], [4383.0, 5808.0], [1116.0, 5823.0]], "score": 0.9956713914871216, "text": "signé par les membres du bureau, après lecture."}, {"orientation_angle": 0, "polygon": [[2165.0, 6247.0], [3066.0, 6247.0], [3066.0, 6380.0], [2165.0, 6380.0]], "score": 0.9982553720474243, "text": "Le Président,"}, {"orientation_angle": 0, "polygon": [[4249.0, 6243.0], [5227.0, 6243.0], [5227.0, 6375.0], [4249.0, 6375.0]], "score": 0.990592896938324, "text": "Le secrétaire,"}, {"orientation_angle": 0, "polygon": [[1397.0, 6526.0], [3090.0, 6516.0], [3090.0, 6658.0], [1398.0, 6668.0]], "score": 0.9976146221160889, "text": "Monsieur Bruno JACQUENET"}, {"orientation_angle": 0, "polygon": [[4034.0, 6521.0], [6008.0, 6516.0], [6009.0, 6649.0], [4035.0, 6654.0]], "score": 0.9984058141708374, "text": "Monsieur Jean-Paul JACQUENET"}, {"orientation_angle": 1, "polygon": [[5238.0, 6755.0], [5436.0, 6951.0], [5267.0, 7119.0], [5069.0, 6923.0]], "score": 0.6983959078788757, "text": "M/"}, {"orientation_angle": 0, "polygon": [[2232.0, 7055.0], [2313.0, 7055.0], [2313.0, 7107.0], [2232.0, 7107.0]], "score": 0.37786099314689636, "text": "("}, {"orientation_angle": 0, "polygon": [[3143.0, 7361.0], [4264.0, 7372.0], [4262.0, 7499.0], [3142.0, 7489.0]], "score": 0.9634628891944885, "text": "Les scrutateurs,"}, {"orientation_angle": 0, "polygon": [[4463.0, 7631.0], [5951.0, 7621.0], [5952.0, 7754.0], [4464.0, 7764.0]], "score": 0.9961851835250854, "text": "Madame Odile BOISSEAU"}, {"orientation_angle": 0, "polygon": [[1483.0, 7645.0], [3319.0, 7636.0], [3319.0, 7763.0], [1484.0, 7773.0]], "score": 0.99608314037323, "text": "Monsieur Bernard JACQUENET"}, {"orientation_angle": 0, "polygon": [[5570.0, 7829.0], [5620.0, 7879.0], [5579.0, 7919.0], [5529.0, 7869.0]], "score": 0.0, "text": ""}], "page": 3, "pdf": "63e3428c5e3cba7204159a37__63e3428c5e3cba7204159a37.pdf", "skew_angle": 0.0}