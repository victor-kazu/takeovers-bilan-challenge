": [[983.0, 3447.0], [6037.0, 3457.0], [6037.0, 3589.0], [982.0, 3579.0]], "score": 0.9728314876556396, "text": "en compte pour le calcul de la majorité et où l'apporteur ou"}, {"orientation_angle": 0, "polygon": [[978.0, 3574.0], [5871.0, 3594.0], [5870.0, 3735.0], [977.0, 3716.0]], "score": 0.9835392236709595, "text": "le bénéficiaire n'a voix délibérative ni pour lui-même, ni"}, {"orientation_angle": 0, "polygon": [[992.0, 3726.0], [6123.0, 3740.0], [6123.0, 3868.0], [992.0, 3853.0]], "score": 0.9835043549537659, "text": "comme mandataire, approuve l'évaluation des apports en nature"}, {"orientation_angle": 0, "polygon": [[983.0, 3853.0], [6200.0, 3868.0], [6199.0, 4014.0], [982.0, 4000.0]], "score": 0.9893167614936829, "text": "ou l'octroi des avantages particuliers,elle constate la réali-"}, {"orientation_angle": 0, "polygon": [[997.0, 3999.0], [3996.0, 4019.0], [3996.0, 4146.0], [996.0, 4127.0]], "score": 0.9732952117919922, "text": "sation de l'augmentation de capital."}, {"orientation_angle": 0, "polygon": [[1321.0, 4136.0], [6061.0, 4156.0], [6061.0, 4297.0], [1321.0, 4278.0]], "score": 0.9893807768821716, "text": "Si l'assemblée réduit l'évaluation des apports en nature"}, {"orientation_angle": 0, "polygon": [[992.0, 4278.0], [6047.0, 4302.0], [6046.0, 4444.0], [992.0, 4420.0]], "score": 0.9918215870857239, "text": "ou la rémunération des avantages particuliers, l'approbation"}, {"orientation_angle": 0, "polygon": [[992.0, 4420.0], [6209.0, 4439.0], [6209.0, 4581.0], [992.0, 4561.0]], "score": 0.9852991700172424, "text": "expresse par les apporteurs ou les bénéficiaires des avantages"}, {"orientation_angle": 0, "polygon": [[992.0, 4561.0], [5794.0, 4585.0], [5794.0, 4727.0], [992.0, 4703.0]], "score": 0.9912047386169434, "text": "particuliers est nécessaire ; à défaut, l'augmentation du"}, {"orientation_angle": 0, "polygon": [[997.0, 4708.0], [3248.0, 4718.0], [3247.0, 4845.0], [996.0, 4835.0]], "score": 0.9755404591560364, "text": "capital n'est pas réalisée."}, {"orientation_angle": 0, "polygon": [[1331.0, 4840.0], [6228.0, 4864.0], [6227.0, 5010.0], [1330.0, 4986.0]], "score": 0.9741658568382263, "text": "Les actions d'apport en nature sont intégralement libérées"}, {"orientation_angle": 0, "polygon": [[1007.0, 4986.0], [2490.0, 4996.0], [2489.0, 5124.0], [1006.0, 5114.0]], "score": 0.9786507487297058, "text": "dès leur émission."}, {"orientation_angle": 0, "polygon": [[1331.0, 5194.0], [6309.0, 5213.0], [6309.0, 5360.0], [1330.0, 5341.0]], "score": 0.9787355661392212, "text": "§ Xl. - Les augmentations du capital sont réalisées nonobs-"}, {"orientation_angle": 0, "polygon": [[1007.0, 5341.0], [6142.0, 5365.0], [6142.0, 5502.0], [1006.0, 5478.0]], "score": 0.9915305376052856, "text": "tant l'existence de \"rompus\" et les actionnaires ne disposant"}, {"orientation_angle": 0, "polygon": [[1002.0, 5497.0], [5713.0, 5506.0], [5713.0, 5638.0], [1001.0, 5629.0]], "score": 0.9912742376327515, "text": "pas du nombre de droits de souscription ou d'attribution"}, {"orientation_angle": 0, "polygon": [[997.0, 5643.0], [6133.0, 5653.0], [6132.0, 5785.0], [997.0, 5775.0]], "score": 0.9916130304336548, "text": "exactement nécessaires pour obtenir la délivrance d'un nombre"}, {"orientation_angle": 0, "polygon": [[992.0, 5775.0], [6052.0, 5794.0], [6051.0, 5936.0], [992.0, 5917.0]], "score": 0.9921165108680725, "text": "entier d'actions nouvelles, font leur affaire personnelle de"}, {"orientation_angle": 0, "polygon": [[1002.0, 5921.0], [5189.0, 5936.0], [5188.0, 6082.0], [1001.0, 6068.0]], "score": 0.9970123767852783, "text": "toute acquisition ou cession nécessaire de droits."}, {"orientation_angle": 0, "polygon": [[1331.0, 6134.0], [5980.0, 6148.0], [5980.0, 6295.0], [1330.0, 6280.0]], "score": 0.9756226539611816, "text": "§ XIll. - L'assemblée générale peut déléguer au conseil"}, {"orientation_angle": 0, "polygon": [[1006.0, 6276.0], [6314.0, 6290.0], [6314.0, 6432.0], [1006.0, 6417.0]], "score": 0.9858974814414978, "text": "