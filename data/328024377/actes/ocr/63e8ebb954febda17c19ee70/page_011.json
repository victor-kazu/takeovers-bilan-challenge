4891166687, "text": "représenter auprès de la société par un seul d'entre eux, considéré"}, {"orientation_angle": 0, "polygon": [[1392.0, 2498.0], [6375.0, 2460.0], [6376.0, 2606.0], [1393.0, 2645.0]], "score": 0.9753996729850769, "text": "comme seul propriétaire ou par un mandataire unique. En cas de"}, {"orientation_angle": 0, "polygon": [[1402.0, 2635.0], [6370.0, 2606.0], [6371.0, 2748.0], [1403.0, 2777.0]], "score": 0.973353922367096, "text": "désaccord, le mandataire unique peut être désigné en justice à la"}, {"orientation_angle": 0, "polygon": [[1406.0, 2791.0], [4415.0, 2762.0], [4416.0, 2890.0], [1408.0, 2919.0]], "score": 0.9935733675956726, "text": "demande du copropriétaire le plus diligent."}, {"orientation_angle": 0, "polygon": [[1755.0, 3055.0], [6385.0, 3022.0], [6386.0, 3168.0], [1756.0, 3202.0]], "score": 0.977766215801239, "text": "II. - Sauf convention contraire notifiée à la société, les"}, {"orientation_angle": 0, "polygon": [[1426.0, 3207.0], [6375.0, 3173.0], [6376.0, 3305.0], [1426.0, 3339.0]], "score": 0.9829179048538208, "text": "usufruitiers d'actions représentent valablement les nus-propriétaires"}, {"orientation_angle": 0, "polygon": [[1421.0, 3348.0], [6385.0, 3319.0], [6386.0, 3447.0], [1422.0, 3476.0]], "score": 0.994016706943512, "text": "à l'égard de la société. Toutefois, le droit de vote appartient au"}, {"orientation_angle": 0, "polygon": [[1425.0, 3499.0], [5746.0, 3461.0], [5747.0, 3593.0], [1427.0, 3632.0]], "score": 0.9979642629623413, "text": "nu-propriétaire dans les assemblées générales extraordinaires."}, {"orientation_angle": 0, "polygon": [[1497.0, 3920.0], [4438.0, 3881.0], [4440.0, 4023.0], [1499.0, 4062.0]], "score": 0.9752021431922913, "text": "ArtiCle 14 . - CONSEIL D'ADMINISTRATION ."}, {"orientation_angle": 0, "polygon": [[1788.0, 4198.0], [6408.0, 4155.0], [6410.0, 4283.0], [1789.0, 4326.0]], "score": 0.9915298819541931, "text": "I. - La société est administrée par un conseil d'administration de"}, {"orientation_angle": 0, "polygon": [[1449.0, 4349.0], [6418.0, 4306.0], [6419.0, 4439.0], [1450.0, 4482.0]], "score": 0.9886838793754578, "text": "trois membres au moins et de douze au plus, sous réserve de la"}, {"orientation_angle": 0, "polygon": [[1449.0, 4505.0], [4663.0, 4467.0], [4664.0, 4594.0], [1451.0, 4633.0]], "score": 0.986548900604248, "text": "dérogation prévue par la loi en cas de fusion."}, {"orientation_angle": 0, "polygon": [[1788.0, 4770.0], [6442.0, 4736.0], [6443.0, 4878.0], [1789.0, 4911.0]], "score": 0.9845506548881531, "text": "En cours de vie sociale, les administrateurs sont nommés ou"}, {"orientation_angle": 0, "polygon": [[1454.0, 4926.0], [6423.0, 4882.0], [6424.0, 5015.0], [1455.0, 5058.0]], "score": 0.9884552955627441, "text": "renouvelés dans leurs fonctions par l'assemblée générale ordinaire des"}, {"orientation_angle": 0, "polygon": [[1463.0, 5072.0], [2364.0, 5057.0], [2366.0, 5184.0], [1465.0, 5200.0]], "score": 0.999137818813324, "text": "actionnaires."}, {"orientation_angle": 0, "polygon": [[1821.0, 5341.0], [5998.0, 5307.0], [5999.0, 5440.0], [1822.0, 5473.0]], "score": 0.9752870798110962, "text": "II. - La durée de leurs fonctions est de six années au plus."}, {"orientation_angle": 0, "polygon": [[1812.0, 5615.0], [6456.0, 5567.0], [6457.0, 5709.0], [1813.0, 5757.0]], "score": 0.9929779171943665, "text": "Les fonctions d'un administrateur prennent fin à l'issue de la"}, {"orientation_angle": 0, "polygon": [[1478.0, 5766.0], [6451.0, 5713.0], [6453.0, 5855.0], [1479.0, 5908.0]], "score": 0.9887828826904297, "text": "réunion de l'assemblée générale ordinaire qui statue sur les comptes de"}, {"orientation_angle": 0, "polygon": [[1483.0, 5908.0], [6451.0, 5865.0], [6453.0, 6011.0], [1484.0, 6054.0]], "score": 0.983224630355835, "text": "l'exercice écoulé, tenue dans l'année au cours de laquelle expire le"}, {"orientation_angle": 0, "polygon": [[1478.0, 6064.0], [3423.0, 6044.0], [3424.0, 6171.0], [1479.0, 6191.0]], "score": 0.9845696091651917, "text": "mandac dudit administrateur."}, {"orientation_angle": 0, "polygon": [[1826.0, 6338.0], [5054.0, 6308.0], [5055.0, 6455.0], [1827.0, 6484.0]], "score": 0.9930981993675232, "text": "Les administrateurs sont toujours rééligibles."}, {"orientation_angle": 0, "polygon": [[1845.0, 6621.0], [6470.0, 6573.0], [6472.0, 6719.0], [1847.0, 6767.0]], "score": 0.9893243312835693, "text": "Ils peuvent étre révoqués à tout moment par l'assemblée générale"}, {"orientation_angle": 0, "polygon": [[1502.0, 6776.0], [2194.0, 6776.0], [2194.0, 6904.0], [1502.0, 6904.0]], "score": 0.9996203184127808, "text": "ordinaire."}, {"orientation_angle": 0, "polygon": [[1855.0, 7060.0], [6485.0, 7017.0], [6486.0, 7144.0], [1856.0, 7188.0]], "score": 0.9861436486244202, "text": "III. - Les administrateurs peuvent être des personnes physiques ou"}, {"orientation_angle": 0, "polygon": [[1511.0, 7211.0], [6475.0, 7154.0], [6476.0, 7281.0], [1513.0, 7339.0]], "score": 0.9970971345901489, "text": "des personnes morales. Ces dernières doivent, lors de leur nomination,"}, {"orientation_angle": 0, "polygon": [[1511.0, 7343.0], [6499.0, 7286.0], [6500.0, 7427.0], [1513.0, 7485.0]], "score": 0.9851187467575073, "text": "désigner un représentant permanent qui est soumis aux mêmes conditions"}, {"orientation_angle": 0, "polygon": [[1511.0, 7485.0], [6499.0, 7423.0], [6500.0, 7564.0], [1513.0, 7627.0]], "score": 0.9876226186752319, "text": "et obligations et qui encourt les mêmes responsabilités que s'il était"}, {"orientation_angle": 0, "polygon": [[1521.0, 7622.0], [6503.0, 7569.0], [6505.0, 7716.0], [1522.0, 7768.0]], "score": 0.9985787272453308, "text": "administrateur en son nom propre, sans préjudice de la responsabilité"}, {"orientation_angle": 0, "polygon": [[1525.0, 7759.0], [6518.0, 7711.0], [6519.0, 7857.0], [1527.0, 7905.0]], "score": 0.9910248517990112, "text": "solidaire de la personne morale qu'il représente. Ce mandat de"}, {"orientation_angle": 0, "polygon": [[1535.0, 7920.0], [6518.0, 7852.0], [6519.0, 7985.0], [1537.0, 8052.0]], "score": 0.974401593208313, "text": "représentant permanent lui est donné pour la durée de celui de la"}, {"orientation_angle": 0, "polygon": [[1535.0, 8052.0], [6575.0, 7999.0], [6577.0, 8141.0], [1537.0, 8193.0]], "score": 0.9734114408493042, "text": "personne morale qu'il représente. Il doit étre renouvelé à chcque."}, {"orientation_angle": 0, "polygon": [[1545.0, 8198.0], [4120.0, 8179.0], [4120.0, 8292.0], [1546.0, 8311.0]], "score": 0.9971873164176941, "text": "renouvellement de mandat de celle-ci."}, {"orientation_angle": 0, "polygon": [[1878.0, 8467.0], [6528.0, 8424.0], [6529.0, 8566.0], [1880.0, 8609.0]], "score": 0.9724000692367554, "text": "Si la personne morale révoque le mandat de son représencant , elle"}, {"orientation_angle": 0, "polygon": [[1540.0, 8618.0], [6527.0, 8561.0], [6529.0, 8702.0], [1541.0, 8760.0]], "score": 0.9882920384407043, "text": "est tenue de notifier cette révocation à la société, sans délai, par"}, {"orientation_angle": 0, "polygon": [[1554.0, 8769.0], [6528.0, 8721.0], [6529.0, 8849.0], [1555.0, 8897.0]], "score": 0.9813574552536011, "text": "lettre recommandée, ainsi que l'identité de son nouveau représentanc"}, {"orientation_angle": 0, "polygon": [[1544.0, 8916.0], [6546.0, 8853.0], [6548.0, 8995.0], [1546.0, 9058.0]], "score": 0.9806181192398071, "text": "permanent. Il en est de même en cas de décès, de démission ou"}, {"orientation_angle": 0, "polygon": [[1554.0, 9048.0], [4992.0, 9024.0], [4993.0, 9151.0], [1555.0, 9175.0]], "score": 0.962099015712738, "text": "d'empéchement prolongé du représencant permanent."}], "page": 11, "pdf": "63e8ebb954febda17c19ee70__63e8ebb954febda17c19ee70.pdf", "skew_angle": 0.9787620637412618}