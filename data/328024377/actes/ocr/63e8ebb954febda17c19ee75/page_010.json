095.0], [522.0, 1144.0], [290.0, 1148.0]], "score": 0.9986488223075867, "text": "Article 8 "}, {"orientation_angle": 0, "polygon": [[584.0, 1097.0], [1503.0, 1095.0], [1504.0, 1143.0], [584.0, 1145.0]], "score": 0.9998053908348083, "text": "MODIFICATION DU CAPITAL SOCIAL"}, {"orientation_angle": 0, "polygon": [[286.0, 1210.0], [1156.0, 1210.0], [1156.0, 1261.0], [286.0, 1261.0]], "score": 0.9764689803123474, "text": "8.1. Le capital social peut être augmenté :"}, {"orientation_angle": 0, "polygon": [[370.0, 1326.0], [2275.0, 1326.0], [2275.0, 1378.0], [370.0, 1378.0]], "score": 0.9949133992195129, "text": "Soit par l'émission, au pair ou avec prime, d'actions nouvelles, ordinaires ou de préférence, de"}, {"orientation_angle": 0, "polygon": [[369.0, 1384.0], [2275.0, 1384.0], [2275.0, 1436.0], [369.0, 1436.0]], "score": 0.9991161823272705, "text": "valeurs mobilières quelles qu'elles soient, donnant immédiatement ou à terme accès au capital,"}, {"orientation_angle": 0, "polygon": [[367.0, 1439.0], [2278.0, 1439.0], [2278.0, 1496.0], [367.0, 1496.0]], "score": 0.9954035878181458, "text": "libérées soit en numéraire, soit par compensation avec des créances liquides et exigibles sur la"}, {"orientation_angle": 0, "polygon": [[365.0, 1496.0], [529.0, 1496.0], [529.0, 1552.0], [365.0, 1552.0]], "score": 0.9986922740936279, "text": "société,"}, {"orientation_angle": 0, "polygon": [[370.0, 1557.0], [1485.0, 1557.0], [1485.0, 1609.0], [370.0, 1609.0]], "score": 0.9974082112312317, "text": "Soit par incorporation de réserves, bénéfices ou primes,"}, {"orientation_angle": 0, "polygon": [[369.0, 1614.0], [882.0, 1618.0], [882.0, 1671.0], [368.0, 1667.0]], "score": 0.9862963557243347, "text": "Soit par apport en nature,"}, {"orientation_angle": 0, "polygon": [[286.0, 1727.0], [2277.0, 1729.0], [2277.0, 1780.0], [286.0, 1778.0]], "score": 0.9906811714172363, "text": "Le tout en vertu d'une décision collective des associés prise dans les formes et conditions"}, {"orientation_angle": 0, "polygon": [[289.0, 1784.0], [1734.0, 1787.0], [1734.0, 1838.0], [289.0, 1835.0]], "score": 0.9974270462989807, "text": "déterminées au titre \"DECISIONS COLLECTIVES\" des présents statuts."}, {"orientation_angle": 0, "polygon": [[291.0, 1902.0], [2278.0, 1902.0], [2278.0, 1953.0], [291.0, 1953.0]], "score": 0.9880433082580566, "text": "En cas d'augmentation de capital en numéraire ou émission de valeurs mobilières donnant accès au"}, {"orientation_angle": 0, "polygon": [[289.0, 1960.0], [2278.0, 1958.0], [2279.0, 2011.0], [289.0, 2013.0]], "score": 0.9840513467788696, "text": "capital ou donnant droit à l'attribution de titres de créances, les associés ont, proportionnellement"}, {"orientation_angle": 0, "polygon": [[289.0, 2018.0], [2278.0, 2018.0], [2278.0, 2070.0], [289.0, 2070.0]], "score": 0.9969893097877502, "text": "au montant de leurs actions, un droit de préférence à la souscription des actions nouvelles ; ils"}, {"orientation_angle": 0, "polygon": [[286.0, 2073.0], [2280.0, 2070.0], [2280.0, 2128.0], [286.0, 2131.0]], "score": 0.9934356212615967, "text": "peuvent renoncer individuellement à ce droit suivant les conditions et modalités fixées par la"}, {"orientation_angle": 0, "polygon": [[291.0, 2133.0], [2277.0, 2133.0], [2277.0, 2185.0], [291.0, 2185.0]], "score": 0.9933676719665527, "text": "réglementation en vigueur. Les associés disposent, en outre, d'un droit de souscription à titre"}, {"orientation_angle": 0, "polygon": [[288.0, 2188.0], [1993.0, 2193.0], [1993.0, 2245.0], [288.0, 2239.0]], "score": 0.9968881607055664, "text": "réductible si la décision collective d'augmentation de capital l'a décidé expressément"}, {"orientation_angle": 0, "polygon": [[288.0, 2303.0], [2277.0, 2305.0], [2277.0, 2358.0], [288.0, 2356.0]], "score": 0.9899471402168274, "text": "La décision collective qui décide l'augmentation de capital peut, dans les conditions et limites fixées"}, {"orientation_angle": 0, "polygon": [[288.0, 2363.0], [2277.0, 2361.0], [2277.0, 2414.0], [288.0, 2416.0]], "score": 0.9903740882873535, "text": "par la loi, supprimer l'exercice du droit préférentiel de souscription et réserver la souscription des"}, {"orientation_angle": 0, "polygon": [[293.0, 2423.0], [1242.0, 2423.0], [1242.0, 2469.0], [293.0, 2469.0]], "score": 0.9928315281867981, "text": "actions nouvelles à telle personne de son choix."}, {"orientation_angle": 0, "polygon": [[286.0, 2532.0], [2036.0, 2536.0], [2036.0, 2589.0], [286.0, 2585.0]], "score": 0.9887511730194092, "text": "8.2. Le capital peut être réduit selon les formes et dans les conditions fixées par la loi."}, {"orientation_angle": 0, "polygon": [[289.0, 2692.0], [524.0, 2692.0], [524.0, 2740.0], [289.0, 2740.0]], "score": 0.9447485208511353, "text": "Article 9 -"}, {"orientation_angle": 0, "polygon": [[581.0, 2688.0], [1126.0, 2692.0], [1126.0, 2745.0], [580.0, 2741.0]], "score": 0.9997146725654602, "text": "FORME DES ACTIONS"}, {"orientation_angle": 0, "polygon": [[286.0, 2803.0], [1779.0, 2808.0], [1779.0, 2865.0], [286.0, 2860.0]], "score": 0.9968216419219971, "text": "Les actions émises par la société ont obligatoirement la forme nominative."}, {"orientation_angle": 0, "polygon": [[288.0, 2914.0], [2275.0, 2921.0], [2275.0, 2978.0], [288.0, 2971.0]], "score": 0.9920532703399658, "text": "Elles sont inscrites en compte au nom de leur propriétaire à la diligence de la société, conformément"}, {"orientation_angle": 0, "polygon": [[286.0, 2974.0], [2275.0, 2980.0], [2275.0, 3033.0], [286.0, 3027.0]], "score": 0.9997344613075256, "text": "à la réglementation en vigueur. A la demande de l'associé, une attestation d'inscription en compte"}, {"orientation_angle": 0, "polygon": [[288.0, 3029.0], [877.0, 3031.0], [877.0, 3082.0], [288.0, 3081.0]], "score": 0.9895585775375366, "text": "lui est délivrée par la société."}, {"orientation_angle": 0, "polygon": [[1262.0, 3348.0], [1300.0, 3348.0], [1300.0, 3391.0], [1262.0, 3391.0]], "score": 0.9999731779098511, "text": "4"}], "page": 10, "pdf": "63e8ebb954febda17c19ee75__63e8ebb954febda17c19ee75.pdf", "skew_angle": 0.0}