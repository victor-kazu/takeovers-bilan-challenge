angle": 0, "polygon": [[298.0, 1326.0], [2171.0, 1312.0], [2172.0, 1363.0], [298.0, 1377.0]], "score": 0.9945365190505981, "text": "Il a été établi une feuille de présence qui a été émargée par chaque associé présent ou mandataire"}, {"orientation_angle": 0, "polygon": [[301.0, 1389.0], [709.0, 1383.0], [710.0, 1425.0], [302.0, 1430.0]], "score": 0.9998856782913208, "text": "en entrant en séance."}, {"orientation_angle": 0, "polygon": [[303.0, 1497.0], [1551.0, 1486.0], [1552.0, 1532.0], [303.0, 1543.0]], "score": 0.9765564799308777, "text": "L'Assemblée est présidée par Monsieur Philippe SILVAiN, Président."}, {"orientation_angle": 0, "polygon": [[303.0, 1608.0], [1775.0, 1592.0], [1776.0, 1639.0], [303.0, 1654.0]], "score": 0.9915027618408203, "text": "Madame Maryline CHAUBARD assume également le secrétariat de l'Assemblée."}, {"orientation_angle": 0, "polygon": [[305.0, 1718.0], [1612.0, 1705.0], [1612.0, 1753.0], [305.0, 1766.0]], "score": 0.9996703267097473, "text": "La feuille de présence est certifiée sincère et véritable par le Président."}, {"orientation_angle": 0, "polygon": [[303.0, 1829.0], [2173.0, 1813.0], [2174.0, 1861.0], [303.0, 1877.0]], "score": 0.9948866367340088, "text": "L'Assemblée est déclarée régulièrement constituée et peut valablement délibérer à la majorité"}, {"orientation_angle": 0, "polygon": [[298.0, 1886.0], [462.0, 1882.0], [464.0, 1936.0], [299.0, 1941.0]], "score": 0.9999593496322632, "text": "requise."}, {"orientation_angle": 0, "polygon": [[305.0, 1997.0], [1873.0, 1979.0], [1874.0, 2027.0], [305.0, 2045.0]], "score": 0.9845957159996033, "text": "Monsieur Philippe SILVAIN dépose sur le bureau et met à la disposition des associés :"}, {"orientation_angle": 0, "polygon": [[525.0, 2106.0], [1453.0, 2098.0], [1454.0, 2146.0], [526.0, 2154.0]], "score": 0.9981656670570374, "text": "la copie des convocations adressées aux associés ;"}, {"orientation_angle": 1, "polygon": [[424.0, 2129.0], [441.0, 2129.0], [441.0, 2144.0], [424.0, 2144