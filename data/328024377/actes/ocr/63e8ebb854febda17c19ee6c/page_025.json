 0, "polygon": [[648.0, 4057.0], [2071.0, 4047.0], [2072.0, 4188.0], [649.0, 4198.0]], "score": 0.9791929721832275, "text": "Maurice BERNACHON."}, {"orientation_angle": 0, "polygon": [[1054.0, 4362.0], [5966.0, 4338.0], [5967.0, 4483.0], [1055.0, 4507.0]], "score": 0.9947831630706787, "text": "Sont scrutateurs de l'assemblée les deux membres disposant du plus grand nombre de"}, {"orientation_angle": 0, "polygon": [[653.0, 4526.0], [2915.0, 4507.0], [2916.0, 4647.0], [654.0, 4667.0]], "score": 0.9997404217720032, "text": "voix et acceptant cette fonction, savoir :"}, {"orientation_angle": 0, "polygon": [[1063.0, 4822.0], [3367.0, 4802.0], [3369.0, 4948.0], [1064.0, 4967.0]], "score": 0.9988842606544495, "text": "- Monsieur Jean-Jacques BERNACHON"}, {"orientation_angle": 0, "polygon": [[1068.0, 4972.0], [3144.0, 4957.0], [3145.0, 5102.0], [1069.0, 5117.0]], "score": 0.9960532188415527, "text": "- Madame Françoise BERNACHON"}, {"orientation_angle": 0, "polygon": [[1059.0, 5276.0], [4039.0, 5262.0], [4040.0, 5407.0], [1059.0, 5422.0]], "score": 0.9939818382263184, "text": "Le bureau de l'assemblée désigne comme secrétaire :"}, {"orientation_angle": 0, "polygon": [[1068.0, 5581.0], [3153.0, 5562.0], [3154.0, 5717.0], [1069.0, 5736.0]], "score": 0.9898840188980103, "text": "- Madame Françoise BERNACHON"}, {"orientation_angle": 0, "polygon": [[1068.0, 6036.0], [5742.0, 6017.0], [5743.0, 6172.0], [1069.0, 6191.0]], "score": 0.9903488159179688, "text": "Monsieur le commissaire aux comptes, régulièrement convoqué, est absent excusé."}, {"orientation_angle": 0, "polygon": [[1063.0, 6336.0], [5990.0, 6317.0], [5990.0, 6472.0], [1064.0, 6491.0]], "score": 0.9892569780349731, "text": "La feuille de présence est vérifiée puis arrêtée par le Bureau de l'Assemblée qui"}, {"orientation_angle": 0, "polygon": [[667.0, 6505.0], [5985.0, 6472.0], [5986.0, 6617.0], [668.0, 6651.0]], "score": 0.9854976534843445, "text": "constate que les actionnaires présents ou représentés, possèdent plus de la moitié des actions"}, {"orientation_angle": 0, "polygon": [[662.0, 6655.0], [5994.0, 6617.0], [5995.0, 6772.0], [663.0, 6810.0]], "score": 0.992307186126709, "text": "composant le capital social et jouissant du droit de vote sur toutes les questions à l'ordre du"}, {"orientation_angle": 0, "polygon": [[658.0, 6801.0], [5994.0, 6772.0], [5995.0, 6932.0], [658.0, 6960.0]], "score": 0.9892235398292542, "text": "jour autres que celles relatives à l'approbation des conventions réglementées. En conséquence,"}, {"orientation_angle": 0, "polygon": [[662.0, 6955.0], [5994.0, 6932.0], [5995.0, 7077.0], [663.0, 7101.0]], "score": 0.9955474734306335, "text": "Monsieur le Président déclare l'assemblée régulièrement constituée et apte à délibérer"}, {"orientation_angle": 0, "polygon": [[664.0, 7105.0], [1410.0, 7115.0], [1407.0, 7261.0], [662.0, 7250.0]], "score": 0.9998951554298401, "text": "valablement."}, {"orientation_angle": 0, "polygon": [[1082.0, 7560.0], [5150.0, 7536.0], [5151.0, 7691.0], [1083.0, 7715.0]], "score": 0.9938063025474548, "text": "Monsieur le Président met à la disposition des membres de l'assemblée :"}, {"orientation_angle": 0, "polygon": [[1087.0, 7861.0], [3391.0, 7851.0], [3392.0, 8010.0], [1087.0, 8020.0]], "score": 0.9987589716911316, "text": "- Un exemplaire des statuts de la société,"}, {"orientation_angle": 0, "polygon": [[1096.0, 8175.0], [5966.0, 8160.0], [5967.0, 8301.0], [1097.0, 8315.0]], "score": 0.9968762397766113, "text": "- Une copie de la lettre de convocation adressée à chaque actionnaire et les attestations"}, {"orientation_angle": 0, "polygon": [[681.0, 8339.0], [2131.0, 8329.0], [2132.0, 8474.0], [682.0, 8484.0]], "score": 0.9997192621231079, "text": "postales correspondantes,"}, {"orientation_angle": 0, "polygon": [[1096.0, 8620.0], [5971.0, 8601.0], [5972.0, 8761.0], [1097.0, 8780.0]], "score": 0.9601827263832092, "text": "- La copie de la lettre de convocation du Comímissaire aux/comptes avec l'accusé de"}, {"orientation_ang