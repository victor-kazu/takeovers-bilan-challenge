es respectivement pour le prix de vente ci-dessous :"}, {"orientation_angle": 0, "polygon": [[1093.0, 2188.0], [1294.0, 2188.0], [1294.0, 2229.0], [1093.0, 2229.0]], "score": 0.9998732805252075, "text": "Nombre de"}, {"orientation_angle": 0, "polygon": [[1415.0, 2184.0], [1724.0, 2188.0], [1724.0, 2234.0], [1415.0, 2230.0]], "score": 0.9992557764053345, "text": "Nombre de parts"}, {"orientation_angle": 0, "polygon": [[1753.0, 2186.0], [1842.0, 2186.0], [1842.0, 2230.0], [1753.0, 2230.0]], "score": 0.9989023804664612, "text": "Prix"}, {"orientation_angle": 0, "polygon": [[1874.0, 2189.0], [1930.0, 2189.0], [1930.0, 2232.0], [1874.0, 2232.0]], "score": 0.9999639391899109, "text": "de"}, {"orientation_angle": 0, "polygon": [[1959.0, 2193.0], [2063.0, 2193.0], [2063.0, 2230.0], [1959.0, 2230.0]], "score": 0.9999498128890991, "text": "vente"}, {"orientation_angle": 0, "polygon": [[468.0, 2208.0], [609.0, 2208.0], [609.0, 2256.0], [468.0, 2256.0]], "score": 0.9958291053771973, "text": "Associé"}, {"orientation_angle": 0, "polygon": [[1090.0, 2234.0], [1333.0, 2230.0], [1333.0, 2276.0], [1090.0, 2280.0]], "score": 0.9998990893363953, "text": "parts sociales"}, {"orientation_angle": 0, "polygon": [[1418.0, 2234.0], [1673.0, 2234.0], [1673.0, 2275.0], [1418.0, 2275.0]], "score": 0.9998217225074768, "text": "sociales cédées"}, {"orientation_angle": 0, "polygon": [[1753.0, 2232.0], [1847.0, 2232.0], [1847.0, 2277.0], [1753.0, 2277.0]], "score": 0.9998710751533508, "text": "total"}, {"orientation_angle": 0, "polygon": [[468.0, 2289.0], [857.0, 2289.0], [857.0, 2335.0], [468.0, 2335.0]], "score": 0.9989169836044312, "text": "Mr Jacques BOCKEL"}, {"orientation_angle": 0, "polygon": [[1187.0, 2287.0], [1292.0, 2287.0], [1292.0, 2336.0], [1187.0, 2336.0]], "score": 0.9918571710586548, "text": "1.700"}, {"orientation_angle": 0, "polygon": [[1534.0, 2287.0], [1610.0, 2287.0], [1610.0, 2338.0], [1534.0, 2338.0]], "score": 0.9999082684516907, "text": "106"}, {"orientation_angle": 0, "p